            dequant = float(q);
          }
          accumulator += x_value *
              (LOAD_VALUE(scales.values[scale_base + group]) *
                    dequant +
                  LOAD_VALUE(biases.values[bias_base + group]));
        }
      }
    // Every lane reaches the reduction, including inactive slots
    // (accumulator 0), so the barriers stay uniform across the
    // workgroup. RPL: the Q4 path reduces R accumulators per slot with
    // the shipped per-column pairing; the generic path keeps the
    // shipped single-accumulator reduction untouched.
#ifdef QMM_VEC_Q4_WORD
#ifdef USE_SUBGROUP
    float total0 = subgroupAdd(accumulator0);
    RPL_STEP_2(float total1 = subgroupAdd(accumulator1);)
    RPL_STEP_3(float total2 = subgroupAdd(accumulator2);)
    RPL_STEP_4(float total3 = subgroupAdd(accumulator3);)
    if (lane_in_slot == 0u) {
      if (column0 < params.matrix_n) {
        output_data.values[params.output_offset + b * params.matrix_n +
            column0] = STORE_VALUE(total0);
      }
      RPL_STEP_2(if (column0 + 1u < params.matrix_n) {
        output_data.values[params.output_offset + b * params.matrix_n +
            column0 + 1u] = STORE_VALUE(total1);
      })
      RPL_STEP_3(if (column0 + 2u < params.matrix_n) {
        output_data.values[params.output_offset + b * params.matrix_n +
            column0 + 2u] = STORE_VALUE(total2);
      })
      RPL_STEP_4(if (column0 + 3u < params.matrix_n) {
        output_data.values[params.output_offset + b * params.matrix_n +
            column0 + 3u] = STORE_VALUE(total3);
      })
    }
#else
    reduce_scratch0[lane] = accumulator0;
    RPL_STEP_2(reduce_scratch1[lane] = accumulator1;)
    RPL_STEP_3(reduce_scratch2[lane] = accumulator2;)
    RPL_STEP_4(reduce_scratch3[lane] = accumulator3;)
    barrier();
    for (uint offset = 1u; offset < LANES; offset <<= 1u) {
      if ((lane_in_slot & (2u * offset - 1u)) == 0u) {
        reduce_scratch0[lane] += reduce_scratch0[lane + offset];
        RPL_STEP_2(reduce_scratch1[lane] += reduce_scratch1[lane + offset];)
        RPL_STEP_3(reduce_scratch2[lane] += reduce_scratch2[lane + offset];)
        RPL_STEP_4(reduce_scratch3[lane] += reduce_scratch3[lane + offset];)
      }
      barrier();
    }
    if (lane_in_slot == 0u) {
      if (column0 < params.matrix_n) {
        output_data.values[params.output_offset + b * params.matrix_n +
            column0] = STORE_VALUE(reduce_scratch0[lane]);
      }
      RPL_STEP_2(if (column0 + 1u < params.matrix_n) {
        output_data.values[params.output_offset + b * params.matrix_n +
            column0 + 1u] = STORE_VALUE(reduce_scratch1[lane]);
      })
      RPL_STEP_3(if (column0 + 2u < params.matrix_n) {
        output_data.values[params.output_offset + b * params.matrix_n +
            column0 + 2u] = STORE_VALUE(reduce_scratch2[lane]);
      })
      RPL_STEP_4(if (column0 + 3u < params.matrix_n) {
        output_data.values[params.output_offset + b * params.matrix_n +
            column0 + 3u] = STORE_VALUE(reduce_scratch3[lane]);
      })
    }
#endif
#else
#ifdef USE_SUBGROUP
    float total = subgroupAdd(accumulator);
    if (lane_in_slot == 0u && column_active) {
      output_data.values[params.output_offset + b * params.matrix_n +
          column] = STORE_VALUE(total);
    }
#else
    reduce_scratch0[lane] = accumulator;
    barrier();
    for (uint offset = 1u; offset < LANES; offset <<= 1u) {
      if ((lane_in_slot & (2u * offset - 1u)) == 0u) {
        reduce_scratch0[lane] += reduce_scratch0[lane + offset];
      }
      barrier();
    }
    if (lane_in_slot == 0u && column_active) {
      output_data.values[params.output_offset + b * params.matrix_n +
          column] = STORE_VALUE(reduce_scratch0[lane]);
    }
#endif
#endif
  }
}
