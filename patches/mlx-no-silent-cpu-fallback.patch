--- a/mlx/device.cpp
+++ b/mlx/device.cpp
@@ -6,2 +6,4 @@
 #include "mlx/backend/gpu/device_info.h"
+#include "mlx/backend/omarchy/device_selection.h"
+#include "mlx/backend/omarchy/omarchy.h"
 #include "mlx/device.h"
@@ -11,3 +13,18 @@
 Device& mutable_default_device() {
-  static Device default_device{gpu::is_available() ? Device::gpu : Device::cpu};
+  static Device default_device{[] {
+    // Release builds never evaluate tensor primitives on CPU: when the
+    // Omarchy Vulkan runtime failed to initialize, raise the recorded
+    // compatibility error instead of silently degrading to CPU. Debug
+    // builds keep the CPU fallback so hosts without Apple GPUs can run
+    // development logic.
+#ifdef NDEBUG
+    constexpr bool kReleaseBuild = true;
+#else
+    constexpr bool kReleaseBuild = false;
+#endif
+    return omarchy::gpu_default_or_refuse(
+               gpu::is_available(), kReleaseBuild, omarchy::init_error())
+        ? Device::gpu
+        : Device::cpu;
+  }()};
   return default_device;
