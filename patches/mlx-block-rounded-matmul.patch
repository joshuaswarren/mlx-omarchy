+class BlockRoundedMatmul : public Custom {
+ public:
+  BlockRoundedMatmul(
+      Stream stream,
+      std::function<std::vector<array>(std::vector<array>)> fallback)
+      : Custom(stream, std::move(fallback)) {}
+
+  static bool use_fallback(Stream stream);
+
+  void eval_cpu(const std::vector<array>& inputs, std::vector<array>& outputs)
+      override {
+    throw std::runtime_error("NYI");
+  }
+  void eval_gpu(const std::vector<array>& inputs, std::vector<array>& outputs)
+      override;
+
+  DEFINE_NAME(BlockRoundedMatmul)
+  DEFINE_DEFAULT_IS_EQUIVALENT()
+
+  std::vector<Shape> output_shapes(const std::vector<array>& inputs)
+      override {
+    Shape shape = inputs[0].shape();
+    shape.back() =
+        static_cast<int>(inputs[1].size()) / inputs[0].shape(-1);
+    return {shape};
+  }
+};
