+array block_rounded_matmul(
+    const array& x,
+    const array& weight,
+    StreamOrDevice s_ /* = {} */) {
+  auto s = to_stream(s_);
+  if (weight.ndim() != 1) {
+    std::ostringstream msg;
+    msg << "[block_rounded_matmul] weight must have 1 dimension but has "
+        << weight.ndim() << " dimensions.";
+    throw std::invalid_argument(msg.str());
+  }
+  if (x.dtype() != float16 || weight.dtype() != float16) {
+    std::ostringstream msg;
+    msg << "[block_rounded_matmul] received unsupported types " << x.dtype()
+        << " and " << weight.dtype() << "; both operands must be float16.";
+    throw std::invalid_argument(msg.str());
+  }
+  const int K = x.shape(-1);
+  if (K <= 0 || (K % 16) != 0 || weight.size() % K != 0) {
+    std::ostringstream msg;
+    msg << "[block_rounded_matmul] K must be a positive multiple of 16 and"
+           " the weight size a positive multiple of K, but got K = "
+        << K << " and weight size " << weight.size() << ".";
+    throw std::invalid_argument(msg.str());
+  }
+  const int N = static_cast<int>(weight.size()) / K;
+
+  auto fallback = [s, K, N](const std::vector<array>& inputs) {
+    // Composition fallback: one fp32-accumulated matmul rounded once.
+    // Correct math, but not the block-rounded contract.
+    auto wb = transpose(reshape(inputs[1], {N, K}, s), {1, 0}, s);
+    return std::vector<array>{astype(
+        matmul(astype(inputs[0], float32, s), astype(wb, float32, s), s),
+        float16,
+        s)};
+  };
+
+  if (!BlockRoundedMatmul::use_fallback(s)) {
+    Shape out_shape(x.shape().begin(), x.shape().end() - 1);
+    out_shape.push_back(N);
+    return array(
+        out_shape,
+        float16,
+        std::make_shared<BlockRoundedMatmul>(s, fallback),
+        {x, weight});
+  }
+  return fallback({x, weight})[0];
+}
+
 } // namespace mlx::core::fast
