+void settle(std::vector<array> outputs) {
+  if (outputs.empty()) {
+    return;
+  }
+  if (std::none_of(outputs.begin(), outputs.end(), [](array& x) {
+        return x.status() == array::Status::unscheduled;
+      })) {
