+  // Grouped-K models (Qwen3.5-9B: linear_num_key_heads=16,
+  // linear_num_value_heads=32) hand q/k with Hk != Hv. Expand q/k to Hv
+  // heads here so the fused kernel's square-head contract holds;
+  // otherwise use_fallback returns true and the composed per-token loop
+  // runs (~7x slower prefill measured on the M2). Mirrors the repeat the
+  // composed fallback below already performs, which becomes a no-op.
+  if (Hv != Hk) {
+    int repeat_factor = Hv / Hk;
+    q = repeat(q, repeat_factor, 2, s);
+    k = repeat(k, repeat_factor, 2, s);
+    Hk = Hv;
+  }
