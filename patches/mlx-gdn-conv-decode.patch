+class GdnConvUpdate : public Custom {
+ public:
+  GdnConvUpdate(
+      Stream stream,
+      std::function<std::vector<array>(std::vector<array>)> fallback,
+      bool activate)
+      : Custom(stream, std::move(fallback)), activate_{activate} {}
+  // Backend-defined: the fused path never composes.
+  static bool use_fallback(Stream s);
+  // Decode-shaped depthwise causal conv (groups == C, stride 1, no
+  // padding, no dilation, bf16, MLX conv weight layout
+  // [C_out, K, C_in/groups]) with the state concatenation folded
+  // into the read. Everything else (prefill, other dtypes or shapes)
+  // composes the exact model ops via the fallback. `activate` applies
+  // the model's silu to the conv output inside the same dispatch; the
+  // backend reproduces the composed sigmoid -> mul rounding exactly.
+  static bool use_fallback(
+      const array& state,
+      const array& x,
+      const array& weight,
+      Stream s) {
+    return x.ndim() != 3 || state.ndim() != 3 || weight.ndim() != 3 ||
+        state.dtype() != bfloat16 || x.dtype() != bfloat16 ||
+        weight.dtype() != bfloat16 || x.shape(1) != 1 ||
+        x.shape(0) != state.shape(0) || x.shape(2) != state.shape(2) ||
+        state.shape(1) != weight.shape(1) - 1 || weight.shape(2) != 1 ||
+        weight.shape(0) != x.shape(2);
+  }
+  void eval_cpu(const std::vector<array>& inputs, std::vector<array>& outputs)
+      override {
+    throw std::runtime_error("NYI");
+  }
+  void eval_gpu(const std::vector<array>& inputs, std::vector<array>& outputs)
+      override;
+  bool activates() const {
+    return activate_;
+  }
+  DEFINE_NAME(GdnConvUpdate)
+  DEFINE_INPUT_OUTPUT_SHAPE()
+
+ private:
+  bool activate_{false};
+};
