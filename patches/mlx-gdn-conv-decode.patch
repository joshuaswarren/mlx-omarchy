+std::vector<array> gdn_conv_update(
+    const array& state,
+    const array& x,
+    const array& weight,
+    bool activate,
+    int qk_key_dim,
+    float qk_scale_q,
+    float qk_scale_k,
+    float qk_eps,
+    StreamOrDevice s_) {
+  auto s = to_stream(s_);
+  // Fallback composes the exact ops the model runs today: concatenate
+  // the carry-in state onto the row, conv1d over it, apply the model's
+  // silu when `activate` (out * sigmoid(out), the nn.silu composition),
+  // and keep the last K-1 rows as the carry-out state. With
+  // `qk_key_dim > 0` it also composes the model's per-head
+  // rms_norm_scaled q/k pair (reshape to head rows of 128, norm, reshape
+  // back) on the first 2*qk_key_dim channels of the conv output.
+  auto fallback = [s, activate, qk_key_dim, qk_scale_q, qk_scale_k, qk_eps](
+                      std::vector<array> inputs) {
+    auto ci = concatenate({inputs[0], inputs[1]}, 1, s);
+    auto out = conv1d(ci, inputs[2], 1, 0, 1, inputs[2].shape(0), s);
+    if (activate) {
+      out = out * sigmoid(out, s);
+    }
+    if (qk_key_dim > 0) {
+      int b = out.shape(0);
+      int t = out.shape(1);
+      auto parts = split(out, {qk_key_dim, 2 * qk_key_dim}, -1, s);
+      auto shape4 = Shape{b, t, qk_key_dim / 128, 128};
+      auto norm_one = [&](const array& part, double scale) {
+        auto r = reshape(part, shape4, s);
+        // Off-bf16, the model composes a python-scalar multiply: the
+        // scalar converts to the array's dtype FIRST (one rounding),
+        // so wrap the scale at the part's dtype instead of relying on
+        // C++ scalar promotion (float32), which double-rounds.
+        array n = (part.dtype() == bfloat16)
+            ? rms_norm_scaled(r, std::nullopt, scale, qk_eps, s)
+            : multiply(
+                  array(scale, part.dtype()),
+                  rms_norm(r, std::nullopt, qk_eps, s),
+                  s);
+        return reshape(n, part.shape(), s);
+      };
+      out = concatenate(
+          {norm_one(parts[0], qk_scale_q),
+           norm_one(parts[1], qk_scale_k),
+           parts[2]},
+          -1,
+          s);
+    }
+    int keep = inputs[2].shape(2) - 1;
+    int start_t = ci.shape(1) - keep;
+    auto ns = slice(
+        ci,
+        Shape{0, start_t, 0},
+        Shape{ci.shape(0), ci.shape(1), ci.shape(2)},
+        s);
+    return std::vector<array>{out, ns};
+  };
+  if (GdnConvUpdate::use_fallback(state, x, weight, s)) {
+    auto r = fallback({state, x, weight});
+      return r;
+  }
+  int B = x.shape(0);
+  int C = x.shape(2);
+  int K = weight.shape(1);
+  return array::make_arrays(
+      /* output shapes */ {{B, 1, C}, {B, K - 1, C}},
+      /* dtypes */ {bfloat16, bfloat16},
+      /* primitive */
+      std::make_shared<GdnConvUpdate>(
+          s, fallback, activate, qk_key_dim, qk_scale_q, qk_scale_k, qk_eps),
+      /* inputs */ std::vector<array>{state, x, weight});
+}
