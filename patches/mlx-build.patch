--- a/mlx/CMakeLists.txt
+++ b/mlx/CMakeLists.txt
@@ -103,7 +103,16 @@ else()
                  PRIVATE ${CMAKE_CURRENT_SOURCE_DIR}/backend/cuda/no_cuda.cpp)
 endif()
 
-if(MLX_BUILD_METAL OR MLX_BUILD_CUDA)
+if(MLX_BUILD_OMARCHY)
