+array reflect_pad(
+    const array& a,
+    const std::vector<int>& axes,
+    const Shape& low_pad_size,
+    const Shape& high_pad_size,
+    const Shape& out_shape,
+    bool include_edge,
+    StreamOrDevice s /* = {} */) {
+  array result = a;
+  for (size_t i = 0; i < axes.size(); i++) {
+    int ax = axes[i];
+    int n = a.shape(ax);
+    int L = low_pad_size[i];
+    int H = high_pad_size[i];
+    if (L == 0 && H == 0) {
+      continue;
+    }
+    if (n == 0) {
+      std::ostringstream msg;
+      msg << "[pad] Cannot pad empty axis " << ax << " using mode '"
+          << (include_edge ? "symmetric" : "reflect") << "'.";
+      throw std::invalid_argument(msg.str());
+    }
+    // Each padded axis becomes one device gather over the original axis. The
+    // host builds only the source index table; no values move on the host.
+    // The table replays the placement NumPy's np.pad uses: every iteration
+    // re-derives the reflectable chunk from the whole filled region (core
+    // plus both pads written so far), so the chunk grows as the region fills.
+    // A fixed-size tile drifts out of phase once a pad outgrows one tile and
+    // duplicates the wrong edge. n == 1 has no reflection: NumPy and the
+    // previous loop both repeat the edge value, so index 0 fills the axis.
+    int total = L + n + H;
+    std::vector<int32_t> src(total, 0);
+    if (n > 1) {
+      int edge_offset = include_edge ? 1 : 0;
+      int reflect_adjust = include_edge ? 0 : 1;
+      std::vector<int32_t> map(total, -1);
+      for (int p = L; p < L + n; ++p) {
+        map[p] = p - L;
+      }
+      int left_rem = L;
+      int right_rem = H;
+      while (left_rem > 0 || right_rem > 0) {
+        int old_length = total - left_rem - right_rem - reflect_adjust;
+        if (left_rem > 0) {
+          int chunk = std::min(old_length, left_rem);
+          int start = left_rem - edge_offset + chunk;
+          for (int k = 0; k < chunk; ++k) {
+            map[left_rem - chunk + k] = map[start - k];
+          }
+          left_rem -= chunk;
+        }
+        if (right_rem > 0) {
+          int chunk = std::min(old_length, right_rem);
+          int start = total - right_rem + edge_offset - 2;
+          for (int k = 0; k < chunk; ++k) {
+            map[total - right_rem + k] = map[start - k];
+          }
+          right_rem -= chunk;
+        }
+      }
+      src = std::move(map);
+    }
+    array indices(src.data(), Shape{total}, int32);
+    result = take(result, indices, ax, s);
+  }
+  return result;
+}
 
