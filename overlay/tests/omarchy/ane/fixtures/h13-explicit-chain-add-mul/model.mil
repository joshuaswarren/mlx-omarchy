program(1.3)
[buildInfo = dict<string, string>({})]
{
  func main<ios18>(tensor<fp16, [1, 64, 1, 1]> a, tensor<fp16, [1, 64, 1, 1]> b) {
    tensor<fp16, [1, 64, 1, 1]> sum = add(x = a, y = b)[name = string("sum")];
    tensor<fp16, [1, 64, 1, 1]> y = mul(x = sum, y = b)[name = string("product")];
  } -> (y);
}
