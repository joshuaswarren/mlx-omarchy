#version 460

#ifdef USE_FP16
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
#else
#define STORAGE_TYPE float
#endif

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer InputA {
  STORAGE_TYPE values[];
} input_a;
layout(set = 0, binding = 1, std430) readonly buffer InputB {
  STORAGE_TYPE values[];
} input_b;
layout(set = 0, binding = 2, std430) writeonly buffer Output {
  STORAGE_TYPE values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
} params;

void main() {
  uint index = gl_GlobalInvocationID.x;
  uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  while (index < params.count) {
    uint lhs_index = params.lhs_offset + (params.lhs_size == 1
        ? 0
        : (params.lhs_size == params.count ? index : index % params.lhs_size));
    uint rhs_index = params.rhs_offset + (params.rhs_size == 1
        ? 0
        : (params.rhs_size == params.count ? index : index % params.rhs_size));
    float lhs = float(input_a.values[lhs_index]);
    float rhs = float(input_b.values[rhs_index]);
    float value;
    switch (params.operation) {
      case 0:
        value = lhs + rhs;
        break;
      case 1:
        value = lhs * rhs;
        break;
      case 2:
        value = lhs / rhs;
        break;
      case 3:
        value = isnan(lhs) || isnan(rhs)
            ? uintBitsToFloat(0x7fc00000u)
            : max(lhs, rhs);
        break;
      case 4:
        value = exp(lhs);
        break;
      case 5:
        value = 1.0 / (1.0 + exp(-lhs));
        break;
      case 6:
        value = lhs * lhs;
        break;
      case 7:
        value = sqrt(lhs);
        break;
      case 8:
        value = inversesqrt(lhs);
        break;
      default:
        return;
    }
    output_data.values[params.output_offset + index] = STORAGE_TYPE(value);
    if (params.count - index <= stride) {
      break;
    }
    index += stride;
  }
}
