#version 460

#ifdef USE_FP16
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#elif defined(USE_BF16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define STORAGE_TYPE uint16_t
#define LOAD_VALUE(x) uintBitsToFloat(uint(x) << 16u)
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
#define STORE_VALUE(f) bf16_store(f)
#else
#define STORAGE_TYPE float
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#endif

layout(local_size_x = 256) in;

// Operation selector, specialized per pipeline (ComputeRuntime::pipeline
// with params.operation): the switch below then folds to one case and
// the pipeline carries only that case's code, constants, and preamble.
// Unspecialized (the default) it reads params.operation at runtime.
layout(constant_id = 0) const uint OPERATION = 0xffffffffu;

layout(set = 0, binding = 0, std430) readonly buffer InputA {
  STORAGE_TYPE values[];
} input_a;
layout(set = 0, binding = 1, std430) readonly buffer InputB {
  STORAGE_TYPE values[];
} input_b;
layout(set = 0, binding = 2, std430) writeonly buffer Output {
  STORAGE_TYPE values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  // dims == 0 selects the modulo fast path below. Otherwise the output
  // is unraveled over shape[] and lhs_strides/rhs_strides index the
  // operands; a stride of 0 broadcasts the axis.
  uint dims;
  uint shape[4];
  uint lhs_strides[4];
  uint rhs_strides[4];
} params;
layout(set = 0, binding = 3, std430) readonly buffer AxisMetadata {
  uint values[];
} axis_data;

// External broadcast transport: matrix_k carries the collapsed axis count
// and axis_data holds [extents | lhs strides | rhs strides], the
// reduce_general.comp binding-3 word order. matrix_k == 0 keeps the
// inline push-constant arrays; the host always binds the metadata slot
// (a placeholder while inline) because the interface is static.
uint axis_extent(uint index) {
  if (params.matrix_k == 0u) {
    return params.shape[index];
  }
  return axis_data.values[index];
}

uint lhs_stride_at(uint index) {
  if (params.matrix_k == 0u) {
    return params.lhs_strides[index];
  }
  return axis_data.values[params.matrix_k + index];
}

uint rhs_stride_at(uint index) {
  if (params.matrix_k == 0u) {
    return params.rhs_strides[index];
  }
  return axis_data.values[2u * params.matrix_k + index];
}

// Natural log of 1 + x through the Goldberg correction
// log1p(x) = log(u) * x / (u - 1) with u = 1 + x: the ratio recovers
// the low bits the addition rounds away. Tiny arguments stay the
// identity, x = -1 keeps -inf, and x < -1 keeps NaN.
float log1p_impl(float x) {
  float u = 1.0f + x;
  if (u == 1.0f) {
    return x;
  }
  return log(u) * (x / (u - 1.0f));
}

float copysignf(float magnitude, float sign) {
  return uintBitsToFloat(
      (floatBitsToUint(magnitude) & 0x7fffffffu) |
      (floatBitsToUint(sign) & 0x80000000u));
}

// The inverse trigonometric and inverse hyperbolic functions are
// computed in software: the software-rasterizer pipelines carry
// low-accuracy ext-instruction implementations (Acos near 1.5e-4 and
// Atan near 3e-6 absolute), while this degree-9 odd minimax fit for
// atan holds 1.2e-7 absolute in float32 on [0, 1] and through the
// reciprocal reduction on [1, inf).
float atan_impl(float x) {
  float z = abs(x);
  float t = z > 1.0f ? 1.0f / z : z;
  float u = t * t;
  float q = -0.0018917238f;
  q = q * u + 0.011302481f;
  q = q * u - 0.03179674f;
  q = q * u + 0.05846257f;
  q = q * u - 0.08425107f;
  q = q * u + 0.10956332f;
  q = q * u - 0.14264207f;
  q = q * u + 0.19998424f;
  q = q * u - 0.33333287f;
  q = q * u + 1.0f;
  float r = t * q;
  if (z > 1.0f) {
    r = 1.5707963719367981f - r;
  }
  return x < 0.0f ? -r : r;
}

float asin_impl(float x) {
  return atan_impl(x / sqrt(1.0f - x * x));
}

float acos_impl(float x) {
  return 1.5707963719367981f - asin_impl(x);
}

// Quadrant-aware two-argument arctangent, matching the upstream
// atan2(y, x): NaN operands stay NaN, (0, 0) keeps the signed zero,
// and the second and third quadrants shift by +/- pi.
float atan2_impl(float y, float x) {
  if (isnan(x) || isnan(y)) {
    return x + y;
  }
  if (x == 0.0f && y == 0.0f) {
    return y;
  }
  if (x > 0.0f) {
    return atan_impl(y / x);
  }
  if (x < 0.0f) {
    return y >= 0.0f
        ? atan_impl(y / x) + 3.1415927410125732f
        : atan_impl(y / x) - 3.1415927410125732f;
  }
  return y > 0.0f ? 1.5707963719367981f : -1.5707963719367981f;
}

// atanh(x) = (log1p(x) - log1p(-x)) / 2: both terms are stable at the
// domain edges, -1 keeps -inf, +1 keeps +inf, and |x| > 1 keeps NaN.
float atanh_impl(float x) {
  return 0.5f * (log1p_impl(x) - log1p_impl(-x));
}

// acosh(x) = log(x + sqrt((x - 1)(x + 1))): the factored product avoids
// the x*x - 1 cancellation near the domain edge at 1.
float acosh_impl(float x) {
  return log(x + sqrt((x - 1.0f) * (x + 1.0f)));
}

// asinh(x) = sign(x) * log1p(|x| + x^2 / (1 + sqrt(1 + x^2))): the
// log1p form keeps tiny arguments exact and x*x overflow degrades to
// log1p(|x|), the right limit.
float asinh_impl(float x) {
  float scaled = x * x / (1.0f + sqrt(1.0f + x * x));
  return copysignf(log1p_impl(abs(x) + scaled), x);
}

const float PIO4 = 0.78539816339744830961566084581987572104f;
const float PIO2_HI = 1.57079625129699707031f;
const float PIO2_LO = 7.54978941586159635335e-08f;

// CEPHES single-precision coefficients (max abs error ~5.8e-8 over
// [-pi/4, pi/4]; fine for f32 final rounding).
const float SIN_S1 = -0.166666666416265235595e+0f;
const float SIN_S2 =  0.833333287989768428654e-2f;
const float SIN_S3 = -0.198412715749886384593e-3f;
const float SIN_S4 =  0.275577660863435693941e-5f;
const float SIN_S5 = -0.250510735778580322372e-7f;
const float SIN_S6 =  0.159057977393749366286e-9f;
const float COS_C1 =  0.4166667908430098468e-1f;
const float COS_C2 = -1.38888892232295477e-3f;
const float COS_C3 =  2.48015872893760250e-5f;
const float COS_C4 = -2.75573144109840010e-7f;
const float COS_C5 =  2.08757451179359244e-9f;

float sin_poly(float r) {
  float z = r * r;
  float p = fma(SIN_S6, z, SIN_S5);
  p = fma(p, z, SIN_S4);
  p = fma(p, z, SIN_S3);
  p = fma(p, z, SIN_S2);
  p = fma(p, z, SIN_S1);
  return fma(fma(r, z, 0.0f), p, r);
}

float cos_poly(float r) {
  float z = r * r;
  float p = fma(COS_C5, z, COS_C4);
  p = fma(p, z, COS_C3);
  p = fma(p, z, COS_C2);
  p = fma(p, z, COS_C1);
  return fma(p, z * z, fma(-0.5f, z, 1.0f));
}

// 21 f32-exact powers of ten (10^-10 through 10^10). The snap path
// returns the integer exactly when the input is one of these bit
// patterns; for everything else the dd-corrected multiply carries
// log10(x) within 1 ulp of a correctly-rounded reference.
const uint LOG10_SNAP_BITS[21] = uint[21](
    0x2edbe6ffu, 0x3089705fu, 0x322bcc77u, 0x33d6bf95u, 0x358637bdu,
    0x3727c5acu, 0x38d1b717u, 0x3a83126fu, 0x3c23d70au, 0x3dcccccdu,
    0x3f800000u,
    0x41200000u, 0x42c80000u, 0x447a0000u, 0x461c4000u, 0x47c35000u,
    0x49742400u, 0x4b189680u, 0x4cbebc20u, 0x4e6e6b28u, 0x501502f9u);
const float LOG10_SNAP_K[21] = float[21](
    -10.0f, -9.0f, -8.0f, -7.0f, -6.0f, -5.0f, -4.0f, -3.0f, -2.0f, -1.0f,
    0.0f,
    1.0f, 2.0f, 3.0f, 4.0f, 5.0f, 6.0f, 7.0f, 8.0f, 9.0f, 10.0f);

// Fixed-point Payne-Hanek reduction. The 256 fractional bits of 2/pi
// come from Sun fdlibm's permissively licensed two_over_pi table
// (k_rem_pio2.c). Named 32-bit limbs replace the old dynamically indexed
// accumulator, which is not portable across the supported shader compilers.
struct UInt288 {
  uint w0; uint w1; uint w2; uint w3; uint w4;
  uint w5; uint w6; uint w7; uint w8;
};

uint multiply_limb(
    uint mantissa, uint limb, uint carry_in, out uint word) {
  uint high;
  uint low;
  umulExtended(mantissa, limb, high, low);
  word = low + carry_in;
  return high + (word < low ? 1u : 0u);
}

UInt288 multiply_two_over_pi(uint mantissa) {
  UInt288 product;
  uint carry = 0u;
  carry = multiply_limb(mantissa, 0xdebbc561u, carry, product.w0);
  carry = multiply_limb(mantissa, 0xfe5163abu, carry, product.w1);
  carry = multiply_limb(mantissa, 0x3c439041u, carry, product.w2);
  carry = multiply_limb(mantissa, 0xdb629599u, carry, product.w3);
  carry = multiply_limb(mantissa, 0xf534ddc0u, carry, product.w4);
  carry = multiply_limb(mantissa, 0xfc2757d1u, carry, product.w5);
  carry = multiply_limb(mantissa, 0x4e441529u, carry, product.w6);
  carry = multiply_limb(mantissa, 0xa2f9836eu, carry, product.w7);
  product.w8 = carry;
  return product;
}

uint product_limb(UInt288 product, int index) {
  if (index == 0) return product.w0;
  if (index == 1) return product.w1;
  if (index == 2) return product.w2;
  if (index == 3) return product.w3;
  if (index == 4) return product.w4;
  if (index == 5) return product.w5;
  if (index == 6) return product.w6;
  if (index == 7) return product.w7;
  if (index == 8) return product.w8;
  return 0u;
}

uint shifted_product_word(UInt288 product, int bit) {
  int index = bit >> 5;
  uint shift = uint(bit & 31);
  uint low = product_limb(product, index);
  if (shift == 0u) {
    return low;
  }
  return (low >> shift) |
      (product_limb(product, index + 1) << (32u - shift));
}

void payne_hanek(float ax, out uint quadrant, out float reduced) {
  uint bits = floatBitsToUint(ax);
  int exponent = int((bits >> 23u) & 0xffu) - 127;
  uint mantissa = (bits & 0x7fffffu) | 0x800000u;
  UInt288 product = multiply_two_over_pi(mantissa);
  int binary_point = 279 - exponent;
  uint round_up = shifted_product_word(product, binary_point - 1) & 1u;
  quadrant = (shifted_product_word(product, binary_point) + round_up) & 3u;

  uint fraction_high =
      shifted_product_word(product, binary_point - 24) & 0x00ffffffu;
  uint fraction_low =
      shifted_product_word(product, binary_point - 48) & 0x00ffffffu;
  float high = float(fraction_high) * 5.9604644775390625e-8f;
  if (round_up != 0u) {
    high -= 1.0f;
  }
  float fraction = fma(float(fraction_low), 3.5527136788005009e-15f, high);
  reduced = fma(fraction, PIO2_HI, fraction * PIO2_LO);
}

float sin_impl(float x) {
  if (isnan(x) || isinf(x)) {
    return x - x;
  }
  float ax = abs(x);
  if (ax < PIO4) {
    return sin_poly(x);
  }
  uint n; float r_f;
  payne_hanek(ax, n, r_f);
  uint j = n & 3u;
  float s;
  if (j == 0u) {
    s = sin_poly(r_f);
  } else if (j == 1u) {
    s = cos_poly(r_f);
  } else if (j == 2u) {
    s = -sin_poly(r_f);
  } else {
    s = -cos_poly(r_f);
  }
  return (x < 0.0f) ? -s : s;
}

float cos_impl(float x) {
  if (isnan(x) || isinf(x)) {
    return x - x;
  }
  float ax = abs(x);
  if (ax < PIO4) {
    return cos_poly(x);
  }
  uint n; float r_f;
  payne_hanek(ax, n, r_f);
  uint j = n & 3u;
  if (j == 0u) {
    return cos_poly(r_f);
  } else if (j == 1u) {
    return -sin_poly(r_f);
  } else if (j == 2u) {
    return -cos_poly(r_f);
  } else {
    return sin_poly(r_f);
  }
}

float tan_impl(float x) {
  if (isnan(x) || isinf(x)) {
    return x - x;
  }
  float ax = abs(x);
  if (ax < PIO4) {
    return sin_poly(x) / cos_poly(x);
  }
  uint n; float r_f;
  payne_hanek(ax, n, r_f);
  uint j = n & 3u;
  float s;
  if (j == 0u || j == 2u) {
    s = sin_poly(r_f) / cos_poly(r_f);
  } else {
    s = -cos_poly(r_f) / sin_poly(r_f);
  }
  return (x < 0.0f) ? -s : s;
}

// log10(x) for x > 0: dd-corrected multiply of log(x) by 1/ln(10),
// plus a 21-entry snap table for f32-exact powers of ten. The snap
// guarantees log10(10^k) = k exactly; for everything else the dd
// product rounds within 1 ulp of a correctly-rounded reference.
float log10_impl(float x) {
  uint x_bits = floatBitsToUint(x);
  for (int i = 0; i < 21; ++i) {
    if (x_bits == LOG10_SNAP_BITS[i]) {
      return LOG10_SNAP_K[i];
    }
  }
  float lg = log(x);
  float hi = 0.43429448190325176f;
  float lo = -1.010305e-08f;
  float t = lg * hi;
  float err = fma(lg, hi, -t);
  return fma(lg, lo, t + err);
}

// The erf and erfinv helpers follow the Metal MLX kernels: Norbert
// Juffa's faithfully rounded rational approximations (about 1 ulp for
// erf, 2.36 ulp for erfinv), the same ones
// mlx/backend/metal/kernels/erf.h ships.


// expm1: the Horner series holds |a| < 0.5, where exp(a) - 1 would
// cancel the leading terms, and exp(a) - 1 serves beyond it, where the
// subtraction is benign. This replaces the Metal MLX exponent-split
// reduction, whose magic-number rounding does not survive pipelines
// that contract multiplies and adds into one wide unrounded fma.
float expm1f_impl(float a) {
  if (abs(a) < 0.5f) {
    return a * (1.0f
        + a * (0.5f
        + a * (1.0f / 6.0f
        + a * (1.0f / 24.0f
        + a * (1.0f / 120.0f
        + a * (1.0f / 720.0f
        + a * (1.0f / 5040.0f)))))));
  }
  return exp(a) - 1.0f;
}

float erf_impl(float a) {
  float r, s, t, u;
  t = abs(a);
  s = a * a;
  if (t > 0.927734375f) {
    // erfc(t) = -expm1(r) on the tail, evaluated through expm1f_impl.
    r = fma(-1.72853470e-5f, t, 3.83197126e-4f);
    u = fma(-3.88396438e-3f, t, 2.42546219e-2f);
    r = fma(r, s, u);
    r = fma(r, t, -1.06777877e-1f);
    r = fma(r, t, -6.34846687e-1f);
    r = fma(r, t, -1.28717512e-1f);
    r = fma(r, t, -t);
    r = -expm1f_impl(r);
    r = copysignf(r, a);
  } else {
    r = -5.96761703e-4f;
    r = fma(r, s, 4.99119423e-3f);
    r = fma(r, s, -2.67681349e-2f);
    r = fma(r, s, 1.12819925e-1f);
    r = fma(r, s, -3.76125336e-1f);
    r = fma(r, s, 1.28379166e-1f);
    r = fma(r, a, a);
  }
  return r;
}

float erfinv_impl(float a) {
  float t = fma(a, 0.0f - a, 1.0f);
  t = log(t);
  float p;
  if (abs(t) > 6.125f) {
    p = 3.03697567e-10f;
    p = fma(p, t, 2.93243101e-8f);
    p = fma(p, t, 1.22150334e-6f);
    p = fma(p, t, 2.84108955e-5f);
    p = fma(p, t, 3.93552968e-4f);
    p = fma(p, t, 3.02698812e-3f);
    p = fma(p, t, 4.83185798e-3f);
    p = fma(p, t, -2.64646143e-1f);
    p = fma(p, t, 8.40016484e-1f);
  } else {
    p = 5.43877832e-9f;
    p = fma(p, t, 1.43285448e-7f);
    p = fma(p, t, 1.22774793e-6f);
    p = fma(p, t, 1.12963626e-7f);
    p = fma(p, t, -5.61530760e-5f);
    p = fma(p, t, -1.47697632e-4f);
    p = fma(p, t, 2.31468678e-3f);
    p = fma(p, t, 1.15392581e-2f);
    p = fma(p, t, -2.32015476e-1f);
    p = fma(p, t, 8.86226892e-1f);
  }
  return a * p;
}

// Python-style modulo (the upstream Remainder/DivMod float contract):
// the truncation remainder adjusted by one divisor when its sign
// differs from the divisor's. A zero divisor is NaN the way the
// upstream C fmod is.
float float_modulo(float a, float b) {
  if (b == 0.0) {
    return uintBitsToFloat(0x7fc00000u);
  }
  float r = a - b * trunc(a / b);
  if (r != 0.0 && (r < 0.0) != (b < 0.0)) {
    r += b;
  }
  return r;
}

// GLSL pow leaves negative bases and zero with nonpositive exponents undefined.
float float_power(float base, float exponent) {
  const float QNAN = uintBitsToFloat(0x7fc00000u);
  const float POS_INF = uintBitsToFloat(0x7f800000u);
  if (exponent == 0.0 || base == 1.0) {
    return 1.0;
  }
  if (isnan(base) || isnan(exponent)) {
    return QNAN;
  }
  float magnitude = abs(base);
  if (isinf(exponent)) {
    return magnitude == 1.0 ? 1.0
        : ((magnitude > 1.0) == (exponent > 0.0) ? POS_INF : 0.0);
  }
  bool integral = exponent == floor(exponent);
  bool odd = integral && mod(abs(exponent), 2.0) == 1.0;
  bool negative = (floatBitsToUint(base) & 0x80000000u) != 0u && odd;
  if (base == 0.0 || isinf(base)) {
    float result = (base == 0.0) == (exponent < 0.0) ? POS_INF : 0.0;
    return negative ? -result : result;
  }
  if (base < 0.0 && !integral) {
    return QNAN;
  }
  float result;
  if (integral && abs(exponent) <= 128.0) {
    float factor = exponent < 0.0 ? 1.0 / magnitude : magnitude;
    int n = int(abs(exponent));
    result = 1.0;
    while (n > 0) {
      if ((n & 1) != 0) {
        result *= factor;
      }
      n >>= 1;
      if (n != 0) {
        factor *= factor;
      }
    }
  } else {
    result = pow(magnitude, exponent);
  }
  return negative ? -result : result;
}

void main() {
  uint index = gl_GlobalInvocationID.x;
  uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  while (index < params.count) {
    uint lhs_index;
    uint rhs_index;
    if (params.dims == 0u) {
      lhs_index = params.lhs_offset + (params.lhs_size == 1
          ? 0u
          : (params.lhs_size == params.count ? index : index % params.lhs_size));
      rhs_index = params.rhs_offset + (params.rhs_size == 1
          ? 0u
          : (params.rhs_size == params.count ? index : index % params.rhs_size));
    } else {
      uint rem = index;
      lhs_index = params.lhs_offset;
      rhs_index = params.rhs_offset;
      for (int dim = int(params.dims) - 1; dim >= 0; --dim) {
        uint coord = rem % axis_extent(uint(dim));
        rem /= axis_extent(uint(dim));
        lhs_index += coord * lhs_stride_at(uint(dim));
        rhs_index += coord * rhs_stride_at(uint(dim));
      }
    }
    float lhs = LOAD_VALUE(input_a.values[lhs_index]);
    float rhs = LOAD_VALUE(input_b.values[rhs_index]);
    float value;
    switch (OPERATION == 0xffffffffu ? params.operation : OPERATION) {
      case 0:
        value = lhs + rhs;
        break;
      case 1:
        value = lhs * rhs;
        break;
      case 2:
        value = lhs / rhs;
        break;
      case 3:
        value = isnan(lhs) || isnan(rhs)
            ? uintBitsToFloat(0x7fc00000u)
            : max(lhs, rhs);
        break;
      case 4:
        value = exp(lhs);
        break;
      case 5:
        value = 1.0 / (1.0 + exp(-lhs));
        break;
      case 6:
        value = lhs * lhs;
        break;
      case 7:
        value = sqrt(lhs);
        break;
      case 8:
        value = inversesqrt(lhs);
        break;
      case 9:
        value = lhs - rhs;
        break;
      case 10:
        value = -lhs;
        break;
      case 11:
        value = cos_impl(lhs);
        break;
      case 12:
        value = sin_impl(lhs);
        break;
      case 13:
        value = log(lhs);
        break;
      case 14:
        value = isnan(lhs) || isnan(rhs)
            ? uintBitsToFloat(0x7fc00000u)
            : min(lhs, rhs);
        break;
      case 15:
        value = log2(lhs);
        break;
      case 16:
        value = log10_impl(lhs);
        break;
      // Operations 17 and above are appended wave-3 cases; the enum in
      // ../primitives.cpp carries the same order.
      case 17:
        value = acos_impl(lhs);
        break;
      case 18:
        value = acosh_impl(lhs);
        break;
      case 19:
        value = asin_impl(lhs);
        break;
      case 20:
        value = asinh_impl(lhs);
        break;
      case 21:
        value = atan_impl(lhs);
        break;
      case 22:
        // atan(y, x) is the quadrant-aware atan2 with y first, matching
        // the ArcTan2 operand order (lhs = y, rhs = x).
        value = atan2_impl(lhs, rhs);
        break;
      case 23:
        value = atanh_impl(lhs);
        break;
      case 24:
        value = cosh(lhs);
        break;
      case 25:
        value = sinh(lhs);
        break;
      case 26:
        value = tan_impl(lhs);
        break;
      case 27:
        value = tanh(lhs);
        break;
      case 28:
        value = erf_impl(lhs);
        break;
      case 29:
        value = erfinv_impl(lhs);
        break;
      case 30:
        value = expm1f_impl(lhs);
        break;
      case 31:
        value = log1p_impl(lhs);
        break;
      case 32:
        // max(a, b) + log1p(exp(-|a - b|)) never overflows and keeps
        // one -inf operand at the other's value; matching the min/max
        // cases, a NaN operand keeps a NaN.
        value = isnan(lhs) || isnan(rhs)
            ? uintBitsToFloat(0x7fc00000u)
            : max(lhs, rhs);
        if (!isnan(value) && !isinf(value)) {
          value += log1p_impl(exp(-abs(lhs - rhs)));
        }
        break;
      case 33:
        value = ceil(lhs);
        break;
      case 34:
        value = floor(lhs);
        break;
      case 35:
        // Upstream Round is rint on both CPU and Metal: halfway cases
        // round to the nearest even integer.
        value = roundEven(lhs);
        break;
      // Wave-2 float ops (36-40); the enum in ../primitives.cpp
      // carries the same order.
      case 36:
        value = float_modulo(lhs, rhs);
        break;
      case 37:
        value = float_power(lhs, rhs);
        break;
      case 38:
        // Upstream Sign compares against zero, so NaN falls through
        // both comparisons and maps to 0.
        value = lhs > 0.0 ? 1.0 : (lhs < 0.0 ? -1.0 : 0.0);
        break;
      case 39:
        // The abs builtin clears the sign bit, so -0.0 flips to +0.0
        // the way the upstream std::abs reference does.
        value = abs(lhs);
        break;
      case 40:
        value = floor(lhs / rhs);
        break;
      default:
        return;
    }
    output_data.values[params.output_offset + index] = STORE_VALUE(value);
    if (params.count - index <= stride) {
      break;
    }
    index += stride;
  }
}
