#version 460

#ifdef USE_U32
#define STORAGE_TYPE uint
#else
#define STORAGE_TYPE int
#endif

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer InputA {
  STORAGE_TYPE values[];
} input_a;
layout(set = 0, binding = 1, std430) readonly buffer InputB {
  STORAGE_TYPE values[];
} input_b;
layout(set = 0, binding = 2, std430) writeonly buffer Output {
  STORAGE_TYPE values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  // dims == 0 selects the modulo fast path below. Otherwise the output
  // is unraveled over shape[] and lhs_strides/rhs_strides index the
  // operands; a stride of 0 broadcasts the axis.
  uint dims;
  uint shape[4];
  uint lhs_strides[4];
  uint rhs_strides[4];
} params;

uint lhs_index_for(uint index) {
  if (params.dims == 0u) {
    return params.lhs_offset + (params.lhs_size == 1u
        ? 0u
        : (params.lhs_size == params.count ? index : index % params.lhs_size));
  }
  uint rem = index;
  uint result = params.lhs_offset;
  for (int dim = int(params.dims) - 1; dim >= 0; --dim) {
    uint coord = rem % params.shape[dim];
    rem /= params.shape[dim];
    result += coord * params.lhs_strides[dim];
  }
  return result;
}

uint rhs_index_for(uint index) {
  if (params.dims == 0u) {
    return params.rhs_offset + (params.rhs_size == 1u
        ? 0u
        : (params.rhs_size == params.count ? index : index % params.rhs_size));
  }
  uint rem = index;
  uint result = params.rhs_offset;
  for (int dim = int(params.dims) - 1; dim >= 0; --dim) {
    uint coord = rem % params.shape[dim];
    rem /= params.shape[dim];
    result += coord * params.rhs_strides[dim];
  }
  return result;
}

// Integer elementwise kernel. The selector matches
// IntElementwiseOperation in primitives.cpp. Wraparound subtraction,
// bitwise logic, and shifts are identical for int32 and uint32, so one
// SPIR-V variant serves both dtypes; `>>` follows the operand
// signedness (arithmetic for int32, logical for uint32), which is the
// upstream C++ behavior. The signed fixups compile for uint32 too and
// are constant-false there, matching upstream's unsigned no-ops.

// Python-style floor division: the C++ quotient adjusted so the
// remainder takes the divisor's sign (upstream DivMod integral_op).
STORAGE_TYPE floor_quotient(STORAGE_TYPE a, STORAGE_TYPE b) {
  STORAGE_TYPE q = a / b;
  STORAGE_TYPE r = a % b;
  if (r != STORAGE_TYPE(0) && (r < STORAGE_TYPE(0)) != (b < STORAGE_TYPE(0))) {
    q -= STORAGE_TYPE(1);
  }
  return q;
}

// Python-style modulo: truncating remainder adjusted by one divisor
// when the signs of remainder and divisor differ. Unsigned stays the
// raw remainder, which is already the upstream unsigned result.
STORAGE_TYPE python_modulo(STORAGE_TYPE a, STORAGE_TYPE b) {
  STORAGE_TYPE r = a % b;
  if (r != STORAGE_TYPE(0) && (r < STORAGE_TYPE(0)) != (b < STORAGE_TYPE(0))) {
    r += b;
  }
  return r;
}

// Exponentiation by squaring with wraparound, mirroring the upstream
// integer pow. A signed negative exponent yields 0; the unsigned
// guard is constant-false.
STORAGE_TYPE integer_power(STORAGE_TYPE base, STORAGE_TYPE exp) {
  STORAGE_TYPE res = STORAGE_TYPE(1);
  if (exp < STORAGE_TYPE(0)) {
    return STORAGE_TYPE(0);
  }
  while (exp != STORAGE_TYPE(0)) {
    if ((exp & STORAGE_TYPE(1)) != STORAGE_TYPE(0)) {
      res *= base;
    }
    exp >>= 1;
    base *= base;
  }
  return res;
}

// Upstream Sign: -1, 0, or 1 by comparison with zero; unsigned is
// 0 or 1 (comparison with a negative constant is constant-false).
STORAGE_TYPE integer_sign(STORAGE_TYPE a) {
  if (a > STORAGE_TYPE(0)) {
    return STORAGE_TYPE(1);
  }
  if (a < STORAGE_TYPE(0)) {
    return STORAGE_TYPE(-1);
  }
  return STORAGE_TYPE(0);
}

void main() {
  uint index = gl_GlobalInvocationID.x;
  uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  while (index < params.count) {
    STORAGE_TYPE a = input_a.values[lhs_index_for(index)];
    STORAGE_TYPE b = input_b.values[rhs_index_for(index)];
    STORAGE_TYPE value;
    switch (params.operation) {
      case 0:
        value = a - b;
        break;
      case 1:
        value = a & b;
        break;
      case 2:
        value = a | b;
        break;
      case 3:
        value = a ^ b;
        break;
      case 4:
        value = a << b;
        break;
      case 5:
        value = a >> b;
        break;
      case 6:
        value = ~a;
        break;
      case 7:
        value = floor_quotient(a, b);
        break;
      case 8:
        value = python_modulo(a, b);
        break;
      case 9:
        value = integer_power(a, b);
        break;
      case 10:
        value = integer_sign(a);
        break;
      case 11:
        // Upstream Abs negates negatives; INT_MIN wraps to itself the
        // way upstream's C++ negation does on this platform.
        value = a < STORAGE_TYPE(0) ? -a : a;
        break;
      default:
        return;
    }
    output_data.values[params.output_offset + index] = value;
    if (params.count - index <= stride) {
      break;
    }
    index += stride;
  }
}
