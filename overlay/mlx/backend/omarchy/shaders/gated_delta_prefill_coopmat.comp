//
// Chunked cooperative-matrix gated-delta-rule prefill (GatedDeltaUpdate,
// T>1), the Vulkan counterpart of Metal's gated_delta_fused_chunk at the
// non-NAX chunk length C=8. Single pass: one 32-lane workgroup (one
// subgroup) per (head, Dv/8 slice) walks every chunk sequentially and owns
// one 8-row x Dk state slice held as sixteen 8x8 f32 cooperative matrix
// tiles, so no thread ever owns a full state row and the 1096 B scratch
// spill of the per-thread scan kernel cannot occur. The slices never
// share data, so every staging round trip orders at subgroup scope, and
// the next chunk's k/q/v/g/beta loads are issued before this chunk's
// math (register software pipeline; each loaded word is consumed by the
// same expression the staging used before, so the arithmetic is the
// four-subgroup kernel's, word for word).
//
// Per chunk (C=8 tokens), with gamma_log = inclusive prefix sum of
// log(max(g, 1e-6)) over the chunk and gamma_j = exp(gamma_log_j):
//   N      = strict_lower(diag(beta) . K.K^T)
//   Tinv   = (I + N)^-1 = (I - N)(I + N^2 + N^4 + N^6)   (N^8 = 0)
//   U      = diag(gamma) . Tinv . (diag(beta.exp(-gamma_log)) . V)
//   WS     = diag(gamma) . Tinv . ((diag(beta) K) . S)
//   delta  = U - WS
//   out    = tril(Q.K^T . diag(exp(gamma_log_r - gamma_log_c))) . delta
//            + ((diag(gamma) Q) . S)                       (y rows)
//   S      = gamma_C . S + (K . diag(exp(gamma_C - gamma_log)))^T . delta
// The (a,b) exp(gamma_a - gamma_b) factors of the causal output term ride
// one shared round trip (store, per-lane scale/mask, load); Vulkan
// cooperative matrices have no lane-addressable elements, so every
// position-dependent scale or mask and every matrix feeding an operand
// role goes through that path. Everything else is coopMatMulAdd chains.
//
// Numeric contract: chunk-form rounding, not the per-token scan's — the
// same class of reordering as the macOS Metal kernel. Gated by the
// per-host determinism plus <=2 bf16-quanta logits rule (kernel-flags.md),
// not by bit equality with the scan kernel. Dispatch (primitives.cpp)
// selects this kernel only for the square bf16 Dk=Dv=128 maskless
// scalar-g shape on coopmat devices; everything else keeps the two-pass
// scan, and MLX_OMARCHY_NO_COOPMAT_GDN=1 forces the scan.

#version 460

#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_control_flow_attributes : require

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

// bf16 activations ride as u32 words (two fp16-path bits per word; the
// widening is exact: bf16 bits << 16). Word views of the same bindings
// the scan kernel uses.
layout(set = 0, binding = 0, std430) readonly buffer QBuf  { uint w[]; } q_buf;
layout(set = 0, binding = 1, std430) readonly buffer KBuf  { uint w[]; } k_buf;
layout(set = 0, binding = 2, std430) readonly buffer VBuf  { uint w[]; } v_buf;
layout(set = 0, binding = 3, std430) readonly buffer GBuf  { uint16_t v[]; } g_buf;
layout(set = 0, binding = 4, std430) readonly buffer BBuf  { uint16_t v[]; } b_buf;
layout(set = 0, binding = 5, std430) readonly buffer SIn    { float    v[]; } s_in;
layout(set = 0, binding = 6, std430) writeonly buffer YBuf { uint w[]; } y_buf;
layout(set = 0, binding = 7, std430) buffer         SOut { float    v[]; } s_out;
layout(set = 0, binding = 8, std430) readonly buffer MBuf  { uint8_t  v[]; } m_buf;
layout(set = 0, binding = 9, std430) readonly buffer GBufF { float     v[]; } g_buf_f;
layout(set = 0, binding = 10, std430) buffer         Snap   { float    v[]; } snap;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;   // Dk (dispatch gate: 128)
  uint matrix_n;   // Dv (dispatch gate: 128)
  uint matrix_k;   // Hv
  uint flags;      // bit2: g is f32
  float alpha;
  float beta_f;
  uint dims;       // T
  uint shape[4];   // [0]=g offset, [1]=h0 offset, [2]=hf offset
  uint in_strides[4];
  uint out_strides[4];
  uint chunk;
  uint chunks;
} params;

const uint C = 8u;       // Metal non-NAX chunk length
const uint DK = 128u;
const uint KSTEPS = DK / 8u;   // 16

float bf16_load(uint16_t bits) {
  return uintBitsToFloat(uint(bits) << 16u);
}

float bf16_word_lo(uint word) {
  return uintBitsToFloat((word & 0xffffu) << 16u);
}

float bf16_word_hi(uint word) {
  return uintBitsToFloat(word & 0xffff0000u);
}

uint bf16_pack(float lo, float hi) {
  uint lb = floatBitsToUint(lo);
  uint hb = floatBitsToUint(hi);
  if ((lb & 0x7fff0000u) == 0x7f800000u) lb = (lb & 0xffff0000u) | 0x40u;
  else lb = (lb + 0x7fffu + ((lb >> 16) & 1u)) >> 16;
  if ((hb & 0x7fff0000u) == 0x7f800000u) hb = (hb & 0xffff0000u) | 0x40u;
  else hb = (hb + 0x7fffu + ((hb >> 16) & 1u)) >> 16;
  return (hb << 16) | (lb & 0xffffu);
}

// Workgroup-shared tile storage (one subgroup per workgroup). Tiles are
// 8x8 f32, element (r,c) at [r*8+c]; staging maps element pair
// (e, e+1), e = lane*2, to lane (adjacent columns -> one u32 load).
shared float s_state[KSTEPS * 64];   // state slice [dk][dv] per tile
shared float k_s[64];
shared float kg_s[64];
shared float q_s[64];
shared float qg_s[64];
shared float kgc_s[64];
shared float v_s[64];
shared float rt_a[64];               // round trip A (kkt, qkt, du, out)
shared float rt_b[64];               // round trip B (m2, neumann, tinvv, ws, delta, kd)
shared float gamma_s[8];             // log-domain prefix sums
shared float beta_s[8];

coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA> mat_a;
coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseB> mat_b;
coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA> mat_a2;
coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseB> mat_b2;
coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> acc;

// Every shared tile belongs to the workgroup's single subgroup, so the
// staging round trips order at subgroup scope.
#define SG_BARRIER()                                                   \
  controlBarrier(gl_ScopeSubgroup, gl_ScopeSubgroup,                   \
                 gl_StorageSemanticsShared, gl_SemanticsAcquireRelease)

// The lane's global operands for one chunk: its k/q word per kk step
// (token row t0 + r0, dk columns kk*8 + c0 .. c0+1), its v word (dv
// columns dv0 + c0 .. c0+1), and the g/beta scalars of token t0 + lane.
// Rows past the chunk's valid tokens hold 0 words (widening to +0.0, the
// value the staging used to write for them).
struct ChunkOps {
  uint kw[KSTEPS];
  uint qw[KSTEPS];
  uint vw;
  float graw;
  float braw;
};

void load_chunk(uint t0, uint head, uint dv0, uint r0, uint c0, uint lane,
                out ChunkOps ops) {
  const uint T = params.dims;
  const uint hv = params.matrix_k;
  const uint valid = min(C, T - t0);
  const bool row_ok = r0 < valid;
  const uint kbase = params.rhs_offset + (t0 + r0) * hv * DK + head * DK + c0;
  const uint qbase = params.lhs_offset + (t0 + r0) * hv * DK + head * DK + c0;
  [[unroll]] for (uint kk = 0u; kk < KSTEPS; ++kk) {
    ops.kw[kk] = row_ok ? k_buf.w[(kbase + kk * 8u) >> 1u] : 0u;
    ops.qw[kk] = row_ok ? q_buf.w[(qbase + kk * 8u) >> 1u] : 0u;
  }
  uint vbase = params.aux_size + (t0 + r0) * hv * params.matrix_n +
      head * params.matrix_n + dv0 + c0;
  ops.vw = row_ok ? v_buf.w[vbase >> 1u] : 0u;
  ops.graw = 0.0;
  ops.braw = 0.0;
  if (lane < valid) {
    const uint gi = params.shape[0] + (t0 + lane) * hv + head;
    ops.graw = (params.flags & 4u) != 0u ? g_buf_f.v[gi] : bf16_load(g_buf.v[gi]);
    ops.braw = bf16_load(b_buf.v[params.aux_offset + (t0 + lane) * hv + head]);
  }
}

void main() {
  const uint lane = gl_SubgroupInvocationID;
  const uint head = gl_WorkGroupID.x;
  const uint dv0 = gl_WorkGroupID.y * 8u;
  const uint T = params.dims;
  const uint hv = params.matrix_k;
  const uint e0 = lane * 2u;
  const uint r0 = e0 / 8u;
  const uint c0 = e0 % 8u;   // the pair (e0, e0+1) shares row r0, cols c0, c0+1

  const uint h0_off = params.shape[1];
  const uint hf_off = params.shape[2];

  // Identity tile (constant across the kernel).
  rt_a[e0] = (r0 == c0) ? 1.0 : 0.0;
  rt_a[e0 + 1u] = (r0 == c0 + 1u) ? 1.0 : 0.0;
  SG_BARRIER();
  coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> eye;
  coopMatLoad(eye, rt_a, 0, 8, gl_CooperativeMatrixLayoutRowMajor);
  coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> zero =
      coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator>(0.0);

  // Restore the state slice: tile[kk][r][c] = h0[(head*Dv + dv0 + c)*Dk + kk*8 + r].
  // The lane's element pair (r0, c0), (r0, c0+1) sits Dk apart in memory.
  for (uint kk = 0u; kk < KSTEPS; ++kk) {
    uint idx = h0_off + (head * params.matrix_n + dv0 + c0) * DK + kk * 8u + r0;
    s_state[kk * 64u + e0] = s_in.v[idx];
    s_state[kk * 64u + e0 + 1u] = s_in.v[idx + DK];
  }

  // Software pipeline: the next chunk's global loads are in flight while
  // this chunk computes.
  ChunkOps nxt;
  load_chunk(0u, head, dv0, r0, c0, lane, nxt);

  for (uint t0 = 0u; t0 < T; t0 += C) {
    const uint valid = min(C, T - t0);
    const ChunkOps cur = nxt;
    if (t0 + C < T) {
      load_chunk(t0 + C, head, dv0, r0, c0, lane, nxt);
    }

    // gamma_log over the chunk (lanes >= valid contribute 0, so the
    // prefix stays at the last valid token — the partial-chunk decay
    // target, matching the Metal kernel).
    float gv = 0.0;
    if (lane < valid) {
      gv = log(max(cur.graw, 1e-6f));
    }
    if (lane < C) {
      gamma_s[lane] = subgroupInclusiveAdd(gv);
      beta_s[lane] = lane < valid ? cur.braw : 0.0f;
    }
    SG_BARRIER();

    const float gamC = exp(gamma_s[C - 1u]);
    const float beta_r0 = beta_s[r0];
    const float gam_r0 = exp(gamma_s[r0]);
    const float gaminv_r0 = exp(-gamma_s[r0]);
    // Decay from token r0 to the chunk end, log-domain difference.
    const float dec_r0 =
        r0 < valid ? exp(gamma_s[C - 1u] - gamma_s[r0]) : 0.0;

    // Loop 1: stage the chunk's k/q tiles (raw and row-scaled variants)
    // and accumulate KK^T, Q.K^T, (beta K).S and (gamma Q).S.
    coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> kkt =
        coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator>(0.0);
    coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> qkt =
        coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator>(0.0);
    coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> m2 =
        coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator>(0.0);
    coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> tmp =
        coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator>(0.0);
    [[unroll]] for (uint kk = 0u; kk < KSTEPS; ++kk) {
      float kv0 = bf16_word_lo(cur.kw[kk]);
      float kv1 = bf16_word_hi(cur.kw[kk]);
      float qv0 = bf16_word_lo(cur.qw[kk]);
      float qv1 = bf16_word_hi(cur.qw[kk]);
      k_s[e0] = kv0;
      k_s[e0 + 1u] = kv1;
      kg_s[e0] = kv0 * beta_r0;
      kg_s[e0 + 1u] = kv1 * beta_r0;
      q_s[e0] = qv0;
      q_s[e0 + 1u] = qv1;
      qg_s[e0] = qv0 * gam_r0;
      qg_s[e0 + 1u] = qv1 * gam_r0;
      SG_BARRIER();
      coopMatLoad(mat_a, k_s, 0, 8, gl_CooperativeMatrixLayoutRowMajor);
      coopMatLoad(mat_b, k_s, 0, 8, gl_CooperativeMatrixLayoutColumnMajor);
      kkt = coopMatMulAdd(mat_a, mat_b, kkt);
      coopMatLoad(mat_a, q_s, 0, 8, gl_CooperativeMatrixLayoutRowMajor);
      qkt = coopMatMulAdd(mat_a, mat_b, qkt);
      coopMatLoad(mat_a, kg_s, 0, 8, gl_CooperativeMatrixLayoutRowMajor);
      coopMatLoad(mat_b2, s_state, kk * 64u, 8, gl_CooperativeMatrixLayoutRowMajor);
      m2 = coopMatMulAdd(mat_a, mat_b2, m2);
      coopMatLoad(mat_a, qg_s, 0, 8, gl_CooperativeMatrixLayoutRowMajor);
      tmp = coopMatMulAdd(mat_a, mat_b2, tmp);
      SG_BARRIER();
    }

    // N = strict_lower(diag(beta) . KK^T): one shared round trip.
    coopMatStore(kkt, rt_a, 0, 8, gl_CooperativeMatrixLayoutRowMajor);
    SG_BARRIER();
    float n0 = rt_a[e0];
    float n1 = rt_a[e0 + 1u];
    rt_a[e0] = (c0 < r0) ? n0 * beta_r0 : 0.0;
    rt_a[e0 + 1u] = (c0 + 1u < r0) ? n1 * beta_r0 : 0.0;
    SG_BARRIER();
    coopMatLoad(mat_a, rt_a, 0, 8, gl_CooperativeMatrixLayoutRowMajor);
    coopMatLoad(mat_b, rt_a, 0, 8, gl_CooperativeMatrixLayoutRowMajor);
    SG_BARRIER();

    // Tinv = (I - N)(I + N^2 + N^4 + N^6), the exact (I+N)^-1 for
    // strictly-lower-triangular N (N^8 = 0 at C = 8).
    coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> a1 =
        coopMatMulAdd(mat_a, mat_b, zero);
    coopMatStore(a1, rt_b, 0, 8, gl_CooperativeMatrixLayoutRowMajor);
    SG_BARRIER();
    coopMatLoad(mat_a2, rt_b, 0, 8, gl_CooperativeMatrixLayoutRowMajor);
    coopMatLoad(mat_b2, rt_b, 0, 8, gl_CooperativeMatrixLayoutRowMajor);
    SG_BARRIER();
    coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> a2 =
        coopMatMulAdd(mat_a2, mat_b2, zero);
    coopMatStore(a2, rt_b, 0, 8, gl_CooperativeMatrixLayoutRowMajor);
    SG_BARRIER();
    coopMatLoad(mat_a2, rt_b, 0, 8, gl_CooperativeMatrixLayoutRowMajor);
    coopMatLoad(mat_b2, rt_b, 0, 8, gl_CooperativeMatrixLayoutRowMajor);
    SG_BARRIER();
    coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> a3 =
        coopMatMulAdd(mat_a2, mat_b2, zero);
    coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> msum =
        eye + a1 + a2 + a3;
    coopMatStore(msum, rt_b, 0, 8, gl_CooperativeMatrixLayoutRowMajor);
    SG_BARRIER();
    coopMatLoad(mat_b, rt_b, 0, 8, gl_CooperativeMatrixLayoutRowMajor);
    SG_BARRIER();
    coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> tinv =
        msum - coopMatMulAdd(mat_a, mat_b, zero);
    // Tinv feeds operand roles twice (U and WS chains): one round trip.
    coopMatStore(tinv, rt_b, 0, 8, gl_CooperativeMatrixLayoutRowMajor);
    SG_BARRIER();
    coopMatLoad(mat_a2, rt_b, 0, 8, gl_CooperativeMatrixLayoutRowMajor);
    SG_BARRIER();

    // diag(gamma): exp(gamma_r) on the diagonal, staged through rt_a.
    rt_a[e0] = (r0 == c0) ? gam_r0 : 0.0;
    rt_a[e0 + 1u] = (r0 == c0 + 1u) ? gam_r0 : 0.0;
    // V tilde: diag(beta.exp(-gamma_log)) rows of V.
    float vv0 = bf16_word_lo(cur.vw);
    float vv1 = bf16_word_hi(cur.vw);
    v_s[e0] = vv0 * beta_r0 * gaminv_r0;
    v_s[e0 + 1u] = vv1 * beta_r0 * gaminv_r0;
    // M2 round trip (operand role for the WS chain).
    coopMatStore(m2, rt_b, 0, 8, gl_CooperativeMatrixLayoutRowMajor);
    SG_BARRIER();
    coopMatLoad(mat_b, rt_b, 0, 8, gl_CooperativeMatrixLayoutRowMajor);
    coopMatLoad(mat_b2, v_s, 0, 8, gl_CooperativeMatrixLayoutRowMajor);
    SG_BARRIER();
    coopMatLoad(mat_a, rt_a, 0, 8, gl_CooperativeMatrixLayoutRowMajor);
    SG_BARRIER();

    // U = diag(gamma) . Tinv . Vtilde; WS = diag(gamma) . Tinv . M2;
    // delta = U - WS. Every intermediate re-consumed as an operand takes
    // one shared round trip.
    coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> tinvv =
        coopMatMulAdd(mat_a2, mat_b2, zero);
    coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> ws =
        coopMatMulAdd(mat_a2, mat_b, zero);
    coopMatStore(tinvv, rt_b, 0, 8, gl_CooperativeMatrixLayoutRowMajor);
    SG_BARRIER();
    coopMatLoad(mat_b, rt_b, 0, 8, gl_CooperativeMatrixLayoutRowMajor);
    SG_BARRIER();
    coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> u =
        coopMatMulAdd(mat_a, mat_b, zero);
    coopMatStore(ws, rt_b, 0, 8, gl_CooperativeMatrixLayoutRowMajor);
    SG_BARRIER();
    coopMatLoad(mat_b, rt_b, 0, 8, gl_CooperativeMatrixLayoutRowMajor);
    SG_BARRIER();
    coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> delta =
        u - coopMatMulAdd(mat_a, mat_b, zero);

    // QKt tri: tril(Q.K^T) scaled elementwise by exp(gamma_log_r - gamma_log_c):
    // one shared round trip. The column factor differs per element (c0 vs
    // c0+1), so read gamma_log per column.
    coopMatStore(qkt, rt_a, 0, 8, gl_CooperativeMatrixLayoutRowMajor);
    SG_BARRIER();
    float qe0 = rt_a[e0];
    float qe1 = rt_a[e0 + 1u];
    rt_a[e0] = (c0 <= r0)
        ? qe0 * exp(gamma_s[r0] - gamma_s[c0]) : 0.0;
    rt_a[e0 + 1u] = (c0 + 1u <= r0)
        ? qe1 * exp(gamma_s[r0] - gamma_s[c0 + 1u]) : 0.0;
    SG_BARRIER();
    coopMatLoad(mat_a, rt_a, 0, 8, gl_CooperativeMatrixLayoutRowMajor);
    // delta feeds the out and state-update matmuls: operand role.
    coopMatStore(delta, rt_b, 0, 8, gl_CooperativeMatrixLayoutRowMajor);
    SG_BARRIER();
    coopMatLoad(mat_b2, rt_b, 0, 8, gl_CooperativeMatrixLayoutRowMajor);
    SG_BARRIER();

    // y rows: out = QKt_tri . delta + (gamma Q).S
    coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> out_t =
        coopMatMulAdd(mat_a, mat_b2, tmp);
    coopMatStore(out_t, rt_a, 0, 8, gl_CooperativeMatrixLayoutRowMajor);
    SG_BARRIER();
    if (r0 < valid) {
      y_buf.w[(((t0 + r0) * hv + head) * params.matrix_n + dv0 + c0) >> 1u] =
          bf16_pack(rt_a[e0], rt_a[e0 + 1u]);
    }
    SG_BARRIER();

    // State update: S = gamma_C . S + (K . diag(exp(gamma_C - gamma)))^T . delta.
    [[unroll]] for (uint kk = 0u; kk < KSTEPS; ++kk) {
      float kv0 = bf16_word_lo(cur.kw[kk]);
      float kv1 = bf16_word_hi(cur.kw[kk]);
      kgc_s[e0] = kv0 * dec_r0;
      kgc_s[e0 + 1u] = kv1 * dec_r0;
      SG_BARRIER();
      coopMatLoad(mat_a, kgc_s, 0, 8, gl_CooperativeMatrixLayoutColumnMajor);
      coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> kd =
          coopMatMulAdd(mat_a, mat_b2, zero);
      coopMatStore(kd, rt_b, 0, 8, gl_CooperativeMatrixLayoutRowMajor);
      SG_BARRIER();
      s_state[kk * 64u + e0] = s_state[kk * 64u + e0] * gamC + rt_b[e0];
      s_state[kk * 64u + e0 + 1u] =
          s_state[kk * 64u + e0 + 1u] * gamC + rt_b[e0 + 1u];
      SG_BARRIER();
    }
  }

  // Terminal state slice: hf[(head*Dv + dv0 + c)*Dk + kk*8 + r]; the
  // lane's element pair sits Dk apart (dv stride).
  for (uint kk = 0u; kk < KSTEPS; ++kk) {
    uint idx = hf_off + (head * params.matrix_n + dv0 + c0) * DK + kk * 8u + r0;
    s_out.v[idx] = s_state[kk * 64u + e0];
    s_out.v[idx + DK] = s_state[kk * 64u + e0 + 1u];
  }
}
