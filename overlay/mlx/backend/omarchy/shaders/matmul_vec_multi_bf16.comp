#version 460

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle_relative : require

layout(local_size_x = 32) in;

layout(set = 0, binding = 0, std430) readonly buffer InputA {
  uvec2 values[];
} input_a;

#define DENSE_WEIGHT(I, W, O) \
layout(set = 0, binding = W, std430) readonly buffer InputB##I { \
  uvec2 values[]; \
} input_b##I; \
layout(set = 0, binding = O, std430) writeonly buffer Output##I { \
  uint16_t values[]; \
} output##I;
DENSE_WEIGHT(0, 1, 2)
DENSE_WEIGHT(1, 3, 4)
DENSE_WEIGHT(2, 5, 6)

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
  uint lhs_gap;
  uint rhs_gap;
} params;

vec4 unpack_bf16x4(uvec2 packed) {
  return vec4(
      uintBitsToFloat((packed.x & 0xffffu) << 16u),
      uintBitsToFloat(packed.x & 0xffff0000u),
      uintBitsToFloat((packed.y & 0xffffu) << 16u),
      uintBitsToFloat(packed.y & 0xffff0000u));
}

uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}

#define DENSE_GEMV(B, O, B_OFFSET, ROW_GROUP, MI) { \
  uint row = (ROW_GROUP) * 4u; \
  uint lane_k = gl_SubgroupInvocationID * 4u; \
  precise float accumulator0 = 0.0; \
  precise float accumulator1 = 0.0; \
  precise float accumulator2 = 0.0; \
  precise float accumulator3 = 0.0; \
  for (uint k = lane_k; k < params.matrix_k; k += 128u) { \
    vec4 x = unpack_bf16x4(input_a.values[(params.lhs_offset + k) / 4u]); \
    vec4 weight0 = unpack_bf16x4( \
        B.values[((B_OFFSET) + row * params.matrix_k + k) / 4u]); \
    vec4 weight1 = unpack_bf16x4( \
        B.values[((B_OFFSET) + (row + 1u) * params.matrix_k + k) / 4u]); \
    vec4 weight2 = unpack_bf16x4( \
        B.values[((B_OFFSET) + (row + 2u) * params.matrix_k + k) / 4u]); \
    vec4 weight3 = unpack_bf16x4( \
        B.values[((B_OFFSET) + (row + 3u) * params.matrix_k + k) / 4u]); \
    accumulator0 = fma(weight0.x, x.x, accumulator0); \
    accumulator0 = fma(weight0.y, x.y, accumulator0); \
    accumulator0 = fma(weight0.z, x.z, accumulator0); \
    accumulator0 = fma(weight0.w, x.w, accumulator0); \
    accumulator1 = fma(weight1.x, x.x, accumulator1); \
    accumulator1 = fma(weight1.y, x.y, accumulator1); \
    accumulator1 = fma(weight1.z, x.z, accumulator1); \
    accumulator1 = fma(weight1.w, x.w, accumulator1); \
    accumulator2 = fma(weight2.x, x.x, accumulator2); \
    accumulator2 = fma(weight2.y, x.y, accumulator2); \
    accumulator2 = fma(weight2.z, x.z, accumulator2); \
    accumulator2 = fma(weight2.w, x.w, accumulator2); \
    accumulator3 = fma(weight3.x, x.x, accumulator3); \
    accumulator3 = fma(weight3.y, x.y, accumulator3); \
    accumulator3 = fma(weight3.z, x.z, accumulator3); \
    accumulator3 = fma(weight3.w, x.w, accumulator3); \
  } \
  accumulator0 += subgroupShuffleDown(accumulator0, 16u); \
  accumulator1 += subgroupShuffleDown(accumulator1, 16u); \
  accumulator2 += subgroupShuffleDown(accumulator2, 16u); \
  accumulator3 += subgroupShuffleDown(accumulator3, 16u); \
  accumulator0 += subgroupShuffleDown(accumulator0, 8u); \
  accumulator1 += subgroupShuffleDown(accumulator1, 8u); \
  accumulator2 += subgroupShuffleDown(accumulator2, 8u); \
  accumulator3 += subgroupShuffleDown(accumulator3, 8u); \
  accumulator0 += subgroupShuffleDown(accumulator0, 4u); \
  accumulator1 += subgroupShuffleDown(accumulator1, 4u); \
  accumulator2 += subgroupShuffleDown(accumulator2, 4u); \
  accumulator3 += subgroupShuffleDown(accumulator3, 4u); \
  accumulator0 += subgroupShuffleDown(accumulator0, 2u); \
  accumulator1 += subgroupShuffleDown(accumulator1, 2u); \
  accumulator2 += subgroupShuffleDown(accumulator2, 2u); \
  accumulator3 += subgroupShuffleDown(accumulator3, 2u); \
  accumulator0 += subgroupShuffleDown(accumulator0, 1u); \
  accumulator1 += subgroupShuffleDown(accumulator1, 1u); \
  accumulator2 += subgroupShuffleDown(accumulator2, 1u); \
  accumulator3 += subgroupShuffleDown(accumulator3, 1u); \
  if (gl_SubgroupInvocationID == 0u) { \
    if ((params.flags & (4096u << MI)) != 0u) { \
      uint base = params.out_strides[MI]; \
      uint gap = params.matrix_n; \
      uint hd = params.matrix_m; \
      O.values[base + (row + 0u) / hd * gap + (row + 0u) % hd] = \
          bf16_store(accumulator0); \
      O.values[base + (row + 1u) / hd * gap + (row + 1u) % hd] = \
          bf16_store(accumulator1); \
      O.values[base + (row + 2u) / hd * gap + (row + 2u) % hd] = \
          bf16_store(accumulator2); \
      O.values[base + (row + 3u) / hd * gap + (row + 3u) % hd] = \
          bf16_store(accumulator3); \
    } else { \
      O.values[row] = bf16_store(accumulator0); \
      O.values[row + 1u] = bf16_store(accumulator1); \
      O.values[row + 2u] = bf16_store(accumulator2); \
      O.values[row + 3u] = bf16_store(accumulator3); \
    } \
  } \
}

void main() {
  uint groups0 = params.shape[0] / 4u;
  uint groups1 = params.shape[1] / 4u;
  uint workgroup = gl_WorkGroupID.x;
  if (workgroup < groups0) {
    DENSE_GEMV(input_b0, output0, params.in_strides[0], workgroup, 0u)
  } else if (workgroup < groups0 + groups1) {
    DENSE_GEMV(
        input_b1,
        output1,
        params.in_strides[1],
        workgroup - groups0,
        1u)
  } else {
    DENSE_GEMV(
        input_b2,
        output2,
        params.in_strides[2],
        workgroup - groups0 - groups1,
        2u)
  }
}
