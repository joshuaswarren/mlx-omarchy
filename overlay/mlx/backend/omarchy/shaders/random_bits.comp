//
// RandomBits for all upstream widths: 4 (uint32), 2 (uint16), and
// 1 (uint8). Each threefry2x32 hash call fills two output words; the
// rotation constants, the 5-round schedule, and the (key, counter) to
// output word mapping mirror mlx/backend/cpu/threefry.cpp and
// RandomBits::eval_cpu exactly, so seeded runs reproduce upstream MLX
// semantics bit for bit. The keys input has shape (N1, ..., NK, 2) as
// raw uint32 words; the output is the (N1, ..., NK, M1, M2, ...)
// bit tensor, packed element-contiguous for every width. Each output
// word is assembled from the elements that own its bytes, and each
// element names its own key, so per-key regions that end mid-word
// (the common width-1/2 case under batched keys) never leak one
// key's masked tail bytes into the next key's elements. Slack lanes
// past the element count stay zero, the same masked-word convention
// the CPU comparison tests pin.

#version 460

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer Keys {
  uint values[];
} keys_data;
layout(set = 0, binding = 1, std430) writeonly buffer Output {
  uint values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
} params;

// count carries the total output words, reduce_size the elements per
// key, output_size the key count, lhs_offset the word offset of the
// keys, operation the element width in bytes (1, 2, or 4), and
// output_offset the word offset of the output.

uvec2 threefry2x32(uvec2 key, uvec2 count) {
  // Upstream rotations[2][4] flattened: rounds 0,2,4 use {13,15,26,6}
  // and rounds 1,3 use {17,29,16,24}.
  const uint rotations[8] = uint[8](
      13u, 15u, 26u, 6u, 17u, 29u, 16u, 24u);
  uint ks[3];
  ks[0] = key.x;
  ks[1] = key.y;
  ks[2] = key.x ^ key.y ^ 0x1BD11BDAu;

  count.x += ks[0];
  count.y += ks[1];

  for (int i = 0; i < 5; ++i) {
    for (int j = 0; j < 4; ++j) {
      uint r = rotations[(i & 1) * 4 + j];
      count.x += count.y;
      count.y = (count.y << r) | (count.y >> (32u - r));
      count.y ^= count.x;
    }
    count.x += ks[(i + 1) % 3];
    count.y += ks[(i + 2) % 3] + uint(i) + 1u;
  }
  return count;
}

void main() {
  uint word_index = gl_GlobalInvocationID.x;
  uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  uint elems_per_word = 4u / params.operation;
  while (word_index < params.count) {
    // Assemble one output word from the elements that own its bytes.
    // Each element names its own key, so a per-key region ending
    // mid-word cannot clobber the next key's leading bytes.
    uint value = 0u;
    uint shift = 0u;
    for (uint lane = 0u; lane < elems_per_word; ++lane) {
      uint element_index = word_index * elems_per_word + lane;
      if (element_index >= params.output_size * params.reduce_size) {
        break; // Slack lanes stay zero, matching the CPU's tail.
      }
      uint key_index = element_index / params.reduce_size;
      uint element = element_index - key_index * params.reduce_size;

      uint key_base = params.lhs_offset + key_index + key_index;
      uvec2 key = uvec2(
          keys_data.values[key_base], keys_data.values[key_base + 1u]);

      // eval_cpu writes word j of a key's region from counter pairs
      // (first, second) with count.first walking 0..half-1 and
      // count.second walking half(+1)..out_skip-1. Words below half
      // take the .first output and the rest the .second output; an
      // odd word count leaves one middle word fed by the counter
      // (half, 0).
      uint words_per_key =
          (params.reduce_size + elems_per_word - 1u) / elems_per_word;
      uint word = element / elems_per_word;
      uint half_count = words_per_key / 2u;
      bool even = (words_per_key & 1u) == 0u;
      uvec2 counter;
      if (word < half_count) {
        counter = uvec2(word, word + half_count + (even ? 0u : 1u));
      } else if (even) {
        counter = uvec2(word - half_count, word);
      } else if (word == half_count) {
        counter = uvec2(half_count, 0u);
      } else {
        counter = uvec2(word - half_count - 1u, word);
      }
      uvec2 bits = threefry2x32(key, counter);
      bool use_first =
          (word < half_count) || (!even && word == half_count);
      uint bits_out = use_first ? bits.x : bits.y;

      // Lane extraction with constant shifts picked by a select
      // chain (the receipt-proven Honeykrisp-safe shape; no
      // data-dependent shift-then-mask). Width 4 takes the whole
      // word; width 2 the low or high halfword; width 1 one of the
      // four byte lanes.
      uint element_lane = element - word * elems_per_word;
      uint element_value = bits_out;
      if (params.operation == 2u) {
        element_value = (element_lane == 0u)
            ? (bits_out & 0xFFFFu)
            : (bits_out >> 16u);
      } else if (params.operation == 1u) {
        element_value =
            (element_lane == 0u) ? (bits_out & 0xFFu)
            : (element_lane == 1u) ? ((bits_out >> 8u) & 0xFFu)
            : (element_lane == 2u) ? ((bits_out >> 16u) & 0xFFu)
                                   : ((bits_out >> 24u) & 0xFFu);
      }
      value |= element_value << shift;
      shift += params.operation * 8u;
    }
    output_data.values[params.output_offset + word_index] = value;
    if (params.count - word_index <= stride) {
      break;
    }
    word_index += stride;
  }
}
