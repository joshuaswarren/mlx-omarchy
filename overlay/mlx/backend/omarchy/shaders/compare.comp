#version 460

#ifdef USE_FP16
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define SOURCE_TYPE float16_t
#define VALUE_TYPE float
#define LOAD_VALUE(x) float(x)
#elif defined(USE_BF16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define SOURCE_TYPE uint16_t
#define VALUE_TYPE float
#define LOAD_VALUE(x) uintBitsToFloat(uint(x) << 16u)
#elif defined(USE_I32)
#define SOURCE_TYPE int
#define VALUE_TYPE int
#define LOAD_VALUE(x) (x)
#else
#define SOURCE_TYPE float
#define VALUE_TYPE float
#define LOAD_VALUE(x) float(x)
#endif

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer InputA {
  SOURCE_TYPE values[];
} input_a;
layout(set = 0, binding = 1, std430) readonly buffer InputB {
  SOURCE_TYPE values[];
} input_b;
// Bool arrays store one byte per element. The interface reads and writes
// them as little-endian 32-bit words, so no 8-bit storage feature is
// needed; the omarchy allocator page-rounds every buffer, so the word
// that contains the last byte is always inside the allocation.
layout(set = 0, binding = 2, std430) writeonly buffer Output {
  uint words[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  // dims == 0 selects the modulo fast path below. Otherwise the output
  // is unraveled over shape[] and lhs_strides/rhs_strides index the
  // operands; a stride of 0 broadcasts the axis.
  uint dims;
  uint shape[4];
  uint lhs_strides[4];
  uint rhs_strides[4];
} params;

uint lhs_index_for(uint index) {
  if (params.dims == 0u) {
    return params.lhs_offset + (params.lhs_size == 1u
        ? 0u
        : (params.lhs_size == params.count ? index : index % params.lhs_size));
  }
  uint rem = index;
  uint result = params.lhs_offset;
  for (int dim = int(params.dims) - 1; dim >= 0; --dim) {
    uint coord = rem % params.shape[dim];
    rem /= params.shape[dim];
    result += coord * params.lhs_strides[dim];
  }
  return result;
}

uint rhs_index_for(uint index) {
  if (params.dims == 0u) {
    return params.rhs_offset + (params.rhs_size == 1u
        ? 0u
        : (params.rhs_size == params.count ? index : index % params.rhs_size));
  }
  uint rem = index;
  uint result = params.rhs_offset;
  for (int dim = int(params.dims) - 1; dim >= 0; --dim) {
    uint coord = rem % params.shape[dim];
    rem /= params.shape[dim];
    result += coord * params.rhs_strides[dim];
  }
  return result;
}

void main() {
  uint word_index = gl_GlobalInvocationID.x;
  uint word_stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  uint word_count = (params.count + 3u) >> 2u;
  while (word_index < word_count) {
    uint base = word_index * 4u;
    uint word = 0u;
    for (uint lane = 0u; lane < 4u; ++lane) {
      uint index = base + lane;
      if (index >= params.count) {
        break;
      }
      VALUE_TYPE a = LOAD_VALUE(input_a.values[lhs_index_for(index)]);
      VALUE_TYPE b = LOAD_VALUE(input_b.values[rhs_index_for(index)]);
      // Upstream float comparators use C++ semantics: every ordered
      // comparison of a NaN is false, and NaN != x is true. GLSL's
      // operators carry the same IEEE ordering, so one selector serves
      // both the float and the int32 variants. The codes match
      // ComparisonOperation in primitives.cpp.
      bool result = params.operation == 0u ? a == b
          : params.operation == 1u ? a >= b
          : params.operation == 2u ? a > b
          : params.operation == 3u ? a < b
          : params.operation == 4u ? a <= b
          : a != b;
      // NaNEqual carries the equal_nan flag (params.flags bit 0): when
      // both operands are NaN, the equal result is true the way the
      // upstream mx.array_equal(..., equal_nan=True) and
      // mx.allclose(..., equal_nan=True) contracts require. The flag
      // only ever rides on the float paths; upstream ops.cpp masks
      // equal_nan off when dtype is not inexact, and the int32/bool
      // compare kernels never set bit 0.
      if ((params.operation == 0u) && ((params.flags & 1u) != 0u)
          && isnan(a) && isnan(b)) {
        result = true;
      }
      uint bit = result ? 1u : 0u;
      word |= bit << ((index & 3u) * 8u);
    }
    output_data.words[word_index] = word;
    if (word_count - word_index <= word_stride) {
      break;
    }
    word_index += word_stride;
  }
}
