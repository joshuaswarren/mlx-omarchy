#version 460

#ifdef USE_FP16
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define SOURCE_TYPE float16_t
#define VALUE_TYPE float
#define LOAD_VALUE(x) float(x)
#define LOAD_INDEXED(buf, i) buf.values[(i)]
#elif defined(USE_BF16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define SOURCE_TYPE uint16_t
#define VALUE_TYPE float
#define LOAD_VALUE(x) uintBitsToFloat(uint(x) << 16u)
#define LOAD_INDEXED(buf, i) buf.values[(i)]
#elif defined(USE_I8) || defined(USE_U8)
// Byte lanes ride uint32 words, one element per byte lane, the same
// packed transport the bool paths use. The load widens to the compute
// word (sign or zero extension) before the comparison.
#define SOURCE_TYPE uint
#define VALUE_TYPE int
#define WIDE(b) WIDEN_BYTE(b)
#define LOAD_VALUE(x) WIDE(x)
#define LOAD_INDEXED(buf, i) \
  BYTE_AT(buf.values[(i) >> 2u], (i) & 3u)
#elif defined(USE_I16) || defined(USE_U16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define SOURCE_TYPE uint16_t
#define VALUE_TYPE int
#define WIDE(h) WIDEN_HALF(h)
#define LOAD_VALUE(x) WIDE(x)
#define LOAD_INDEXED(buf, i) buf.values[(i)]
#elif defined(USE_I32)
#define SOURCE_TYPE int
#define VALUE_TYPE int
#define LOAD_VALUE(x) (x)
#define LOAD_INDEXED(buf, i) buf.values[(i)]
#elif defined(USE_U32)
#define SOURCE_TYPE uint
#define VALUE_TYPE uint
#define LOAD_VALUE(x) (x)
#define LOAD_INDEXED(buf, i) buf.values[(i)]
#elif defined(USE_I64)
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#define SOURCE_TYPE int64_t
#define VALUE_TYPE int64_t
#define LOAD_VALUE(x) (x)
#define LOAD_INDEXED(buf, i) buf.values[(i)]
#elif defined(USE_U64)
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#define SOURCE_TYPE uint64_t
#define VALUE_TYPE uint64_t
#define LOAD_VALUE(x) (x)
#define LOAD_INDEXED(buf, i) buf.values[(i)]
#else
#define SOURCE_TYPE float
#define VALUE_TYPE float
#define LOAD_VALUE(x) float(x)
#define LOAD_INDEXED(buf, i) buf.values[(i)]
#endif

// Honeykrisp miscompiles shift-then-mask byte extraction with a
// data-dependent shift amount; four constant shifts picked by a select
// chain are the receipt-proven equivalent (scatter.comp BYTE_AT).
#define BYTE_AT(word, lane)                                                  \
  ((lane) == 0u ? ((word) & 0xFFu)                                           \
       : (lane) == 1u ? (((word) >> 8u) & 0xFFu)                             \
       : (lane) == 2u ? (((word) >> 16u) & 0xFFu)                            \
                      : (((word) >> 24u) & 0xFFu))

#if defined(USE_I8)
int WIDEN_BYTE(uint b) {
  return (b & 0x80u) != 0u ? int(b | 0xFFFFFF00u) : int(b);
}
#elif defined(USE_U8)
int WIDEN_BYTE(uint b) {
  return int(b);
}
#elif defined(USE_I16)
int WIDEN_HALF(uint16_t h) {
  return (uint(h) & 0x8000u) != 0u ? int(uint(h) | 0xFFFF0000u) : int(uint(h));
}
#elif defined(USE_U16)
int WIDEN_HALF(uint16_t h) {
  return int(uint(h));
}
#endif

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer InputA {
  SOURCE_TYPE values[];
} input_a;
layout(set = 0, binding = 1, std430) readonly buffer InputB {
  SOURCE_TYPE values[];
} input_b;
// Bool arrays store one byte per element. The interface reads and writes
// them as little-endian 32-bit words, so no 8-bit storage feature is
// needed; the omarchy allocator page-rounds every buffer, so the word
// that contains the last byte is always inside the allocation.
layout(set = 0, binding = 2, std430) writeonly buffer Output {
  uint words[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  // dims == 0 selects the modulo fast path below. Otherwise the output
  // is unraveled over shape[] and lhs_strides/rhs_strides index the
  // operands; a stride of 0 broadcasts the axis.
  uint dims;
  uint shape[4];
  uint lhs_strides[4];
  uint rhs_strides[4];
} params;
layout(set = 0, binding = 3, std430) readonly buffer AxisMetadata {
  uint values[];
} axis_data;

// Rank>4 broadcast transport: matrix_k carries the collapsed axis count
// and axis_data holds [extents | lhs strides | rhs strides], the
// reduce_general.comp binding-3 word order. matrix_k == 0 keeps the
// inline push-constant arrays; the host always binds the metadata slot
// (a placeholder while inline) because the interface is static.
uint axis_extent(uint index) {
  if (params.matrix_k == 0u) {
    return params.shape[index];
  }
  return axis_data.values[index];
}

uint lhs_stride_at(uint index) {
  if (params.matrix_k == 0u) {
    return params.lhs_strides[index];
  }
  return axis_data.values[params.matrix_k + index];
}

uint rhs_stride_at(uint index) {
  if (params.matrix_k == 0u) {
    return params.rhs_strides[index];
  }
  return axis_data.values[2u * params.matrix_k + index];
}

uint lhs_index_for(uint index) {
  if (params.dims == 0u) {
    return params.lhs_offset + (params.lhs_size == 1u
        ? 0u
        : (params.lhs_size == params.count ? index : index % params.lhs_size));
  }
  uint rem = index;
  uint result = params.lhs_offset;
  for (int dim = int(params.dims) - 1; dim >= 0; --dim) {
    uint coord = rem % axis_extent(uint(dim));
    rem /= axis_extent(uint(dim));
    result += coord * lhs_stride_at(uint(dim));
  }
  return result;
}

uint rhs_index_for(uint index) {
  if (params.dims == 0u) {
    return params.rhs_offset + (params.rhs_size == 1u
        ? 0u
        : (params.rhs_size == params.count ? index : index % params.rhs_size));
  }
  uint rem = index;
  uint result = params.rhs_offset;
  for (int dim = int(params.dims) - 1; dim >= 0; --dim) {
    uint coord = rem % axis_extent(uint(dim));
    rem /= axis_extent(uint(dim));
    result += coord * rhs_stride_at(uint(dim));
  }
  return result;
}

void main() {
  uint word_index = gl_GlobalInvocationID.x;
  uint word_stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  uint word_count = (params.count + 3u) >> 2u;
  while (word_index < word_count) {
    uint base = word_index * 4u;
    uint word = 0u;
    for (uint lane = 0u; lane < 4u; ++lane) {
      uint index = base + lane;
      if (index >= params.count) {
        break;
      }
      VALUE_TYPE a = LOAD_VALUE(LOAD_INDEXED(input_a, lhs_index_for(index)));
      VALUE_TYPE b = LOAD_VALUE(LOAD_INDEXED(input_b, rhs_index_for(index)));
      // Upstream float comparators use C++ semantics: every ordered
      // comparison of a NaN is false, and NaN != x is true. GLSL's
      // operators carry the same IEEE ordering, so one selector serves
      // both the float and the int32 variants. The codes match
      // ComparisonOperation in primitives.cpp.
      bool result = params.operation == 0u ? a == b
          : params.operation == 1u ? a >= b
          : params.operation == 2u ? a > b
          : params.operation == 3u ? a < b
          : params.operation == 4u ? a <= b
          : a != b;
      // NaNEqual carries the equal_nan flag (params.flags bit 0): when
      // both operands are NaN, the equal result is true the way the
      // upstream mx.array_equal(..., equal_nan=True) and
      // mx.allclose(..., equal_nan=True) contracts require. The flag
      // only ever rides on the float paths; upstream ops.cpp masks
      // equal_nan off when dtype is not inexact, and the int32/bool
      // compare kernels never set bit 0.
      // Float variants only: isnan() has no meaning for the integer
      // types, and the float-to-integer implicit conversion that made
      // the int32 build type-check silently produced a constant-false
      // predicate anyway.
#if !defined(USE_I32) && !defined(USE_U32) && !defined(USE_I64) && \
    !defined(USE_I8) && !defined(USE_U8) && !defined(USE_I16) && \
    !defined(USE_U16)
      if ((params.operation == 0u) && ((params.flags & 1u) != 0u)
          && isnan(a) && isnan(b)) {
        result = true;
      }
#endif
      uint bit = result ? 1u : 0u;
      word |= bit << ((index & 3u) * 8u);
    }
    output_data.words[word_index] = word;
    if (word_count - word_index <= word_stride) {
      break;
    }
    word_index += word_stride;
  }
}
