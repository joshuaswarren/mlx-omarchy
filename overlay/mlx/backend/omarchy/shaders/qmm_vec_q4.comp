#version 460

// Decode GEMV for the transposed affine 4-bit / group-64 contract:
// out[1, n] = x[1, k] @ dequant(w), w packed [n][k / 8] uint32 words,
// low nibble first, one f16/bf16/f32 scale and bias per 64 elements.
// This is every linear layer of a 4-bit decode step, so the kernel is
// shaped like the AGX consensus GEMV (MLX `qmv_fast`, ggml-Metal
// `mul_mv_q4_0`): small workgroups, a few rows per subgroup, 8 B per
// lane per row per K-step, x read once per step and reused across the
// rows, subgroupAdd epilogue.
//
//   * A workgroup is THREADS / 32 slots of 32 lanes; on the subgroup
//     flavor a slot is one hardware subgroup. Each slot owns ROWS
//     consecutive output rows. Both are specialization constants
//     (constant 0 = ROWS, constant 1 = THREADS, keyed from shape[3] and
//     in_strides[0]) so the row loop unrolls and registers are
//     allocated for exactly the rows in use; dispatch picks them
//     (QuantizedMatmul::eval_gpu). On the M1 ROWS = 2 wins on every
//     decode shape: 73 GPRs keeps a full 1024 threads per core, while
//     4 and 8 rows cost 115 / 179 GPRs (832 / 576 threads) and lose
//     more to occupancy than they gain from x reuse (receipts
//     2026-09-07-perf-dispatch/qmm-bandwidth-v3-m1.md).
//   * Per K-step a lane streams one uvec2 (8 B = 16 elements) of every
//     row, so a slot covers 512 contiguous elements per step and each
//     lane fetches one scale/bias pair per row per step. All ROWS
//     loads of a step are issued before the first FMA, so a lane keeps
//     ROWS independent loads in flight.
//   * The 16 activations a lane needs are read straight from the
//     cached x buffer as uvec4 words, pre-scaled once per step and
//     shared across the slot's rows in registers. No shared-memory
//     staging, no barrier, no multiply in the K loop: every row base is
//     computed once before it.
//
// Dequantization uses the affine identity
//   sum_i x_i * (s * q_i + b) = s * sum_i (x_i * q_i) + b * sum_i x_i
// per lane step (the Metal qmv kernel's qdot order), and masks nibbles
// in place instead of shifting them: element j of a word is
// x_j * 2^-4j times float(word & (0xF << 4j)). Both factors are exact
// power-of-two rescalings, so every product equals x_j * q_j exactly.
// Accumulation order: per lane per step, an f32 dot of 16 terms (one
// 8-term chain per word, the two chains summed), then s * dot + b * xsum
// accumulated per lane over that lane's steps, then one subgroupAdd
// (or the shared-memory tree) across the 32 lanes.
//
// USE_SUBGROUP=1 compiles the subgroupAdd flavor (gated in dispatch on
// subgroupSize == 32 and the ARITHMETIC feature bit); the default
// flavor reduces through shared memory and is correct on any subgroup
// size (llvmpipe).

#ifdef USE_FP16
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#elif defined(USE_BF16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define STORAGE_TYPE uint16_t
#define LOAD_VALUE(x) uintBitsToFloat(uint(x) << 16u)
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
#define STORE_VALUE(f) bf16_store(f)
#else
#define STORAGE_TYPE float
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#endif

#ifdef USE_SUBGROUP
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#endif

layout(constant_id = 0) const uint ROWS = 2u;
layout(constant_id = 1) const uint THREADS = 128u;
layout(local_size_x_id = 1) in;

const uint LANES = 32u;
const uint SLOTS = THREADS / LANES;
const uint MAX_ROWS = 8u;
const uint MAX_THREADS = 256u;
// Packed words and elements per lane per step.
const uint LANE_WORDS = 2u;
const uint LANE_ELEMS = 8u * LANE_WORDS;

// x is read through a uvec4 view: dispatch guarantees the element
// offset is 16-byte aligned and k is a multiple of 64.
layout(set = 0, binding = 0, std430) readonly buffer InputX {
  uvec4 values[];
} input_x;
layout(set = 0, binding = 1, std430) readonly buffer InputW {
  uvec2 values[];
} input_w;
layout(set = 0, binding = 2, std430) readonly buffer Scales {
  STORAGE_TYPE values[];
} scales;
layout(set = 0, binding = 3, std430) readonly buffer Biases {
  STORAGE_TYPE values[];
} biases;
layout(set = 0, binding = 4, std430) writeonly buffer Output {
  STORAGE_TYPE values[];
} output_data;

// Same block as qmm_vec.comp: operation = bits (4), reduce_size = group
// size (64), lhs/rhs/output offsets in elements (lhs_offset 16-byte
// aligned, rhs_offset a multiple of 4 words), aux_offset the scale
// base, aux_size the bias base, shape[0] the batch count, shape[1] the
// per-batch weight words, shape[2] the per-batch scale/bias elements.
// shape[3] (rows per slot) and in_strides[0] (workgroup threads) key
// the specialization constants above and are not read here.
layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

#ifndef USE_SUBGROUP
shared float reduce_scratch[MAX_ROWS * MAX_THREADS];
#endif

const float NIBBLE_SCALE[8] = float[8](
    1.0, 0.0625, 0.00390625, 0.000244140625, 1.52587890625e-05,
    9.5367431640625e-07, 5.9604644775390625e-08, 3.725290298461914e-09);

// Eight consecutive x elements from one uvec4 (f16/bf16) or two (f32),
// scaled for the in-place nibble masks below.
#ifdef USE_FP16
#define X_VECS_PER_8 1u
void load_x8(uint vec_index, out float x[8]) {
  uvec4 raw = input_x.values[vec_index];
  vec2 p0 = unpackHalf2x16(raw.x);
  vec2 p1 = unpackHalf2x16(raw.y);
  vec2 p2 = unpackHalf2x16(raw.z);
  vec2 p3 = unpackHalf2x16(raw.w);
  x[0] = p0.x;
  x[1] = p0.y * NIBBLE_SCALE[1];
  x[2] = p1.x * NIBBLE_SCALE[2];
  x[3] = p1.y * NIBBLE_SCALE[3];
  x[4] = p2.x * NIBBLE_SCALE[4];
  x[5] = p2.y * NIBBLE_SCALE[5];
  x[6] = p3.x * NIBBLE_SCALE[6];
  x[7] = p3.y * NIBBLE_SCALE[7];
}
#elif defined(USE_BF16)
#define X_VECS_PER_8 1u
void load_x8(uint vec_index, out float x[8]) {
  uvec4 raw = input_x.values[vec_index];
  x[0] = uintBitsToFloat(raw.x << 16u);
  x[1] = uintBitsToFloat(raw.x & 0xffff0000u) * NIBBLE_SCALE[1];
  x[2] = uintBitsToFloat(raw.y << 16u) * NIBBLE_SCALE[2];
  x[3] = uintBitsToFloat(raw.y & 0xffff0000u) * NIBBLE_SCALE[3];
  x[4] = uintBitsToFloat(raw.z << 16u) * NIBBLE_SCALE[4];
  x[5] = uintBitsToFloat(raw.z & 0xffff0000u) * NIBBLE_SCALE[5];
  x[6] = uintBitsToFloat(raw.w << 16u) * NIBBLE_SCALE[6];
  x[7] = uintBitsToFloat(raw.w & 0xffff0000u) * NIBBLE_SCALE[7];
}
#else
#define X_VECS_PER_8 2u
void load_x8(uint vec_index, out float x[8]) {
  uvec4 lo = input_x.values[vec_index];
  uvec4 hi = input_x.values[vec_index + 1u];
  x[0] = uintBitsToFloat(lo.x);
  x[1] = uintBitsToFloat(lo.y) * NIBBLE_SCALE[1];
  x[2] = uintBitsToFloat(lo.z) * NIBBLE_SCALE[2];
  x[3] = uintBitsToFloat(lo.w) * NIBBLE_SCALE[3];
  x[4] = uintBitsToFloat(hi.x) * NIBBLE_SCALE[4];
  x[5] = uintBitsToFloat(hi.y) * NIBBLE_SCALE[5];
  x[6] = uintBitsToFloat(hi.z) * NIBBLE_SCALE[6];
  x[7] = uintBitsToFloat(hi.w) * NIBBLE_SCALE[7];
}
#endif

// One packed word against its eight pre-scaled activations; the
// masked word is q_j * 2^4j exactly, so each product is x_j * q_j.
float word_dot(uint w, float x[8]) {
  float d = x[0] * float(w & 0xfu);
  d += x[1] * float(w & 0xf0u);
  d += x[2] * float(w & 0xf00u);
  d += x[3] * float(w & 0xf000u);
  d += x[4] * float(w & 0xf0000u);
  d += x[5] * float(w & 0xf00000u);
  d += x[6] * float(w & 0xf000000u);
  d += x[7] * float(w & 0xf0000000u);
  return d;
}

// Unscaled sum of the eight elements (the pre-scale is a power of two,
// so dividing it back out is exact).
float x8_sum(float x[8]) {
  float s = x[0];
  s += x[1] * 16.0;
  s += x[2] * 256.0;
  s += x[3] * 4096.0;
  s += x[4] * 65536.0;
  s += x[5] * 1048576.0;
  s += x[6] * 16777216.0;
  s += x[7] * 268435456.0;
  return s;
}

void main() {
#ifdef USE_SUBGROUP
  // Slot == hardware subgroup: the final reduction folds over subgroup
  // lanes, so the lane split follows the subgroup ids.
  uint slot = gl_SubgroupID;
  uint li = gl_SubgroupInvocationID;
#else
  uint slot = gl_LocalInvocationID.x / LANES;
  uint li = gl_LocalInvocationID.x % LANES;
#endif
  uint lane = slot * LANES + li;
  uint n = params.matrix_n;
  uint k = params.matrix_k;
  // Packed words per row, lane chunks per row, groups per row.
  uint row_words = k / 8u;
  uint row_chunks = k / LANE_ELEMS;
  uint groups_per_row = k / 64u;
  uint batch = params.shape[0];
  uint w_batch_words = params.shape[1];
  uint param_batch = params.shape[2];
  uint row0 = (gl_WorkGroupID.x * SLOTS + slot) * ROWS;
  // Rows past n read the last row (a valid address) and are never
  // written, so the K loop carries no row guard.
  uint row_index[MAX_ROWS];
  for (uint r = 0u; r < ROWS; ++r) {
    row_index[r] = min(row0 + r, n - 1u);
  }

  for (uint b = 0u; b < batch; ++b) {
    float acc[MAX_ROWS];
    // Row bases in lane chunks (weights) and groups (scale/bias),
    // computed once: no multiply survives in the K loop.
    uint w_row[MAX_ROWS];
    uint p_row[MAX_ROWS];
    uint w_base = (params.rhs_offset + b * w_batch_words) / LANE_WORDS;
    uint scale_base = params.aux_offset + b * param_batch;
    uint bias_base = params.aux_size + b * param_batch;
    for (uint r = 0u; r < ROWS; ++r) {
      acc[r] = 0.0;
      w_row[r] = w_base + row_index[r] * (row_words / LANE_WORDS);
      p_row[r] = row_index[r] * groups_per_row;
    }
    uint x_base = (params.lhs_offset + b * k) * X_VECS_PER_8 / 8u;
    for (uint v = li; v < row_chunks; v += LANES) {
      // Group of this lane's chunk: LANE_ELEMS divides 64.
      uint g = v / (64u / LANE_ELEMS);
      uvec2 w[MAX_ROWS];
      float s[MAX_ROWS];
      float bias[MAX_ROWS];
      for (uint r = 0u; r < ROWS; ++r) {
        w[r] = input_w.values[w_row[r] + v];
        s[r] = LOAD_VALUE(scales.values[scale_base + p_row[r] + g]);
        bias[r] = LOAD_VALUE(biases.values[bias_base + p_row[r] + g]);
      }
      uint xv = x_base + v * (LANE_ELEMS / 8u) * X_VECS_PER_8;
      float x0[8];
      float x1[8];
      load_x8(xv, x0);
      load_x8(xv + X_VECS_PER_8, x1);
      float xs = x8_sum(x0) + x8_sum(x1);
      for (uint r = 0u; r < ROWS; ++r) {
        float d = word_dot(w[r].x, x0);
        d += word_dot(w[r].y, x1);
        acc[r] += s[r] * d + bias[r] * xs;
      }
    }

    uint out_base = params.output_offset + b * n;
#ifdef USE_SUBGROUP
    for (uint r = 0u; r < ROWS; ++r) {
      float total = subgroupAdd(acc[r]);
      if (li == 0u && row0 + r < n) {
        output_data.values[out_base + row0 + r] = STORE_VALUE(total);
      }
    }
#else
    if (b > 0u) {
      barrier();
    }
    for (uint r = 0u; r < ROWS; ++r) {
      reduce_scratch[r * THREADS + lane] = acc[r];
    }
    barrier();
    if (lane < SLOTS * ROWS) {
      uint out_slot = lane / ROWS;
      uint r = lane % ROWS;
      uint row = (gl_WorkGroupID.x * SLOTS + out_slot) * ROWS + r;
      if (row < n) {
        float total = 0.0;
        for (uint i = 0u; i < LANES; ++i) {
          total += reduce_scratch[r * THREADS + out_slot * LANES + i];
        }
        output_data.values[out_base + row] = STORE_VALUE(total);
      }
    }
#endif
  }
}
