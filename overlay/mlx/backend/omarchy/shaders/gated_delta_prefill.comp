//
// Fused gated-delta-rule prefill scan (GatedDeltaUpdate, T>1), chunked
// two-pass form:
//
//   pass 0 (prefix scan, flags bit3 clear): one workgroup per v-head, one
//     thread per Dv row, the head's state row lives in registers for the
//     whole scan. At every chunk boundary (params.lhs_gap = chunk size C)
//     the row's chunk-initial state is written to the snapshot buffer, so
//     no chunk ever reads another chunk's working state from memory. The
//     last chunk's terminal row is written to hf (the [B, Hv, Dv, Dk] f32
//     row-contiguous layout shared with the decode kernel).
//   pass 1 (outputs, flags bit3 set): grid (heads x ceil(T/C)); each
//     workgroup restores its chunk's initial row (h0 for chunk 0, snapshot
//     otherwise), replays the chunk's tokens with the identical per-token
//     arithmetic, and writes the bf16 output rows. All chunks run
//     concurrently: heads x chunks workgroups instead of heads.
//
// Per-token math is unchanged from the single-workgroup kernel and the
// fast.cpp gated_delta_update fallback with everything promoted to f32;
// each product is rounded separately (no fused multiply-adds) to match the
// ops path's elementwise-then-reduce rounding:
//   state *= decay           (decay = g scalar per head, or per-Dk vector)
//   kv[dv]  = sum_dk state[dv,dk] * k[dk]
//   delta[dv] = (v[dv] - kv[dv]) * beta
//   state[dv,dk] += delta[dv] * k[dk]
//   o[dv]   = sum_dk state[dv,dk] * q[dk];  o stored bf16 RNE.

#version 460

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer QBuf  { uint16_t v[]; } q_buf;
layout(set = 0, binding = 1, std430) readonly buffer KBuf  { uint16_t v[]; } k_buf;
layout(set = 0, binding = 2, std430) readonly buffer VBuf  { uint16_t v[]; } v_buf;
layout(set = 0, binding = 3, std430) readonly buffer GBuf  { uint16_t v[]; } g_buf;
layout(set = 0, binding = 4, std430) readonly buffer BBuf  { uint16_t v[]; } b_buf;
layout(set = 0, binding = 5, std430) readonly buffer SIn    { float    v[]; } s_in;
layout(set = 0, binding = 6, std430) writeonly buffer YBuf { uint16_t v[]; } y_buf;
layout(set = 0, binding = 7, std430) buffer         SOut { float    v[]; } s_out;
layout(set = 0, binding = 8, std430) readonly buffer MBuf  { uint8_t  v[]; } m_buf;
layout(set = 0, binding = 9, std430) readonly buffer GBufF { float     v[]; } g_buf_f;
layout(set = 0, binding = 10, std430) buffer         Snap   { float    v[]; } snap;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;   // Dk
  uint matrix_n;   // Dv
  uint matrix_k;   // Hv
  uint flags;      // bit0: per-Dk decay, bit1: mask, bit2: g is f32,
                   // bit3: output pass
  float alpha;
  float beta_f;
  uint dims;       // T
  uint shape[4];   // [0]=g offset, [1]=h0 offset, [2]=hf offset, [3]=mask offset
  uint in_strides[4];
  uint out_strides[4];
  uint chunk;      // chunk size C
  uint chunks;     // ceil(T / C)
} params;

float bf16_load(uint16_t bits) {
  return uintBitsToFloat(uint(bits) << 16u);
}

uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if ((bits & 0x7fff0000u) == 0x7f800000u) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}

shared float sk[2][128];
shared float sq[2][128];
shared float sg[2][128];


float load_g_scalar(uint t, uint head, uint hv) {
  if ((params.flags & 4u) != 0u) {
    return g_buf_f.v[params.shape[0] + t * hv + head];
  }
  return bf16_load(g_buf.v[params.shape[0] + t * hv + head]);
}

// g vector load is done inline in main(), spread across the workgroup.

// One token's recurrence on the register-resident state row |st|. Each
// thread owns a full Dv row, so delta never crosses threads; k/q/g ride
// shared because the workgroup stages k/q/g together each token. Arithmetic
// mirrors the ops path elementwise rounding.
void token_step(
    inout float st[128],
    uint dk,
    bool tok,
    float beta,
    float g,
    float v_row,
    bool compute_o,
    uint buf,
    out float o_acc) {
  o_acc = 0.0f;
  if (!tok) {
    return;
  }
  // precise: the ops reference rounds each product and each add
  // separately (elementwise kernels then a sequential sum); NoContraction
  // keeps the driver from fusing these into FMAs.
  precise float kv_acc = 0.0f;
  for (uint i = 0u; i < dk; ++i) {
    precise float gi = (params.flags & 1u) != 0u ? sg[buf][i] : g;
    precise float p = st[i] * gi;
    p = p * sk[buf][i];
    kv_acc += p;
  }
  precise float delta = (v_row - kv_acc) * beta;
  for (uint i = 0u; i < dk; ++i) {
    precise float gi = (params.flags & 1u) != 0u ? sg[buf][i] : g;
    precise float dec = st[i] * gi;
    // The ops reference stores the decayed state, then its eager-fused
    // add(state, k*delta) elementwise kernel contracts the multiply-add;
    // mirror that with an explicit fma.
    precise float ns = fma(delta, sk[buf][i], dec);
    st[i] = ns;
    if (compute_o) {
      // Output pass only: the prefix scan never reads o_acc, so the
      // ns*q dot is skipped there (state arithmetic is untouched).
      precise float o = ns * sq[buf][i];
      o_acc += o;
    }
  }
}

void main() {
  uint dk = params.matrix_m;
  uint dv = params.matrix_n;
  uint hv = params.matrix_k;
  uint T = params.dims;
  uint C = params.chunk;
  uint head = gl_WorkGroupID.x;
  uint row = gl_LocalInvocationID.x;   // one dv row per thread
  bool out_pass = (params.flags & 8u) != 0u;
  uint chunk = out_pass ? gl_WorkGroupID.y : 0u;

  if (head >= hv) {
    return;
  }
  uint head_base = head * dv * dk;
  uint row_base = head_base + row * dk;

  float st[128];

  // Restore this row's chunk-initial state: chunk 0 reads h0, later
  // chunks read the prefix scan's snapshot slot (chunk c stores at c-1).
  if (chunk == 0u) {
    for (uint i = 0u; i < dk; ++i) {
      st[i] = s_in.v[params.shape[1] + row_base + i];
    }
  } else {
    uint snap_base = ((chunk - 1u) * hv + head) * dv * dk + row * dk;
    for (uint i = 0u; i < dk; ++i) {
      st[i] = snap.v[snap_base + i];
    }
  }

  // Pass 0 (prefix scan) walks every token; pass 1 replays one chunk.
  uint t_begin = out_pass ? chunk * C : 0u;
  uint t_end = out_pass ? min(t_begin + C, T) : T;

  for (uint t = t_begin; t < t_end; ++t) {
    uint t_head = t * hv + head;
    // Scalar per-token validity (mask [B, T] / [B, T, 1, 1], workgroup
    // uniform): a masked-out token leaves the state untouched and the
    // output zero, matching the composed fallback's where().
    bool tok = true;
    if ((params.flags & 2u) != 0u) {
      tok = m_buf.v[params.shape[3] + t] != 0u;
    }
    // Parallel shared load: thread i stages k/q (and per-Dk g when
    // present) into this token's double-buffer slot, then one barrier
    // orders the load before every thread's token_step. The second slot
    // lets the next iteration's writes (two steps later) safely wait on
    // the single per-iteration barrier.
    uint buf = t & 1u;
    if (row < dk) {
      sk[buf][row] = bf16_load(k_buf.v[params.rhs_offset + t_head * dk + row]);
      sq[buf][row] = bf16_load(q_buf.v[params.lhs_offset + t_head * dk + row]);
      if ((params.flags & 1u) != 0u) {
        sg[buf][row] = (params.flags & 4u) != 0u
            ? g_buf_f.v[params.shape[0] + (t * hv + head) * dk + row]
            : bf16_load(g_buf.v[params.shape[0] + (t * hv + head) * dk + row]);
      }
    }
    barrier();

    float beta = bf16_load(b_buf.v[params.aux_offset + t * hv + head]);
    float g = (params.flags & 1u) != 0u ? 0.0f : load_g_scalar(t, head, hv);
    float v_row = bf16_load(v_buf.v[params.aux_size + t_head * dv + row]);

    float o_acc;
    token_step(st, dk, tok, beta, g, v_row, out_pass, buf, o_acc);

    if (out_pass) {
      y_buf.v[params.output_offset + t_head * dv + row] =
          tok ? bf16_store(o_acc) : bf16_store(0.0f);
    } else if ((t + 1u) % C == 0u && t + 1u < T) {
      // Chunk boundary: snapshot the row for pass 1's chunk t/C + 1
      // (slot index t/C).
      uint snap_base = ((t / C) * hv + head) * dv * dk + row * dk;
      for (uint i = 0u; i < dk; ++i) {
        snap.v[snap_base + i] = st[i];
      }
    }
    // No trailing barrier: the next iteration reads the other shared
    // slot, and its load barrier orders the slot reuse after every
    // thread's reads from two slots ago.
  }

  if (out_pass && chunk + 1u == params.chunks) {
    // Last chunk's terminal state is hf.
    for (uint i = 0u; i < dk; ++i) {
      s_out.v[params.shape[2] + row_base + i] = st[i];
    }
  }
}
