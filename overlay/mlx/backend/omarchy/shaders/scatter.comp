//
// Scatter with one index array (out = copy of src pre-populated by the
// host through a copy dispatch; this kernel only applies updates).
// params.operation selects the phase:
//   0 NONE pass 1: atomicMax the slot rank into scratch[target]
//   1 NONE pass 2: the winning slot copies its update to target, so
//     duplicate indices resolve to the highest slot, exactly the CPU
//     last-write-wins order; deterministic for every dtype
//   2 MAX pass 1: atomicMax the monotone key of the update
//   3 MIN pass 1: atomicMin the monotone key
//   4 MAX finalize (one thread per output element): combine src with
//     the winning key in key space
//   5 MIN finalize
//   6 SUM: USE_U32 atomicAdd of the update word into the output;
//     integer addition is associative, so this is deterministic.
//     USE_BOOL atomicOr of the canonical update bit into scratch
//     (bool add saturates at 1, so duplicates are exact).
//   7 PROD pass: USE_U32 CAS-multiply of the raw update word into
//     scratch[target]; wrap-around integer multiply is associative and
//     commutative, so the CAS order never changes the product.
//     USE_BOOL atomicAnd of the canonical update bit into scratch
//     (bool multiply is AND, so duplicates are exact).
//   8 PROD finalize (one thread per output element): multiply the
//     copied src word by the accumulated product.
//  11 FADD Sum pass: hardware fp32 atomicAdd (VK_EXT_shader_atomic_
//     float) of the decoded update into the fp32 per-element scratch.
//     Duplicate indices accumulate in device order: the total matches
//     upstream Metal, which uses native float atomics for float32 and
//     a packed CAS loop for float16/bfloat16, so reordering between
//     runs can change the last rounding bits. Accumulating in fp32 and
//     rounding once at the end keeps half-precision Sum at least as
//     accurate as upstream's per-add rounding.
//  12 FADD Sum finalize (one thread per output element): store the
//     fp32 accumulation converted once to the output dtype.
//  13 FADD Prod pass: CAS-multiply the fp32 scratch through its uint
//     view (the float-atomic extension has no compare-exchange). Each
//     step rounds in device order, the same nondeterminism class as
//     upstream Metal's CAS-multiply float Prod.
//  17 FCAS Sum pass: the no-hardware-atomic-float twin of op 11, a
//     compare-exchange add through the uint view of the fp32 scratch.
//     Compiled into the FCAS variants for devices that do not
//     advertise VK_EXT_shader_atomic_float (the M1 Honeykrisp).
//  14 BOOL Sum/Max finalize (one thread per output element): write the
//     accumulated OR bit into the packed byte with an atomicAnd/atomicOr
//     pair; the two ops touch disjoint bits, so concurrent byte writes
//     to one word commute and no write is lost.
//  15 BOOL Prod/Min finalize: same byte write with the AND bit.
// Bool storage is the packed word transport (4 bools per uint32 word,
// one byte lane each); the rank scratch stays one uint32 per element,
// so every order-sensitive accumulation runs on unpadded words.
// The monotone key maps every value to a uint32 whose unsigned order
// matches the value order, with canonical NaN above +inf (the rule the
// sort kernel uses). Integer keys use the biased two's-complement map.
// Keys are order-deterministic, so MAX and MIN are deterministic for
// every dtype.
// Index updates whose value is outside [0, dim) after negative wrap are
// skipped; upstream leaves them undefined.
// With USE_MULTI_INDEX the kernel scatters through TWO index arrays, one
// per scatter axis (upstream's multi-axis mx.scatter; the host passes one
// pre-broadcast array per axis). Binding 3 becomes the second index array
// and scratch moves to binding 4, so the dispatch needs five storage-buffer
// bindings. A slot lands only when BOTH axis indices are in range after the
// same decode rule as the single-array path; the axis-0 pair is unchanged
// (reduce_size/matrix_m) and the axis-1 dim/stride ride matrix_n/matrix_k
// with the second array's word offset in lhs_size.
// With USE_TRIPLE_INDEX a third index array joins at binding 2's sibling
// binding 4 and scratch moves to binding 5 (six bindings). The third
// axis's dim, stride, and word offset ride the never-used lhs_gap,
// rhs_gap, and out_strides[0] fields (rhs_size must stay the no-index
// flag the first axis checks). The same in-range rule guards all axes
// and the host refuses the scratch-heavy modes on three arrays when the
// device reports fewer than six storage-buffer slots.
//
// t addresses one update element: slot = t / output_size selects the
// index row, and t mod output_size is the element's position inside
// that slot's update block. updates is dense row-contiguous; its
// trailing dims (shape/in_strides) map each update element onto the
// output. USE_U32 also covers float32 (bitwise word
// copy for NONE, key mapping for MAX/MIN) and int32/uint32; aux_offset
// selects the key mapping: 0 = float32 bits, 1 = int32 biased,
// 2 = uint32 identity. aux_size carries the index word mode:
// 0 = int32, 1 = uint32, 2 = int64.
#version 460
// Hardware fp32 atomicAdd (op 11) exists only in the USE_HW_ATOMIC
// variants; the FCAS variants replace it with the op-17 compare-
// exchange add, so devices that do not advertise
// VK_EXT_shader_atomic_float (the M1 Honeykrisp) keep a correct float
// Sum path.
#if defined(USE_FADD) && defined(USE_HW_ATOMIC)
#extension GL_EXT_shader_atomic_float : require
#endif


#ifdef USE_FP16
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#elif defined(USE_BF16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define STORAGE_TYPE uint16_t
#define LOAD_VALUE(x) uintBitsToFloat(uint(x) << 16u)
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
#define STORE_VALUE(f) bf16_store(f)
#elif defined(USE_U32)
#define STORAGE_TYPE uint
#define LOAD_VALUE(x) (x)
#define STORE_VALUE(x) (x)
#elif defined(USE_BOOL)
// Bool rides the packed word transport: uint32 words, 4 bools per
// word, one byte lane each, same as the logical kernels.
#define STORAGE_TYPE uint
#define LOAD_VALUE(x) (x)
#define STORE_VALUE(x) (x)
#else
#define STORAGE_TYPE float
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#endif

// Honeykrisp miscompiles shift-then-mask byte extraction with a
// data-dependent shift amount: the masked_scatter scan undercounted
// and dropped writes until the pattern was replaced (receipt
// 2026-09-02-masked-scatter-m1-fix, diag68/diag81/diag86). Four
// constant shifts picked by a select chain are the receipt-proven
// equivalent. A macro, not a helper function: the same receipt keeps
// per-thread helper calls out of the hot path on this driver.
#define BYTE_AT(word, lane)                                                  \
  ((lane) == 0u ? ((word) & 0xFFu)                                           \
       : (lane) == 1u ? (((word) >> 8u) & 0xFFu)                             \
       : (lane) == 2u ? (((word) >> 16u) & 0xFFu)                            \
                      : (((word) >> 24u) & 0xFFu))
layout(local_size_x = 256) in;

#if defined(USE_TRIPLE_INDEX)
layout(set = 0, binding = 0, std430) buffer Output {
  STORAGE_TYPE values[];
} out_data;
layout(set = 0, binding = 1, std430) readonly buffer Updates {
  STORAGE_TYPE values[];
} upd_data;
layout(set = 0, binding = 2, std430) readonly buffer Indices {
  int values[];
} indices_data;
layout(set = 0, binding = 3, std430) readonly buffer IndicesB {
  int values[];
} indices_b_data;
layout(set = 0, binding = 4, std430) readonly buffer IndicesC {
  int values[];
} indices_c_data;
layout(set = 0, binding = 5, std430) buffer Scratch {
  uint values[];
} scratch_data;
#elif defined(USE_MULTI_INDEX)
layout(set = 0, binding = 0, std430) buffer Output {
  STORAGE_TYPE values[];
} out_data;
layout(set = 0, binding = 1, std430) readonly buffer Updates {
  STORAGE_TYPE values[];
} upd_data;
layout(set = 0, binding = 2, std430) readonly buffer Indices {
  int values[];
} indices_data;
layout(set = 0, binding = 3, std430) readonly buffer IndicesB {
  int values[];
} indices_b_data;
layout(set = 0, binding = 4, std430) buffer Scratch {
  uint values[];
} scratch_data;
#else
layout(set = 0, binding = 0, std430) buffer Output {
  STORAGE_TYPE values[];
} out_data;
layout(set = 0, binding = 1, std430) readonly buffer Updates {
  STORAGE_TYPE values[];
} upd_data;
layout(set = 0, binding = 2, std430) readonly buffer Indices {
  int values[];
} indices_data;
layout(set = 0, binding = 3, std430) buffer Scratch {
  uint values[];
} scratch_data;
#endif
#if defined(USE_FADD) && defined(USE_MULTI_INDEX)
// fp32 view of the multi-index accumulation scratch, aliased on the
// same binding as the uint rank view; ops 11-13 address it per output
// element. The uint view stays available for the op-13 compare-exchange,
// which the float-atomic extension does not provide on float storage.
layout(set = 0, binding = 4, std430) buffer ScratchF {
  float values[];
} scratch_f_data;
#elif defined(USE_FADD)
layout(set = 0, binding = 3, std430) buffer ScratchF {
  float values[];
} scratch_f_data;
#endif

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
  // Matmul-only fields on the host; the triple-index scatter borrows
  // lhs_gap (third axis dim) and rhs_gap (third axis stride).
  uint lhs_gap;
  uint rhs_gap;
} params;

#if defined(USE_U32) || defined(USE_BOOL)

uint key_of(uint raw) {
  if (params.aux_offset == 0u) {
    return (raw & 0x80000000u) != 0u ? ~raw : (raw | 0x80000000u);
  }
  if (params.aux_offset == 1u) {
    return raw ^ 0x80000000u;
  }
  return raw;
}
STORAGE_TYPE value_of_key(uint key) {
  if (params.aux_offset == 0u) {
    uint bits = (key & 0x80000000u) != 0u ? (key & 0x7FFFFFFFu) : ~key;
    return bits;
  }
  if (params.aux_offset == 1u) {
    return key ^ 0x80000000u;
  }
  return key;
}

#else

uint key_of(STORAGE_TYPE value) {
  uint bits = floatBitsToUint(LOAD_VALUE(value));
  return (bits & 0x80000000u) != 0u ? ~bits : (bits | 0x80000000u);
}

STORAGE_TYPE value_of_key(uint key) {
  uint bits = (key & 0x80000000u) != 0u ? (key & 0x7FFFFFFFu) : ~key;
  return STORE_VALUE(uintBitsToFloat(bits));
}

#endif

void main() {
  uint t = gl_GlobalInvocationID.x;
  uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  uint op = params.operation;
  while (t < params.count) {
    if (op == 4u || op == 5u || op == 8u) {
      // Finalize: one thread per output element.
      uint element = params.output_offset + t;
      uint key = scratch_data.values[element];
      if (op == 8u) {
        // Prod: multiply the copied src word by the product of every
        // update targeted here. Wrap-around integer multiply is
        // order-independent, so the result stays deterministic. The
        // host dispatches Prod only through the U32 kernel.
#ifdef USE_U32
        if (key != 1u) {
          out_data.values[element] = out_data.values[element] * key;
        }
#endif
      } else if (key != (op == 4u ? 0u : 0xFFFFFFFFu)) {
        uint current = key_of(out_data.values[element]);
        if ((op == 4u && key > current) || (op == 5u && key < current)) {
          out_data.values[element] = value_of_key(key);
        }
      }
    } else if (op == 12u) {
#ifdef USE_FADD
      // FADD Sum finalize: one thread per output element adds the fp32
      // accumulation into the copied src word, rounding once to the
      // output dtype. The output buffer already holds src from the
      // host copy, so the combine must add, not overwrite.
      uint element = params.output_offset + t;
      out_data.values[element] = STORE_VALUE(
          scratch_f_data.values[element] +
          LOAD_VALUE(out_data.values[element]));
#endif
    } else if (op == 16u) {
#ifdef USE_FADD
      // FADD Prod finalize: one thread per output element multiplies
      // the copied src by the fp32 product and stores once.
      uint element = params.output_offset + t;
      out_data.values[element] = STORE_VALUE(
          LOAD_VALUE(out_data.values[element]) *
          scratch_f_data.values[element]);
#endif
    } else if (op == 14u || op == 15u) {
#ifdef USE_BOOL
      // Bool Sum/Max (14, OR) and Prod/Min (15, AND) finalize: fold
      // the accumulated updates bit into the copied src byte. Out
      // already holds src, so op 14 sets the lane (src OR bit) with a
      // plain bit-set and op 15 masks it (src AND bit) with a
      // lane-preserving clear; sibling lanes stay untouched either way.
      uint element = params.output_offset + t;
      uint word = element >> 2u;
      uint shift = (element & 3u) * 8u;
      uint bit = scratch_data.values[element] & 1u;
      if (op == 14u) {
        atomicOr(out_data.values[word], bit << shift);
      } else {
        atomicAnd(
            out_data.values[word],
            (bit << shift) | ~(1u << shift));
      }
#endif
    } else {
      // Slot phases: t addresses one update element; slot selects the
      // index row and block is the element's offset inside the row's
      // update block.
      uint slot = t / params.output_size;
      uint block = t - slot * params.output_size;
      uint word_slot = params.aux_size == 2u ? slot + slot : slot;
      uint index = 0u;
      if (params.rhs_size == 0u) {
        uint word = uint(indices_data.values[params.rhs_offset + word_slot]);
        index = params.reduce_size;
        if (params.aux_size == 0u) {
          if (word < 0x80000000u) {
            index = word;
          }
        } else if (params.aux_size == 1u) {
          index = word;
        } else {
          uint high = uint(indices_data.values[params.rhs_offset + word_slot + 1u]);
          if (high == 0u) {
            index = word;
          }
        }
      }
      bool in_range = index < params.reduce_size;
      uint axis_b_offset = 0u;
#if defined(USE_MULTI_INDEX) || defined(USE_TRIPLE_INDEX)
      // Second axis: same decode rule against the second index array,
      // the axis dim in matrix_n, and the axis stride in matrix_k. A
      // slot lands only when both axes decode in range.
      uint index_b = params.matrix_n;
      uint word_b = uint(indices_b_data.values[params.lhs_size + word_slot]);
      if (params.aux_size == 0u) {
        if (word_b < 0x80000000u) {
          index_b = word_b;
        }
      } else if (params.aux_size == 1u) {
        index_b = word_b;
      } else {
        uint high_b =
            uint(indices_b_data.values[params.lhs_size + word_slot + 1u]);
        if (high_b == 0u) {
          index_b = word_b;
        }
      }
      in_range = in_range && index_b < params.matrix_n;
      axis_b_offset = index_b * params.matrix_k;
#ifdef USE_TRIPLE_INDEX
      // Third axis: the same decode rule against the third index
      // array; the dim, stride, and word offset ride lhs_gap, rhs_gap,
      // and out_strides[0] (see the binding notes above). A slot lands
      // only when every axis decodes in range.
      uint index_c = params.lhs_gap;
      uint word_c =
          uint(indices_c_data.values[params.out_strides[0] + word_slot]);
      if (params.aux_size == 0u) {
        if (word_c < 0x80000000u) {
          index_c = word_c;
        }
      } else if (params.aux_size == 1u) {
        index_c = word_c;
      } else {
        uint high_c = uint(
            indices_c_data.values[params.out_strides[0] + word_slot + 1u]);
        if (high_c == 0u) {
          index_c = word_c;
        }
      }
      in_range = in_range && index_c < params.lhs_gap;
      axis_b_offset += index_c * params.rhs_gap;
#endif
#endif
      if (in_range) {
        uint out_tail = 0u;
        uint scale = 1u;
        for (uint i = params.flags; i > 0u; --i) {
          uint dim = params.shape[i - 1u];
          uint j = (block / scale) % dim;
          out_tail += j * params.in_strides[i - 1u];
          scale *= dim;
        }
        uint target = params.output_offset + index * params.matrix_m +
            axis_b_offset + out_tail;
        // An update block whose trailing dims overflow the output writes
        // out of range under upstream's undefined behavior; skip instead
        // of corrupting adjacent storage. params.dims is the output
        // element count, set by the host on every dispatch.
        if (target < params.dims) {
        if (op == 0u) {
          atomicMax(scratch_data.values[target], slot + 1u);
        } else if (op == 1u) {
          if (scratch_data.values[target] == slot + 1u) {
#ifdef USE_BOOL
            // Winner writes its packed byte: clear the lane, then set
            // the canonical update bit. Commuting atomics, so two
            // winners in one word cannot lose either lane.
            uint ue = params.lhs_offset + t;
            uint ubyte =
                BYTE_AT(upd_data.values[ue >> 2u], ue & 3u);
            uint lane = (target & 3u) * 8u;
            atomicAnd(out_data.values[target >> 2u], ~(0xFFu << lane));
            atomicOr(
                out_data.values[target >> 2u],
                (ubyte != 0u ? 1u : 0u) << lane);
#else
            out_data.values[target] =
                upd_data.values[params.lhs_offset + t];
#endif
          }
        } else if (op == 2u) {
          atomicMax(
              scratch_data.values[target],
              key_of(upd_data.values[params.lhs_offset + t]));
        } else if (op == 3u) {
          atomicMin(
              scratch_data.values[target],
              key_of(upd_data.values[params.lhs_offset + t]));
#ifdef USE_U32
        } else if (op == 6u) {
          atomicAdd(
              out_data.values[target],
              upd_data.values[params.lhs_offset + t]);
        } else if (op == 7u) {
          // CAS-multiply the raw update word into the scratch slot.
          // The product is exact under any interleaving, so no
          // ordering guarantee is required beyond atomicity.
          uint mul = upd_data.values[params.lhs_offset + t];
          uint assumed = scratch_data.values[target];
          for (;;) {
            uint next = assumed * mul;
            uint prev =
                atomicCompSwap(scratch_data.values[target], assumed, next);
            if (prev == assumed) {
              break;
            }
            assumed = prev;
          }
#endif
#if defined(USE_FADD)
#if defined(USE_HW_ATOMIC)
        } else if (op == 11u) {
          // FADD Sum: hardware fp32 atomicAdd of the decoded update
          // into the fp32 per-element scratch. Duplicate indices
          // accumulate in device order; the total matches upstream
          // Metal, whose float32 scatter add is a native atomic fetch
          // add and whose float16/bfloat16 path is a packed CAS loop,
          // so reordering between runs can change the last rounding
          // bits. fp32 accumulation rounds once at the op-12 finalize,
          // at least as accurate as upstream's per-add rounding.
          atomicAdd(
              scratch_f_data.values[target],
              LOAD_VALUE(upd_data.values[params.lhs_offset + t]));
#else
        } else if (op == 17u) {
          // FCAS Sum: compare-exchange add through the uint view of
          // the fp32 scratch, the twin of op 11 for devices without
          // hardware float atomics. The CAS loop is exact under every
          // interleaving for the integer-valued addends the
          // determinism contract pins; fractional duplicates keep the
          // same reorder-tolerant total as op 11.
          uint add_bits = floatBitsToUint(
              LOAD_VALUE(upd_data.values[params.lhs_offset + t]));
          uint assumed = scratch_data.values[target];
          for (;;) {
            uint next = floatBitsToUint(
                uintBitsToFloat(assumed) + uintBitsToFloat(add_bits));
            uint prev =
                atomicCompSwap(scratch_data.values[target], assumed, next);
            if (prev == assumed) {
              break;
            }
            assumed = prev;
          }
#endif
        } else if (op == 13u) {
          // FADD Prod: CAS-multiply through the uint view of the fp32
          // scratch (the extension provides no compare-exchange on
          // float). Each step rounds in device order: the same
          // nondeterminism class as upstream Metal's float CAS
          // multiply, with fp32 partial products exact for fp16 inputs.
          uint mul_bits = floatBitsToUint(
              LOAD_VALUE(upd_data.values[params.lhs_offset + t]));
          uint assumed = scratch_data.values[target];
          for (;;) {
            uint next = floatBitsToUint(
                uintBitsToFloat(assumed) * uintBitsToFloat(mul_bits));
            uint prev =
                atomicCompSwap(scratch_data.values[target], assumed, next);
            if (prev == assumed) {
              break;
            }
            assumed = prev;
          }
#endif
#ifdef USE_BOOL
        } else if (op == 6u) {
          // Bool Sum/Max: OR the canonical update bit into the
          // per-element scratch. Saturating and associative, so
          // duplicate indices are exact regardless of order.
          uint ue6 = params.lhs_offset + t;
          atomicOr(
              scratch_data.values[target],
              BYTE_AT(upd_data.values[ue6 >> 2u], ue6 & 3u) != 0u
                  ? 1u
                  : 0u);
        } else if (op == 7u) {
          // Bool Prod/Min: AND the canonical update bit. Scratch is
          // pre-cleared to all ones; the AND bit pattern makes
          // duplicates exact.
          uint ue7 = params.lhs_offset + t;
          atomicAnd(
              scratch_data.values[target],
              BYTE_AT(upd_data.values[ue7 >> 2u], ue7 & 3u) != 0u
                  ? 1u
                  : 0u);
#endif
        }
        }
      }
    }
    if (params.count - t <= stride) {
      break;
    }
    t += stride;
  }
}
