#version 460

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer Queries {
  float16_t values[];
} query_data;
layout(set = 0, binding = 1, std430) readonly buffer Keys {
  float16_t values[];
} key_data;
layout(set = 0, binding = 2, std430) readonly buffer Values {
  float16_t values[];
} value_data;
layout(set = 0, binding = 3, std430) writeonly buffer Output {
  float16_t values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

shared float block_values[256];
shared float16_t score_values[512];

float rounded_score(uint head, uint key) {
  uint repeats = params.matrix_m / params.matrix_n;
  uint kv_head = head / repeats;
  uint q_base = params.lhs_offset + head * params.shape[0];
  uint k_base = params.rhs_offset + kv_head * params.shape[2] +
      key * params.shape[3];
  float score = 0.0;
  for (uint dim = 0u; dim < params.dims; ++dim) {
    score = fma(
        float(query_data.values[q_base + dim * params.shape[1]]),
        float(key_data.values[k_base + dim * params.in_strides[0]]),
        score);
  }
  return float(float16_t(params.alpha * score));
}

void main() {
  uint thread = gl_LocalInvocationID.x;
  uint head = gl_WorkGroupID.x;
  uint key_count = params.matrix_k;

  float local_max = uintBitsToFloat(0xff800000u);
  for (uint key = thread; key < key_count; key += 256u) {
    float next = rounded_score(head, key);
    score_values[key] = float16_t(next);
    if (isnan(next) || next > local_max) {
      local_max = next;
    }
  }
  block_values[thread] = local_max;
  barrier();
  for (uint stride = 128u; stride > 0u; stride >>= 1u) {
    if (thread < stride) {
      block_values[thread] =
          max(block_values[thread], block_values[thread + stride]);
    }
    barrier();
  }
  float row_max = block_values[0];
  barrier();

  float local_sum = 0.0;
  for (uint key = thread; key < key_count; key += 256u) {
    local_sum += exp(float(score_values[key]) - row_max);
  }
  block_values[thread] = local_sum;
  barrier();
  for (uint stride = 128u; stride > 0u; stride >>= 1u) {
    if (thread < stride) {
      block_values[thread] += block_values[thread + stride];
    }
    barrier();
  }
  float normalizer = 1.0 / block_values[0];
  barrier();

  for (uint key = thread; key < key_count; key += 256u) {
    score_values[key] = float16_t(
        exp(float(score_values[key]) - row_max) * normalizer);
  }
  barrier();

  if (thread < params.dims) {
    uint repeats = params.matrix_m / params.matrix_n;
    uint kv_head = head / repeats;
    float result = 0.0;
    for (uint key = 0u; key < key_count; ++key) {
      float probability = float(score_values[key]);
      uint value_index = params.aux_offset + kv_head * params.shape[2] +
          key * params.shape[3] + thread * params.in_strides[0];
      result = fma(
          probability, float(value_data.values[value_index]), result);
    }
    output_data.values[params.output_offset + head * params.dims + thread] =
        float16_t(result);
  }
}
