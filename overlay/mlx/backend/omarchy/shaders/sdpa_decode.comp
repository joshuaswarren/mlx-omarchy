//
// Decode attention (q_len <= 8) over float16 storage, flash-decoding
// style: one workgroup per (batch, q head, query row, 256-key block).
// The block's 256 lanes each own one key: score = scale * q.k in float,
// mask, block max and exp-sum through shared-memory trees, then the
// lanes regroup as (key split, output dim) to accumulate probs @ v.
// Scores and probs never round to float16 (the composed
// matmul -> softmax -> matmul path stores both in float16), so this is
// the closer path to the float32 reference; only the output rounds.
//
// Without PARTIAL the kernel covers k_len <= 256 and writes the
// normalized float16 output itself (one dispatch). With PARTIAL each
// block writes (o[v_dim], max, sum) to a float scratch buffer and
// sdpa_decode_combine.comp merges the blocks of a row.
//
// Masks: causal positions and additive mask values at or below the
// float16 minimum (-65504, what fast.cpp writes for a false bool mask)
// become -1e30, the composed f32 path's floor: they take exactly zero
// weight against any attended key, and a fully masked row softmaxes to
// the uniform average like the composed paths. Other additive values
// add in float.

#version 460
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#ifdef USE_SUBGROUP
// One subgroupMax / subgroupAdd per subgroup, then a shared pass over
// the gl_NumSubgroups partials: five barriers per workgroup instead of
// eighteen. The host picks this variant when the device reports
// subgroup arithmetic.
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#endif

const uint THREADS = 256u;
const uint MAX_HEAD_DIM = 256u;
const uint MAX_SPLITS = 4u;
const float MASK_FLOOR = -1e30;

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer Query {
  float16_t values[];
} query_data;
// Keys load four halves at a time: the host only takes this path when
// head_dim and every key element offset are multiples of four.
layout(set = 0, binding = 1, std430) readonly buffer Key {
  f16vec4 values[];
} key_data;
layout(set = 0, binding = 2, std430) readonly buffer Value {
  float16_t values[];
} value_data;
layout(set = 0, binding = 3, std430) readonly buffer Mask {
  float16_t values[];
} mask_data;
#ifdef PARTIAL
// [P * v_dim] block outputs, then [P * 2] (max, sum) pairs; P = the
// dispatch's workgroup count.
layout(set = 0, binding = 4, std430) writeonly buffer Partial {
  float values[];
} partial_data;
#else
layout(set = 0, binding = 4, std430) writeonly buffer Output {
  float16_t values[];
} output_data;
#endif

// Same 128-byte layout as ComputeParams; the names are this kernel's
// roles for each slot (host mapping in ScaledDotProductAttention::eval_gpu).
layout(push_constant) uniform Params {
  uint v_dim; // count
  uint operation; // 1 = causal, 2 = additive array mask
  uint mask_stride_b; // lhs_size
  uint mask_stride_h; // rhs_size
  uint k_len; // reduce_size
  uint mask_stride_q; // output_size
  uint q_offset; // lhs_offset
  uint k_offset; // rhs_offset
  uint out_offset; // output_offset
  uint mask_stride_k; // aux_size
  uint v_offset; // aux_offset
  uint q_len; // matrix_m
  uint repeats; // matrix_n
  uint head_dim; // matrix_k
  uint mask_offset; // flags
  float scale; // alpha
  float beta;
  uint kv_heads; // dims
  uint k_strides[4]; // shape: batch, kv head, key row
  uint q_strides[4]; // in_strides: batch, head, query row
  uint v_strides[4]; // out_strides: batch, kv head, key row
  uint n_blocks; // lhs_gap
  uint rhs_gap;
} params;

shared float q_row[MAX_HEAD_DIM];
shared float reduce[THREADS];
shared float probs[THREADS];
shared float o_part[MAX_SPLITS][MAX_HEAD_DIM];

void main() {
  uint t = gl_LocalInvocationID.x;
  uint group = gl_WorkGroupID.x;
  uint row = group / params.n_blocks;
  uint block = group - row * params.n_blocks;
  uint heads = params.kv_heads * params.repeats;
  uint qi = row % params.q_len;
  uint bh = row / params.q_len;
  uint head = bh % heads;
  uint batch = bh / heads;
  uint kv_head = head / params.repeats;

  if (t < params.head_dim) {
    q_row[t] = float(query_data.values
                         [params.q_offset + batch * params.q_strides[0] +
                          head * params.q_strides[1] +
                          qi * params.q_strides[2] + t]);
  }
  barrier();

  uint key = block * THREADS + t;
  bool valid = key < params.k_len;
  float score = uintBitsToFloat(0xff800000u);
  if (valid) {
    uint k_index = (params.k_offset + batch * params.k_strides[0] +
                    kv_head * params.k_strides[1] +
                    key * params.k_strides[2]) /
        4u;
    float acc = 0.0;
    for (uint d = 0u; d < params.head_dim; d += 4u) {
      vec4 keys = vec4(key_data.values[k_index + d / 4u]);
      acc += q_row[d] * keys.x;
      acc += q_row[d + 1u] * keys.y;
      acc += q_row[d + 2u] * keys.z;
      acc += q_row[d + 3u] * keys.w;
    }
    score = params.scale * acc;
    if ((params.operation & 1u) != 0u) {
      if (int(params.k_len) - int(params.q_len) + int(qi) < int(key)) {
        score = MASK_FLOOR;
      }
    } else if ((params.operation & 2u) != 0u) {
      float mask = float(mask_data.values
                             [params.mask_offset +
                              batch * params.mask_stride_b +
                              head * params.mask_stride_h +
                              qi * params.mask_stride_q +
                              key * params.mask_stride_k]);
      score = mask <= -65504.0 ? MASK_FLOOR : score + mask;
    }
  }

#ifdef USE_SUBGROUP
  float subgroup_max = subgroupMax(score);
  if (subgroupElect()) {
    reduce[gl_SubgroupID] = subgroup_max;
  }
  barrier();
  float block_max = reduce[0];
  for (uint i = 1u; i < gl_NumSubgroups; ++i) {
    block_max = max(block_max, reduce[i]);
  }
  barrier();

  float prob = valid ? exp(score - block_max) : 0.0;
  probs[t] = prob;
  float subgroup_sum = subgroupAdd(prob);
  if (subgroupElect()) {
    reduce[gl_SubgroupID] = subgroup_sum;
  }
  barrier();
  float block_sum = 0.0;
  for (uint i = 0u; i < gl_NumSubgroups; ++i) {
    block_sum += reduce[i];
  }
#else
  reduce[t] = score;
  barrier();
  for (uint stride = THREADS / 2u; stride > 0u; stride >>= 1u) {
    if (t < stride) {
      reduce[t] = max(reduce[t], reduce[t + stride]);
    }
    barrier();
  }
  float block_max = reduce[0];
  barrier();

  float prob = valid ? exp(score - block_max) : 0.0;
  probs[t] = prob;
  reduce[t] = prob;
  barrier();
  for (uint stride = THREADS / 2u; stride > 0u; stride >>= 1u) {
    if (t < stride) {
      reduce[t] += reduce[t + stride];
    }
    barrier();
  }
  float block_sum = reduce[0];
#endif

  // probs @ v: `splits` lane groups each take a run of the block's
  // keys for every output dim, then the runs add in shared memory.
  uint block_len = min(THREADS, params.k_len - block * THREADS);
  uint splits = min(MAX_SPLITS, THREADS / params.v_dim);
  uint split = t / params.v_dim;
  uint dim = t - split * params.v_dim;
  if (split < splits) {
    uint per_split = (block_len + splits - 1u) / splits;
    uint first = split * per_split;
    uint last = min(block_len, first + per_split);
    uint v_index = params.v_offset + batch * params.v_strides[0] +
        kv_head * params.v_strides[1] +
        (block * THREADS + first) * params.v_strides[2] + dim;
    float acc = 0.0;
    for (uint j = first; j < last; ++j) {
      acc += probs[j] * float(value_data.values[v_index]);
      v_index += params.v_strides[2];
    }
    o_part[split][dim] = acc;
  }
  barrier();
  if (t < params.v_dim) {
    float o = 0.0;
    for (uint s = 0u; s < splits; ++s) {
      o += o_part[s][t];
    }
#ifdef PARTIAL
    partial_data.values[group * params.v_dim + t] = o;
    if (t == 0u) {
      uint stats = gl_NumWorkGroups.x * params.v_dim + group * 2u;
      partial_data.values[stats] = block_max;
      partial_data.values[stats + 1u] = block_sum;
    }
#else
    output_data.values[params.out_offset + row * params.v_dim + t] =
        float16_t(o / block_sum);
#endif
  }
}
