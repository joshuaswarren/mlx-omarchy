//
// Gathered affine quantized matmul (GatherQMM, GatherQQMM, and the
// quantized-weight QQMatmul path). One thread owns one output element:
// out[b, m, n] contracts the x row (lhs[b], m, :) with the dequantized
// packed-w row (rhs[b], n, :), where packed uint32 words hold 32/bits
// quantized values along K in the low bits first and each group of
// group_size elements shares one scale (and one bias unless NO_BIAS).
// Binding 1 is a raw uint32 word buffer packing [all scale bytes |
// (all bias bytes) | all lhs index words | all rhs index words]; the
// scale/bias bytes arrive in the output dtype and are decoded from the
// words (PARAM_F32 bitcast, PARAM_FP16 half unpack, PARAM_BF16 word
// shift), so no sub-32-bit storage reads exist anywhere. Binding 0/3
// carry the float activations/output in the dtype storage.
//
// Push-constant routing: operation carries bits, reduce_size the group
// size, shape[0] the per-half index count S, in_strides[0]/out_strides[0]
// the lhs/rhs word offsets inside the packed buffer.
// Every load is a straight-line per-thread word or element read at a
// linear address inside uniform-trip-count loops (Honeykrisp caution:
// no per-lane divergent word loads, no broadcast-unravel addressing).

#version 460

#if defined(USE_FP16) || defined(USE_BF16)
#extension GL_EXT_shader_16bit_storage : require
#endif
#ifdef USE_FP16
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#elif defined(USE_BF16)
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define STORAGE_TYPE uint16_t
#define LOAD_VALUE(x) uintBitsToFloat(uint(x) << 16u)
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
#define STORE_VALUE(f) bf16_store(f)
#else
#define STORAGE_TYPE float
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#endif

#if defined(USE_FP16) || defined(USE_BF16)
#define PARAM_BYTES 2u
#else
#define PARAM_BYTES 4u
#endif

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer InputX {
  STORAGE_TYPE values[];
} input_x;
layout(set = 0, binding = 1, std430) readonly buffer PackedParams {
  uint values[];
} packed_params;
layout(set = 0, binding = 2, std430) readonly buffer InputW {
  uint values[];
} input_w;
layout(set = 0, binding = 3, std430) writeonly buffer Output {
  STORAGE_TYPE values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

// Decode one group parameter stored at byte_offset in the packed word
// buffer, in the output dtype.
float decode_param(uint byte_offset) {
  uint word = packed_params.values[params.aux_offset + byte_offset / 4u];
#if defined(USE_FP16)
  uint half_index = byte_offset / 2u;
  uint shifted = (half_index & 1u) == 0u ? word : word >> 16u;
  return unpackHalf2x16(shifted).x;
#elif defined(USE_BF16)
  uint half_index = byte_offset / 2u;
  uint bits = (half_index & 1u) == 0u ? word << 16u : word & 0xffff0000u;
  return uintBitsToFloat(bits);
#else
  return uintBitsToFloat(word);
#endif
}

void main() {
  uint bits = params.operation;
  uint group_size = params.reduce_size;
  uint pack_factor = 32u / bits;
  uint value_mask = (1u << bits) - 1u;
  uint words_per_row = params.matrix_k / pack_factor;
  uint groups_per_row = params.matrix_k / group_size;
  uint matrix = params.matrix_m * params.matrix_n;
  uint param_bytes = PARAM_BYTES;
  uint w_row_words = params.matrix_n * words_per_row;
  uint scale_row_words = params.matrix_n * groups_per_row;
  uint index_count = params.shape[0];
  uint lhs_word_base = params.in_strides[0];
  uint rhs_word_base = params.out_strides[0];
  uint total = index_count * matrix;
  uint stride = gl_NumWorkGroups.x * 256u;

  for (uint index = gl_GlobalInvocationID.x; index < total;
       index += stride) {
    uint batch = index / matrix;
    uint within = index - batch * matrix;
    uint row = within / params.matrix_n;
    uint column = within - row * params.matrix_n;
    uint lhs = packed_params.values[params.aux_offset + lhs_word_base +
        batch];
    uint rhs = packed_params.values[params.aux_offset + rhs_word_base +
        batch];
    uint x_base = params.lhs_offset +
        lhs * (params.matrix_m * params.matrix_k) +
        row * params.matrix_k;
    uint w_base = params.rhs_offset + rhs * w_row_words +
        column * words_per_row;
    uint scale_base = rhs * scale_row_words + column * groups_per_row;
    // Flat k loop with every index derived from k. A nested group/word/
    // lane structure carrying a word_base induction variable miscompiles
    // on older Lavapipe (Mesa 22.3): the accumulated word offset pairs x
    // columns with the wrong packed words from the third word of a group
    // on, silently, for sub-byte codes. Derived indices keep the compiled
    // form straight-line and identical math everywhere.
    float accumulator = 0.0;
    for (uint k = 0u; k < params.matrix_k; ++k) {
      uint group = k / group_size;
      uint word = input_w.values[w_base + k / pack_factor];
      uint lane = k - (k / pack_factor) * pack_factor;
      // bitfieldExtract compiles to OpBitFieldUExtract; the equivalent
      // shift+mask misdecodes lanes 1..2 (reading the next lane's nibble,
      // lane 0 reading zero) on llvmpipe Mesa 22.3 when the lane comes
      // from a division-derived index.
      uint q = bitfieldExtract(word, int(lane * bits), int(bits));
      float scale = decode_param(scale_base * param_bytes +
          group * param_bytes);
      float bias = 0.0;
#ifndef NO_BIAS
      // shape[1] is the byte base of the bias region inside the packed
      // buffer, placed after the whole scales region.
      bias = decode_param(params.shape[1] + scale_base * param_bytes +
          group * param_bytes);
#endif
      float x_value = LOAD_VALUE(input_x.values[x_base + k]);
      accumulator += x_value * (scale * float(q) + bias);
    }
    output_data.values[params.output_offset + index] =
        STORE_VALUE(accumulator);
  }
}
