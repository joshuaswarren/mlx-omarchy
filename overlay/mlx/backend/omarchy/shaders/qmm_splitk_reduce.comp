#version 460
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Reduces the QmmPrefillCoopmatSplitKF16 f32 partial planes into the f16
// output: output[i] = round_f16(sum over s of partial[s * count + i]),
// accumulated in ascending split order with one final rounding. count
// covers all batch*m*n outputs, matching the qmm push-constant count.

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer Partial {
  float values[];
} partial_data;
layout(set = 0, binding = 1, std430) writeonly buffer Output {
  float16_t values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

void main() {
  uint stride = gl_NumWorkGroups.x * 256u;
  for (uint i = gl_GlobalInvocationID.x; i < params.count; i += stride) {
    float acc = partial_data.values[i];
    for (uint s = 1u; s < params.shape[0]; ++s) {
      acc += partial_data.values[s * params.count + i];
    }
    output_data.values[params.output_offset + i] = float16_t(acc);
  }
}
