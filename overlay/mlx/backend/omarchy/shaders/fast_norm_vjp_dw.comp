//
// Weight-gradient (dw) partial kernel for RMSNorm/LayerNorm backward,
// stage 1 of 2. Matches the reduction in RMSNorm::vjp and LayerNorm::vjp
// (mlx/fast.cpp):
//
//   RMS:   dw = sum_rows(g * x * n_row),  n_row = rsqrt(mean(x^2) + eps)
//   Layer: dw = sum_rows(g * (x - mu_row) * n_row)
//
// One workgroup owns one row (the same shape as the dx kernel): it reduces
// the row statistics in shared memory and scatters this row's per-column
// contribution into partial[row * row_length + column]. The column sum
// across rows runs in shaders/fast_norm_vjp_dw_reduce.comp.
//
// History: an earlier revision kept one workgroup for the entire output and
// accumulated column tiles in registers across a rows*tiles barrier nest.
// Past roughly a thousand row iterations, llvmpipe stops honoring the
// workgroup barriers and the row statistics corrupt (NaN dw for 8x100x1024
// and larger). Row-per-workgroup keeps the per-workgroup barrier count at a
// constant dozen, proven at 8x100x8192.
// ponytail: the partial buffer costs rows * row_length floats; split-fuse
// the two kernels if dw shows up in a training profile with huge row counts.

#version 460

#ifdef USE_FP16
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
#define LOAD_VALUE(x) float(x)
#elif defined(USE_BF16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define STORAGE_TYPE uint16_t
#define LOAD_VALUE(x) uintBitsToFloat(uint(x) << 16u)
#else
#define STORAGE_TYPE float
#define LOAD_VALUE(x) float(x)
#endif

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer Input {
  STORAGE_TYPE values[];
} input_data;
layout(set = 0, binding = 1, std430) readonly buffer Grad {
  STORAGE_TYPE values[];
} grad_data;
layout(set = 0, binding = 2, std430) writeonly buffer Partial {
  float values[];
} partial_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  // Batch routing fields must stay declared even when unused: the encoder
  // pushes sizeof(ComputeParams), so the block has to match its full size.
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

shared float block_values[256];

void main() {
  uint thread = gl_LocalInvocationID.x;
  uint row_length = params.reduce_size;
  float eps = params.alpha;
  uint threads = 256u;

  for (uint row = gl_WorkGroupID.x; row < params.output_size;
       row += gl_NumWorkGroups.x) {
    uint start = params.lhs_offset + row * row_length;
    uint grad_start = params.rhs_offset + row * row_length;

#ifdef LAYER_NORM
    float local_sum = 0.0;
    for (uint index = thread; index < row_length; index += threads) {
      local_sum += LOAD_VALUE(input_data.values[start + index]);
    }
    block_values[thread] = local_sum;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
      if (thread < stride) {
        block_values[thread] += block_values[thread + stride];
      }
      barrier();
    }
    float mu = block_values[0] / float(row_length);
    barrier();
#endif

    float local_sq = 0.0;
    for (uint index = thread; index < row_length; index += threads) {
      float value = LOAD_VALUE(input_data.values[start + index]);
      local_sq += value * value;
    }
    block_values[thread] = local_sq;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
      if (thread < stride) {
        block_values[thread] += block_values[thread + stride];
      }
      barrier();
    }
    float mean_square = block_values[0] / float(row_length);
    barrier();
#ifdef LAYER_NORM
    float variance = mean_square - mu * mu;
#else
    float variance = mean_square;
#endif
    float norm = inversesqrt(variance + eps);

    // No barriers in this phase: each thread writes only its own columns
    // of this row's partial slot.
    for (uint column = thread; column < row_length; column += threads) {
      float value = LOAD_VALUE(input_data.values[start + column]);
      float grad = LOAD_VALUE(grad_data.values[grad_start + column]);
#ifdef LAYER_NORM
      float contribution = grad * (value - mu) * norm;
#else
      float contribution = grad * value * norm;
#endif
      partial_data.values[params.output_offset + row * row_length + column] =
          contribution;
    }
    barrier();
  }
}
