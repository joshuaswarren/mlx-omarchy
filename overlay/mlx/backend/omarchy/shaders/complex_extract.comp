// Complex64 component extraction and magnitude. Operation 0 takes the
// real part, 1 the imaginary part, 2 the magnitude |z| with
// overflow-safe scaling. Operations 0 and 1 mirror the upstream
// real()/imag() semantics on a complex64 array
// (mlx/backend/cpu/unary.cpp routes both through
// unary_complex_to_float); operation 2 mirrors cabsf / std::abs so
// upstream allclose can take the absolute value of a complex64
// difference. The op layer only constructs the primitives for
// complex64 input, real input short-circuits before a backend is
// reached.

#version 460

layout(local_size_x = 256) in;
layout(set = 0, binding = 0, std430) readonly buffer InComplex {
  vec2 values[];
} input_data;
#ifdef ABS_AS_COMPLEX
layout(set = 0, binding = 2, std430) writeonly buffer Output {
  vec2 values[];
} output_data;
#else
layout(set = 0, binding = 2, std430) writeonly buffer Output {
  float values[];
} output_data;
#endif

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
} params;

void main() {
  uint index = gl_GlobalInvocationID.x;
  uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  while (index < params.count) {
    vec2 value_in = input_data.values[params.lhs_offset + index];
    float result;
    if (params.operation == 2u) {
      // |z| = hypot(re, im) with overflow-safe scaling: scale by the
      // larger absolute component so the inner sum stays in normal
      // range, then fold the scale back. Matches the cabsf / std::abs
      // contract on normal inputs; the GLSL length() builtin uses
      // sqrt(x*x + y*y), which overflows when both |x| and |y| exceed
      // ~1.8e19 in float32.
      float re = abs(value_in.x);
      float im = abs(value_in.y);
      float mx = max(re, im);
      float mn = min(re, im);
      if (mx == 0.0) {
        result = 0.0;
      } else {
        float r = mn / mx;
        result = mx * sqrt(1.0 + r * r);
      }
    } else {
      result = params.operation == 0u ? value_in.x : value_in.y;
    }
    // The float-output variant (operations 0/1 and the standalone
    // ComplexAbs) writes one scalar per element; the vec2-output
    // variant (ABS_AS_COMPLEX for Abs::eval_gpu's intermediate
    // complex64 buffer) stores the magnitude in .x and 0 in .y so
    // the downstream Cast(complex64 -> float32) just reads real().
    #ifdef ABS_AS_COMPLEX
    output_data.values[params.output_offset + index] = vec2(result, 0.0);
    #else
    output_data.values[params.output_offset + index] = result;
    #endif
    if (params.count - index <= stride) {
      break;
    }
    index += stride;
  }
}
