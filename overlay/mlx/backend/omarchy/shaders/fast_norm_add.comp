//
// Fused residual Add + RMSNorm forward prologue: one workgroup computes the
// elementwise sum, writes it exactly as the standalone Add kernel does, and
// normalizes that same sum with the fast_norm.comp reduction (identical
// thread striding, shared-memory tree, and arithmetic order), replacing two
// dispatches with one. Every arithmetic step runs in float32; the sum is
// rounded to the storage dtype before squaring so the folded path reads the
// same bytes the per-node path would have written.
//
//   sum[i] = round(a[i] + b[i])
//   n = inversesqrt(mean(sum^2) + eps);  y[i] = sum[i] * n * w[i]
//
// eps arrives in params.alpha. params.matrix_m carries the normalized
// output offset; params.aux_size is the weight element count (1 broadcasts).

#version 460

#ifdef USE_FP16
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
// The float16_t round trip failed M1 equality; integer packing preserves
// the required intermediate rounding (see fused_chain.comp).
#define ROUND_INTERMEDIATE(f) (unpackHalf2x16(packHalf2x16(vec2(f, 0.0))).x)
#else
#define STORAGE_TYPE float
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#define ROUND_INTERMEDIATE(f) (f)
#endif

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer Lhs {
  STORAGE_TYPE values[];
} lhs_data;
layout(set = 0, binding = 1, std430) readonly buffer Weight {
  STORAGE_TYPE values[];
} weight_data;
layout(set = 0, binding = 2, std430) readonly buffer Rhs {
  STORAGE_TYPE values[];
} rhs_data;
layout(set = 0, binding = 3, std430) writeonly buffer Sum {
  STORAGE_TYPE values[];
} sum_data;
layout(set = 0, binding = 4, std430) writeonly buffer Normalized {
  STORAGE_TYPE values[];
} normalized_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
} params;

shared float block_values[256];

void main() {
  uint thread = gl_LocalInvocationID.x;
  uint row_length = params.reduce_size;
  float eps = params.alpha;
  uint threads = 256u;

  for (uint row = gl_WorkGroupID.x; row < params.output_size;
       row += gl_NumWorkGroups.x) {
    uint start = params.lhs_offset + row * row_length;
    uint addend_start = params.aux_offset + row * row_length;

    float local_sq = 0.0;
    for (uint index = thread; index < row_length; index += threads) {
      float sum = ROUND_INTERMEDIATE(
          LOAD_VALUE(lhs_data.values[start + index]) +
          LOAD_VALUE(rhs_data.values[addend_start + index]));
      sum_data.values[params.output_offset + row * row_length + index] =
          STORE_VALUE(sum);
      local_sq += sum * sum;
    }
    block_values[thread] = local_sq;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
      if (thread < stride) {
        block_values[thread] += block_values[thread + stride];
      }
      barrier();
    }
    float mean_square = block_values[0] / float(row_length);
    barrier();
    float norm = inversesqrt(mean_square + eps);

    for (uint index = thread; index < row_length; index += threads) {
      float sum = ROUND_INTERMEDIATE(
          LOAD_VALUE(lhs_data.values[start + index]) +
          LOAD_VALUE(rhs_data.values[addend_start + index]));
      float weight =
          (params.aux_size == 1u)
              ? LOAD_VALUE(weight_data.values[params.rhs_offset])
              : LOAD_VALUE(weight_data.values[params.rhs_offset + index]);
      float result = sum * norm * weight;
      normalized_data.values[params.matrix_m + row * row_length + index] =
          STORE_VALUE(result);
    }
    barrier();
  }
}
