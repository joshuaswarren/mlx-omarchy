//
// Fill a uint32 buffer region with one value. Scatter uses it to zero
// rank scratch or write atomicMin/Max sentinels; the wide-row selection
// uses it to zero histograms and to write the initial selection state.

#version 460

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) buffer Output {
  uint values[];
} out_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

void main() {
  uint t = gl_GlobalInvocationID.x;
  uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  while (t < params.count) {
    out_data.values[params.output_offset + t] = params.operation;
    if (params.count - t <= stride) {
      break;
    }
    t += stride;
  }
}
