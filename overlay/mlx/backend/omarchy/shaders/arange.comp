#version 460

#if defined(USE_I64) || defined(USE_U64)
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#endif
#if defined(USE_I32) || defined(USE_U32)
#define STORAGE_TYPE uint
#define STORE_VALUE(value) (value)
#define USE_I32_MATH 1
#elif defined(USE_I64) || defined(USE_U64)
#define STORAGE_TYPE uint64_t
#define STORE_VALUE(value) (value)
#define USE_I64_MATH 1
#elif defined(USE_FP16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
#define STORE_VALUE(value) STORAGE_TYPE(value)
#elif defined(USE_BF16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define STORAGE_TYPE uint16_t
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
#define STORE_VALUE(value) bf16_store(value)
#else
#define STORAGE_TYPE float
#define STORE_VALUE(value) STORAGE_TYPE(value)
#endif

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) writeonly buffer Output {
  STORAGE_TYPE values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
} params;

void main() {
  uint index = gl_GlobalInvocationID.x;
  uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  while (index < params.count) {
#if defined(USE_I32_MATH)
    uint value = params.lhs_size + index * params.reduce_size;
#elif defined(USE_I64_MATH)
    uint64_t start =
        uint64_t(params.lhs_size) | (uint64_t(params.rhs_size) << 32u);
    uint64_t step =
        uint64_t(params.reduce_size) | (uint64_t(params.aux_size) << 32u);
    uint64_t value = start + uint64_t(index) * step;
#else
    float value = params.alpha + params.beta * float(index);
#endif
    output_data.values[params.output_offset + index] = STORE_VALUE(value);
    if (params.count - index <= stride) {
      break;
    }
    index += stride;
  }
}
