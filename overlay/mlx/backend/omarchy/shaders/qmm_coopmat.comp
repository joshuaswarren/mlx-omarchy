#version 460
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Prefill Q4/group-64 f16 matmul on the G13 8x8x8 fp32 subgroup
// cooperative matrix. A 64-lane workgroup owns a 32x32 output tile;
// each subgroup owns a 16x32 half. It stages 16 k values at a time,
// dequantizes each 16x32 weight tile once into shared f32, and reuses it
// across all 32 rows. The two ascending 8-wide coopmat updates preserve
// the previous kernel's per-output accumulation order and output ids.
// The dispatch gate requires cooperative_matrix_f32_8, subgroup size 32,
// f16 output, transposed affine 4-bit/group-64, even x/output offsets,
// enough shared memory, and !MLX_OMARCHY_NO_COOPMAT.

const uint TILE_M = 32u;
const uint TILE_N = 32u;
const uint CHUNK_K = 64u;
const uint STEP_K = 16u;
const uint MAT = 8u;

layout(local_size_x = 64) in;

layout(set = 0, binding = 0, std430) readonly buffer InputX {
  uint values[];
} input_x;
layout(set = 0, binding = 1, std430) readonly buffer InputW {
  uint values[];
} input_w;
layout(set = 0, binding = 2, std430) readonly buffer Scales {
  float16_t values[];
} scales;
layout(set = 0, binding = 3, std430) readonly buffer Biases {
  float16_t values[];
} biases;
layout(set = 0, binding = 4, std430) writeonly buffer Output {
  float16_t values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

// 4 KiB shared: one 32x16 x tile and one 16x32 f32 weight tile.
shared float x_s[TILE_M * STEP_K];
shared float w_s[STEP_K * TILE_N];

void main() {
  uint lid = gl_LocalInvocationID.x;
  uint sub = gl_SubgroupID;
  uint sub_rb = 2u * sub;
  uint batch = params.shape[0];
  uint w_batch_words = params.shape[1];
  uint param_batch = params.shape[2];
  uint x_batch_rows = params.matrix_m * params.matrix_k;
  uint m_tiles = (params.matrix_m + TILE_M - 1u) / TILE_M;
  uint n_tiles = (params.matrix_n + TILE_N - 1u) / TILE_N;
  uint k_chunks = params.matrix_k / CHUNK_K;
  uint words_per_row = params.matrix_k / 8u;
  uint groups_per_row = params.matrix_k / 64u;
  uint x_words_per_row = params.matrix_k / 2u;
  uint w_column_local = lid % 32u;
  uint w_part = lid / 32u;
  uint w_base = 8u * w_part * TILE_N + w_column_local;

  for (uint b = 0u; b < batch; ++b) {
  uint w_slice = params.rhs_offset + b * w_batch_words;
  uint scale_slice = params.aux_offset + b * param_batch;
  uint bias_slice = params.aux_size + b * param_batch;
  uint x_slice = (params.lhs_offset + b * x_batch_rows) / 2u;
  uint out_slice = params.output_offset +
      b * params.matrix_m * params.matrix_n;
  for (uint tile_row = gl_WorkGroupID.y; tile_row < m_tiles;
       tile_row += gl_NumWorkGroups.y) {
    uint row_base = tile_row * TILE_M;
    uint x_lane = lid & 7u;
    uint x_local_row = lid >> 3u;
    uint x_row0 = row_base + x_local_row;
    uint x_row1 = x_row0 + 8u;
    uint x_row2 = x_row0 + 16u;
    uint x_row3 = x_row0 + 24u;
    uint x_address0 = x_slice + x_row0 * x_words_per_row + x_lane;
    uint x_address1 = x_slice + x_row1 * x_words_per_row + x_lane;
    uint x_address2 = x_slice + x_row2 * x_words_per_row + x_lane;
    uint x_address3 = x_slice + x_row3 * x_words_per_row + x_lane;
    uint x_local0 = x_local_row * STEP_K + 2u * x_lane;
    for (uint tile_col = gl_WorkGroupID.x; tile_col < n_tiles;
         tile_col += gl_NumWorkGroups.x) {
      uint column = tile_col * TILE_N + w_column_local;
      bool column_ok = column < params.matrix_n;
      uint w_row = w_slice + column * words_per_row;
      uint scale_row = scale_slice + column * groups_per_row;
      uint bias_row = bias_slice + column * groups_per_row;

      coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseAccumulator>
          acc[2][4];
      for (uint rb = 0u; rb < 2u; ++rb) {
        for (uint cb = 0u; cb < 4u; ++cb) {
          acc[rb][cb] = coopmat<float, gl_ScopeSubgroup, MAT, MAT,
              gl_MatrixUseAccumulator>(0.0);
        }
      }

      for (uint chunk = 0u; chunk < k_chunks; ++chunk) {
        float scale = 0.0;
        float bias = 0.0;
        if (column_ok) {
          scale = float(scales.values[scale_row + chunk]);
          bias = float(biases.values[bias_row + chunk]);
        }
        for (uint step = 0u; step < CHUNK_K / STEP_K; ++step) {
          uint k_base = chunk * CHUNK_K + step * STEP_K;
          uint x_k_word = k_base / 2u;
          // Four half2 loads per lane cover the 32x16 x tile.
          uint x_word0 = x_row0 < params.matrix_m
              ? input_x.values[x_address0 + x_k_word] : 0u;
          uint x_word1 = x_row1 < params.matrix_m
              ? input_x.values[x_address1 + x_k_word] : 0u;
          uint x_word2 = x_row2 < params.matrix_m
              ? input_x.values[x_address2 + x_k_word] : 0u;
          uint x_word3 = x_row3 < params.matrix_m
              ? input_x.values[x_address3 + x_k_word] : 0u;
          vec2 pair0 = unpackHalf2x16(x_word0);
          vec2 pair1 = unpackHalf2x16(x_word1);
          vec2 pair2 = unpackHalf2x16(x_word2);
          vec2 pair3 = unpackHalf2x16(x_word3);
          x_s[x_local0] = pair0.x;
          x_s[x_local0 + 1u] = pair0.y;
          x_s[x_local0 + 8u * STEP_K] = pair1.x;
          x_s[x_local0 + 8u * STEP_K + 1u] = pair1.y;
          x_s[x_local0 + 16u * STEP_K] = pair2.x;
          x_s[x_local0 + 16u * STEP_K + 1u] = pair2.y;
          x_s[x_local0 + 24u * STEP_K] = pair3.x;
          x_s[x_local0 + 24u * STEP_K + 1u] = pair3.y;
          // One packed word per lane covers the 16x32 weight tile.
          uint packed = column_ok
              ? input_w.values[w_row + k_base / 8u + w_part] : 0u;
          w_s[w_base + 0u * TILE_N] = scale * float(packed & 0xFu) + bias;
          w_s[w_base + 1u * TILE_N] =
              scale * float((packed >> 4u) & 0xFu) + bias;
          w_s[w_base + 2u * TILE_N] =
              scale * float((packed >> 8u) & 0xFu) + bias;
          w_s[w_base + 3u * TILE_N] =
              scale * float((packed >> 12u) & 0xFu) + bias;
          w_s[w_base + 4u * TILE_N] =
              scale * float((packed >> 16u) & 0xFu) + bias;
          w_s[w_base + 5u * TILE_N] =
              scale * float((packed >> 20u) & 0xFu) + bias;
          w_s[w_base + 6u * TILE_N] =
              scale * float((packed >> 24u) & 0xFu) + bias;
          w_s[w_base + 7u * TILE_N] = scale * float(packed >> 28u) + bias;
          barrier();

          for (uint ks = 0u; ks < STEP_K / MAT; ++ks) {
            coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseA> mat_a[2];
            coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseB> mat_b[4];
            for (uint rb = 0u; rb < 2u; ++rb) {
              coopMatLoad(
                  mat_a[rb], x_s,
                  (sub_rb + rb) * MAT * STEP_K + ks * MAT, STEP_K,
                  gl_CooperativeMatrixLayoutRowMajor);
            }
            for (uint cb = 0u; cb < 4u; ++cb) {
              coopMatLoad(
                  mat_b[cb], w_s, ks * MAT * TILE_N + cb * MAT, TILE_N,
                  gl_CooperativeMatrixLayoutRowMajor);
            }
            for (uint rb = 0u; rb < 2u; ++rb) {
              for (uint cb = 0u; cb < 4u; ++cb) {
                acc[rb][cb] =
                    coopMatMulAdd(mat_a[rb], mat_b[cb], acc[rb][cb]);
              }
            }
          }
          barrier();
        }
      }

      // One subgroup stores each 16-row half; duplicated column lanes
      // each drain their four distinct rows of the selected 8-row block.
      for (uint rb = 0u; rb < 4u; ++rb) {
        if (sub_rb == (rb & ~1u)) {
          for (uint cb = 0u; cb < 4u; ++cb) {
            coopMatStore(
                acc[rb & 1u][cb], x_s, cb * MAT * MAT, MAT,
                gl_CooperativeMatrixLayoutRowMajor);
          }
        }
        barrier();
        if (column_ok) {
          for (uint pass = 0u; pass < 4u; ++pass) {
            uint r = 4u * w_part + pass;
            uint row = row_base + rb * MAT + r;
            if (row < params.matrix_m) {
              output_data.values[out_slice + row * params.matrix_n + column] =
                  float16_t(x_s[(w_column_local / 8u) * MAT * MAT +
                                r * MAT + (w_column_local % 8u)]);
            }
          }
        }
        barrier();
      }
    }
  }
  }
}
