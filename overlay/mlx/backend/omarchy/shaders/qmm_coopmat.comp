#version 460
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Prefill QuantizedMatmul (matrix_m > 1) for the transposed affine
// 4-bit / group-64 f16 layout on the G13 8x8x8 fp32 subgroup
// cooperative matrix (VK_KHR_cooperative_matrix behind AGX_SIMDMAT on
// the honeykrisp-coopmat branch). One workgroup is four 32-lane
// subgroups and owns a 32 x 32 output tile; subgroup s owns the 16 x
// 16 quadrant (s / 2, s % 2) as a 2 x 2 grid of 8x8 accumulators. Per
// 8-wide k step the 128 lanes stage the x rows as f32 (one word each)
// and the weight block dequantized ONCE into shared memory - the same
// packed-word unpack and scale/bias addressing as the REGISTER_BLOCK
// qmm_tile.comp, one scale/bias load per 64-wide quant group, two
// nibbles per lane - and each subgroup coopMatLoads its two A and two
// B fragments from shared for four coopMatMulAdd. Every accumulator
// receives the same 8-wide products in the same ascending k order as
// the one-subgroup 32x32 layout this replaced, so the sums are
// unchanged; the difference is a quarter of the accumulator and
// fragment registers per lane and a quarter of the staging work per
// lane, which is what the latency-bound step needed (2026-09-09: the
// one-subgroup kernel reached 0.6-0.9 TFLOP/s on the M1, and staging
// 32 k at a time with 8 KiB shared ran 2.3x slower still). Accumulation
// is f32 in the matrix unit; the finished tile is drained through
// shared one 8-row block at a time, rounded to f16 once, and written
// with the m tail and n tail masked.
// Dispatch gate (primitives.cpp): cooperative_matrix_f32_8, subgroup
// size 32 (so the 128-lane workgroup is exactly four subgroups), f16
// output, transposed 4-bit/group-64 affine, even x and output element
// offsets (both are read/written through 32-bit words), and
// !MLX_OMARCHY_NO_COOPMAT. Push-constant routing matches
// qmm_tile.comp; matrix_k is a multiple of 64 (dispatch checks K is a
// multiple of group_size), so there is no k tail. Layout arguments to
// coopMatLoad/Store are compile-time constants (glslang asserts on a
// runtime layout).

const uint TILE_M = 32u;
const uint TILE_N = 32u;
const uint CHUNK_K = 64u;
const uint MAT = 8u;

layout(local_size_x = 128) in;

layout(set = 0, binding = 0, std430) readonly buffer InputX {
  uint values[];
} input_x;
layout(set = 0, binding = 1, std430) readonly buffer InputW {
  uint values[];
} input_w;
layout(set = 0, binding = 2, std430) readonly buffer Scales {
  float16_t values[];
} scales;
layout(set = 0, binding = 3, std430) readonly buffer Biases {
  float16_t values[];
} biases;
layout(set = 0, binding = 4, std430) writeonly buffer Output {
  float16_t values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

// 2 KiB of shared per 128-lane workgroup: one 32x8 x step and one 8x32
// weight step. Threadgroup memory bounds occupancy on AGX (32 KiB per
// core), so a 64-wide chunk staged at once (20 KiB) left one subgroup
// per core and ran 0.55x the scalar tile; the output tile is drained
// through x_s one row block at a time for the same reason.
shared float x_s[TILE_M * MAT];
shared float w_s[MAT * TILE_N];

void main() {
  uint lid = gl_LocalInvocationID.x;
  uint lane = gl_SubgroupInvocationID;
  uint sub = gl_SubgroupID;
  uint sub_rb = 2u * (sub / 2u);
  uint sub_cb = 2u * (sub % 2u);
  uint batch = params.shape[0];
  uint w_batch_words = params.shape[1];
  uint param_batch = params.shape[2];
  uint x_batch_rows = params.matrix_m * params.matrix_k;
  uint m_tiles = (params.matrix_m + TILE_M - 1u) / TILE_M;
  uint n_tiles = (params.matrix_n + TILE_N - 1u) / TILE_N;
  uint k_chunks = params.matrix_k / CHUNK_K;
  uint words_per_row = params.matrix_k / 8u;
  uint groups_per_row = params.matrix_k / 64u;
  uint x_words_per_row = params.matrix_k / 2u;
  // Staging roles: x word lid covers row lid / 4, k pair lid % 4;
  // weight lane lid covers column lid % 32, nibbles 2 (lid / 32) and
  // 2 (lid / 32) + 1.
  uint x_local_row = lid / 4u;
  uint x_pair = lid % 4u;
  uint w_column_local = lid % 32u;
  uint w_part = lid / 32u;

  for (uint b = 0u; b < batch; ++b) {
  uint w_slice = params.rhs_offset + b * w_batch_words;
  uint scale_slice = params.aux_offset + b * param_batch;
  uint bias_slice = params.aux_size + b * param_batch;
  uint x_slice = (params.lhs_offset + b * x_batch_rows) / 2u;
  uint out_slice = params.output_offset +
      b * params.matrix_m * params.matrix_n;
  for (uint tile_row = gl_WorkGroupID.y; tile_row < m_tiles;
       tile_row += gl_NumWorkGroups.y) {
    uint row_base = tile_row * TILE_M;
    uint x_row = row_base + x_local_row;
    bool x_row_ok = x_row < params.matrix_m;
    for (uint tile_col = gl_WorkGroupID.x; tile_col < n_tiles;
         tile_col += gl_NumWorkGroups.x) {
      uint column = tile_col * TILE_N + w_column_local;
      bool column_ok = column < params.matrix_n;
      uint w_row = w_slice + column * words_per_row;
      uint scale_row = scale_slice + column * groups_per_row;
      uint bias_row = bias_slice + column * groups_per_row;

      coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseAccumulator>
          acc[2][2];
      for (uint rb = 0u; rb < 2u; ++rb) {
        for (uint cb = 0u; cb < 2u; ++cb) {
          acc[rb][cb] = coopmat<float, gl_ScopeSubgroup, MAT, MAT,
              gl_MatrixUseAccumulator>(0.0);
        }
      }

      for (uint chunk = 0u; chunk < k_chunks; ++chunk) {
        float scale = 0.0;
        float bias = 0.0;
        if (column_ok) {
          scale = float(scales.values[scale_row + chunk]);
          bias = float(biases.values[bias_row + chunk]);
        }
        for (uint ks = 0u; ks < CHUNK_K / MAT; ++ks) {
          uint k_base = chunk * CHUNK_K + ks * MAT;
          vec2 pair = x_row_ok
              ? unpackHalf2x16(input_x.values[
                    x_slice + x_row * x_words_per_row + k_base / 2u +
                    x_pair])
              : vec2(0.0);
          x_s[x_local_row * MAT + 2u * x_pair] = pair.x;
          x_s[x_local_row * MAT + 2u * x_pair + 1u] = pair.y;
          uint packed = column_ok
              ? input_w.values[w_row + k_base / 8u] : 0u;
          uint shift = 8u * w_part;
          w_s[(2u * w_part) * TILE_N + w_column_local] =
              scale * float((packed >> shift) & 0xFu) + bias;
          w_s[(2u * w_part + 1u) * TILE_N + w_column_local] =
              scale * float((packed >> (shift + 4u)) & 0xFu) + bias;
          barrier();

          coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseA> mat_a[2];
          coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseB> mat_b[2];
          for (uint rb = 0u; rb < 2u; ++rb) {
            coopMatLoad(
                mat_a[rb], x_s, (sub_rb + rb) * MAT * MAT, MAT,
                gl_CooperativeMatrixLayoutRowMajor);
          }
          for (uint cb = 0u; cb < 2u; ++cb) {
            coopMatLoad(
                mat_b[cb], w_s, (sub_cb + cb) * MAT, TILE_N,
                gl_CooperativeMatrixLayoutRowMajor);
          }
          for (uint rb = 0u; rb < 2u; ++rb) {
            for (uint cb = 0u; cb < 2u; ++cb) {
              acc[rb][cb] = coopMatMulAdd(mat_a[rb], mat_b[cb], acc[rb][cb]);
            }
          }
          barrier();
        }
      }

      // Drain one 8-row block at a time through x_s (4 x 8x8 floats):
      // the two subgroups owning row block rb store their column
      // blocks, then every lane writes two outputs: column lid % 32,
      // rows lid / 32 and lid / 32 + 4 of the block.
      for (uint rb = 0u; rb < 4u; ++rb) {
        if (sub_rb == (rb & ~1u)) {
          for (uint cb = 0u; cb < 2u; ++cb) {
            coopMatStore(
                acc[rb & 1u][cb], x_s, (sub_cb + cb) * MAT * MAT, MAT,
                gl_CooperativeMatrixLayoutRowMajor);
          }
        }
        barrier();
        if (column_ok) {
          for (uint pass = 0u; pass < 2u; ++pass) {
            uint r = w_part + 4u * pass;
            uint row = row_base + rb * MAT + r;
            if (row < params.matrix_m) {
              output_data.values[out_slice + row * params.matrix_n + column] =
                  float16_t(x_s[(w_column_local / 8u) * MAT * MAT + r * MAT +
                                (w_column_local % 8u)]);
            }
          }
        }
        barrier();
      }
    }
  }
  }
}
