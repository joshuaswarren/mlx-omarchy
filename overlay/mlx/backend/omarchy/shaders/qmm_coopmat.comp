#version 460
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Prefill Q4/group-64 f16 matmul on the G13 8x8x8 fp32 subgroup
// cooperative matrix. A 64-lane workgroup owns a 32x32 output tile;
// each subgroup owns a 16x32 half. Each lane fills its two cooperative-
// matrix fragment elements directly from global operands, avoiding the
// shared-memory staging and two workgroup barriers per 16-wide k step.
// Ascending 8-wide updates preserve per-output accumulation order.
// The direct fragment mapping is the GPU-verified G13 layout documented
// by Honeykrisp's agx_nir_lower_simdmat.c.

const uint TILE_M = 32u;
const uint TILE_N = 32u;
const uint CHUNK_K = 64u;
const uint STEP_K = 16u;
const uint MAT = 8u;

layout(local_size_x = 64) in;

layout(set = 0, binding = 0, std430) readonly buffer InputX {
  uint values[];
} input_x;
layout(set = 0, binding = 1, std430) readonly buffer InputW {
  uint values[];
} input_w;
layout(set = 0, binding = 2, std430) readonly buffer Scales {
  float16_t values[];
} scales;
layout(set = 0, binding = 3, std430) readonly buffer Biases {
  float16_t values[];
} biases;
layout(set = 0, binding = 4, std430) writeonly buffer Output {
  float16_t values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

shared float out_s[4u * MAT * MAT];

void main() {
  uint lid = gl_LocalInvocationID.x;
  uint lane = gl_SubgroupInvocationID;
  uint sub_rb = 2u * gl_SubgroupID;
  uint frag_row = ((lane >> 4u) & 1u) * 4u + ((lane >> 1u) & 3u);
  uint frag_col = ((lane >> 3u) & 1u) * 4u + (lane & 1u) * 2u;
  uint batch = params.shape[0];
  uint w_batch_words = params.shape[1];
  uint param_batch = params.shape[2];
  uint x_batch_rows = params.matrix_m * params.matrix_k;
  uint m_tiles = (params.matrix_m + TILE_M - 1u) / TILE_M;
  uint n_tiles = (params.matrix_n + TILE_N - 1u) / TILE_N;
  uint k_chunks = params.matrix_k / CHUNK_K;
  uint words_per_row = params.matrix_k / 8u;
  uint groups_per_row = params.matrix_k / 64u;
  uint x_words_per_row = params.matrix_k / 2u;
  uint w_column_local = lid % TILE_N;
  uint w_part = lid / TILE_N;

  for (uint b = 0u; b < batch; ++b) {
    uint w_slice = params.rhs_offset + b * w_batch_words;
    uint scale_slice = params.aux_offset + b * param_batch;
    uint bias_slice = params.aux_size + b * param_batch;
    uint x_slice = (params.lhs_offset + b * x_batch_rows) / 2u;
    uint out_slice = params.output_offset +
        b * params.matrix_m * params.matrix_n;
    for (uint tile_row = gl_WorkGroupID.y; tile_row < m_tiles;
         tile_row += gl_NumWorkGroups.y) {
      uint row_base = tile_row * TILE_M;
      for (uint tile_col = gl_WorkGroupID.x; tile_col < n_tiles;
           tile_col += gl_NumWorkGroups.x) {
        uint col_base = tile_col * TILE_N;
        uint column = col_base + w_column_local;
        bool column_ok = column < params.matrix_n;

        coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseAccumulator>
            acc[2][4];
        for (uint rb = 0u; rb < 2u; ++rb) {
          for (uint cb = 0u; cb < 4u; ++cb) {
            acc[rb][cb] = coopmat<float, gl_ScopeSubgroup, MAT, MAT,
                gl_MatrixUseAccumulator>(0.0);
          }
        }

        for (uint chunk = 0u; chunk < k_chunks; ++chunk) {
          vec2 scale_pair[4];
          vec2 bias_pair[4];
          for (uint cb = 0u; cb < 4u; ++cb) {
            uint c0 = col_base + cb * MAT + frag_col;
            uint c1 = c0 + 1u;
            if (c0 < params.matrix_n) {
              scale_pair[cb].x = float(scales.values[
                  scale_slice + c0 * groups_per_row + chunk]);
              bias_pair[cb].x = float(biases.values[
                  bias_slice + c0 * groups_per_row + chunk]);
            } else {
              scale_pair[cb].x = 0.0;
              bias_pair[cb].x = 0.0;
            }
            if (c1 < params.matrix_n) {
              scale_pair[cb].y = float(scales.values[
                  scale_slice + c1 * groups_per_row + chunk]);
              bias_pair[cb].y = float(biases.values[
                  bias_slice + c1 * groups_per_row + chunk]);
            } else {
              scale_pair[cb].y = 0.0;
              bias_pair[cb].y = 0.0;
            }
          }

          for (uint step = 0u; step < CHUNK_K / STEP_K; ++step) {
            uint k_base = chunk * CHUNK_K + step * STEP_K;
            for (uint ks = 0u; ks < STEP_K / MAT; ++ks) {
              uint mma_k = k_base + ks * MAT;
              coopmat<float, gl_ScopeSubgroup, MAT, MAT,
                  gl_MatrixUseA> mat_a[2];
              coopmat<float, gl_ScopeSubgroup, MAT, MAT,
                  gl_MatrixUseB> mat_b[4];

              for (uint rb = 0u; rb < 2u; ++rb) {
                uint row = row_base + (sub_rb + rb) * MAT + frag_row;
                vec2 pair = vec2(0.0);
                if (row < params.matrix_m) {
                  pair = unpackHalf2x16(input_x.values[
                      x_slice + row * x_words_per_row +
                      (mma_k + frag_col) / 2u]);
                }
                mat_a[rb][0] = pair.x;
                mat_a[rb][1] = pair.y;
              }

              uint shift = 4u * frag_row;
              for (uint cb = 0u; cb < 4u; ++cb) {
                uint c0 = col_base + cb * MAT + frag_col;
                uint c1 = c0 + 1u;
                uint packed0 = c0 < params.matrix_n
                    ? input_w.values[w_slice + c0 * words_per_row + mma_k / 8u]
                    : 0u;
                uint packed1 = c1 < params.matrix_n
                    ? input_w.values[w_slice + c1 * words_per_row + mma_k / 8u]
                    : 0u;
                mat_b[cb][0] = scale_pair[cb].x *
                    float((packed0 >> shift) & 0xFu) + bias_pair[cb].x;
                mat_b[cb][1] = scale_pair[cb].y *
                    float((packed1 >> shift) & 0xFu) + bias_pair[cb].y;
              }

              for (uint rb = 0u; rb < 2u; ++rb) {
                for (uint cb = 0u; cb < 4u; ++cb) {
                  acc[rb][cb] =
                      coopMatMulAdd(mat_a[rb], mat_b[cb], acc[rb][cb]);
                }
              }
            }
          }
        }

        for (uint rb = 0u; rb < 4u; ++rb) {
          if (sub_rb == (rb & ~1u)) {
            for (uint cb = 0u; cb < 4u; ++cb) {
              coopMatStore(
                  acc[rb & 1u][cb], out_s, cb * MAT * MAT, MAT,
                  gl_CooperativeMatrixLayoutRowMajor);
            }
          }
          barrier();
          if (column_ok) {
            for (uint pass = 0u; pass < 4u; ++pass) {
              uint r = 4u * w_part + pass;
              uint row = row_base + rb * MAT + r;
              if (row < params.matrix_m) {
                output_data.values[
                    out_slice + row * params.matrix_n + column] =
                    float16_t(out_s[(w_column_local / MAT) * MAT * MAT +
                                    r * MAT + (w_column_local % MAT)]);
              }
            }
          }
          barrier();
        }
      }
    }
  }
}
