#version 460
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Prefill QuantizedMatmul (matrix_m > 1) for the transposed affine
// 4-bit / group-64 f16 layout on the G13 8x8x8 fp32 subgroup
// cooperative matrix (VK_KHR_cooperative_matrix behind AGX_SIMDMAT on
// the honeykrisp-coopmat branch). One workgroup is one 32-lane
// subgroup and owns a 32 x 32 output tile as a 4 x 4 grid of 8x8
// accumulators. Per 32-wide k step the lanes stage the x rows as f32
// (sixteen word loads per lane, all issued before any store so their
// latency overlaps) and the weight block dequantized ONCE into shared
// memory - the same packed-word unpack and scale/bias addressing as
// the REGISTER_BLOCK qmm_tile.comp, one scale/bias load per 64-wide
// quant group, four packed words per lane - then run four 8-wide
// k sub-steps of coopMatLoad + 16 coopMatMulAdd between one barrier
// pair. Each accumulator still receives its 8-wide products in
// ascending k order, so the sums are the same as the 8-wide staging
// this replaced (2026-09-09: that shape spent two barriers and one
// exposed global-load round trip per 8 k and reached 0.6-0.9 TFLOP/s
// on the M1). Accumulation is f32 in the matrix unit; the finished
// tile is drained through shared, rounded to f16 once, and written
// with the m tail and n tail masked.
// Dispatch gate (primitives.cpp): cooperative_matrix_f32_8, subgroup
// size 32, f16 output, transposed 4-bit/group-64 affine, even x and
// output element offsets (both are read/written through 32-bit words),
// and !MLX_OMARCHY_NO_COOPMAT. Push-constant routing matches
// qmm_tile.comp; matrix_k is a multiple of 64 (dispatch checks K is a
// multiple of group_size), so there is no k tail. Layout arguments to
// coopMatLoad/Store are compile-time constants (glslang asserts on a
// runtime layout).

const uint TILE_M = 32u;
const uint TILE_N = 32u;
const uint CHUNK_K = 64u;
const uint STEP_K = 32u;
const uint MAT = 8u;

layout(local_size_x = 32) in;

layout(set = 0, binding = 0, std430) readonly buffer InputX {
  uint values[];
} input_x;
layout(set = 0, binding = 1, std430) readonly buffer InputW {
  uint values[];
} input_w;
layout(set = 0, binding = 2, std430) readonly buffer Scales {
  float16_t values[];
} scales;
layout(set = 0, binding = 3, std430) readonly buffer Biases {
  float16_t values[];
} biases;
layout(set = 0, binding = 4, std430) writeonly buffer Output {
  float16_t values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

// 8 KiB of shared per 32-lane workgroup: one 32x32 x step and one
// 32x32 weight step, both row-major with stride 32. Threadgroup memory
// bounds occupancy on AGX (32 KiB per core): a 64-wide chunk staged at
// once (20 KiB with the old layout) left one subgroup per core and ran
// 0.55x the scalar tile. The output tile is drained through x_s one
// row block at a time.
shared float x_s[TILE_M * STEP_K];
shared float w_s[STEP_K * TILE_N];

void main() {
  uint lane = gl_LocalInvocationID.x;
  uint batch = params.shape[0];
  uint w_batch_words = params.shape[1];
  uint param_batch = params.shape[2];
  uint x_batch_rows = params.matrix_m * params.matrix_k;
  uint m_tiles = (params.matrix_m + TILE_M - 1u) / TILE_M;
  uint n_tiles = (params.matrix_n + TILE_N - 1u) / TILE_N;
  uint k_chunks = params.matrix_k / CHUNK_K;
  uint words_per_row = params.matrix_k / 8u;
  uint groups_per_row = params.matrix_k / 64u;
  uint x_words_per_row = params.matrix_k / 2u;

  for (uint b = 0u; b < batch; ++b) {
  uint w_slice = params.rhs_offset + b * w_batch_words;
  uint scale_slice = params.aux_offset + b * param_batch;
  uint bias_slice = params.aux_size + b * param_batch;
  uint x_slice = (params.lhs_offset + b * x_batch_rows) / 2u;
  uint out_slice = params.output_offset +
      b * params.matrix_m * params.matrix_n;
  for (uint tile_row = gl_WorkGroupID.y; tile_row < m_tiles;
       tile_row += gl_NumWorkGroups.y) {
    uint row_base = tile_row * TILE_M;
    for (uint tile_col = gl_WorkGroupID.x; tile_col < n_tiles;
         tile_col += gl_NumWorkGroups.x) {
      uint column = tile_col * TILE_N + lane;
      bool column_ok = column < params.matrix_n;
      uint w_row = w_slice + column * words_per_row;
      uint scale_row = scale_slice + column * groups_per_row;
      uint bias_row = bias_slice + column * groups_per_row;

      coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseAccumulator>
          acc[4][4];
      for (uint rb = 0u; rb < 4u; ++rb) {
        for (uint cb = 0u; cb < 4u; ++cb) {
          acc[rb][cb] = coopmat<float, gl_ScopeSubgroup, MAT, MAT,
              gl_MatrixUseAccumulator>(0.0);
        }
      }

      for (uint chunk = 0u; chunk < k_chunks; ++chunk) {
        float scale = 0.0;
        float bias = 0.0;
        if (column_ok) {
          scale = float(scales.values[scale_row + chunk]);
          bias = float(biases.values[bias_row + chunk]);
        }
        for (uint step = 0u; step < CHUNK_K / STEP_K; ++step) {
          uint k_base = chunk * CHUNK_K + step * STEP_K;
          // x step: word i = lane + 32 j covers row i / 16, k pair
          // i % 16. All sixteen loads are issued before the stores.
          uint x_words[16];
          for (uint j = 0u; j < 16u; ++j) {
            uint i = lane + 32u * j;
            uint row = row_base + i / 16u;
            x_words[j] = row < params.matrix_m
                ? input_x.values[
                      x_slice + row * x_words_per_row + k_base / 2u +
                      (i % 16u)]
                : 0u;
          }
          // Weight step: four packed words per column, 32 k values.
          uint w0 = 0u;
          uint w1 = 0u;
          uint w2 = 0u;
          uint w3 = 0u;
          if (column_ok) {
            uint w_word = w_row + k_base / 8u;
            w0 = input_w.values[w_word];
            w1 = input_w.values[w_word + 1u];
            w2 = input_w.values[w_word + 2u];
            w3 = input_w.values[w_word + 3u];
          }
          for (uint j = 0u; j < 16u; ++j) {
            uint i = lane + 32u * j;
            uint local_row = i / 16u;
            vec2 pair = unpackHalf2x16(x_words[j]);
            x_s[local_row * STEP_K + 2u * (i % 16u)] = pair.x;
            x_s[local_row * STEP_K + 2u * (i % 16u) + 1u] = pair.y;
          }
          for (uint n = 0u; n < 8u; ++n) {
            uint shift = 4u * n;
            w_s[(0u * 8u + n) * TILE_N + lane] =
                scale * float((w0 >> shift) & 0xFu) + bias;
            w_s[(1u * 8u + n) * TILE_N + lane] =
                scale * float((w1 >> shift) & 0xFu) + bias;
            w_s[(2u * 8u + n) * TILE_N + lane] =
                scale * float((w2 >> shift) & 0xFu) + bias;
            w_s[(3u * 8u + n) * TILE_N + lane] =
                scale * float((w3 >> shift) & 0xFu) + bias;
          }
          barrier();

          for (uint ks = 0u; ks < STEP_K / MAT; ++ks) {
            coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseA> mat_a[4];
            coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseB> mat_b[4];
            for (uint rb = 0u; rb < 4u; ++rb) {
              coopMatLoad(
                  mat_a[rb], x_s, rb * MAT * STEP_K + ks * MAT, STEP_K,
                  gl_CooperativeMatrixLayoutRowMajor);
            }
            for (uint cb = 0u; cb < 4u; ++cb) {
              coopMatLoad(
                  mat_b[cb], w_s, ks * MAT * TILE_N + cb * MAT, TILE_N,
                  gl_CooperativeMatrixLayoutRowMajor);
            }
            for (uint rb = 0u; rb < 4u; ++rb) {
              for (uint cb = 0u; cb < 4u; ++cb) {
                acc[rb][cb] =
                    coopMatMulAdd(mat_a[rb], mat_b[cb], acc[rb][cb]);
              }
            }
          }
          barrier();
        }
      }

      // Drain one 8-row block at a time through x_s (4 x 8x8 floats):
      // lane = column, cb = lane / 8, block-local column = lane % 8.
      for (uint rb = 0u; rb < 4u; ++rb) {
        for (uint cb = 0u; cb < 4u; ++cb) {
          coopMatStore(
              acc[rb][cb], x_s, cb * MAT * MAT, MAT,
              gl_CooperativeMatrixLayoutRowMajor);
        }
        barrier();
        if (column_ok) {
          for (uint r = 0u; r < MAT; ++r) {
            uint row = row_base + rb * MAT + r;
            if (row < params.matrix_m) {
              output_data.values[out_slice + row * params.matrix_n + column] =
                  float16_t(x_s[(lane / 8u) * MAT * MAT + r * MAT +
                                (lane % 8u)]);
            }
          }
        }
        barrier();
      }
    }
  }
  }
}
