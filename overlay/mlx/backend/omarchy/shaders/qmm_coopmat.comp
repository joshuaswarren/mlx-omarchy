#version 460
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Prefill Q4/group-64 f16 matmul on the G13 8x8x8 subgroup cooperative
// matrix, staged the way upstream Metal stages it (mlx/backend/metal/
// kernels/quantized.h qmm_t_impl): both operands live in threadgroup
// memory as f16 with the leading dimension padded by 8 f16 elements
// against bank aliasing (the weight tile keeps upstream's 32 -> 40
// pad), and the packed weight words are dequantized straight into the
// f16 tile with upstream's f32 scale*q+bias arithmetic and a single f16
// rounding at the tile store - no f32 staging round trip. x never
// rounds: the f16 input halves are stored bit-exact. The cooperative
// multiply takes f16 A/B with an f32 accumulator, so the per-output
// ascending-k accumulation order is unchanged and the only arithmetic
// difference to the previous f32-staged kernel is that one f16 weight
// rounding, which is also what the native Metal kernel applies
// (generated ids may move; the 2026-09-11-qmm-f16-operand receipt
// measures where). 2.75 KiB shared staging plus a 1 KiB f32 drain
// scratch stays under the shipped 4 KiB cadence and far below the >=8
// KiB occupancy cliff measured on the double-buffer and chunk arms.
// dispatch gate requires cooperative_matrix_f32_8, subgroup size 32,
// f16 output, transposed affine 4-bit/group-64, even x/output offsets
// (the host stages an odd-offset x view into an aligned buffer instead
// of rerouting to the tile kernel), enough shared memory, and
// !MLX_OMARCHY_NO_COOPMAT.

const uint TILE_M = 32u;
const uint TILE_N = 32u;
const uint CHUNK_K = 64u;
const uint STEP_K = 16u;
const uint MAT = 8u;
const uint X_PITCH = STEP_K + 8u;  // 24 f16 = 48 B row pitch
const uint W_PITCH = TILE_N + 8u;  // 40 f16 = upstream 32 -> 40 pad

layout(local_size_x = 64) in;

layout(set = 0, binding = 0, std430) readonly buffer InputX {
  uint values[];
} input_x;
layout(set = 0, binding = 1, std430) readonly buffer InputW {
  uint values[];
} input_w;
layout(set = 0, binding = 2, std430) readonly buffer Scales {
  float16_t values[];
} scales;
layout(set = 0, binding = 3, std430) readonly buffer Biases {
  float16_t values[];
} biases;
layout(set = 0, binding = 4, std430) writeonly buffer Output {
  float16_t values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

// 2.75 KiB f16 operand staging plus a 1 KiB f32 accumulator drain
// scratch (the old x tile no longer doubles as the drain buffer: f16
// fragments need an f32 landing pad).
shared float16_t x_s[TILE_M * X_PITCH];
shared float16_t w_s[STEP_K * W_PITCH];
shared float acc_s[4u * MAT * MAT];

void main() {
  uint lid = gl_LocalInvocationID.x;
  uint sub = gl_SubgroupID;
  uint sub_rb = 2u * sub;
  uint batch = params.shape[0];
  uint w_batch_words = params.shape[1];
  uint param_batch = params.shape[2];
  uint x_batch_rows = params.matrix_m * params.matrix_k;
  uint m_tiles = (params.matrix_m + TILE_M - 1u) / TILE_M;
  uint n_tiles = (params.matrix_n + TILE_N - 1u) / TILE_N;
  uint k_chunks = params.matrix_k / CHUNK_K;
  uint words_per_row = params.matrix_k / 8u;
  uint groups_per_row = params.matrix_k / 64u;
  uint x_words_per_row = params.matrix_k / 2u;
  uint w_column_local = lid % 32u;
  uint w_part = lid / 32u;

  for (uint b = 0u; b < batch; ++b) {
  uint w_slice = params.rhs_offset + b * w_batch_words;
  uint scale_slice = params.aux_offset + b * param_batch;
  uint bias_slice = params.aux_size + b * param_batch;
  uint x_slice = (params.lhs_offset + b * x_batch_rows) / 2u;
  uint out_slice = params.output_offset +
      b * params.matrix_m * params.matrix_n;
  for (uint tile_row = gl_WorkGroupID.y; tile_row < m_tiles;
       tile_row += gl_NumWorkGroups.y) {
    uint row_base = tile_row * TILE_M;
    for (uint tile_col = gl_WorkGroupID.x; tile_col < n_tiles;
         tile_col += gl_NumWorkGroups.x) {
      uint column = tile_col * TILE_N + w_column_local;
      bool column_ok = column < params.matrix_n;
      uint w_row = w_slice + column * words_per_row;
      uint scale_row = scale_slice + column * groups_per_row;
      uint bias_row = bias_slice + column * groups_per_row;

      coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseAccumulator>
          acc[2][4];
      for (uint rb = 0u; rb < 2u; ++rb) {
        for (uint cb = 0u; cb < 4u; ++cb) {
          acc[rb][cb] = coopmat<float, gl_ScopeSubgroup, MAT, MAT,
              gl_MatrixUseAccumulator>(0.0);
        }
      }

      for (uint chunk = 0u; chunk < k_chunks; ++chunk) {
        float scale = 0.0;
        float bias = 0.0;
        if (column_ok) {
          scale = float(scales.values[scale_row + chunk]);
          bias = float(biases.values[bias_row + chunk]);
        }
        for (uint step = 0u; step < CHUNK_K / STEP_K; ++step) {
          uint k_base = chunk * CHUNK_K + step * STEP_K;
          // Four half2 loads per lane cover the 32x16 x tile; the f16
          // halves are stored bit-exact (unpack + cast never rounds an
          // exactly representable f16 value).
          uint x_words[4];
          for (uint j = 0u; j < 4u; ++j) {
            uint i = lid + 64u * j;
            uint local_row = i / 8u;
            uint row = row_base + local_row;
            x_words[j] = row < params.matrix_m
                ? input_x.values[
                      x_slice + row * x_words_per_row + k_base / 2u +
                      (i % 8u)]
                : 0u;
          }
          for (uint j = 0u; j < 4u; ++j) {
            uint i = lid + 64u * j;
            uint local_row = i / 8u;
            vec2 pair = unpackHalf2x16(x_words[j]);
            uint col = 2u * (i % 8u);
            x_s[local_row * X_PITCH + col] = float16_t(pair.x);
            x_s[local_row * X_PITCH + col + 1u] = float16_t(pair.y);
          }
          // One packed word per lane covers the 16x32 weight tile;
          // dequantize straight into the f16 staging tile the way
          // upstream Metal's QuantizedBlockLoader does (f32 s*q+bias,
          // one f16 rounding at the store).
          uint packed = column_ok
              ? input_w.values[w_row + k_base / 8u + w_part] : 0u;
          uint w_base = 8u * w_part * W_PITCH + w_column_local;
          w_s[w_base + 0u * W_PITCH] = float16_t(scale * float(packed & 0xFu) + bias);
          w_s[w_base + 1u * W_PITCH] =
              float16_t(scale * float((packed >> 4u) & 0xFu) + bias);
          w_s[w_base + 2u * W_PITCH] =
              float16_t(scale * float((packed >> 8u) & 0xFu) + bias);
          w_s[w_base + 3u * W_PITCH] =
              float16_t(scale * float((packed >> 12u) & 0xFu) + bias);
          w_s[w_base + 4u * W_PITCH] =
              float16_t(scale * float((packed >> 16u) & 0xFu) + bias);
          w_s[w_base + 5u * W_PITCH] =
              float16_t(scale * float((packed >> 20u) & 0xFu) + bias);
          w_s[w_base + 6u * W_PITCH] =
              float16_t(scale * float((packed >> 24u) & 0xFu) + bias);
          w_s[w_base + 7u * W_PITCH] =
              float16_t(scale * float(packed >> 28u) + bias);
          barrier();

          for (uint ks = 0u; ks < STEP_K / MAT; ++ks) {
            coopmat<float16_t, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseA> mat_a[2];
            coopmat<float16_t, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseB> mat_b[4];
            for (uint rb = 0u; rb < 2u; ++rb) {
              coopMatLoad(
                  mat_a[rb], x_s,
                  (sub_rb + rb) * MAT * X_PITCH + ks * MAT, X_PITCH,
                  gl_CooperativeMatrixLayoutRowMajor);
            }
            for (uint cb = 0u; cb < 4u; ++cb) {
              coopMatLoad(
                  mat_b[cb], w_s, ks * MAT * W_PITCH + cb * MAT, W_PITCH,
                  gl_CooperativeMatrixLayoutRowMajor);
            }
            for (uint rb = 0u; rb < 2u; ++rb) {
              for (uint cb = 0u; cb < 4u; ++cb) {
                acc[rb][cb] =
                    coopMatMulAdd(mat_a[rb], mat_b[cb], acc[rb][cb]);
              }
            }
          }
          barrier();
        }
      }

      // One subgroup stores each 16-row half; duplicated column lanes
      // each drain their four distinct rows of the selected 8-row block.
      for (uint rb = 0u; rb < 4u; ++rb) {
        if (sub_rb == (rb & ~1u)) {
          for (uint cb = 0u; cb < 4u; ++cb) {
            coopMatStore(
                acc[rb & 1u][cb], acc_s, cb * MAT * MAT, MAT,
                gl_CooperativeMatrixLayoutRowMajor);
          }
        }
        barrier();
        if (column_ok) {
          for (uint pass = 0u; pass < 4u; ++pass) {
            uint r = 4u * w_part + pass;
            uint row = row_base + rb * MAT + r;
            if (row < params.matrix_m) {
              output_data.values[out_slice + row * params.matrix_n + column] =
                  float16_t(acc_s[(w_column_local / 8u) * MAT * MAT +
                                  r * MAT + (w_column_local % 8u)]);
            }
          }
        }
        barrier();
      }
    }
  }
  }
}
