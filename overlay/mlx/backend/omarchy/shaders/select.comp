#version 460

#ifdef USE_FP16
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#elif defined(USE_BF16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define STORAGE_TYPE uint16_t
#define LOAD_VALUE(x) uintBitsToFloat(uint(x) << 16u)
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
#define STORE_VALUE(f) bf16_store(f)
#else
#define STORAGE_TYPE float
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#endif

layout(local_size_x = 256) in;

// The condition is a bool array (one byte per element); the interface
// reads it as little-endian 32-bit words, so no 8-bit storage feature
// is needed. The omarchy allocator page-rounds every buffer, so the
// word that contains the last condition byte is inside the allocation.
// The true operand reads flat because the host requires a
// row-contiguous value, and the false operand reads flat because the
// host requires a scalar.
layout(set = 0, binding = 0, std430) readonly buffer Condition {
  uint words[];
} condition;
layout(set = 0, binding = 1, std430) readonly buffer InputTrue {
  STORAGE_TYPE values[];
} input_true;
layout(set = 0, binding = 2, std430) readonly buffer InputFalse {
  STORAGE_TYPE values[];
} input_false;
layout(set = 0, binding = 3, std430) writeonly buffer Output {
  STORAGE_TYPE values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  // dims == 0 selects the modulo fast path below. Otherwise the output
  // is unraveled over shape[] and lhs_strides indexes the condition; a
  // stride of 0 broadcasts the axis.
  uint dims;
  uint shape[4];
  uint lhs_strides[4];
  uint rhs_strides[4];
} params;

uint condition_byte(uint index) {
  uint word = condition.words[index >> 2u];
  return (word >> ((index & 3u) * 8u)) & 0xFFu;
}

uint condition_index_for(uint index) {
  if (params.dims == 0u) {
    return params.lhs_offset +
        (params.lhs_size == 1u ? 0u : index % params.lhs_size);
  }
  uint rem = index;
  uint result = params.lhs_offset;
  for (int dim = int(params.dims) - 1; dim >= 0; --dim) {
    uint coord = rem % params.shape[dim];
    rem /= params.shape[dim];
    result += coord * params.lhs_strides[dim];
  }
  return result;
}

void main() {
  uint index = gl_GlobalInvocationID.x;
  uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  while (index < params.count) {
    bool truthy = condition_byte(condition_index_for(index)) != 0u;
    float value = truthy
        ? LOAD_VALUE(input_true.values[params.rhs_offset + index])
        : LOAD_VALUE(input_false.values[params.aux_offset]);
    output_data.values[params.output_offset + index] = STORE_VALUE(value);
    if (params.count - index <= stride) {
      break;
    }
    index += stride;
  }
}
