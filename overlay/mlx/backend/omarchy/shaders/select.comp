#version 460

#ifdef USE_FP16
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#elif defined(USE_BF16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define STORAGE_TYPE uint16_t
#define LOAD_VALUE(x) uintBitsToFloat(uint(x) << 16u)
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
#define STORE_VALUE(f) bf16_store(f)
#else
#define STORAGE_TYPE float
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#endif

layout(local_size_x = 256) in;

// The condition is a bool array (one byte per element); the interface
// reads it as little-endian 32-bit words, so no 8-bit storage feature
// is needed. The host only dispatches this kernel when the condition is
// row-contiguous with data_size == output count, so the condition
// element for output index i is lhs_offset + i; broadcast or strided
// conditions are materialized first. The true operand reads flat
// because the host requires a row-contiguous value, and the false
// operand reads scalar or flat through the modulo fast path, the same
// rule the elementwise kernels apply to a suffix-aligned operand.
layout(set = 0, binding = 0, std430) readonly buffer Condition {
  uint words[];
} condition;
layout(set = 0, binding = 1, std430) readonly buffer InputTrue {
  STORAGE_TYPE values[];
} input_true;
layout(set = 0, binding = 2, std430) readonly buffer InputFalse {
  STORAGE_TYPE values[];
} input_false;
layout(set = 0, binding = 3, std430) writeonly buffer Output {
  STORAGE_TYPE values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint lhs_strides[4];
  uint rhs_strides[4];
} params;

uint false_index_for(uint index) {
  if (params.aux_size == 1u) {
    return params.aux_offset;
  }
  return params.aux_offset +
      (params.aux_size == params.count ? index : index % params.aux_size);
}

void main() {
  uint word_index = gl_GlobalInvocationID.x;
  uint word_count = (params.count + 3u) >> 2u;
  if (word_index >= word_count) {
    return;
  }
  // One condition word load per thread, straight-line at the top of the
  // function, with its address computed as (lhs_offset >> 2) +
  // word_index. The Honeykrisp driver on Apple M1 returns zero for bool
  // word loads whose address is recomputed per lane inside a loop or
  // derived through broadcast unravel math; probes show this exact
  // straight-line form reads correctly on that driver, and the loaded
  // register feeds all four lanes without further SSBO reads.
  uint word = condition.words[(params.lhs_offset >> 2u) + word_index];
  uint mis = params.lhs_offset & 3u;
  uint first = 4u * word_index - mis;
  for (uint lane = 0u; lane < 4u; ++lane) {
    if (word_index == 0u && lane < mis) {
      continue;
    }
    uint index = first + lane;
    if (index >= params.count) {
      break;
    }
    bool truthy = ((word >> (lane * 8u)) & 0xFFu) != 0u;
    float value = truthy
        ? LOAD_VALUE(input_true.values[params.rhs_offset + index])
        : LOAD_VALUE(input_false.values[false_index_for(index)]);
    output_data.values[params.output_offset + index] = STORE_VALUE(value);
  }
}
