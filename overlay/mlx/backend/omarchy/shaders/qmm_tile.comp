#version 460

// m-tiled QuantizedMatmul for prefill (matrix_m > 1): out[m, n] = x @
// dequant(w).T with w packed uint32 words holding 32/bits values along K,
// low bits first, one affine scale and bias per group_size elements.
// The per-element kernel (qmm.comp) unpacks the weight word and applies
// scale/bias INLINE PER MAC, so unpack work is m x n x k per matmul -
// at m=1023 that dominates prefill (receipts/2026-09-04-prefill-census.md
// lever 1). Here one 16x16 workgroup owns a 16-row m-tile x 16-column
// n-tile of the output and dequantizes each 16 x 16 weight block ONCE
// into shared float before every row-thread consumes it, amortizing the
// unpack across 16 rows. MAC count and per-output accumulation order are
// unchanged: each output element is still one thread summing x[r][k] *
// (scale*q + bias) over ascending k in a single f32 accumulator.
// Shared tiles are float, not the storage dtype: the per-element kernel
// keeps scale*q+bias at f32 precision inside the dot, and rounding the
// dequantized weight to the storage dtype here would change results.
// Push-constant routing and the packed scale/bias binding match
// qmm.comp exactly (operation carries bits, reduce_size the group size,
// binding 2 = [all scales | all biases]). matrix_k is always a multiple
// of group_size (32, 64, or 128, checked in dispatch), hence of the
// 16-wide k-tile: no k tail exists.

#ifdef USE_FP16
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#elif defined(USE_BF16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define STORAGE_TYPE uint16_t
#define LOAD_VALUE(x) uintBitsToFloat(uint(x) << 16u)
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
#define STORE_VALUE(f) bf16_store(f)
#else
#define STORAGE_TYPE float
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#endif

const uint TILE = 16u;

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0, std430) readonly buffer InputX {
  STORAGE_TYPE values[];
} input_x;
layout(set = 0, binding = 1, std430) readonly buffer InputW {
  uint values[];
} input_w;
layout(set = 0, binding = 2, std430) readonly buffer ScaleBias {
  STORAGE_TYPE values[];
} scale_bias;
layout(set = 0, binding = 3, std430) writeonly buffer Output {
  STORAGE_TYPE values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

shared float tile_x[16][16];
shared float tile_w[16][16];

// Weight layout routing mirrors qmm.comp: flags bit 0 set means
// non-transposed weights ([batch, Kp, N], scales [batch, K/group_size,
// N]); shape[0] carries the batch count B and the tile loops run once
// per batch slice with per-slice x/w/scale bases. Only strides differ
// between the layouts, selected as uniform values before the loops.
void main() {
  uint lx = gl_LocalInvocationID.x;
  uint ly = gl_LocalInvocationID.y;
  uint bits = params.operation;
  uint group_size = params.reduce_size;
  bool non_transposed = (params.flags & 1u) != 0u;
  uint pack_factor = 32u / bits;
  uint value_mask = (1u << bits) - 1u;
  uint words_per_row = params.matrix_k / pack_factor;
  uint groups_per_row = params.matrix_k / group_size;
  uint batch = params.shape[0];
  uint w_batch_words = params.shape[1];
  uint param_batch = params.shape[2];
  uint scale_total = params.shape[3];
  uint x_batch_rows = params.matrix_m * params.matrix_k;
  uint m_tiles = params.matrix_m / TILE +
      uint(params.matrix_m % TILE != 0u);
  uint n_tiles = params.matrix_n / TILE +
      uint(params.matrix_n % TILE != 0u);
  // Transposed: groups run along K, so K is a multiple of group_size
  // (32/64/128) and of the 16-wide k-tile: no k tail. Non-transposed:
  // groups run along N and K only needs pack alignment, so the final
  // k-tile can be partial and must bound-check.
  uint k_tiles = params.matrix_k / TILE +
      uint(non_transposed && (params.matrix_k % TILE != 0u));
  // Grid-stride over both tile axes keeps the kernel correct under any
  // dispatch clamping, the same contract matmul.comp uses.
  for (uint b = 0u; b < batch; ++b) {
  for (uint tile_row = gl_WorkGroupID.y; tile_row < m_tiles;
       tile_row += gl_NumWorkGroups.y) {
    uint row = tile_row * TILE + ly;
    for (uint tile_col = gl_WorkGroupID.x; tile_col < n_tiles;
         tile_col += gl_NumWorkGroups.x) {
      uint column = tile_col * TILE + lx;
      // Non-transposed: w batch slice [K, Np], groups along N, scale
      // [k][n / gs], fixed lane nibble per thread. Transposed:
      // [N, Kp], groups along K, scale [n][k / gs].
      uint w_slice = params.rhs_offset + b * w_batch_words;
      uint p_slice = params.aux_offset + b * param_batch;
      uint w_base = w_slice +
          (non_transposed ? column / pack_factor : column * words_per_row);
      uint scale_base = p_slice +
          (non_transposed ? column / group_size : column * groups_per_row);
      uint bias_base = p_slice + scale_total +
          (non_transposed ? column / group_size : column * groups_per_row);
      uint w_step = non_transposed ? params.matrix_n / pack_factor : 1u;
      uint w_pack_div = non_transposed ? 1u : pack_factor;
      uint p_step = non_transposed ? params.matrix_n / group_size : 1u;
      uint lane_shift = (column % pack_factor) * bits;
      float accumulator = 0.0;
      for (uint tile = 0u; tile < k_tiles; ++tile) {
        uint k_base = tile * TILE;
        uint x_k = k_base + lx;
        tile_x[ly][lx] = row < params.matrix_m && x_k < params.matrix_k
            ? LOAD_VALUE(input_x.values[params.lhs_offset +
                  b * x_batch_rows + row * params.matrix_k + x_k])
            : 0.0;
        float dequant = 0.0;
        if (column < params.matrix_n &&
            (!non_transposed || (k_base + ly) < params.matrix_k)) {
          uint word = input_w.values[
              w_base + (k_base + ly) / w_pack_div * w_step];
          uint q = non_transposed
              ? (word >> lane_shift) & value_mask
              : (word >> ((k_base + ly) % pack_factor * bits)) & value_mask;
          uint param = non_transposed
              ? (k_base + ly) * p_step
              : ((k_base + ly) / group_size);
          float scale = LOAD_VALUE(
              scale_bias.values[scale_base + param]);
          float bias = LOAD_VALUE(
              scale_bias.values[bias_base + param]);
          dequant = scale * float(q) + bias;
        }
        tile_w[ly][lx] = dequant;
        barrier();

        for (uint index = 0u; index < TILE; ++index) {
          accumulator += tile_x[ly][index] * tile_w[index][lx];
        }
        barrier();
      }
      if (row < params.matrix_m && column < params.matrix_n) {
        output_data.values[params.output_offset +
            b * params.matrix_m * params.matrix_n +
            row * params.matrix_n + column] = STORE_VALUE(accumulator);
      }
    }
  }
  }
}
