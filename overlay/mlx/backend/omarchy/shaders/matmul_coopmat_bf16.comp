#version 460
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require

// Dense bf16 matmul on the G13 hardware 8x8x8 fp32 matrix unit,
// STAGED. One 32-lane workgroup owns a 32x32 output tile as a 4x4
// grid of 8x8 accumulators. Per 8-wide k step the lanes stage an A
// 32x8 patch and a B 8x32 patch into 2 KiB of shared memory, loading
// bf16 word pairs and widening to f32 (a 16-bit left shift -- exact,
// no numerics change versus the scalar tile), then issue 16
// coopMatMulAdd from shared. f32 staging also removes the old scalar
// tile's repeated bf16-to-f32 conversion from the inner product.
//
// Tails in m and n are masked at staging and at the drain. The drain
// packs bf16 output pairs into 32-bit words with the same
// round-to-nearest-even bf16_store as matmul.comp (NaN quiet bit
// included), so the output contract matches the 16x16 tile bitwise
// for the same f32 tile values. K must be a multiple of 8; matrix_n
// and the output element offset must be even (word packing). A and B
// loads are scalar element-addressed, so no alignment gates apply.
//
// Push-constant layout matches matmul.comp. Transpose flags: 1 = rhs
// column-major, 4 = lhs column-major. Batch unravel matches
// matmul.comp (workgroup z over shape[]).

const uint TILE_M = 32u;
const uint TILE_N = 32u;
const uint MAT = 8u;

layout(local_size_x = 32) in;

layout(set = 0, binding = 0, std430) readonly buffer InputA {
  uint values[];
} input_a;
layout(set = 0, binding = 1, std430) readonly buffer InputB {
  uint values[];
} input_b;
layout(set = 0, binding = 2, std430) readonly buffer InputC {
  uint values[];
} input_c;
layout(set = 0, binding = 3, std430) writeonly buffer Output {
  uint values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
  uint lhs_gap;
  uint rhs_gap;
} params;

uint bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return (bits >> 16) | 0x40u;
  }
  return (bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16;
}

float bf16_load(uint element) {
  uint word = input_a.values[element >> 1u];
  return uintBitsToFloat(((element & 1u) != 0u)
      ? (word & 0xFFFF0000u)
      : (word << 16u));
}

float bf16_load_b(uint element) {
  uint word = input_b.values[element >> 1u];
  return uintBitsToFloat(((element & 1u) != 0u)
      ? (word & 0xFFFF0000u)
      : (word << 16u));
}

// 2 KiB per 32-lane workgroup: one 32x8 A step and one 8x32 B step.
shared float a_s[TILE_M * MAT];
shared float b_s[MAT * TILE_N];

void main() {
  uint lane = gl_LocalInvocationID.x;
  uint batch_index = gl_WorkGroupID.z;
  uint remaining = batch_index;
  uint a_batch = 0u;
  uint b_batch = 0u;
  for (uint axis = params.dims; axis > 0u; --axis) {
    uint coord = remaining % params.shape[axis - 1u];
    remaining /= params.shape[axis - 1u];
    a_batch += coord * params.in_strides[axis - 1u];
    b_batch += coord * params.out_strides[axis - 1u];
  }
  // Offsets are ELEMENT units; the word view halves them.
  uint a_slice = params.lhs_offset / 2u + a_batch / 2u;
  uint b_slice = params.rhs_offset / 2u + b_batch / 2u;
  uint out_matrix = params.matrix_m * params.matrix_n;
  uint out_slice = params.output_offset / 2u + batch_index * out_matrix / 2u;
  uint m_tiles = (params.matrix_m + TILE_M - 1u) / TILE_M;
  uint n_tiles = (params.matrix_n + TILE_N - 1u) / TILE_N;
  uint k_steps = params.matrix_k / MAT;
  bool a_colmaj = (params.flags & 4u) != 0u;
  bool b_colmaj = (params.flags & 1u) != 0u;

  for (uint tile_row = gl_WorkGroupID.y; tile_row < m_tiles;
       tile_row += gl_NumWorkGroups.y) {
    uint row_base = tile_row * TILE_M;
    for (uint tile_col = gl_WorkGroupID.x; tile_col < n_tiles;
         tile_col += gl_NumWorkGroups.x) {
      uint col_base = tile_col * TILE_N;

      coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseAccumulator>
          acc[4][4];
      for (uint rb = 0u; rb < 4u; ++rb) {
        for (uint cb = 0u; cb < 4u; ++cb) {
          acc[rb][cb] = coopmat<float, gl_ScopeSubgroup, MAT, MAT,
              gl_MatrixUseAccumulator>(0.0);
        }
      }

      for (uint step = 0u; step < k_steps; ++step) {
        uint k_base = step * MAT;
        // Stage A (32 rows x 8 k): i = lane + 32 j covers row i / 8.
        for (uint j = 0u; j < 8u; ++j) {
          uint i = lane + 32u * j;
          uint row_local = i / MAT;
          uint row = row_base + row_local;
          uint k = k_base + (i % MAT);
          float v = 0.0;
          if (row < params.matrix_m) {
            v = a_colmaj
                ? bf16_load(a_slice * 2u + k * params.lhs_gap + row)
                : bf16_load(a_slice * 2u + row * params.lhs_gap + k);
          }
          a_s[row_local * MAT + (i % MAT)] = v;
        }
        // Stage B (8 k x 32 columns): i covers column i / 8.
        for (uint j = 0u; j < 8u; ++j) {
          uint i = lane + 32u * j;
          uint col_local = i / MAT;
          uint col = col_base + col_local;
          uint k = k_base + (i % MAT);
          float v = 0.0;
          if (col < params.matrix_n) {
            v = b_colmaj
                ? bf16_load_b(b_slice * 2u + col * params.rhs_gap + k)
                : bf16_load_b(b_slice * 2u + k * params.rhs_gap + col);
          }
          b_s[(i % MAT) * TILE_N + col_local] = v;
        }
        barrier();

        coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseA> mat_a[4];
        coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseB> mat_b[4];
        for (uint rb = 0u; rb < 4u; ++rb) {
          coopMatLoad(
              mat_a[rb], a_s, rb * MAT * MAT, MAT,
              gl_CooperativeMatrixLayoutRowMajor);
        }
        for (uint cb = 0u; cb < 4u; ++cb) {
          coopMatLoad(
              mat_b[cb], b_s, cb * MAT, TILE_N,
              gl_CooperativeMatrixLayoutRowMajor);
        }
        for (uint rb = 0u; rb < 4u; ++rb) {
          for (uint cb = 0u; cb < 4u; ++cb) {
            acc[rb][cb] =
                coopMatMulAdd(mat_a[rb], mat_b[cb], acc[rb][cb]);
          }
        }
        barrier();
      }

      // Drain one 8-row block at a time through a_s; even lanes pack
      // bf16 pairs into words, tails masked.
      for (uint rb = 0u; rb < 4u; ++rb) {
        for (uint cb = 0u; cb < 4u; ++cb) {
          coopMatStore(
              acc[rb][cb], a_s, cb * MAT * MAT, MAT,
              gl_CooperativeMatrixLayoutRowMajor);
        }
        barrier();
        uint pair = lane % 16u;
        uint r0 = lane / 16u;
        for (uint rr = 0u; rr < 2u; ++rr) {
          uint r = r0 + 2u * rr;
          uint c0 = pair * 2u;
          uint cb = c0 / MAT;
          uint cc = c0 % MAT;
          uint row = row_base + rb * MAT + r;
          uint col = col_base + c0;
          if (row < params.matrix_m && col + 1u < params.matrix_n) {
            float v0 = a_s[cb * MAT * MAT + r * MAT + cc];
            float v1 = a_s[cb * MAT * MAT + r * MAT + cc + 1u];
            output_data.values[out_slice +
                               (row * params.matrix_n + col) / 2u] =
                bf16_store(v0) | (bf16_store(v1) << 16u);
          }
        }
      }
    }
  }
}
