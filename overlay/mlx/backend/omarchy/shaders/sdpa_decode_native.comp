//
// Single-query SDPA in native Metal's decode arithmetic order
// (mlx/backend/metal/kernels/sdpa_vector.h). One 1024-thread workgroup owns
// one query head. Short decode reproduces sdpa_vector's 32 interleaved online
// streams and final SIMD reduction. At native's long-context crossover it
// reproduces the 64/128-block two-pass algorithm, including f16 partial
// storage, inside the same workgroup and dispatch.
//
// The bf16 compile (-DBF16_IO) does not ride that structure. Its parity
// contract is the f32-score composition, so it reproduces the composition's
// observable arithmetic exactly - matmul.comp's per-dot accumulation order,
// softmax_suffix.comp's max/exp/sum/normalize sequence over stored f32
// scores, one f32 q*scale, and a single RNE bf16 output store - making the
// route bit-identical to the ten-dispatch path it replaces. See the comment
// above main().

#version 460

#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#ifdef BF16_IO
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#endif

layout(local_size_x = 1024, local_size_y = 1, local_size_z = 1) in;
#ifdef BF16_IO
// bf16 storage rides a uint16 word view: loads widen exactly (the bf16
// bits are the f32 top half), stores round-to-nearest-even like every
// other USE_BF16 leg (cast.comp).
layout(set = 0, binding = 0, std430) readonly buffer Query {
  uint16_t values[];
} query_data;
layout(set = 0, binding = 1, std430) readonly buffer Key {
  uint16_t values[];
} key_data;
layout(set = 0, binding = 2, std430) readonly buffer Value {
  uint16_t values[];
} value_data;
layout(set = 0, binding = 3, std430) writeonly buffer Output {
  uint16_t values[];
} output_data;
#else
layout(set = 0, binding = 0, std430) readonly buffer Query {
  float16_t values[];
} query_data;
layout(set = 0, binding = 1, std430) readonly buffer Key {
  float16_t values[];
} key_data;
layout(set = 0, binding = 2, std430) readonly buffer Value {
  float16_t values[];
} value_data;
layout(set = 0, binding = 3, std430) writeonly buffer Output {
  float16_t values[];
} output_data;
#endif

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

const uint SIMD = 32u;
const uint DIM = 64u;
const uint MAX_BLOCKS = 128u;
const uint CHUNK = 4u;
const float FINITE_MIN = -3.4028234663852886e38;

#ifndef BF16_IO
shared float s_outputs[SIMD * SIMD];
shared float s_max[MAX_BLOCKS];
shared float s_sum[MAX_BLOCKS];
// Native two-pass stores every 64-element partial through f16. Each word is
// one adjacent output pair.
shared uint s_partial_words[MAX_BLOCKS * SIMD];
#else
// The composition-exact arm replaces the online-softmax structure with the
// f32-score composition's observable arithmetic. Scores and probs share one
// f32 stream (probs overwrite scores in place; the normalize pass reads and
// writes only its own strided slots). The kStreamKeys bound is enforced by
// the host guard; larger contexts fall through to the composition, which
// this arm reproduces bit for bit.
const uint kStreamKeys = 2048u;
shared float s_qrow[64];
shared float s_stream[kStreamKeys];
shared float s_tree[256];
#endif

float native_exp(float x) {
  return exp(x);
}

#ifdef BF16_IO
// The cast.comp conversion pair, verbatim: exact widening in, RNE out.
float bf16_load(uint16_t bits) {
  return uintBitsToFloat(uint(bits) << 16u);
}
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
#define LD16(x) bf16_load(x)
#else
#define LD16(x) float(x)
#endif

// One chunk of a stream's keys folded into the online-softmax state. This
// is the shipped serial per-key update re-spread for issue overlap: the
// subgroup reductions issue as one independent batch, the two exps as a
// second batch, and the only dependent chain left is the accumulator fmas.
// Every operation keeps the operand bits and per-stream order of the
// serial update (max/exp/fma on identical values in identical sequence),
// so the result is bit-identical to the fully serial loop. The per-j
// active guard gives each subgroupAdd exactly the active-lane set the
// serial loop's same iteration had.
void fold_chunk(uint key0, uint key_stride, uint k_len,
                uint kv_head, uint q_dim, float q0, float q1,
                inout float max_score, inout float sum_exp_score,
                inout float o0, inout float o1) {
  float sc[CHUNK];
  float v0c[CHUNK];
  float v1c[CHUNK];
  float fac[CHUNK];
  float expsc[CHUNK];
  bool act[CHUNK];
  uint key = key0;
  for (uint j = 0u; j < CHUNK; ++j) {
    sc[j] = 0.0;
    v0c[j] = 0.0;
    v1c[j] = 0.0;
    fac[j] = 1.0;
    expsc[j] = 0.0;
    act[j] = key < k_len;
    if (act[j]) {
      uint k_base = params.rhs_offset + kv_head * params.shape[1] +
          key * params.shape[2] + q_dim * params.in_strides[0];
      float score = fma(q0, LD16(key_data.values[k_base]), 0.0);
      score = fma(
          q1,
          LD16(key_data.values[k_base + params.in_strides[0]]),
          score);
      sc[j] = subgroupAdd(score);
      uint v_base = params.aux_offset + kv_head * params.in_strides[1] +
          key * params.in_strides[2] + q_dim * params.in_strides[3];
      v0c[j] = LD16(value_data.values[v_base]);
      v1c[j] = LD16(value_data.values[v_base + params.in_strides[3]]);
    }
    key += key_stride;
  }
  float running = max_score;
  for (uint j = 0u; j < CHUNK; ++j) {
    if (act[j]) {
      float new_max = max(running, sc[j]);
      fac[j] = native_exp(running - new_max);
      expsc[j] = native_exp(sc[j] - new_max);
      running = new_max;
    }
  }
  max_score = running;
  for (uint j = 0u; j < CHUNK; ++j) {
    if (act[j]) {
      sum_exp_score = fma(sum_exp_score, fac[j], expsc[j]);
      o0 = fma(o0, fac[j], expsc[j] * v0c[j]);
      o1 = fma(o1, fac[j], expsc[j] * v1c[j]);
    }
  }
}

void store_pair(uint head, uint lane, float x, float y, float denominator) {
  if (lane == 0u) {
    uint out_base = params.output_offset + head * DIM +
        2u * gl_SubgroupID;
#ifdef BF16_IO
    output_data.values[out_base] = bf16_store(x / denominator);
    output_data.values[out_base + 1u] = bf16_store(y / denominator);
#else
    output_data.values[out_base] = float16_t(x / denominator);
    output_data.values[out_base + 1u] = float16_t(y / denominator);
#endif
  }
}

void main() {
#ifdef BF16_IO
  // ------------------------------------------------------------------
  // The composition-exact bf16 arm. Every operation below reproduces the
  // f32-score composition's observable arithmetic in the same order, so
  // the route is bit-identical to the ten-dispatch path it replaces and
  // no generated token can move:
  //   1. q*scale once in f32 (the composition's elementwise multiply;
  //      the matmul alpha is 1.0 and its drain multiplies by it),
  //   2. scores = per-dot ascending-d `acc += a * b` accumulation over
  //      16-wide tiles with exact-zero tail padding, drained by 1.0f,
  //      stored f32 (matmul.comp),
  //   3. softmax: 256-lane strided max scan + binary max tree, strided
  //      sequential exp-sum per lane + binary sum tree, normalizer
  //      1.0/sum, probs = exp(score - max) * normalizer recomputed from
  //      the stored f32 scores (softmax_suffix.comp),
  //   4. output = ascending-key `acc += a * b` over 16-wide tiles with
  //      exact-zero tail padding, drained by 1.0f (matmul.comp), stored
  //      through the cast.comp RNE bf16 pair.
  // Threads 256..1023 share every barrier but do no phase work; the
  // reduction trees only involve lanes 0..255, exactly as the 256-thread
  // softmax kernel computes them.
  // ------------------------------------------------------------------
  uint thread = gl_LocalInvocationID.x;
  uint head = gl_WorkGroupID.x;
  uint repeats = params.matrix_m / params.matrix_n;
  uint kv_head = head / repeats;
  uint k_len = params.matrix_k;

  if (thread < 64u) {
    s_qrow[thread] = params.alpha * bf16_load(
        query_data.values[params.lhs_offset +
            head * params.shape[0] + thread * params.shape[3]]);
  }
  barrier();

  // Scores over every key: ascending-d accumulation, matmul.comp order.
  for (uint key = thread; key < k_len; key += 1024u) {
    uint k_base = params.rhs_offset + kv_head * params.shape[1] +
        key * params.shape[2];
    float accumulator = 0.0;
    for (uint d = 0u; d < 64u; ++d) {
      accumulator += s_qrow[d] *
          bf16_load(key_data.values[k_base + d * params.in_strides[0]]);
    }
    s_stream[key] = 1.0 * accumulator;
  }
  barrier();

  // Row max: strided scan then the 256-lane binary tree.
  if (thread < 256u) {
    float local_max = uintBitsToFloat(0xff800000u);
    for (uint index = thread; index < k_len; index += 256u) {
      float next = s_stream[index];
      if (isnan(next) || next > local_max) {
        local_max = next;
      }
    }
    s_tree[thread] = local_max;
  }
  barrier();
  for (uint stride = 128u; stride > 0u; stride >>= 1u) {
    if (thread < stride) {
      s_tree[thread] = max(s_tree[thread], s_tree[thread + stride]);
    }
    barrier();
  }
  float row_max = s_tree[0];
  barrier();

  // Denominator: strided sequential exp-sum per lane, then the tree.
  if (thread < 256u) {
    float local_sum = 0.0;
    for (uint index = thread; index < k_len; index += 256u) {
      local_sum += exp(s_stream[index] - row_max);
    }
    s_tree[thread] = local_sum;
  }
  barrier();
  for (uint stride = 128u; stride > 0u; stride >>= 1u) {
    if (thread < stride) {
      s_tree[thread] += s_tree[thread + stride];
    }
    barrier();
  }
  float normalizer = 1.0 / s_tree[0];
  barrier();

  // Probs in place: exp recomputed from the stored f32 scores, exactly
  // as the normalize pass of softmax_suffix.comp does.
  if (thread < 256u) {
    for (uint index = thread; index < k_len; index += 256u) {
      s_stream[index] = exp(s_stream[index] - row_max) * normalizer;
    }
  }
  barrier();

  // Output dim d: ascending-key accumulation over 16-wide tiles with
  // exact-zero tail padding, drained by 1.0f, stored RNE bf16.
  if (thread < 64u) {
    uint d = thread;
    float accumulator = 0.0;
    uint key = 0u;
    for (uint tile = 0u; tile < k_len / 16u; ++tile) {
      for (uint index = 0u; index < 16u; ++index) {
        accumulator += s_stream[key] * bf16_load(
            value_data.values[params.aux_offset +
                kv_head * params.in_strides[1] +
                key * params.in_strides[2] +
                d * params.in_strides[3]]);
        ++key;
      }
    }
    for (uint index = 0u; index < 16u; ++index) {
      float prob = key < k_len ? s_stream[key] : 0.0;
      float value16 = key < k_len ? bf16_load(
          value_data.values[params.aux_offset +
              kv_head * params.in_strides[1] +
              key * params.in_strides[2] +
              d * params.in_strides[3]]) : 0.0;
      accumulator += prob * value16;
      ++key;
    }
    output_data.values[params.output_offset + head * DIM + d] =
        bf16_store(1.0 * accumulator);
  }
  return;
#else
  uint lane = gl_SubgroupInvocationID;
  uint sgid = gl_SubgroupID;
  uint head = gl_WorkGroupID.x;
  uint repeats = params.matrix_m / params.matrix_n;
  uint kv_head = head / repeats;
  uint q_base = params.lhs_offset + head * params.shape[0];
  uint q_dim = 2u * lane;
  float q0 = params.alpha *
      LD16(query_data.values[q_base + q_dim * params.shape[3]]);
  float q1 = params.alpha *
      LD16(query_data.values[q_base + (q_dim + 1u) * params.shape[3]]);
  uint blocks = params.flags;

  if (blocks == 0u) {
    // Native sdpa_vector: each SIMD owns keys sgid, sgid+32, ... and keeps an
    // independent online-softmax state before the 32 states are merged.
    // The stream walks CHUNK keys per fold_chunk call; the chunk count is
    // uniform across the workgroup and the per-j guards keep every
    // subgroupAdd's active lanes identical to the serial loop's.
    float max_score = FINITE_MIN;
    float sum_exp_score = 0.0;
    float o0 = 0.0;
    float o1 = 0.0;
    uint chunk_count =
        (params.matrix_k + SIMD * CHUNK - 1u) / (SIMD * CHUNK);
    for (uint c = 0u; c < chunk_count; ++c) {
      fold_chunk(
          sgid + c * SIMD * CHUNK,
          SIMD,
          params.matrix_k,
          kv_head,
          q_dim,
          q0,
          q1,
          max_score,
          sum_exp_score,
          o0,
          o1);
    }

    if (lane == 0u) {
      s_max[sgid] = max_score;
      s_sum[sgid] = sum_exp_score;
    }
    barrier();
    max_score = s_max[lane];
    float merged_max = subgroupMax(max_score);
    float factor = native_exp(max_score - merged_max);
    float denominator = subgroupAdd(s_sum[lane] * factor);

    s_outputs[lane * SIMD + sgid] = o0;
    barrier();
    float merged0 = subgroupAdd(s_outputs[sgid * SIMD + lane] * factor);
    barrier();
    s_outputs[lane * SIMD + sgid] = o1;
    barrier();
    float merged1 = subgroupAdd(s_outputs[sgid * SIMD + lane] * factor);
    store_pair(head, lane, merged0, merged1, denominator);
    return;
  }

  // Native sdpa_vector_2pass_1. A physical subgroup computes four logical
  // native blocks sequentially; logical blocks remain independent and land
  // in the exact f16/f32 intermediate formats consumed by pass 2.
  for (uint block = sgid; block < blocks; block += SIMD) {
    float max_score = FINITE_MIN;
    float sum_exp_score = 0.0;
    float o0 = 0.0;
    float o1 = 0.0;
    uint chunk_count =
        (params.matrix_k + blocks * CHUNK - 1u) / (blocks * CHUNK);
    for (uint c = 0u; c < chunk_count; ++c) {
      fold_chunk(
          block + c * blocks * CHUNK,
          blocks,
          params.matrix_k,
          kv_head,
          q_dim,
          q0,
          q1,
          max_score,
          sum_exp_score,
          o0,
          o1);
    }
    if (lane == 0u) {
      s_max[block] = max_score;
      s_sum[block] = sum_exp_score;
    }
    s_partial_words[block * SIMD + lane] = packHalf2x16(vec2(o0, o1));
  }
  barrier();
  float merged_max = FINITE_MIN;
  for (uint block = lane; block < blocks; block += SIMD) {
    merged_max = max(merged_max, s_max[block]);
  }
  merged_max = subgroupMax(merged_max);
  float denominator = 0.0;
  for (uint block = lane; block < blocks; block += SIMD) {
    float factor = native_exp(s_max[block] - merged_max);
    denominator = fma(factor, s_sum[block], denominator);
  }
  denominator = subgroupAdd(denominator);

  // Each SIMD first folds blocks sgid+32*b for each lane's output pair,
  // preserving pass 2's loop order, then the native shared transpose and
  // SIMD reduction merge the 32 partial streams for output pair sgid.
  float o0 = 0.0;
  float o1 = 0.0;
  for (uint block = sgid; block < blocks; block += SIMD) {
    float factor = native_exp(s_max[block] - merged_max);
    vec2 partial = unpackHalf2x16(s_partial_words[block * SIMD + lane]);
    o0 = fma(factor, partial.x, o0);
    o1 = fma(factor, partial.y, o1);
  }
  s_outputs[lane * SIMD + sgid] = o0;
  barrier();
  float merged0 = subgroupAdd(s_outputs[sgid * SIMD + lane]);
  barrier();
  s_outputs[lane * SIMD + sgid] = o1;
  barrier();
  float merged1 = subgroupAdd(s_outputs[sgid * SIMD + lane]);
  store_pair(head, lane, merged0, merged1, denominator);
#endif
}
