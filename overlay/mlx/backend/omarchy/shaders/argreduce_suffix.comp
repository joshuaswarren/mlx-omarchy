//
// ArgMin/ArgMax over the last axis. One workgroup handles one row with a
// shared-memory (value, index) reduction. Matches the upstream Metal kernel:
// the running pair starts at +/-infinity with index 0, a candidate wins only
// on a strict compare, ties keep the smaller index (first occurrence), and a
// NaN never wins because every comparison against it is false. All compares
// run in float32 for every storage dtype.

#version 460

#ifdef USE_FP16
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
#define LOAD_VALUE(x) float(x)
#elif defined(USE_BF16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define STORAGE_TYPE uint16_t
#define LOAD_VALUE(x) uintBitsToFloat(uint(x) << 16u)
#else
#define STORAGE_TYPE float
#define LOAD_VALUE(x) float(x)
#endif

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer Input {
  STORAGE_TYPE values[];
} input_data;
layout(set = 0, binding = 2, std430) writeonly buffer Output {
  uint values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
} params;

shared float block_values[256];
shared uint block_indices[256];

void main() {
  uint thread = gl_LocalInvocationID.x;
  uint row_length = params.reduce_size;
  bool is_max = params.operation == 1u;
  for (uint row = gl_WorkGroupID.x; row < params.output_size;
       row += gl_NumWorkGroups.x) {
    uint start = params.lhs_offset + row * row_length;
    float local_value = is_max ? uintBitsToFloat(0xff800000u)
                               : uintBitsToFloat(0x7f800000u);
    uint local_index = 0u;
    for (uint index = thread; index < row_length; index += 256u) {
      float next = LOAD_VALUE(input_data.values[start + index]);
      bool wins = is_max ? next > local_value : next < local_value;
      if (wins) {
        local_value = next;
        local_index = index;
      }
    }
    block_values[thread] = local_value;
    block_indices[thread] = local_index;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
      if (thread < stride) {
        float mine = block_values[thread];
        float theirs = block_values[thread + stride];
        bool wins = is_max ? theirs > mine : theirs < mine;
        bool ties = theirs == mine &&
            block_indices[thread + stride] < block_indices[thread];
        if (wins || ties) {
          block_values[thread] = theirs;
          block_indices[thread] = block_indices[thread + stride];
        }
      }
      barrier();
    }
    output_data.values[params.output_offset + row] = block_indices[0];
    barrier();
  }
}
