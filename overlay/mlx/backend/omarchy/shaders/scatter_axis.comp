//
// ScatterAxis (put_along_axis and scatter_add_axis; upstream defines
// only the None and Sum reduce modes for this primitive). out holds the
// copied src; each slot resolves one axis coordinate:
//   0 NONE pass 1: atomicMax the slot rank into scratch[target]
//   1 NONE pass 2: the winning slot copies its update, so duplicate
//     indices resolve to the highest slot exactly like the CPU loop;
//     deterministic for every dtype
//   6 SUM: USE_U32 atomicAdd of the update word; deterministic for
//     int32 and uint32 (integer addition is associative). USE_BOOL
//     atomicOr of the canonical update bit into scratch (saturating,
//     so exact). USE_FADD hardware fp32 atomicAdd into the fp32
//     scratch: duplicates accumulate in device order, matching
//     upstream Metal's nondeterministic float add, and the fp32
//     accumulation rounds once at the op-12 finalize.
//  11 FADD Sum pass: fp32 atomicAdd of the decoded update into the
//     fp32 per-element scratch.
//  12 FADD Sum finalize (one thread per output element): store the
//     fp32 accumulation converted once to the output dtype.
//  17 FCAS Sum pass: the no-hardware-atomic-float twin of op 11, a
//     compare-exchange add through the uint view of the fp32 scratch.
//  14 BOOL Sum/Max finalize: write the OR bit into the packed byte
//     with a commuting atomicAnd/Or pair.
// An index outside [0, src axis extent) after negative wrap skips the
// slot; upstream leaves such writes undefined.
//
// The index array is dense and its flat index is the slot t; updates
// may be a broadcast view and address through out_strides plus the
// matrix_n axis stride. src addresses through in_strides plus the
// matrix_m axis stride. shape[0..flags) are the non-axis extents,
// pre-axis dims first; matrix_k is the pre-axis dim count. USE_U32
// covers float32 (bitwise NONE copy) plus int32/uint32.

#version 460

// Hardware fp32 atomicAdd (op 11) exists only in the USE_HW_ATOMIC
// variants; the FCAS variants replace it with the op-17 compare-
// exchange add for devices that do not advertise
// VK_EXT_shader_atomic_float (the M1 Honeykrisp).
#if defined(USE_FADD) && defined(USE_HW_ATOMIC)
#extension GL_EXT_shader_atomic_float : require
#endif

#ifdef USE_FP16
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#elif defined(USE_BF16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define STORAGE_TYPE uint16_t
#define LOAD_VALUE(x) uintBitsToFloat(uint(x) << 16u)
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
#define STORE_VALUE(f) bf16_store(f)
#elif defined(USE_U32)
#define STORAGE_TYPE uint
#elif defined(USE_BOOL)
// Packed word transport: uint32 words, 4 bools per word.
#define STORAGE_TYPE uint
#else
#define STORAGE_TYPE float
#define LOAD_VALUE(x) (x)
#define STORE_VALUE(f) (f)
#endif

// Receipt-proven replacement for shift-then-mask byte extraction with
// a data-dependent shift amount, which Honeykrisp miscompiles (see
// scatter.comp); a macro, not a helper function, for the same reason.
#define BYTE_AT(word, lane)                                                  \
  ((lane) == 0u ? ((word) & 0xFFu)                                           \
       : (lane) == 1u ? (((word) >> 8u) & 0xFFu)                             \
       : (lane) == 2u ? (((word) >> 16u) & 0xFFu)                            \
                      : (((word) >> 24u) & 0xFFu))
layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) buffer Output {
  STORAGE_TYPE values[];
} out_data;
layout(set = 0, binding = 1, std430) readonly buffer Indices {
  int values[];
} indices_data;
layout(set = 0, binding = 2, std430) readonly buffer Updates {
  STORAGE_TYPE values[];
} upd_data;
layout(set = 0, binding = 3, std430) buffer Scratch {
  uint values[];
} scratch_data;
#if defined(USE_FADD)
// fp32 view of the accumulation scratch, aliased on binding 3; the
// uint view stays for the rank phases and bool bit accumulation.
layout(set = 0, binding = 3, std430) buffer ScratchF {
  float values[];
} scratch_f_data;
#endif

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

void main() {
  uint t = gl_GlobalInvocationID.x;
  uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  uint op = params.operation;
  uint m_axis = params.aux_size;
  uint post_size = params.output_size;
  while (t < params.count) {
    if (op == 12u) {
#ifdef USE_FADD
      // FADD Sum finalize: one thread per output element stores the
      // fp32 accumulation converted once to the output dtype.
      out_data.values[params.output_offset + t] =
          STORE_VALUE(scratch_f_data.values[params.output_offset + t]);
#endif
    } else if (op == 14u) {
#ifdef USE_BOOL
      // Bool Sum/Max finalize: set the lane to the accumulated OR bit;
      // out already holds src and OR never clears a set src bit, so a
      // plain bit-set leaves sibling lanes untouched.
      uint element = params.output_offset + t;
      uint lane = (element & 3u) * 8u;
      atomicOr(
          out_data.values[element >> 2u],
          (scratch_data.values[element] & 1u) << lane);
#endif
    } else {
    // t decomposes as slot * (m_axis * post_size) + ax * post_size +
    // post; the remainder must strip the full slot prefix, not just
    // slot * m_axis, or every slot past the first misreads ax and post.
    uint slot = t / (m_axis * post_size);
    uint rem = t - slot * (m_axis * post_size);
    uint ax = rem / post_size;
    uint post = rem - ax * post_size;
    uint word_slot = params.aux_offset == 2u ? t + t : t;
    uint word = uint(
        indices_data.values[params.rhs_offset + word_slot]);
    uint index = params.reduce_size;
    if (params.aux_offset == 0u) {
      if (word < 0x80000000u) {
        index = word;
      }
    } else if (params.aux_offset == 1u) {
      index = word;
    } else {
      uint high =
          uint(indices_data.values[params.rhs_offset + word_slot + 1u]);
      if (high == 0u) {
        index = word;
      }
    }
    if (index < params.reduce_size) {
      // Non-axis source/update offsets: pre dims walk slot, post dims
      // walk post.
      uint src_elem = 0u;
      uint upd_elem = 0u;
      uint coord_scale = 1u;
      for (uint i = params.flags; i > params.matrix_k; --i) {
        uint dim = params.shape[i - 1u];
        uint coord = (post / coord_scale) % dim;
        src_elem += coord * params.in_strides[i - 1u];
        upd_elem += coord * params.out_strides[i - 1u];
        coord_scale *= dim;
      }
      coord_scale = 1u;
      for (uint i = params.matrix_k; i > 0u; --i) {
        uint dim = params.shape[i - 1u];
        uint coord = (slot / coord_scale) % dim;
        src_elem += coord * params.in_strides[i - 1u];
        upd_elem += coord * params.out_strides[i - 1u];
        coord_scale *= dim;
      }
      uint target = params.output_offset + src_elem +
          index * params.matrix_m;
      if (op == 0u) {
        atomicMax(scratch_data.values[target], t + 1u);
      } else if (op == 1u) {
        if (scratch_data.values[target] == t + 1u) {
#ifdef USE_BOOL
          // Winner writes its packed byte: clear the lane, then set
          // the canonical update bit; commuting atomics keep sibling
          // lanes intact.
          uint ue = params.lhs_offset + upd_elem +
              ax * params.matrix_n;
          uint ubyte = BYTE_AT(upd_data.values[ue >> 2u], ue & 3u);
          uint lane1 = (target & 3u) * 8u;
          atomicAnd(out_data.values[target >> 2u], ~(0xFFu << lane1));
          atomicOr(
              out_data.values[target >> 2u],
              (ubyte != 0u ? 1u : 0u) << lane1);
#else
          out_data.values[target] = upd_data
              .values[params.lhs_offset + upd_elem + ax * params.matrix_n];
#endif
        }
#ifdef USE_U32
      } else if (op == 6u) {
        atomicAdd(
            out_data.values[target],
            upd_data
                .values[params.lhs_offset + upd_elem + ax * params.matrix_n]);
#endif
#ifdef USE_BOOL
      } else if (op == 6u) {
        // Bool Sum/Max: OR the canonical update bit into the
        // per-element scratch; saturating, so duplicates are exact.
        uint ue6 = params.lhs_offset + upd_elem +
            ax * params.matrix_n;
        atomicOr(
            scratch_data.values[target],
            BYTE_AT(upd_data.values[ue6 >> 2u], ue6 & 3u) != 0u
                ? 1u
                : 0u);
#endif
#if defined(USE_FADD) && defined(USE_HW_ATOMIC)
      } else if (op == 11u) {
        // FADD Sum: hardware fp32 atomicAdd into the fp32 scratch;
        // duplicates accumulate in device order, matching upstream
        // Metal's nondeterministic float add, rounded once at the
        // op-12 finalize.
        atomicAdd(
            scratch_f_data.values[target],
            LOAD_VALUE(upd_data
                           .values[params.lhs_offset + upd_elem +
                                   ax * params.matrix_n]));
#elif defined(USE_FADD)
      } else if (op == 17u) {
        // FCAS Sum: compare-exchange add through the uint view of the
        // fp32 scratch, the twin of op 11 for devices without hardware
        // float atomics; rounded once at the op-12 finalize.
        uint add_bits = floatBitsToUint(LOAD_VALUE(
            upd_data
                .values[params.lhs_offset + upd_elem + ax * params.matrix_n]));
        uint assumed = scratch_data.values[target];
        for (;;) {
          uint next = floatBitsToUint(
              uintBitsToFloat(assumed) + uintBitsToFloat(add_bits));
          uint prev =
              atomicCompSwap(scratch_data.values[target], assumed, next);
          if (prev == assumed) {
            break;
          }
          assumed = prev;
        }
#endif
      }
    }
    }
    if (params.count - t <= stride) {
      break;
    }
    t += stride;
  }
}
