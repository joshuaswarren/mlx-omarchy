#version 460

// Column-batched GEMV for short prefill (2 <= m <= 64) on the transposed
// affine 4-bit / group-64 float16 contract: out[m, n] = x[m, k] @
// dequant(w), w packed [n][k / 8] uint32 words, low nibble first, one
// f16 scale and bias per 64 elements. The 64-wide tile GEMM is
// latency-bound at these m (one or two 64-row tiles), while the weight
// stream is small, so this kernel keeps the decode GEMV's shape
// (qmm_vec_q4.comp: one 32-lane slot per ROWS output rows, one uvec4 of
// weights per row per lane per step) and applies every dequantized
// weight it streams to NUM_COLS activation rows before moving on.
//
// Grid: x over ceil(n / (8 * ROWS)) workgroups of eight slots, y over
// ceil(m / NUM_COLS) column blocks. The workgroup first tabulates the
// per-(column, half-group) activation sums in shared memory (slot c
// sums column c; every slot would otherwise recompute all eight). Then
// per step a lane loads its ROWS weight uvec4s (32 nibbles each, half
// a group), unpacks them to q_j (in-place mask, then the exact
// power-of-two rescale), and for each of the block's NUM_COLS
// activation rows loads that row's 32 elements (64 B as f16 through the
// uvec4 view, kept as float16_t) and takes the 32-term dot per weight
// row, accumulating s * dot + b * xsum over the lane's half groups.
// This is the decode kernel's arithmetic (every product is exactly
// x_j * q_j, same per-lane half-group order, same lane fold), so a
// column's output is bit-identical to the m == 1 GEMV on that row. It
// differs from the tile / blocked GEMM order (scale * q + bias per
// product, ascending k), which the dispatch documents.
//
// USE_SUBGROUP=1 folds the lanes with subgroupAdd (dispatch gate:
// subgroupSize == 32 with the ARITHMETIC feature); the default flavor
// reduces through shared memory and is correct on any subgroup size.

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)

#ifdef USE_SUBGROUP
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#endif

const uint LANES = 32u;
const uint SLOTS = 8u;
const uint THREADS = LANES * SLOTS;
#ifndef NUM_COLS
#define NUM_COLS 8
#endif
#ifndef ROWS
#define ROWS 2
#endif
const uint COLS = uint(NUM_COLS);
const uint R = uint(ROWS);
// k <= 4864 (the decode contract), so at most 152 half groups per row.
const uint MAX_ROW_VECS = 152u;

layout(local_size_x = 256) in;

// x is read through a uvec4 view: dispatch guarantees the element
// offset is 16-byte aligned and k is a multiple of 32.
layout(set = 0, binding = 0, std430) readonly buffer InputX {
  uvec4 values[];
} input_x;
layout(set = 0, binding = 1, std430) readonly buffer InputW {
  uvec4 values[];
} input_w;
layout(set = 0, binding = 2, std430) readonly buffer Scales {
  STORAGE_TYPE values[];
} scales;
layout(set = 0, binding = 3, std430) readonly buffer Biases {
  STORAGE_TYPE values[];
} biases;
layout(set = 0, binding = 4, std430) writeonly buffer Output {
  STORAGE_TYPE values[];
} output_data;

// Same block as qmm_vec_q4.comp: lhs/rhs/output offsets in elements
// (lhs_offset 16-byte aligned, rhs_offset a multiple of 4 words),
// aux_offset the scale base, aux_size the bias base, shape[0] the batch
// count, shape[1] the per-batch weight words, shape[2] the per-batch
// scale/bias elements.
layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

shared float xsum_table[COLS][MAX_ROW_VECS];
#ifndef USE_SUBGROUP
shared float reduce_scratch[R * COLS * THREADS];
#endif

const float NIBBLE_SCALE[8] = float[8](
    1.0, 0.0625, 0.00390625, 0.000244140625, 1.52587890625e-05,
    9.5367431640625e-07, 5.9604644775390625e-08, 3.725290298461914e-09);

// The eight nibbles of one word as floats q_j: the mask keeps q_j * 2^4j
// exactly and the power-of-two rescale is exact.
void unpack_word(uint w, out float q[8]) {
  q[0] = float(w & 0xfu);
  q[1] = float(w & 0xf0u) * NIBBLE_SCALE[1];
  q[2] = float(w & 0xf00u) * NIBBLE_SCALE[2];
  q[3] = float(w & 0xf000u) * NIBBLE_SCALE[3];
  q[4] = float(w & 0xf0000u) * NIBBLE_SCALE[4];
  q[5] = float(w & 0xf00000u) * NIBBLE_SCALE[5];
  q[6] = float(w & 0xf000000u) * NIBBLE_SCALE[6];
  q[7] = float(w & 0xf0000000u) * NIBBLE_SCALE[7];
}

// Eight consecutive f16 activations from one uvec4, kept as halves.
void load_x8(uint vec_index, out f16vec2 x[4]) {
  uvec4 raw = input_x.values[vec_index];
  x[0] = unpackFloat2x16(raw.x);
  x[1] = unpackFloat2x16(raw.y);
  x[2] = unpackFloat2x16(raw.z);
  x[3] = unpackFloat2x16(raw.w);
}

// Dot in the decode kernel's order: d = x0 q0; d += x1 q1; ...
float dot8(f16vec2 x[4], float q[8]) {
  float d = float(x[0].x) * q[0];
  d += float(x[0].y) * q[1];
  d += float(x[1].x) * q[2];
  d += float(x[1].y) * q[3];
  d += float(x[2].x) * q[4];
  d += float(x[2].y) * q[5];
  d += float(x[3].x) * q[6];
  d += float(x[3].y) * q[7];
  return d;
}

// Element sum in the decode kernel's order.
float sum8(f16vec2 x[4]) {
  float s = float(x[0].x);
  s += float(x[0].y);
  s += float(x[1].x);
  s += float(x[1].y);
  s += float(x[2].x);
  s += float(x[2].y);
  s += float(x[3].x);
  s += float(x[3].y);
  return s;
}

void main() {
#ifdef USE_SUBGROUP
  uint slot = gl_SubgroupID;
  uint li = gl_SubgroupInvocationID;
#else
  uint slot = gl_LocalInvocationID.x / LANES;
  uint li = gl_LocalInvocationID.x % LANES;
#endif
  uint lane = slot * LANES + li;
  uint m = params.matrix_m;
  uint n = params.matrix_n;
  uint k = params.matrix_k;
  uint row_vecs = k / 32u;
  uint groups_per_row = k / 64u;
  uint batch = params.shape[0];
  uint w_batch_words = params.shape[1];
  uint param_batch = params.shape[2];
  uint row0 = (gl_WorkGroupID.x * SLOTS + slot) * R;
  uint col0 = gl_WorkGroupID.y * COLS;

  for (uint b = 0u; b < batch; ++b) {
    // f16: eight elements per uvec4, so a row is k / 8 vectors.
    uint x_base = (params.lhs_offset + b * m * k) / 8u;
    uint w_base = (params.rhs_offset + b * w_batch_words) / 4u;
    uint scale_base = params.aux_offset + b * param_batch;
    uint bias_base = params.aux_size + b * param_batch;

    // Activation sums: slot c tabulates column c over its lanes' half
    // groups (the sum order is the decode kernel's).
    if (b > 0u) {
      barrier();
    }
    {
      uint col = min(col0 + slot, m - 1u);
      for (uint v = li; v < row_vecs; v += LANES) {
        uint xv = x_base + col * (k / 8u) + v * 4u;
        f16vec2 x0[4];
        f16vec2 x1[4];
        f16vec2 x2[4];
        f16vec2 x3[4];
        load_x8(xv, x0);
        load_x8(xv + 1u, x1);
        load_x8(xv + 2u, x2);
        load_x8(xv + 3u, x3);
        xsum_table[slot][v] = sum8(x0) + sum8(x1) + sum8(x2) + sum8(x3);
      }
    }
    barrier();

    float acc[R][COLS];
    for (uint r = 0u; r < R; ++r) {
      for (uint c = 0u; c < COLS; ++c) {
        acc[r][c] = 0.0;
      }
    }
    for (uint v = li; v < row_vecs; v += LANES) {
      uint g = v >> 1u;
      float q[R][4][8];
      float s[R];
      float bias[R];
      for (uint r = 0u; r < R; ++r) {
        uint row = min(row0 + r, n - 1u);
        uvec4 w = input_w.values[w_base + row * row_vecs + v];
        s[r] = LOAD_VALUE(scales.values[scale_base + row * groups_per_row + g]);
        bias[r] = LOAD_VALUE(biases.values[bias_base + row * groups_per_row + g]);
        unpack_word(w.x, q[r][0]);
        unpack_word(w.y, q[r][1]);
        unpack_word(w.z, q[r][2]);
        unpack_word(w.w, q[r][3]);
      }
      for (uint c = 0u; c < COLS; ++c) {
        uint col = min(col0 + c, m - 1u);
        uint xv = x_base + col * (k / 8u) + v * 4u;
        f16vec2 x0[4];
        f16vec2 x1[4];
        f16vec2 x2[4];
        f16vec2 x3[4];
        load_x8(xv, x0);
        load_x8(xv + 1u, x1);
        load_x8(xv + 2u, x2);
        load_x8(xv + 3u, x3);
        float xs = xsum_table[c][v];
        for (uint r = 0u; r < R; ++r) {
          float d = dot8(x0, q[r][0]);
          d += dot8(x1, q[r][1]);
          d += dot8(x2, q[r][2]);
          d += dot8(x3, q[r][3]);
          acc[r][c] += s[r] * d + bias[r] * xs;
        }
      }
    }

    uint out_base = params.output_offset + b * m * n;
#ifdef USE_SUBGROUP
    for (uint r = 0u; r < R; ++r) {
      for (uint c = 0u; c < COLS; ++c) {
        float total = subgroupAdd(acc[r][c]);
        if (li == 0u && row0 + r < n && col0 + c < m) {
          output_data.values[out_base + (col0 + c) * n + row0 + r] =
              STORE_VALUE(total);
        }
      }
    }
#else
    for (uint r = 0u; r < R; ++r) {
      for (uint c = 0u; c < COLS; ++c) {
        reduce_scratch[(r * COLS + c) * THREADS + lane] = acc[r][c];
      }
    }
    barrier();
    if (lane < SLOTS * R * COLS) {
      uint out_slot = lane / (R * COLS);
      uint r = (lane / COLS) % R;
      uint c = lane % COLS;
      uint out_row = (gl_WorkGroupID.x * SLOTS + out_slot) * R + r;
      if (out_row < n && col0 + c < m) {
        float total = 0.0;
        for (uint i = 0u; i < LANES; ++i) {
          total += reduce_scratch[(r * COLS + c) * THREADS + out_slot * LANES + i];
        }
        output_data.values[out_base + (col0 + c) * n + out_row] =
            STORE_VALUE(total);
      }
    }
#endif
  }
}
