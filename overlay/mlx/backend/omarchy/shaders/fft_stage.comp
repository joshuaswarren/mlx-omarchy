//
// General-length FFT stage kernels: one thread per element, selected by the
// mode carried in push-constant reduce_size.
//
//   0 twiddle multiply     Cooley-Tukey factor stage: element j of its
//                          n-point transform gains w_n^(m0*T), j = m0*M + T.
//   1 Bluestein a-build    a[j] = x[j]*w[j] for j < n, zero-padded to the
//                          convolution length L. Reads the pipeline input in
//                          all three source modes (real promoted, half
//                          spectrum synthesized, plain complex).
//   2 Bluestein b-build    b[k] = conj-direction chirp for k in [0,n), folded
//                          to L-k, one at k = 0, zero between.
//   3 pointwise multiply   c = a * b, with c aliasing b (per-element
//                          read-then-write, safe).
//   4 Bluestein epilogue   y[j] = conv[j]*w[j], scaled by L/n on the inverse
//                          direction (the inner passes already contributed
//                          the 1/L factor or its absence), packed or strided
//                          store.
//
// Push-constant map: lhs_size = axis length n, rhs_size = axis sample stride,
// reduce_size = mode, output_size = M (twiddle) or L (Bluestein), count =
// elements this dispatch covers, operation bit 0 = inverse (positive-angle)
// direction, bits 1..3 reuse the fft_c2c pass-flag semantics on the
// Bluestein edges.
//
// Phase products stay exactly representable: twiddle m0*T < n <= 2^24 and
// Bluestein k^2 < 2^32 under the 32768 length bound, so both reduce exactly
// in u32 before the float conversion.

#version 460

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer InComplex {
  vec2 values[];
} fft_in_complex;
// Read-only alias of the same binding for the promoted float32 input.
layout(set = 0, binding = 0, std430) readonly buffer InReal {
  float values[];
} fft_in_real;
// Read-write: modes 0/1/2/4 only store, mode 3 multiplies in place.
layout(set = 0, binding = 2, std430) buffer OutComplex {
  vec2 values[];
} fft_out_complex;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
} params;

vec2 cmul(vec2 a, vec2 b) {
  return vec2(a.x * b.x - a.y * b.y, a.x * b.y + a.y * b.x);
}

// e^(direction * i * pi * (k^2 mod 2n) / n), the Bluestein chirp. k < 65536
// under the length bound, so k*k reduces exactly in u32.
vec2 chirp(float direction, uint k, uint n) {
  uint reduced = (k * k) % (2u * n);
  float angle = direction * 3.141592653589793 * float(reduced) / float(n);
  return vec2(cos(angle), sin(angle));
}

// Address of sample j of transform t in a dense row-major buffer whose axis
// extent is n with sample stride `stride`.
uint dense_address(uint t, uint j, uint n, uint stride) {
  return (t / stride) * n * stride + (t % stride) * stride + j * stride;
}

void main() {
  uint p = gl_GlobalInvocationID.x;
  if (p >= params.count) {
    return;
  }
  uint n = params.lhs_size;
  uint stride = params.rhs_size;
  uint mode = params.reduce_size;
  bool inverse = (params.operation & 1u) != 0u;
  float direction = inverse ? 1.0 : -1.0;

  if (mode == 0u) {
    // Twiddle stage: p enumerates transform-local samples, t*n + j.
    uint trailing = params.output_size;
    uint t = p / n;
    uint j = p % n;
    uint phase = (j / trailing) * (j % trailing);
    float angle = direction * 6.283185307179586 * float(phase) / float(n);
    vec2 w = vec2(cos(angle), sin(angle));
    uint at = params.lhs_offset + dense_address(t, j, n, stride);
    vec2 x = fft_in_complex.values[at];
    fft_out_complex.values[params.output_offset + at] = cmul(x, w);
  } else if (mode == 1u) {
    // Bluestein a-build: p enumerates the packed convolution buffer, t*L + j.
    uint conv_len = params.output_size;
    uint j = p % conv_len;
    uint t = p / conv_len;
    vec2 value = vec2(0.0, 0.0);
    if (j < n) {
      vec2 x;
      if ((params.operation & 4u) != 0u) {
        // Half-spectrum source: synthesize the full Hermitian input.
        uint half_bins = n / 2u + 1u;
        if (j <= n / 2u) {
          x = fft_in_complex.values[params.lhs_offset + t * half_bins + j];
        } else {
          x = fft_in_complex.values[params.lhs_offset + t * half_bins + (n - j)];
          x.y = -x.y;
        }
      } else {
        uint source = dense_address(t, j, n, stride);
        if ((params.operation & 2u) != 0u) {
          x = vec2(fft_in_real.values[params.lhs_offset + source], 0.0);
        } else {
          x = fft_in_complex.values[params.lhs_offset + source];
        }
      }
      value = cmul(x, chirp(direction, j, n));
    }
    fft_out_complex.values[params.output_offset + p] = value;
  } else if (mode == 2u) {
    // Bluestein b-build: p enumerates the packed convolution buffer.
    uint conv_len = params.output_size;
    uint k = p % conv_len;
    vec2 value = vec2(1.0, 0.0);
    if (k > 0u && k < n) {
      value = chirp(-direction, k, n);
    } else if (k > conv_len - n) {
      value = chirp(-direction, conv_len - k, n);
    }
    fft_out_complex.values[params.output_offset + p] = value;
  } else if (mode == 3u) {
    vec2 a = fft_in_complex.values[params.lhs_offset + p];
    vec2 b = fft_out_complex.values[params.output_offset + p];
    fft_out_complex.values[params.output_offset + p] = cmul(a, b);
  } else {
    // Bluestein epilogue: p enumerates t*n + j over the n-point results.
    uint conv_len = params.output_size;
    uint j = p % n;
    uint t = p / n;
    if ((params.operation & 8u) != 0u && j > n / 2u) {
      return; // packed half-spectrum store keeps only bins 0..n/2
    }
    vec2 value =
        cmul(fft_in_complex.values[params.lhs_offset + t * conv_len + j],
             chirp(direction, j, n));
    float scale = inverse ? float(conv_len) / float(n) : 1.0;
    value *= scale;
    uint at = (params.operation & 8u) != 0u
        ? params.output_offset + t * (n / 2u + 1u) + j
        : params.output_offset + dense_address(t, j, n, stride);
    fft_out_complex.values[at] = value;
  }
}
