//
// Fused RMSNorm (-DRMS default) or LayerNorm (-DLAYER_NORM=1) forward over the
// last axis, matching mlx::core::fast fallback math in mlx/fast.cpp. One
// workgroup handles one row with shared-memory reductions and a grid-stride
// row loop; every arithmetic step runs in float32 for all storage dtypes.
//
//   RMS:   n = rsqrt(mean(x^2) + eps);            y = x * n * w
//   Layer: mu = mean(x); var = mean(x^2) - mu^2;
//          n = rsqrt(var + eps);                  y = (x - mu) * n * w + b
//
// A scalar weight or bias (element count 1, the weightless upstream form)
// broadcasts to every column. eps arrives in params.alpha.

#version 460
#extension GL_EXT_control_flow_attributes : require

#ifdef USE_FP16
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#elif defined(USE_BF16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define STORAGE_TYPE uint16_t
#define LOAD_VALUE(x) uintBitsToFloat(uint(x) << 16u)
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
#define STORE_VALUE(f) bf16_store(f)
#else
#define STORAGE_TYPE float
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#endif

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer Input {
  STORAGE_TYPE values[];
} input_data;
layout(set = 0, binding = 1, std430) readonly buffer Weight {
  STORAGE_TYPE values[];
} weight_data;
#ifdef LAYER_NORM
layout(set = 0, binding = 2, std430) readonly buffer Bias {
  STORAGE_TYPE values[];
} bias_data;
#endif
layout(set = 0, binding = 3, std430) writeonly buffer Output {
  STORAGE_TYPE values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
} params;

shared float block_values[256];

// Decode rows (2048 wide, one 256-thread workgroup) spent 8 + 8 serial memory
// round trips per thread in the two walks below. The walks now issue the
// loads of 8 strided steps before the arithmetic consumes them in the
// original order, and the arithmetic stays what Honeykrisp compiled the
// one-step loop bodies to (AGX NIR of the shipped kernel,
// receipts/2026-09-29-jw16-decode-gdn-lse-argmax): sum of squares
// acc = ffma(v, v, acc), RMS output v * (norm * w). An unrolled non-exact
// add chain would be regrouped by rank (nir_opt_reassociate) and GLSL fma()
// is only a contractible hint there, so the squares stay one step per
// iteration of a loop the compiler may not unroll, and the output products
// are exact (precise, in a helper so precise does not reach norm or mean).
float rms_out(float value, float norm, float weight) {
  precise float scale = norm * weight;
  precise float result = value * scale;
  return result;
}
#define NORM_LOAD(j) float v##j = LOAD_VALUE(input_data.values[base + (j) * 256u]);
#define NORM_LOAD8 NORM_LOAD(0u) NORM_LOAD(1u) NORM_LOAD(2u) NORM_LOAD(3u) \
  NORM_LOAD(4u) NORM_LOAD(5u) NORM_LOAD(6u) NORM_LOAD(7u)
#define NORM_W(j) float w##j = (params.lhs_size == 1u) \
  ? LOAD_VALUE(weight_data.values[params.rhs_offset]) \
  : LOAD_VALUE(weight_data.values[params.rhs_offset + index + (j) * 256u]);
#define NORM_OUT(j) \
  output_data.values[out_base + (j) * 256u] = STORE_VALUE(rms_out(v##j, norm, w##j));
#define NORM_APPLY8(OP) OP(0u) OP(1u) OP(2u) OP(3u) OP(4u) OP(5u) OP(6u) OP(7u)

void main() {
  uint thread = gl_LocalInvocationID.x;
  uint row_length = params.reduce_size;
  float eps = params.alpha;
  uint threads = 256u;

  for (uint row = gl_WorkGroupID.x; row < params.output_size;
       row += gl_NumWorkGroups.x) {
    uint start = params.lhs_offset + row * row_length;

#ifdef LAYER_NORM
    float local_sum = 0.0;
    for (uint index = thread; index < row_length; index += threads) {
      local_sum += LOAD_VALUE(input_data.values[start + index]);
    }
    block_values[thread] = local_sum;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
      if (thread < stride) {
        block_values[thread] += block_values[thread + stride];
      }
      barrier();
    }
    float mu = block_values[0] / float(row_length);
    barrier();
#endif

    float local_sq = 0.0;
    uint index = thread;
    for (; index + 7u * 256u < row_length; index += 8u * 256u) {
      uint base = start + index;
      float vals[8];
      for (uint j = 0u; j < 8u; ++j) {
        vals[j] = LOAD_VALUE(input_data.values[base + j * 256u]);
      }
      [[dont_unroll]] for (uint j = 0u; j < 8u; ++j) {
        local_sq += vals[j] * vals[j];
      }
    }
    for (; index < row_length; index += threads) {
      float value = LOAD_VALUE(input_data.values[start + index]);
      local_sq += value * value;
    }
    block_values[thread] = local_sq;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
      if (thread < stride) {
        block_values[thread] += block_values[thread + stride];
      }
      barrier();
    }
    float mean_square = block_values[0] / float(row_length);
    barrier();
#ifdef LAYER_NORM
    float variance = mean_square - mu * mu;
#else
    float variance = mean_square;
#endif
    float norm = inversesqrt(variance + eps);

    index = thread;
#ifndef LAYER_NORM
    for (; index + 7u * 256u < row_length; index += 8u * 256u) {
      uint base = start + index;
      uint out_base = params.output_offset + row * row_length + index;
      NORM_LOAD8
      NORM_APPLY8(NORM_W)
      NORM_APPLY8(NORM_OUT)
    }
#endif
    for (; index < row_length; index += threads) {
      float value = LOAD_VALUE(input_data.values[start + index]);
      float weight =
          (params.lhs_size == 1u)
              ? LOAD_VALUE(weight_data.values[params.rhs_offset])
              : LOAD_VALUE(weight_data.values[params.rhs_offset + index]);
#ifdef LAYER_NORM
      float bias =
          (params.aux_size == 1u)
              ? LOAD_VALUE(bias_data.values[params.aux_offset])
              : LOAD_VALUE(bias_data.values[params.aux_offset + index]);
      float result = (value - mu) * norm * weight + bias;
#else
      float result = rms_out(value, norm, weight);
#endif
      output_data.values[params.output_offset + row * row_length + index] =
          STORE_VALUE(result);
    }
    barrier();
  }
}
