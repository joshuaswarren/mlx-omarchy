#version 460

// QuantizedMatmul (affine, transposed weights): out[m, n] is the dot
// product of x row m with the dequantized w row n, where packed uint32
// words hold 32/bits quantized values along K in the low bits first and
// each group of group_size elements shares one scale and one bias:
// w_deq[n, k] = q * scale[n, k / group_size] + bias[n, k / group_size].
// Push-constant routing: operation carries bits (4 or 8), reduce_size
// carries the group size. Binding 2 packs the group parameters as two
// halves of one buffer ([all scales | all biases], K / group_size
// values per row) so the five operand arrays fit the four-binding
// pipeline limit.
// Every load is a straight-line per-thread word or element read at a
// linear address inside uniform-trip-count loops (Honeykrisp caution:
// no per-lane divergent word loads, no broadcast-unravel addressing).

#ifdef USE_FP16
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#elif defined(USE_BF16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define STORAGE_TYPE uint16_t
#define LOAD_VALUE(x) uintBitsToFloat(uint(x) << 16u)
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
#define STORE_VALUE(f) bf16_store(f)
#else
#define STORAGE_TYPE float
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#endif

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer InputX {
  STORAGE_TYPE values[];
} input_x;
layout(set = 0, binding = 1, std430) readonly buffer InputW {
  uint values[];
} input_w;
layout(set = 0, binding = 2, std430) readonly buffer ScaleBias {
  STORAGE_TYPE values[];
} scale_bias;
layout(set = 0, binding = 3, std430) writeonly buffer Output {
  STORAGE_TYPE values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

void main() {
  uint bits = params.operation;
  uint group_size = params.reduce_size;
  uint pack_factor = 32u / bits;
  uint value_mask = (1u << bits) - 1u;
  uint words_per_group = group_size / pack_factor;
  uint words_per_row = params.matrix_k / pack_factor;
  uint groups_per_row = params.matrix_k / group_size;
  uint total = params.matrix_m * params.matrix_n;
  uint stride = gl_NumWorkGroups.x * 256u;

  for (uint index = gl_GlobalInvocationID.x; index < total;
       index += stride) {
    uint row = index / params.matrix_n;
    uint column = index % params.matrix_n;
    uint w_base = params.rhs_offset + column * words_per_row;
    uint param_base = params.aux_offset + column * groups_per_row;
    uint bias_base = param_base + params.matrix_n * groups_per_row;
    float accumulator = 0.0;
    uint group = 0u;
    uint word_base = w_base;
    for (uint k = 0u; k < params.matrix_k; k += group_size) {
      float scale = LOAD_VALUE(scale_bias.values[param_base + group]);
      float bias = LOAD_VALUE(scale_bias.values[bias_base + group]);
      ++group;
      for (uint word_index = 0u; word_index < words_per_group;
           ++word_index) {
        uint word = input_w.values[word_base + word_index];
        uint k_base = k + word_index * pack_factor;
        for (uint lane = 0u; lane < pack_factor; ++lane) {
          uint q = (word >> (lane * bits)) & value_mask;
          float x_value = LOAD_VALUE(
              input_x.values[params.lhs_offset + row * params.matrix_k +
                  k_base + lane]);
          accumulator += x_value * (scale * float(q) + bias);
        }
      }
      word_base += words_per_group;
    }
    output_data.values[params.output_offset + index] =
        STORE_VALUE(accumulator);
  }
}
