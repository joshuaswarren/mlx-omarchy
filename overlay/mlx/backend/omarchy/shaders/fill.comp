#version 460

#ifdef USE_FP16
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#elif defined(USE_BF16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define STORAGE_TYPE uint16_t
#define LOAD_VALUE(x) uintBitsToFloat(uint(x) << 16u)
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
#define STORE_VALUE(f) bf16_store(f)
#elif defined(USE_U16)
// 16-bit fill: the raw halfword rides in the low 16 bits of the alpha
// push-constant slot bit-exactly.
#extension GL_EXT_shader_16bit_storage : require
#define STORAGE_TYPE uint16_t
#define LOAD_VALUE(x) (x)
#define STORE_VALUE(f) uint16_t(floatBitsToUint(params.alpha) & 0xFFFFu)
#elif defined(USE_U64)
// 64-bit fill, dispatched only behind the device's shaderInt64
// feature. The two little-endian words ride the alpha/beta float
// push-constant slots bit-exactly: every uint32 is a valid float bit
// pattern, so no value is unreachable.
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#define STORAGE_TYPE uint
#define LOAD_VALUE(x) (x)
#define STORE_VALUE(f) (f)
#elif defined(USE_COMPLEX64)
// Complex64 fill: one element is a vec2 (re, im). The host packs the
// scalar's real part into alpha and the imaginary part into beta; a
// zero scalar never reaches this branch because copy.cpp byte-fills
// it with vkCmdFillBuffer instead.
#define STORAGE_TYPE vec2
#define LOAD_VALUE(x) (x)
#define STORE_VALUE(f) vec2(params.alpha, params.beta)
#else
#define STORAGE_TYPE float
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#endif

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) writeonly buffer Output {
  STORAGE_TYPE values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
} params;

#ifdef USE_U64
uint64_t fill_word() {
  return uint64_t(floatBitsToUint(params.alpha)) |
      (uint64_t(floatBitsToUint(params.beta)) << 32ul);
}
#endif

void main() {
  uint index = gl_GlobalInvocationID.x;
  uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  while (index < params.count) {
#ifdef USE_U64
    uvec2 halves = unpackUint2x32(fill_word());
    output_data.values[2u * (params.output_offset + index)] = halves.x;
    output_data.values[2u * (params.output_offset + index) + 1u] = halves.y;
#else
    output_data.values[params.output_offset + index] =
        STORE_VALUE(params.alpha);
#endif
    if (params.count - index <= stride) {
      break;
    }
    index += stride;
  }
}
