//
// Native-shape pass 1 of the long-context decode SDPA (t6001-test-hostDecodeGap's
// named lever, receipts 2026-09-17). The fused SdpaDecodeNativeF16 kernel
// keeps one workgroup per head, so each of its 32 subgroups walks k/32
// sequential keys no matter how many blocks the two-pass splits into - the
// walk is latency-bound in that serial depth. Native Metal instead runs
// sdpa_vector_2pass_1 with grid = heads x blocks and ONE 32-thread
// simdgroup per block, so the serial depth is k/blocks (~8 at the
// 128-block crossover) with heads*blocks concurrent chains.
//
// This kernel is that shape: one workgroup per (head, block), one subgroup
// of 32 lanes, no shared memory and no barrier. Each workgroup reproduces
// the fused kernel's per-block loop exactly - same key order (stride-fold
// block + t*blocks), same fma/exp chain, same subgroupAdd over the dim
// lanes - and stores the same intermediates the fused kernel kept in
// shared memory: the f32 block max, the f32 exp sum, and the 32 packed f16
// output-pair words. Pass 2 (sdpa_decode_native_p2.comp) folds them with
// the fused kernel's pass-2 code unchanged, so the pair is bit-identical
// to the fused two-pass it replaces. f16 only: the bf16 arm always runs
// one-pass (see the fused kernel comment).

#version 460

#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer Query {
  float16_t values[];
} query_data;
layout(set = 0, binding = 1, std430) readonly buffer Key {
  float16_t values[];
} key_data;
layout(set = 0, binding = 2, std430) readonly buffer Value {
  float16_t values[];
} value_data;
layout(set = 0, binding = 3, std430) writeonly buffer Scratch {
  uint values[];
} scratch_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

const uint SIMD = 32u;
const float FINITE_MIN = -3.4028234663852886e38;

// Scratch words per head: blocks max words + blocks sum words +
// blocks*SIMD packed output-pair words. Shared with pass 2; keep the two
// shaders' layouts in lockstep.
const uint SCRATCH_STRIDE_FACTOR = 2u + SIMD;

#define LD16(x) float(x)

float native_exp(float x) {
  return exp(x);
}

void main() {
  uint lane = gl_SubgroupInvocationID;
  uint head = gl_WorkGroupID.x;
  uint block = gl_WorkGroupID.y;
  uint blocks = params.flags;
  uint repeats = params.matrix_m / params.matrix_n;
  uint kv_head = head / repeats;
  uint q_base = params.lhs_offset + head * params.shape[0];
  uint q_dim = 2u * lane;
  float q0 = params.alpha *
      LD16(query_data.values[q_base + q_dim * params.shape[3]]);
  float q1 = params.alpha *
      LD16(query_data.values[q_base + (q_dim + 1u) * params.shape[3]]);

  // The fused kernel's per-block online state, verbatim.
  float max_score = FINITE_MIN;
  float sum_exp_score = 0.0;
  float o0 = 0.0;
  float o1 = 0.0;
  for (uint key = block; key < params.matrix_k; key += blocks) {
    uint k_base = params.rhs_offset + kv_head * params.shape[1] +
        key * params.shape[2] + q_dim * params.in_strides[0];
    float score = fma(q0, LD16(key_data.values[k_base]), 0.0);
    score = fma(
        q1,
        LD16(key_data.values[k_base + params.in_strides[0]]),
        score);
    score = subgroupAdd(score);
    float new_max = max(max_score, score);
    float factor = native_exp(max_score - new_max);
    float exp_score = native_exp(score - new_max);
    max_score = new_max;
    sum_exp_score = fma(sum_exp_score, factor, exp_score);
    uint v_base = params.aux_offset + kv_head * params.in_strides[1] +
        key * params.in_strides[2] + q_dim * params.in_strides[3];
    o0 = fma(
        o0,
        factor,
        exp_score * LD16(value_data.values[v_base]));
    o1 = fma(
        o1,
        factor,
        exp_score *
            LD16(value_data.values[v_base + params.in_strides[3]]));
  }

  uint head_base = head * blocks * SCRATCH_STRIDE_FACTOR;
  if (lane == 0u) {
    scratch_data.values[head_base + block] = floatBitsToUint(max_score);
    scratch_data.values[head_base + blocks + block] =
        floatBitsToUint(sum_exp_score);
  }
  scratch_data.values[head_base + 2u * blocks + block * SIMD + lane] =
      packHalf2x16(vec2(o0, o1));
}
