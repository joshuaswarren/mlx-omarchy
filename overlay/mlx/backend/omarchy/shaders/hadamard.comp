// Hadamard transform, matching mlx/backend/cpu/hadamard.cpp exactly: one
// invocation owns one row of the last axis, the host having copied the input
// into the output buffer first. The row of length n*m decomposes into a 2^k
// component n and a Sylvester or embedded-Hadamard component m in
// (1, 12, 20, 28). The Walsh-Hadamard butterfly runs over each n segment in
// place, with the global scale applied on the final stage when m is 1; for
// m above 1 the dense H_m rows mix the n segments and apply the scale, the
// same order the CPU kernel uses so float results round identically.
//
// Push-constant routing: reduce_size carries n, matrix_m carries m,
// output_size the row count, and alpha the scale. The kernel mutates one
// buffer in place through a single read_write binding; rows are disjoint so
// no invocation sees another's writes.
//
// Serial per-row cost is n*log2(n) butterflies; sizes above 2^16 stay a
// named host-side error.
#version 460

#ifdef USE_FP16
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#elif defined(USE_BF16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define STORAGE_TYPE uint16_t
#define LOAD_VALUE(x) uintBitsToFloat(uint(x) << 16u)
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
#define STORE_VALUE(f) bf16_store(f)
#else
#define STORAGE_TYPE float
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#endif

layout(local_size_x = 1) in;

layout(set = 0, binding = 0, std430) buffer Row {
  STORAGE_TYPE values[];
} row_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

// The neilsloane.com Hadamard matrices upstream embeds, one uint per row;
// bit k set means row j, column k is '+'.
const uint H12_ROWS[12] = uint[12](
0x00000ffdu, 0x00000554u, 0x00000c37u, 0x00000691u, 0x000000dfu, 0x00000a45u,
0x00000373u, 0x00000919u, 0x00000dc3u, 0x00000469u, 0x0000070fu, 0x000001a5u
);
const uint H20_ROWS[20] = uint[20](
0x0006cc21u, 0x000d1c42u, 0x000ab884u, 0x0005f108u, 0x000b6610u, 0x0009c83eu,
0x0003945du, 0x0007289bu, 0x000e5117u, 0x000ca60fu, 0x000f05acu, 0x000e8b58u,
0x000d92b1u, 0x000ba163u, 0x0007c2c6u, 0x00008592u, 0x00010b05u, 0x0002122au,
0x00042074u, 0x000840c9u
);
const uint H28_ROWS[28] = uint[28](
0x03296181u, 0x06528382u, 0x0c854704u, 0x092a8e08u, 0x02751c10u, 0x04ca7820u,
0x0994b0c0u, 0x04b980bcu, 0x09534178u, 0x02a6c271u, 0x054d8463u, 0x0a9b0847u,
0x0536500fu, 0x0a4ce01eu, 0x07804cdau, 0x0f009935u, 0x0e21326au, 0x0c6224d5u,
0x08e409abu, 0x01e81356u, 0x03d0262du, 0x0030ed66u, 0x0041dacdu, 0x0083b51bu,
0x01072ab6u, 0x020e15ecu, 0x041c2b59u, 0x081856b3u
);

uint matrix_row(uint m, uint j) {
  if (m == 12u) {
    return H12_ROWS[j];
  }
  if (m == 20u) {
    return H20_ROWS[j];
  }
  return H28_ROWS[j];
}

void main() {
  uint row = gl_GlobalInvocationID.x;
  if (row >= params.output_size) {
    return;
  }
  uint n = params.reduce_size;
  uint m = params.matrix_m;
  uint base = row * n * m;

  // Walsh-Hadamard butterfly over each n segment, the upstream index math:
  // pairs (j, j+h) combine as (x+y, x-y) for h walking 1, 2, ..., n/2.
  // Upstream hadamard_n walks b over size/n contiguous groups; within one
  // row that is each of the m segments below, so segment k=0 alone is not
  // enough when the dense H_m stage mixes segments.
  float row_scale = m > 1u ? 1.0 : params.alpha;
  for (uint seg = 0u; seg < m; ++seg) {
    uint seg_base = base + seg * n;
    for (uint h = 1u; h < n; h <<= 1u) {
      for (uint i = 0u; i < n / 2u; ++i) {
        uint k = i & (h - 1u);
        uint j = ((i - k) << 1u) + k;
        float x = LOAD_VALUE(row_data.values[seg_base + j]);
        float y = LOAD_VALUE(row_data.values[seg_base + j + h]);
        float a = x + y;
        float b = x - y;
        if (h == n / 2u) {
          a *= row_scale;
          b *= row_scale;
        }
        row_data.values[seg_base + j] = STORE_VALUE(a);
        row_data.values[seg_base + j + h] = STORE_VALUE(b);
      }
    }
  }

  if (m <= 1u) {
    return;
  }
  // Dense H_m mixing over the m segments, stride n between rows.
  for (uint i = 0u; i < n; ++i) {
    float acc[28];
    for (uint j = 0u; j < m; ++j) {
      uint bits = matrix_row(m, j);
      float sum = 0.0;
      for (uint k = 0u; k < m; ++k) {
        float x = LOAD_VALUE(row_data.values[base + i + k * n]);
        sum += ((bits >> k) & 1u) == 1u ? x : -x;
      }
      acc[j] = sum;
    }
    for (uint j = 0u; j < m; ++j) {
      row_data.values[base + i + j * n] = STORE_VALUE(acc[j] * params.alpha);
    }
  }
}
