//
// Wave 8 FFT: one workgroup computes one power-of-two 1-D complex FFT of up
// to 2048 samples with a radix-2 Cooley-Tukey decimation-in-time pass over
// 16 KiB of shared state (two 2048-float arrays, the Vulkan minimum shared
// memory guarantee). Sample k of a transform lives at element base + k *
// stride of a dense row-major buffer, which reaches every transform axis of
// a batched array without transposes.
//
// Push-constant flag bits in `operation` select the variant passes, matching
// the upstream CPU primitive's per-call behaviour (mlx/backend/cpu/fft.cpp
// and pocketfft): 1 inverse (applies the per-axis 1/n scale), 2 float32
// input promoted to complex (rfft pass one), 4 half-spectrum input of n/2+1
// bins synthesized to the full Hermitian spectrum at load (irfft final
// pass), 8 keep only bins 0..n/2 at store (rfft pass one output). The real
// flags require the transform axis to be the trailing axis, so their stride
// is 1.

#version 460

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer InComplex {
  vec2 values[];
} fft_in_complex;
// Read-only alias of the same binding for the promoted float32 input.
layout(set = 0, binding = 0, std430) readonly buffer InReal {
  float values[];
} fft_in_real;
layout(set = 0, binding = 2, std430) writeonly buffer OutComplex {
  vec2 values[];
} fft_out_complex;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
} params;

shared float sh_re[2048];
shared float sh_im[2048];

uint reverse_bits(uint value, uint bit_count) {
  uint result = 0u;
  for (uint bit = 0u; bit < bit_count; ++bit) {
    result = (result << 1u) | (value & 1u);
    value >>= 1u;
  }
  return result;
}

void main() {
  uint transform =
      gl_WorkGroupID.z * gl_NumWorkGroups.y * gl_NumWorkGroups.x +
      gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
  if (transform >= params.count) {
    return;
  }

  uint n = params.lhs_size;
  uint stride = params.rhs_size;
  uint log_n = findMSB(n);
  uint half_n = n >> 1u;
  bool input_real = (params.operation & 2u) != 0u;
  bool input_half = (params.operation & 4u) != 0u;
  bool output_half = (params.operation & 8u) != 0u;
  bool inverse = (params.operation & 1u) != 0u;

  // Dense row-major base: trailing-axis transforms pack one after another
  // (stride 1), inner-axis transforms interleave with the trailing extent.
  // A half-spectrum input stores n/2+1 samples per transform, so its row
  // stride differs from the n-sample outputs it feeds.
  uint in_base = input_half
      ? transform * (half_n + 1u) + params.lhs_offset
      : (transform % stride) + (transform / stride) * n * stride +
            params.lhs_offset;
  uint n_store = output_half ? half_n + 1u : n;
  uint out_base = output_half
      ? transform * n_store + params.output_offset
      : (transform % stride) + (transform / stride) * n * stride +
            params.output_offset;

  // Load with the bit-reversal permutation folded in, so the decimation-
  // in-time stages need no swap pass afterwards.
  for (uint slot = gl_LocalInvocationID.x; slot < n; slot += 256u) {
    uint source = reverse_bits(slot, log_n);
    vec2 value;
    if (input_real) {
      value = vec2(fft_in_real.values[in_base + source * stride], 0.0);
    } else if (input_half) {
      uint mirror = source <= half_n ? source : n - source;
      value = fft_in_complex.values[in_base + mirror * stride];
      if (source > half_n) {
        value = vec2(value.x, -value.y);
      }
    } else {
      value = fft_in_complex.values[in_base + source * stride];
    }
    sh_re[slot] = value.x;
    sh_im[slot] = value.y;
  }
  barrier();

  // Twiddles stay in one turn around the circle, so the argument magnitude
  // never leaves (-pi, pi] per stage and single-precision sin/cos keeps
  // roughly 1e-6 relative accuracy over the eleven stages.
  for (uint stage = 1u; stage <= log_n; ++stage) {
    uint len = 1u << stage;
    uint half_len = len >> 1u;
    barrier();
    float angle_step =
        (inverse ? 1.0 : -1.0) * 6.283185307179586 / float(len);
    for (uint pair = gl_LocalInvocationID.x; pair < (n >> 1u);
         pair += 256u) {
      uint offset = pair % half_len;
      float angle = angle_step * float(offset);
      float w_re = cos(angle);
      float w_im = sin(angle);
      uint a = (pair / half_len) * len + offset;
      uint b = a + half_len;
      float ur = sh_re[a];
      float ui = sh_im[a];
      float vr = sh_re[b] * w_re - sh_im[b] * w_im;
      float vi = sh_re[b] * w_im + sh_im[b] * w_re;
      sh_re[a] = ur + vr;
      sh_im[a] = ui + vi;
      sh_re[b] = ur - vr;
      sh_im[b] = ui - vi;
    }
  }
  barrier();

  // The inverse scale matches the CPU primitive: every transformed axis
  // divides by its own length, so a multi-axis inverse accumulates the
  // 1/(n0 * n1 * ...) factor one axis at a time.
  float scale = inverse ? 1.0 / float(n) : 1.0;
  for (uint slot = gl_LocalInvocationID.x; slot < n_store; slot += 256u) {
    fft_out_complex.values[out_base + slot * stride] =
        vec2(sh_re[slot] * scale, sh_im[slot] * scale);
  }
}
