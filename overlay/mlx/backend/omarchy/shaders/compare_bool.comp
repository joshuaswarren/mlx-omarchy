#version 460

layout(local_size_x = 256) in;

// Bool arrays store one byte per element. The interface reads and writes
// them as little-endian 32-bit words, so no 8-bit storage feature is
// needed; the omarchy allocator page-rounds every buffer, so the word
// that contains the last byte is always inside the allocation.
//
// This kernel is the bool comparison sextet (Equal, NotEqual, Greater,
// Less, GreaterEqual, LessEqual). It is separate from logical_or.comp
// on purpose:
//   * one plain word store per output word, no atomicOr — the caller
//     never has to zero-fill the output buffer first;
//   * a 6-op selector, well below the op-count width where Honeykrisp
//     mis-lowers wide if/else chains into coalesced stores (the same
//     driver bug FixM1BoolAndInt isolated on packed-byte logical ops);
//   * no shared selector space with the logical trio, so extending
//     either family later cannot re-trigger the collision.

layout(set = 0, binding = 0, std430) readonly buffer InputA {
  uint words[];
} input_a;
layout(set = 0, binding = 1, std430) readonly buffer InputB {
  uint words[];
} input_b;
layout(set = 0, binding = 2, std430) writeonly buffer Output {
  uint words[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  // dims == 0 selects the modulo fast path below. Otherwise the output
  // is unraveled over shape[] and lhs_strides/rhs_strides index the
  // operands; a stride of 0 broadcasts the axis.
  uint dims;
  uint shape[4];
  uint lhs_strides[4];
  uint rhs_strides[4];
} params;

// Honeykrisp miscompiles shift-then-mask byte extraction with a
// data-dependent shift amount (receipt 2026-09-02-masked-scatter-m1-fix,
// diag68); four constant shifts picked by a select chain are the
// receipt-proven equivalent.
#define BYTE_AT(word, lane)                                                  \
  ((lane) == 0u ? ((word) & 0xFFu)                                           \
       : (lane) == 1u ? (((word) >> 8u) & 0xFFu)                             \
       : (lane) == 2u ? (((word) >> 16u) & 0xFFu)                            \
                      : (((word) >> 24u) & 0xFFu))
uint lhs_byte(uint index) {
  uint word = input_a.words[index >> 2u];
  return BYTE_AT(word, index & 3u);
}

uint rhs_byte(uint index) {
  uint word = input_b.words[index >> 2u];
  return BYTE_AT(word, index & 3u);
}

uint lhs_index_for(uint index) {
  if (params.dims == 0u) {
    return params.lhs_offset + (params.lhs_size == 1u
        ? 0u
        : (params.lhs_size == params.count ? index : index % params.lhs_size));
  }
  uint rem = index;
  uint result = params.lhs_offset;
  for (int dim = int(params.dims) - 1; dim >= 0; --dim) {
    uint coord = rem % params.shape[dim];
    rem /= params.shape[dim];
    result += coord * params.lhs_strides[dim];
  }
  return result;
}

uint rhs_index_for(uint index) {
  if (params.dims == 0u) {
    return params.rhs_offset + (params.rhs_size == 1u
        ? 0u
        : (params.rhs_size == params.count ? index : index % params.rhs_size));
  }
  uint rem = index;
  uint result = params.rhs_offset;
  for (int dim = int(params.dims) - 1; dim >= 0; --dim) {
    uint coord = rem % params.shape[dim];
    rem /= params.shape[dim];
    result += coord * params.rhs_strides[dim];
  }
  return result;
}

void main() {
  uint word_index = gl_GlobalInvocationID.x;
  uint word_stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  uint word_count = (params.count + 3u) >> 2u;
  while (word_index < word_count) {
    uint base = word_index * 4u;
    uint word = 0u;
    for (uint lane = 0u; lane < 4u; ++lane) {
      uint index = base + lane;
      if (index >= params.count) {
        break;
      }
      // Normalize to canonical 0/1 the way upstream bool casts do, so
      // a stray 0xFF byte from a vendor cast still compares truthy.
      uint a = lhs_byte(lhs_index_for(index)) != 0u ? 1u : 0u;
      uint b = rhs_byte(rhs_index_for(index)) != 0u ? 1u : 0u;
      // Selector codes: 0 = Equal, 1 = NotEqual, 2 = Greater,
      // 3 = Less, 4 = GreaterEqual, 5 = LessEqual. These are LOCAL to
      // this kernel; the host maps ComparisonOperation onto them.
      bool result;
      if (params.operation == 0u) {
        result = a == b;
      } else if (params.operation == 1u) {
        result = a != b;
      } else if (params.operation == 2u) {
        result = a > b;
      } else if (params.operation == 3u) {
        result = a < b;
      } else if (params.operation == 4u) {
        result = a >= b;
      } else {
        result = a <= b;
      }
      uint bit = result ? 1u : 0u;
      word |= bit << ((index & 3u) * 8u);
    }
    // Plain store: every byte of this word was decided above, so the
    // write needs no read-modify-write and no zero-filled destination.
    output_data.words[word_index] = word;
    if (word_count - word_index <= word_stride) {
      break;
    }
    word_index += word_stride;
  }
}
