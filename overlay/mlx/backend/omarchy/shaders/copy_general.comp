// Strided general copy. USE_U32 selects raw uint32 storage: words copy
// with no float conversion, so int32 and uint32 stay bit-exact including
// packed words above 2^31. USE_BOOL selects the packed word transport:
// 4 bools per uint32 word, one byte lane each; bytes write as the
// commuting atomicAnd/atomicOr lane pair (scatter.comp shape), so
// concurrent threads sharing an edge word never lose a lane, and a
// source byte canonicalizes to 0/1.
// Index math is signed: a view with negative strides (a flip) carries
// its base offset at the far end, and the host span check guarantees
// every intermediate index stays inside int32 range, so the same
// unravel serves positive and negative strides alike.
// The load stays one straight-line per-thread read at a linear address,
// the shape the Honeykrisp driver reads correctly (see gather_rows.comp
// and docs/known-defects.md).
#version 460

#ifdef USE_FP16
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#elif defined(USE_U32)
#define STORAGE_TYPE uint
#define LOAD_VALUE(x) (x)
#define STORE_VALUE(x) (x)
#elif defined(USE_BF16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define STORAGE_TYPE uint16_t
#define LOAD_VALUE(x) uintBitsToFloat(uint(x) << 16u)
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
#define STORE_VALUE(f) bf16_store(f)
#elif defined(USE_COMPLEX64)
// Complex64 same-dtype strided copy: one element is a vec2 (re, im)
// and the words copy bit-exact with no conversion, the same raw
// transport USE_U32 gives 4-byte words. Strides and offsets are item
// offsets, so an 8-byte item strides like a float32 item does.
#define STORAGE_TYPE vec2
#define LOAD_VALUE(x) (x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#elif defined(USE_BOOL)
#define STORAGE_TYPE uint
#define LOAD_VALUE(x) (x)
#define STORE_VALUE(x) (x)
#else
#define STORAGE_TYPE float
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#endif

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer InputA {
  STORAGE_TYPE values[];
} input_a;
layout(set = 0, binding = 1, std430) readonly buffer InputB {
  STORAGE_TYPE values[];
} input_b;
#ifdef USE_BOOL
// Bool destinations insert byte lanes with atomics, so the binding is
// readable and writable.
layout(set = 0, binding = 2, std430) buffer Output {
  uint values[];
} output_data;
#else
layout(set = 0, binding = 2, std430) writeonly buffer Output {
  STORAGE_TYPE values[];
} output_data;
#endif

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

void main() {
#ifdef USE_BOOL
  uint index = gl_GlobalInvocationID.x;
  uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  while (index < params.count) {
    uint rem = index;
    int in_index = int(params.lhs_offset);
    int out_index = int(params.output_offset);
    for (int dim = int(params.dims) - 1; dim >= 0; --dim) {
      uint coord = rem % params.shape[dim];
      rem /= params.shape[dim];
      in_index += int(coord) * int(params.in_strides[dim]);
      out_index += int(coord) * int(params.out_strides[dim]);
    }
    uint word = input_a.values[in_index >> 2];
    uint lane = uint(in_index & 3);
    uint b = (lane == 0u)
        ? (word & 0xFFu)
        : (lane == 1u)
        ? ((word >> 8u) & 0xFFu)
        : (lane == 2u)
        ? ((word >> 16u) & 0xFFu)
        : ((word >> 24u) & 0xFFu);
    uint shift = uint(out_index & 3) * 8u;
    atomicAnd(output_data.values[out_index >> 2], ~(0xFFu << shift));
    atomicOr(output_data.values[out_index >> 2], (b != 0u ? 1u : 0u) << shift);
    if (params.count - index <= stride) {
      break;
    }
    index += stride;
  }
#else
  uint index = gl_GlobalInvocationID.x;
  uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  while (index < params.count) {
    uint rem = index;
    int in_index = int(params.lhs_offset);
    int out_index = int(params.output_offset);
    for (int dim = int(params.dims) - 1; dim >= 0; --dim) {
      uint coord = rem % params.shape[dim];
      rem /= params.shape[dim];
      in_index += int(coord) * int(params.in_strides[dim]);
      out_index += int(coord) * int(params.out_strides[dim]);
    }
    output_data.values[out_index] =
        STORE_VALUE(LOAD_VALUE(input_a.values[in_index]));
    if (params.count - index <= stride) {
      break;
    }
    index += stride;
  }
#endif
}
