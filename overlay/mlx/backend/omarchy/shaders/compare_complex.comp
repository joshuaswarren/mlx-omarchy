//
// Complex64 comparison kernel: two vec2 operands per element, one
// word-packed bool output, the same transport contract compare.comp
// uses for the scalar dtypes. One element is a vec2 (re, im), so
// every offset in the params is a complex item offset.
//
// Ordering follows the upstream complex64_t operators: comparisons
// are lexicographic on (real, then imaginary), with IEEE semantics
// inside each component (every ordered comparison against NaN is
// false). Equality is componentwise exact; the NaNEqual flag
// (params.flags bit 0) treats an operand as NaN when either component
// is NaN, matching the upstream NaNEqual complex instantiation.
//
// Operation codes match ComparisonOperation in ../primitives.cpp:
// 0 Equal, 1 GreaterEqual, 2 Greater, 3 Less, 4 LessEqual,
// 5 NotEqual. One plain word store per output word, no atomicOr and
// no zero-fill requirement, and a 6-op selector that stays well below
// the Honeykrisp wide-selector store-coalescing hazard documented in
// compare_bool.comp.

#version 460

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer InputA {
  vec2 values[];
} input_a;
layout(set = 0, binding = 1, std430) readonly buffer InputB {
  vec2 values[];
} input_b;
layout(set = 0, binding = 2, std430) writeonly buffer Output {
  uint words[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  // dims == 0 selects the modulo fast path below. Otherwise the output
  // is unraveled over shape[] and lhs_strides/rhs_strides index the
  // operands; a stride of 0 broadcasts the axis.
  uint dims;
  uint shape[4];
  uint lhs_strides[4];
  uint rhs_strides[4];
} params;

uint lhs_index_for(uint index) {
  if (params.dims == 0u) {
    return params.lhs_offset + (params.lhs_size == 1u
        ? 0u
        : (params.lhs_size == params.count ? index : index % params.lhs_size));
  }
  uint rem = index;
  uint result = params.lhs_offset;
  for (int dim = int(params.dims) - 1; dim >= 0; --dim) {
    uint coord = rem % params.shape[dim];
    rem /= params.shape[dim];
    result += coord * params.lhs_strides[dim];
  }
  return result;
}

uint rhs_index_for(uint index) {
  if (params.dims == 0u) {
    return params.rhs_offset + (params.rhs_size == 1u
        ? 0u
        : (params.rhs_size == params.count ? index : index % params.rhs_size));
  }
  uint rem = index;
  uint result = params.rhs_offset;
  for (int dim = int(params.dims) - 1; dim >= 0; --dim) {
    uint coord = rem % params.shape[dim];
    rem /= params.shape[dim];
    result += coord * params.rhs_strides[dim];
  }
  return result;
}

bool complex_nan(vec2 value) {
  return isnan(value.x) || isnan(value.y);
}

void main() {
  uint word_index = gl_GlobalInvocationID.x;
  uint word_stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  uint word_count = (params.count + 3u) >> 2u;
  while (word_index < word_count) {
    uint base = word_index * 4u;
    uint word = 0u;
    for (uint lane = 0u; lane < 4u; ++lane) {
      uint index = base + lane;
      if (index >= params.count) {
        break;
      }
      vec2 a = input_a.values[lhs_index_for(index)];
      vec2 b = input_b.values[rhs_index_for(index)];
      // Lexicographic ordering on (real, then imaginary): each of the
      // four ordered comparisons mirrors one upstream complex64_t
      // operator directly, so NaN operands keep C++ semantics (every
      // ordered comparison false, equality false, inequality true).
      bool ge = (a.x > b.x) || (a.x == b.x && a.y >= b.y);
      bool gt = (a.x > b.x) || (a.x == b.x && a.y > b.y);
      bool le = (b.x > a.x) || (b.x == a.x && b.y >= a.y);
      bool lt = (b.x > a.x) || (b.x == a.x && b.y > a.y);
      bool eq = a.x == b.x && a.y == b.y;
      bool result = params.operation == 0u ? eq
          : params.operation == 1u ? ge
          : params.operation == 2u ? gt
          : params.operation == 3u ? lt
          : params.operation == 4u ? le
          : !eq;
      if ((params.operation == 0u) && ((params.flags & 1u) != 0u)
          && complex_nan(a) && complex_nan(b)) {
        result = true;
      }
      uint bit = result ? 1u : 0u;
      word |= bit << ((index & 3u) * 8u);
    }
    output_data.words[word_index] = word;
    if (word_count - word_index <= word_stride) {
      break;
    }
    word_index += word_stride;
  }
}
