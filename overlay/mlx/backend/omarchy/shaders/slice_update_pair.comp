#version 460

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer InputA {
  float16_t values[];
} input_a;
layout(set = 0, binding = 1, std430) readonly buffer InputB {
  float16_t values[];
} input_b;
layout(set = 0, binding = 2, std430) writeonly buffer OutputA {
  float16_t values[];
} output_a;
layout(set = 0, binding = 3, std430) writeonly buffer OutputB {
  float16_t values[];
} output_b;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

void main() {
  uint index = gl_GlobalInvocationID.x;
  uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  while (index < params.count) {
    uint rem = index;
    uint in_index = 0u;
    uint out_index = params.output_offset;
    for (int dim = int(params.dims) - 1; dim >= 0; --dim) {
      uint coord = rem % params.shape[dim];
      rem /= params.shape[dim];
      in_index += coord * params.in_strides[dim];
      out_index += coord * params.out_strides[dim];
    }
    output_a.values[out_index] = input_a.values[params.lhs_offset + in_index];
    output_b.values[out_index] = input_b.values[params.rhs_offset + in_index];
    if (params.count - index <= stride) {
      break;
    }
    index += stride;
  }
}
