//
// Fused cross-entropy input gradient, matching CrossEntropy::vjp fallback
// math in mlx/fast.cpp: gx = g * (softmax(logits) - onehot(targets)) with the
// gradient cast back to the logits dtype.
//
// The row logsumexp is recomputed from the logits with the same stable
// max-shifted two-pass form the CrossEntropy forward uses (loss = lse -
// score), so p = exp(x - lse) is the exact softmax probability and the loss
// array is not needed as an input. Targets are only compared against column
// indices, never used as load addresses, so the kernel has no gather path.
//
// Bindings: 0 = logits (storage dtype), 1 = int32 targets, 2 = float32
// cotangent [rows], 3 = gradient output (logits dtype).

#version 460

#ifdef USE_FP16
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#elif defined(USE_BF16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define STORAGE_TYPE uint16_t
#define LOAD_VALUE(x) uintBitsToFloat(uint(x) << 16u)
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
#define STORE_VALUE(f) bf16_store(f)
#else
#define STORAGE_TYPE float
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#endif

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer Logits {
  STORAGE_TYPE values[];
} logits_data;
layout(set = 0, binding = 1, std430) readonly buffer Targets {
  int values[];
} target_data;
layout(set = 0, binding = 2, std430) readonly buffer Cotangent {
  float values[];
} cotangent_data;
layout(set = 0, binding = 3, std430) writeonly buffer Output {
  STORAGE_TYPE values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
} params;

shared float block_values[256];

void main() {
  uint thread = gl_LocalInvocationID.x;
  uint row_length = params.reduce_size;
  uint threads = 256u;

  for (uint row = gl_WorkGroupID.x; row < params.output_size;
       row += gl_NumWorkGroups.x) {
    uint start = params.lhs_offset + row * row_length;

    float local_max = uintBitsToFloat(0xff800000u);
    for (uint index = thread; index < row_length; index += threads) {
      float next = LOAD_VALUE(logits_data.values[start + index]);
      if (isnan(next) || next > local_max) {
        local_max = next;
      }
    }
    block_values[thread] = local_max;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
      if (thread < stride) {
        block_values[thread] =
            max(block_values[thread], block_values[thread + stride]);
      }
      barrier();
    }
    float row_max = block_values[0];
    barrier();

    float local_sum = 0.0;
    for (uint index = thread; index < row_length; index += threads) {
      local_sum +=
          exp(LOAD_VALUE(logits_data.values[start + index]) - row_max);
    }
    block_values[thread] = local_sum;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
      if (thread < stride) {
        block_values[thread] += block_values[thread + stride];
      }
      barrier();
    }
    float lse = row_max + log(block_values[0]);
    float scale = cotangent_data.values[params.aux_offset + row];
    int target = target_data.values[params.rhs_offset + row];
    barrier();

    for (uint index = thread; index < row_length; index += threads) {
      float probability =
          exp(LOAD_VALUE(logits_data.values[start + index]) - lse);
      float onehot = (int(index) == target) ? 1.0 : 0.0;
      float result = scale * (probability - onehot);
      output_data.values[params.output_offset + row * row_length + index] =
          STORE_VALUE(result);
    }
    barrier();
  }
}
