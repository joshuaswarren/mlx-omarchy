#version 460

// Four-wide "precise" SwiGLU: the f32 composition that
// mlx_lm qwen3_next._precise_swiglu builds under MLX_DISABLE_COMPILE=1 —
//   g32 = f32(gate); u32 = f32(up);
//   sig = 1.0 / (1.0 + exp(-g32));
//   r1  = g32 * sig;
//   r2  = r1 * u32;
//   out = bf16(r2)
// with f32 math end to end and NO intermediate narrowing to storage
// (unlike swiglu.comp, whose round4 reproduces the 16-bit interpreter).
// bf16 -> f32 widening is exact and the only storage rounding is the
// final RNE narrow, so the bits match the eager AsType -> FusedChainF32
// -> AsType composition exactly. The fused_chain.cpp tape scan claims
// that seven-node run into one dispatch of this kernel.

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

#define STORAGE_VEC u16vec4
#define LOAD_VEC(x) uintBitsToFloat(uvec4(x) << 16u)
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
#define STORE_VEC(v) \
  u16vec4(bf16_store(v.x), bf16_store(v.y), bf16_store(v.z), bf16_store(v.w))

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer Gate {
  STORAGE_VEC values[];
} gate_buf;
layout(set = 0, binding = 1, std430) readonly buffer Up {
  STORAGE_VEC values[];
} up_buf;
layout(set = 0, binding = 2, std430) writeonly buffer Output {
  STORAGE_VEC values[];
} output_data;

// count in elements; gate_offset / up_offset are element offsets into
// the whole buffers (bindings start at byte 0, allocations 256-byte
// aligned, so in-shader u16vec4 indexing stays 8-byte aligned as long
// as the offsets are multiples of four elements — checked host-side,
// together with count % 4 == 0: unaligned shapes keep the eager
// AsType -> FusedChainF32 -> AsType path).
layout(push_constant) uniform Params {
  uint count;
  uint gate_offset;
  uint up_offset;
  uint unused;
} params;

void main() {
  uint vec_count = params.count / 4u;
  uint index = gl_GlobalInvocationID.x;
  uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  while (index < vec_count) {
    vec4 gate = LOAD_VEC(gate_buf.values[params.gate_offset / 4u + index]);
    vec4 up = LOAD_VEC(up_buf.values[params.up_offset / 4u + index]);
    vec4 sig = 1.0 / (1.0 + exp(-gate));
    vec4 value = (gate * sig) * up;
    output_data.values[index] = STORE_VEC(value);
    if (vec_count - index <= stride) {
      break;
    }
    index += stride;
  }
}
