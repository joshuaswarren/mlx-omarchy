// Fused elementwise chain (FuseDecodeChains, 2026-09-02): evaluates a
// short straight-line program of float unary/binary ops in ONE dispatch
// instead of one dispatch per tape node. The program is a packed uint
// word list in the program buffer; operands are registers (chain-local,
// so intermediates never touch memory) or leaf buffer slots with a
// broadcast addressing mode. Interpreted dispatch, not generated code:
// register pressure stays tiny (8 floats), which is what Honeykrisp
// occupancy tolerates.
//
// Instruction word packing: op[7:0] | a[15:8] | b[23:16] | dst[31:24].
// Operand encoding: 0x00-0x07 = register, 0x10+slot = leaf buffer slot.
// Op codes are the Chain* space packed by fused_chain.cpp
// (chain_op_for maps primitives onto them); they are NOT the
// ElementwiseOperation enum values from ../primitives.cpp.
//
// Rounding contract: a tape node's output is a storage-dtype (f16/f32)
// array, so the per-node path rounds EVERY node's result to the storage
// dtype before the next node loads it. ROUND_INTERMEDIATE applies that
// same rounding to each register write, which makes a fused chain
// BIT-EXACT against the per-node path for both float32 and float16.
//
// STORAGE_TYPE/LOAD_VALUE/STORE_VALUE mirror shaders/elementwise.comp;
// the op formulas below (sigmoid, NaN-propagating max/min) mirror it
// case for case. GLSL max/min return the non-NaN operand, but MLX
// Maximum/Minimum propagate NaN like the other comparator ops.
//
// STORAGE_TYPE/LOAD_VALUE/STORE_VALUE mirror shaders/elementwise.comp.

#version 460

#ifdef USE_FP16
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#define ROUND_INTERMEDIATE(f) float(STORAGE_TYPE(f))
#else
#define STORAGE_TYPE float
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#define ROUND_INTERMEDIATE(f) (f)
#endif

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer LeafA {
  STORAGE_TYPE values[];
} leaf_a;
layout(set = 0, binding = 1, std430) readonly buffer LeafB {
  STORAGE_TYPE values[];
} leaf_b;
layout(set = 0, binding = 2, std430) readonly buffer LeafC {
  STORAGE_TYPE values[];
} leaf_c;
layout(set = 0, binding = 3, std430) readonly buffer Program {
  uint words[];
} program_buf;
layout(set = 0, binding = 4, std430) writeonly buffer Output {
  STORAGE_TYPE values[];
} output_data;

// The host pushes ComputeParams by value (see compute.h). The ten
// scalars below occupy the first ten ComputeParams fields in order, so
// the host mapping (shader name = ComputeParams field) is:
//   count = count, instr_count = operation, last_dim = lhs_size,
//   dst_final = rhs_size,
//   leaf_offset[3] = reduce_size, output_size, lhs_offset
//   leaf_mode[3] = rhs_offset, output_offset, aux_size
// Lockstep with ../fused_chain.cpp evaluate().
layout(push_constant) uniform Params {
  uint count;
  uint instr_count;
  uint last_dim;
  uint dst_final;
  uint leaf_offset[3];
  // Per leaf: 0 = direct, 1 = index % last_dim, 2 = index / last_dim,
  // 3 = scalar (index 0).
  uint leaf_mode[3];
} params;

STORAGE_TYPE load_leaf(uint slot, uint index) {
  uint offset = params.leaf_offset[slot];
  uint address;
  if (params.leaf_mode[slot] == 1u) {
    address = index % params.last_dim;
  } else if (params.leaf_mode[slot] == 2u) {
    address = index / params.last_dim;
  } else if (params.leaf_mode[slot] == 3u) {
    address = 0u;
  } else {
    address = index;
  }
  if (slot == 0u) {
    return leaf_a.values[offset + address];
  }
  if (slot == 1u) {
    return leaf_b.values[offset + address];
  }
  return leaf_c.values[offset + address];
}

float eval_operand(uint operand, uint index, float regs[8]) {
  if (operand <= 7u) {
    return regs[operand];
  }
  return LOAD_VALUE(load_leaf(operand - 0x10u, index));
}

void main() {
  // Grid stride, mirroring elementwise.comp: the dispatcher caps the
  // group count at the device limit, so one invocation covers several
  // chain elements when count exceeds one full grid.
  uint index = gl_GlobalInvocationID.x;
  uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  while (index < params.count) {
    float regs[8];
    for (uint i = 0; i < params.instr_count; ++i) {
      uint word = program_buf.words[i];
      uint op = word & 0xffu;
      uint a = (word >> 8) & 0xffu;
      uint b = (word >> 16) & 0xffu;
      uint dst = (word >> 24) & 0xffu;
      float lhs = eval_operand(a, index, regs);
      float rhs = eval_operand(b, index, regs);
      float value;
      switch (op) {
        case 0u: // Add
          value = lhs + rhs;
          break;
        case 1u: // Multiply
          value = lhs * rhs;
          break;
        case 2u: // Divide
          value = lhs / rhs;
          break;
        case 3u: // Maximum: NaN propagates, mirroring elementwise.comp.
          value = (isnan(lhs) || isnan(rhs))
              ? uintBitsToFloat(0x7fc00000u)
              : max(lhs, rhs);
          break;
        case 4u: // Exp
          value = exp(lhs);
          break;
        case 5u: // Sigmoid: same unguarded form as elementwise.comp
          // case 5. exp underflows to 0 for large positive x and
          // overflows to inf for large negative x, both of which the
          // division folds to the correct 1.0 / 0.0 without producing
          // the inf/inf NaN a sign-guarded form would.
          value = 1.0 / (1.0 + exp(-lhs));
          break;
        case 6u: // Square
          value = lhs * lhs;
          break;
        case 7u: // Sqrt
          value = sqrt(lhs);
          break;
        case 8u: // Rsqrt
          value = inversesqrt(lhs);
          break;
        case 9u: // Subtract
          value = lhs - rhs;
          break;
        case 10u: // Negative
          value = -lhs;
          break;
        case 11u: // Minimum: NaN propagates, mirroring elementwise.comp.
          value = (isnan(lhs) || isnan(rhs))
              ? uintBitsToFloat(0x7fc00000u)
              : min(lhs, rhs);
          break;
        case 12u: // Tanh
          value = tanh(lhs);
          break;
        default:
          return;
      }
      regs[dst] = ROUND_INTERMEDIATE(value);
    }
    output_data.values[index] = STORE_VALUE(regs[params.dst_final]);
    if (params.count - index <= stride) {
      break;
    }
    index += stride;
  }
}
