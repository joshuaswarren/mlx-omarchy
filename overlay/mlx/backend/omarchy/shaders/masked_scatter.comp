//
// MaskedScatter: out holds the copied dst; within each batch row, the
// true mask positions receive consecutive elements of that row's source
// segment, in position order. One workgroup owns one batch row and
// walks it in 256-wide chunks with a shared-memory scan, so the
// source-to-position assignment is a fixed sequential order: fully
// deterministic, matching the upstream CPU loop. When the source
// segment runs out, remaining true positions are skipped, the same
// behavior as the upstream Metal kernel (the CPU variant throws).
//
// The mask arrives as the packed word transport (4 bools per uint32
// word, one byte lane each). dst/out, mask, and src must be
// row-contiguous; params: count = total mask elements, reduce_size =
// mask elements per row, aux_size = src elements per row, rhs_offset =
// mask word offset, lhs_offset = src element offset, output_offset =
// out element offset.

#version 460

#ifdef USE_FP16
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
#elif defined(USE_BF16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define STORAGE_TYPE uint16_t
#elif defined(USE_U32)
#define STORAGE_TYPE uint
#else
#define STORAGE_TYPE float
#endif

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) buffer Output {
  STORAGE_TYPE values[];
} out_data;
layout(set = 0, binding = 1, std430) readonly buffer Mask {
  uint values[];
} mask_data;
layout(set = 0, binding = 2, std430) readonly buffer Source {
  STORAGE_TYPE values[];
} src_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

shared uint s_scan[256];
shared uint s_carry;

void main() {
  uint row = gl_WorkGroupID.x;
  uint row_len = params.reduce_size;
  uint src_len = params.aux_size;
  uint row_begin = row * row_len;
  uint src_begin = row * src_len;
  uint lane = gl_LocalInvocationID.x;
  if (lane == 0u) {
    s_carry = 0u;
  }
  barrier();
  uint carry = 0u;
  for (uint chunk = 0u; chunk < row_len; chunk += 256u) {
    uint pos_in_row = chunk + lane;
    bool live = pos_in_row < row_len;
    uint bit = 0u;
    if (live) {
      uint flat_pos = row_begin + pos_in_row;
      // Honeykrisp miscompiles the Hillis-Steele scan below when the
      // bit is produced by a single dynamic shift
      // (word >> ((index & 3u) * 8u)) & 0xFFu: scan sums undercount as
      // if later iterations dropped (measured s_scan[255]=32 where 128
      // is correct). Extract the byte with CONSTANT shifts and pick the
      // lane by select; the data is identical and the scan is correct.
      // Normalize the byte to 0/1 the way upstream bool casts do, so a
      // stray non-0/1 true byte still counts as true.
      uint word = mask_data.values[params.rhs_offset + (flat_pos >> 2u)];
      uint b0 = word & 0xFFu;
      uint b1 = (word >> 8u) & 0xFFu;
      uint b2 = (word >> 16u) & 0xFFu;
      uint b3 = word >> 24u;
      uint idx = flat_pos & 3u;
      uint byte = (idx == 0u) ? b0 : (idx == 1u) ? b1 : (idx == 2u) ? b2 : b3;
      bit = byte != 0u ? 1u : 0u;
    }
    barrier();
    // Inclusive Hillis-Steele scan over the chunk.
    for (uint offset = 1u; offset < 256u; offset <<= 1u) {
      uint add = 0u;
      if (lane >= offset) {
        add = s_scan[lane - offset];
      }
      barrier();
      s_scan[lane] += add;
      barrier();
    }
    if (bit == 1u) {
      uint rank = carry + s_scan[lane] - 1u;
      if (rank < src_len) {
        out_data.values[params.output_offset + row_begin + pos_in_row] =
            src_data.values[params.lhs_offset + src_begin + rank];
      }
    }
    if (lane == 255u) {
      s_carry += s_scan[255u];
    }
    barrier();
    carry = s_carry;
  }
}
