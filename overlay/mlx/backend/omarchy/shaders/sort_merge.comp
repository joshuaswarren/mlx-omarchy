//
// One bitonic compare-exchange stage over global memory: the multi-block
// continuation of sort_suffix.comp for rows longer than the 1024-element
// in-workgroup limit. The suffix kernel leaves every 1024-element chunk
// of each padded row sorted with the direction the merge network
// requires (even chunks ascending, odd chunks descending), which is the
// state the k <= 1024 stages of the full bitonic network produce. Each
// dispatch of this kernel runs one network stage (block size k,
// sub-stage j) over every padded row: element i pairs with i ^ j inside
// its row, ascending blocks (i & k == 0) keep the smaller element low,
// and the host alternates a ping-pong buffer pair per stage. Padded
// slots hold the PAD sentinel, which sorts after every real element, so
// the finished row keeps its real prefix in [0, row_length). The
// comparator matches sort_suffix.comp exactly: integer modes compare
// order-preserving unsigned keys, while float and complex modes place NaNs
// after every non-NaN and complex values otherwise use lexicographic order. ARGSORT
// mode carries those source positions in a parallel index buffer, which
// keeps the unique stable order across every stage; value mode ties on
// the current position, which never reorders equal keys.

#version 460

#if defined(USE_C64)
#define STORAGE_TYPE vec2
#define KEY_TYPE vec2
#define LOAD_KEY(x) (x)
#define STORE_KEY(k) (k)
#elif defined(USE_FP16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
#define LOAD_KEY(x) float(x)
#define STORE_KEY(k) STORAGE_TYPE(k)
#elif defined(USE_BF16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define STORAGE_TYPE uint16_t
#define LOAD_KEY(x) uintBitsToFloat(uint(x) << 16u)
#define STORE_KEY(k) uint16_t(floatBitsToUint(k) >> 16)
#elif defined(USE_I32)
#define STORAGE_TYPE int
#define KEY_TYPE uint
// Order-preserving map from int32 to uint32: flip the sign bit. Negative
// words map below non-negative words, and the mapping is monotone.
#define LOAD_KEY(x) (uint(x) ^ 0x80000000u)
#define STORE_KEY(k) int((k) ^ 0x80000000u)
#elif defined(USE_U32)
#define STORAGE_TYPE uint
#define KEY_TYPE uint
#define LOAD_KEY(x) (x)
#define STORE_KEY(k) (k)
#else
#define STORAGE_TYPE float
#define LOAD_KEY(x) float(x)
#define STORE_KEY(k) STORAGE_TYPE(k)
#endif

#ifndef KEY_TYPE
#define KEY_TYPE float
#endif

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) buffer Keys {
  STORAGE_TYPE values[];
} keys_data;
#ifdef ARGSORT
layout(set = 0, binding = 1, std430) buffer Indices {
  uint values[];
} indices_data;
#endif

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
} params;

#if defined(USE_I32) || defined(USE_U32)
// Strict order on (key, index). Equal keys break on the smaller source
// index, so duplicates keep the unique stable order.
bool key_less(KEY_TYPE key_a, uint index_a, KEY_TYPE key_b, uint index_b) {
  return key_a < key_b || (key_a == key_b && index_a < index_b);
}
#elif defined(USE_C64)
bool key_less(vec2 value_a, uint index_a, vec2 value_b, uint index_b) {
  bool nan_a = isnan(value_a.x) || isnan(value_a.y);
  bool nan_b = isnan(value_b.x) || isnan(value_b.y);
  if (nan_a != nan_b) {
    return nan_b;
  }
  if (nan_a) {
    return index_a < index_b;
  }
  return value_a.x < value_b.x ||
      (value_a.x == value_b.x &&
       (value_a.y < value_b.y ||
        (value_a.y == value_b.y && index_a < index_b)));
}
#else
// Strict order on (value, index) keys. A NaN key sorts after every number,
// and two NaN keys order by source index, which also keeps real NaNs ahead
// of the NaN padding.
bool key_less(float value_a, uint index_a, float value_b, uint index_b) {
  bool nan_a = isnan(value_a);
  bool nan_b = isnan(value_b);
  if (nan_a != nan_b) {
    return nan_b;
  }
  if (nan_a) {
    return index_a < index_b;
  }
  return value_a < value_b || (value_a == value_b && index_a < index_b);
}
#endif

void main() {
  uint stride = gl_NumWorkGroups.x * 256u;
  // lhs_size carries the network block size k, rhs_size the sub-stage
  // distance j, reduce_size the padded row length.
  for (uint t = gl_GlobalInvocationID.x; t < params.count; t += stride) {
    uint local = t % params.reduce_size;
    uint partner = local ^ params.rhs_size;
    if (partner <= local) {
      continue;
    }
    uint other = (t - local) + partner;
    KEY_TYPE key = LOAD_KEY(keys_data.values[t]);
    KEY_TYPE partner_key = LOAD_KEY(keys_data.values[other]);
#ifdef ARGSORT
    uint index_key = indices_data.values[t];
    uint partner_index_key = indices_data.values[other];
#else
    uint index_key = local;
    uint partner_index_key = partner;
#endif
    bool ascending = (local & params.lhs_size) == 0u;
    bool swap = ascending
        ? key_less(partner_key, partner_index_key, key, index_key)
        : key_less(key, index_key, partner_key, partner_index_key);
    if (swap) {
      keys_data.values[t] = STORE_KEY(partner_key);
      keys_data.values[other] = STORE_KEY(key);
#ifdef ARGSORT
      indices_data.values[t] = partner_index_key;
      indices_data.values[other] = index_key;
#endif
    }
  }
}
