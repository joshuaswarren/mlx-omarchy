//
// SliceUpdate with a reduce mode (slice_update_add and friends). The
// output already holds a copy of the input when this kernel runs; each
// update element folds into its slice-window position with
// read-modify-write. A slice window visits every output position at
// most once, so no atomics are needed and the fold is deterministic.
//
// params.operation selects the fold:
//   0 Sum  1 Prod  2 Max  3 Min
// Float Max/Min propagate NaN the way the reduce kernels do: an NaN
// update wins over any current value. USE_U32 also carries int32
// (params.aux_offset = 1: signed Max/Min compare, bitwise Sum/Prod) and
// uint32 (aux_offset = 2: unsigned compare). USE_BF16 decodes to
// float32, folds, and rounds once per fold through the same bf16_store
// rule the copy and scatter kernels use, so the fold is at least as
// accurate as native half-precision arithmetic.
// The collapsed window rank caps at four entries (shape/in_strides/
// out_strides); the host refuses deeper windows by name.
#version 460

#ifdef USE_FP16
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#elif defined(USE_BF16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define STORAGE_TYPE uint16_t
#define LOAD_VALUE(x) uintBitsToFloat(uint(x) << 16u)
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
#define STORE_VALUE(f) bf16_store(f)
#elif defined(USE_U32)
#define STORAGE_TYPE uint
#define LOAD_VALUE(x) (x)
#define STORE_VALUE(x) (x)
#else
#define STORAGE_TYPE float
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#endif

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer Updates {
  STORAGE_TYPE values[];
} upd_data;
layout(set = 0, binding = 1, std430) buffer Output {
  STORAGE_TYPE values[];
} out_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

#ifdef USE_U32

STORAGE_TYPE fold(STORAGE_TYPE current, STORAGE_TYPE update) {
  if (params.operation == 0u) {
    return current + update;
  }
  if (params.operation == 1u) {
    return current * update;
  }
  if (params.aux_offset == 1u) {
    // int32: signed compare, sum and product are bitwise identical.
    int a = int(current);
    int b = int(update);
    if (params.operation == 2u) {
      return uint(b > a ? b : a);
    }
    return uint(b < a ? b : a);
  }
  if (params.operation == 2u) {
    return update > current ? update : current;
  }
  return update < current ? update : current;
}

#else

STORAGE_TYPE fold(STORAGE_TYPE current, STORAGE_TYPE update) {
  float a = LOAD_VALUE(current);
  float b = LOAD_VALUE(update);
  if (params.operation == 0u) {
    return STORE_VALUE(a + b);
  }
  if (params.operation == 1u) {
    return STORE_VALUE(a * b);
  }
  // NaN wins, matching the reduce kernels.
  if (params.operation == 2u) {
    return STORE_VALUE(isnan(b) || b > a ? b : a);
  }
  return STORE_VALUE(isnan(b) || b < a ? b : a);
}

#endif

void main() {
  uint t = gl_GlobalInvocationID.x;
  uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  while (t < params.count) {
    uint rem = t;
    uint in_index = 0u;
    uint out_index = params.output_offset;
    for (int dim = int(params.dims) - 1; dim >= 0; --dim) {
      uint coord = rem % params.shape[dim];
      rem /= params.shape[dim];
      in_index += coord * params.in_strides[dim];
      out_index += coord * params.out_strides[dim];
    }
    out_data.values[out_index] = fold(
        out_data.values[out_index],
        upd_data.values[params.lhs_offset + in_index]);
    if (params.count - t <= stride) {
      break;
    }
    t += stride;
  }
}
