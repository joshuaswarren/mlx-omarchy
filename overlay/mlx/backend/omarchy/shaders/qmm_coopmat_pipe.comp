#version 460
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Software-pipelined twin of qmm_coopmat.comp (bench arm 6,
// MLX_OMARCHY_QMM_COOP_BENCH=6). Identical tile geometry, arithmetic and
// per-output k accumulation order; the schedule differs: the step loop
// issues the global loads for step s+1 before the matrix work of step
// s, dequantizes and stores them after it, and takes ONE workgroup
// barrier per step instead of two. The x and w staging buffers are
// doubled (8 KiB total) so the store for step s+1 never races the
// matrix reads of step s-1 (the barrier at the end of iteration s-1
// orders those reads). Step indices are flattened over the whole k
// range: step s covers k [16s, 16s+16), so the x word offset is 8*s,
// the weight word offset is 2*s + w_part, and the scale/bias group is
// s/4. Digest-preserving by construction: every output's f32 ffma
// chain is the ascending-8-wide coopmat sequence of the shipped kernel.
// Never default: selected only by the bench arm env.

const uint TILE_M = 32u;
const uint TILE_N = 32u;
const uint STEP_K = 16u;
const uint MAT = 8u;
const uint SUBGROUP_ROW_BLOCKS = 2u;
const uint ROW_BLOCKS = TILE_M / 8u;
const uint X_LOADS = TILE_M / 8u;

layout(local_size_x = 64) in;

layout(set = 0, binding = 0, std430) readonly buffer InputX {
  uint values[];
} input_x;
layout(set = 0, binding = 1, std430) readonly buffer InputW {
  uint values[];
} input_w;
layout(set = 0, binding = 2, std430) readonly buffer Scales {
  float16_t values[];
} scales;
layout(set = 0, binding = 3, std430) readonly buffer Biases {
  float16_t values[];
} biases;
layout(set = 0, binding = 4, std430) writeonly buffer Output {
  float16_t values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

// Two buffered step tiles: x_s[2][32x16], w_s[2][16x32].
shared float x_s[2][TILE_M * STEP_K];
shared float w_s[2][STEP_K * TILE_N];

void main() {
  uint lid = gl_LocalInvocationID.x;
  uint sub = gl_SubgroupID;
  uint sub_rb = SUBGROUP_ROW_BLOCKS * sub;
  uint batch = params.shape[0];
  uint w_batch_words = params.shape[1];
  uint param_batch = params.shape[2];
  uint x_batch_rows = params.matrix_m * params.matrix_k;
  uint m_tiles = (params.matrix_m + TILE_M - 1u) / TILE_M;
  uint n_tiles = (params.matrix_n + TILE_N - 1u) / TILE_N;
  uint k_chunks = params.matrix_k / 64u;
  uint total_steps = k_chunks * (64u / STEP_K);
  uint words_per_row = params.matrix_k / 8u;
  uint groups_per_row = params.matrix_k / 64u;
  uint x_words_per_row = params.matrix_k / 2u;
  uint w_column_local = lid % 32u;
  uint w_part = lid / 32u;

  for (uint b = 0u; b < batch; ++b) {
  uint w_slice = params.rhs_offset + b * w_batch_words;
  uint scale_slice = params.aux_offset + b * param_batch;
  uint bias_slice = params.aux_size + b * param_batch;
  uint x_slice = (params.lhs_offset + b * x_batch_rows) / 2u;
  uint out_slice = params.output_offset +
      b * params.matrix_m * params.matrix_n;
  for (uint tile_row = gl_WorkGroupID.y; tile_row < m_tiles;
       tile_row += gl_NumWorkGroups.y) {
    uint row_base = tile_row * TILE_M;
    for (uint tile_col = gl_WorkGroupID.x; tile_col < n_tiles;
         tile_col += gl_NumWorkGroups.x) {
      uint column = tile_col * TILE_N + w_column_local;
      bool column_ok = column < params.matrix_n;
      uint w_row = w_slice + column * words_per_row;
      uint scale_row = scale_slice + column * groups_per_row;
      uint bias_row = bias_slice + column * groups_per_row;

      // Row predicate and word row are step-invariant; hoisted.
      uint x_local_row[X_LOADS];
      uint x_row_id[X_LOADS];
      bool x_row_ok[X_LOADS];
      for (uint j = 0u; j < X_LOADS; ++j) {
        uint i = lid + 64u * j;
        x_local_row[j] = i / 8u;
        x_row_id[j] = row_base + x_local_row[j];
        x_row_ok[j] = x_row_id[j] < params.matrix_m;
      }

      coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseAccumulator>
          acc[SUBGROUP_ROW_BLOCKS][4];
      for (uint rb = 0u; rb < SUBGROUP_ROW_BLOCKS; ++rb) {
        for (uint cb = 0u; cb < 4u; ++cb) {
          acc[rb][cb] = coopmat<float, gl_ScopeSubgroup, MAT, MAT,
              gl_MatrixUseAccumulator>(0.0);
        }
      }

      // Stage step 0 into buffer 0 before the loop.
      {
        uint s = 0u;
        uint chunk = s / 4u;
        float scale = column_ok
            ? float(scales.values[scale_row + chunk]) : 0.0;
        float bias = column_ok
            ? float(biases.values[bias_row + chunk]) : 0.0;
        uint packed = column_ok
            ? input_w.values[w_row + 2u * s + w_part] : 0u;
        uint w_base = 8u * w_part * TILE_N + w_column_local;
        w_s[0u][w_base + 0u * TILE_N] =
            scale * float(packed & 0xFu) + bias;
        w_s[0u][w_base + 1u * TILE_N] =
            scale * float((packed >> 4u) & 0xFu) + bias;
        w_s[0u][w_base + 2u * TILE_N] =
            scale * float((packed >> 8u) & 0xFu) + bias;
        w_s[0u][w_base + 3u * TILE_N] =
            scale * float((packed >> 12u) & 0xFu) + bias;
        w_s[0u][w_base + 4u * TILE_N] =
            scale * float((packed >> 16u) & 0xFu) + bias;
        w_s[0u][w_base + 5u * TILE_N] =
            scale * float((packed >> 20u) & 0xFu) + bias;
        w_s[0u][w_base + 6u * TILE_N] =
            scale * float((packed >> 24u) & 0xFu) + bias;
        w_s[0u][w_base + 7u * TILE_N] =
            scale * float(packed >> 28u) + bias;
        for (uint j = 0u; j < X_LOADS; ++j) {
          uint word = x_row_ok[j]
              ? input_x.values[x_slice + x_row_id[j] * x_words_per_row +
                               8u * s + (lid % 8u)]
              : 0u;
          vec2 pair = unpackHalf2x16(word);
          x_s[0u][x_local_row[j] * STEP_K + 2u * (lid % 8u)] = pair.x;
          x_s[0u][x_local_row[j] * STEP_K + 2u * (lid % 8u) + 1u] =
              pair.y;
        }
      }
      barrier();

      for (uint s = 0u; s < total_steps; ++s) {
        uint buf = s & 1u;
        uint nbuf = buf ^ 1u;
        uint s1 = s + 1u;
        bool has_next = s1 < total_steps;
        uint chunk1 = s1 / 4u;

        // Issue the step s+1 loads first so their latency overlaps the
        // matrix work below.
        uint x_words[X_LOADS];
        uint packed1 = 0u;
        float scale1 = 0.0;
        float bias1 = 0.0;
        if (has_next) {
          scale1 = column_ok
              ? float(scales.values[scale_row + chunk1]) : 0.0;
          bias1 = column_ok
              ? float(biases.values[bias_row + chunk1]) : 0.0;
          packed1 = column_ok
              ? input_w.values[w_row + 2u * s1 + w_part] : 0u;
          for (uint j = 0u; j < X_LOADS; ++j) {
            x_words[j] = x_row_ok[j]
                ? input_x.values[x_slice + x_row_id[j] * x_words_per_row +
                                 8u * s1 + (lid % 8u)]
                : 0u;
          }
        }

        for (uint ks = 0u; ks < STEP_K / MAT; ++ks) {
          coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseA>
              mat_a[SUBGROUP_ROW_BLOCKS];
          coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseB>
              mat_b[4];
          for (uint rb = 0u; rb < SUBGROUP_ROW_BLOCKS; ++rb) {
            coopMatLoad(
                mat_a[rb], x_s[buf],
                (sub_rb + rb) * MAT * STEP_K + ks * MAT, STEP_K,
                gl_CooperativeMatrixLayoutRowMajor);
          }
          for (uint cb = 0u; cb < 4u; ++cb) {
            coopMatLoad(
                mat_b[cb], w_s[buf], ks * MAT * TILE_N + cb * MAT,
                TILE_N, gl_CooperativeMatrixLayoutRowMajor);
          }
          for (uint rb = 0u; rb < SUBGROUP_ROW_BLOCKS; ++rb) {
            for (uint cb = 0u; cb < 4u; ++cb) {
              acc[rb][cb] =
                  coopMatMulAdd(mat_a[rb], mat_b[cb], acc[rb][cb]);
            }
          }
        }

        // Dequantize and store step s+1 into the other buffer.
        if (has_next) {
          uint w_base = 8u * w_part * TILE_N + w_column_local;
          w_s[nbuf][w_base + 0u * TILE_N] =
              scale1 * float(packed1 & 0xFu) + bias1;
          w_s[nbuf][w_base + 1u * TILE_N] =
              scale1 * float((packed1 >> 4u) & 0xFu) + bias1;
          w_s[nbuf][w_base + 2u * TILE_N] =
              scale1 * float((packed1 >> 8u) & 0xFu) + bias1;
          w_s[nbuf][w_base + 3u * TILE_N] =
              scale1 * float((packed1 >> 12u) & 0xFu) + bias1;
          w_s[nbuf][w_base + 4u * TILE_N] =
              scale1 * float((packed1 >> 16u) & 0xFu) + bias1;
          w_s[nbuf][w_base + 5u * TILE_N] =
              scale1 * float((packed1 >> 20u) & 0xFu) + bias1;
          w_s[nbuf][w_base + 6u * TILE_N] =
              scale1 * float((packed1 >> 24u) & 0xFu) + bias1;
          w_s[nbuf][w_base + 7u * TILE_N] =
              scale1 * float(packed1 >> 28u) + bias1;
          for (uint j = 0u; j < X_LOADS; ++j) {
            vec2 pair = unpackHalf2x16(x_words[j]);
            x_s[nbuf][x_local_row[j] * STEP_K + 2u * (lid % 8u)] =
                pair.x;
            x_s[nbuf][x_local_row[j] * STEP_K + 2u * (lid % 8u) + 1u] =
                pair.y;
          }
        }
        // Orders the matrix reads of step s-1 (same buffer as the
        // stores just issued) before them, and the stores of step s+1
        // before the matrix reads of step s+1.
        barrier();
      }

      // One subgroup stores each 8-row block it owns; duplicated column
      // lanes each drain their four distinct rows of that block.
      for (uint rb = 0u; rb < ROW_BLOCKS; ++rb) {
        if (sub_rb == (rb & ~(SUBGROUP_ROW_BLOCKS - 1u))) {
          for (uint cb = 0u; cb < 4u; ++cb) {
            coopMatStore(
                acc[rb & (SUBGROUP_ROW_BLOCKS - 1u)][cb], x_s[0u],
                cb * MAT * MAT, MAT,
                gl_CooperativeMatrixLayoutRowMajor);
          }
        }
        barrier();
        if (column_ok) {
          for (uint pass = 0u; pass < 4u; ++pass) {
            uint r = 4u * w_part + pass;
            uint row = row_base + rb * MAT + r;
            if (row < params.matrix_m) {
              output_data.values[out_slice + row * params.matrix_n + column] =
                  float16_t(x_s[0u][(w_column_local / 8u) * MAT * MAT +
                                    r * MAT + (w_column_local % 8u)]);
            }
          }
        }
        barrier();
      }
    }
  }
  }
}
