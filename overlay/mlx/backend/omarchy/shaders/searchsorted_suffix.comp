#version 460

#ifdef USE_FP16
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define SOURCE_TYPE float16_t
#define VALUE_TYPE float
#define LOAD_VALUE(x) float(x)
#elif defined(USE_BF16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define SOURCE_TYPE uint16_t
#define VALUE_TYPE float
#define LOAD_VALUE(x) uintBitsToFloat(uint(x) << 16u)
#elif defined(USE_I32)
#define SOURCE_TYPE int
#define VALUE_TYPE int
#define LOAD_VALUE(x) (x)
#elif defined(USE_U32)
#define SOURCE_TYPE uint
#define VALUE_TYPE uint
#define LOAD_VALUE(x) (x)
#else
#define SOURCE_TYPE float
#define VALUE_TYPE float
#define LOAD_VALUE(x) float(x)
#endif

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer SortedSequence {
  SOURCE_TYPE values[];
} sequence;
layout(set = 0, binding = 1, std430) readonly buffer InputValues {
  SOURCE_TYPE values[];
} values;
layout(set = 0, binding = 2, std430) writeonly buffer Output {
  uint values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
} params;

bool ordered_less(VALUE_TYPE lhs, VALUE_TYPE rhs) {
#if defined(USE_I32) || defined(USE_U32)
  return lhs < rhs;
#else
  return lhs < rhs || (!isnan(lhs) && isnan(rhs));
#endif
}

void main() {
  uint index = gl_GlobalInvocationID.x;
  uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  while (index < params.count) {
    VALUE_TYPE x = LOAD_VALUE(values.values[params.rhs_offset + index]);
    uint low = 0u;
    uint high = params.reduce_size;
    while (low < high) {
      uint mid = low + (high - low) / 2u;
      VALUE_TYPE m = LOAD_VALUE(sequence.values[params.lhs_offset + mid]);
      bool below = params.operation == 1u
          ? !ordered_less(x, m)
          : ordered_less(m, x);
      if (below) {
        low = mid + 1u;
      } else {
        high = mid;
      }
    }
    output_data.values[params.output_offset + index] = low;
    if (params.count - index <= stride) {
      break;
    }
    index += stride;
  }
}
