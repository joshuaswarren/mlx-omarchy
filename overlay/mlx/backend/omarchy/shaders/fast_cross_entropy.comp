//
// Fused cross-entropy forward, matching the CrossEntropy fallback in
// mlx/fast.cpp: loss_row = logsumexp(logits_row) - logits_row[target]. The
// output is always float32, like the upstream astype(loss, float32). One
// workgroup handles one row with the same stable max-shifted logsumexp the
// Metal kernel uses; arithmetic runs in float32 for every logits storage
// dtype. Targets must be in-bounds class indices (the upstream contract).

#version 460

#ifdef USE_FP16
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
#define LOAD_VALUE(x) float(x)
#elif defined(USE_BF16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define STORAGE_TYPE uint16_t
#define LOAD_VALUE(x) uintBitsToFloat(uint(x) << 16u)
#else
#define STORAGE_TYPE float
#define LOAD_VALUE(x) float(x)
#endif

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer Logits {
  STORAGE_TYPE values[];
} logits_data;
layout(set = 0, binding = 1, std430) readonly buffer Targets {
  int values[];
} target_data;
layout(set = 0, binding = 2, std430) writeonly buffer Output {
  float values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
} params;

shared float block_values[256];

void main() {
  uint thread = gl_LocalInvocationID.x;
  uint row_length = params.reduce_size;
  uint threads = 256u;

  for (uint row = gl_WorkGroupID.x; row < params.output_size;
       row += gl_NumWorkGroups.x) {
    uint start = params.lhs_offset + row * row_length;

    float local_max = uintBitsToFloat(0xff800000u);
    for (uint index = thread; index < row_length; index += threads) {
      float next = LOAD_VALUE(logits_data.values[start + index]);
      if (isnan(next) || next > local_max) {
        local_max = next;
      }
    }
    block_values[thread] = local_max;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
      if (thread < stride) {
        block_values[thread] =
            max(block_values[thread], block_values[thread + stride]);
      }
      barrier();
    }
    float row_max = block_values[0];
    barrier();

    float local_sum = 0.0;
    for (uint index = thread; index < row_length; index += threads) {
      local_sum +=
          exp(LOAD_VALUE(logits_data.values[start + index]) - row_max);
    }
    block_values[thread] = local_sum;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
      if (thread < stride) {
        block_values[thread] += block_values[thread + stride];
      }
      barrier();
    }
    if (thread == 0u) {
      float lse = row_max + log(block_values[0]);
      int target = target_data.values[params.rhs_offset + row];
      float score = LOAD_VALUE(
          logits_data.values[start + uint(target)]);
      output_data.values[params.output_offset + row] = lse - score;
    }
    barrier();
  }
}
