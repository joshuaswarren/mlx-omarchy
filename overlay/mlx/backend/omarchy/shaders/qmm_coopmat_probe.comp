#version 460
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Staging-attribution probes for the Q4/group-64 f16 prefill
// cooperative matrix kernel (shaders/qmm_coopmat.comp), for
// receipts/2026-09-12-qmm-staging-attribution. Selected only through
// MLX_OMARCHY_QMM_COOP_PROBE; unset keeps the shipped dispatch.
//
// The four 16-k steps are expanded in the SOURCE (QMM_STEP_BODY x4)
// rather than left to nir_opt_loop_unroll: measurement windows 1-2
// showed that tiny body-size deltas flip the constant-trip step loop
// into compiler-restructured forms that swamp the attribution signal,
// and DontUnroll loop control is not honored end to end. Manual
// expansion pins identical structure across paths by construction;
// per-output accumulation order is unchanged (still ascending k), so
// the hoist path remains bit-preserving and the digest gate still
// proves it against the shipped kernel.
//
// Paths (compiled via -DQMM_COOP_PROBE_PATH):
//   1  hoist: per-lane staging addresses computed once per output tile
//      (identical integer values to the shipped per-step computation).
//   2  nodequant: dequant stores become raw u32->f32 casts of the
//      packed word. Output values are WRONG; timing attribution probe,
//      never a landing candidate.
//   3  unrollbase: shipped staging arithmetic verbatim, manually
//      unrolled - the structure control for paths 1 and 2.

#define QMM_PATH QMM_COOP_PROBE_PATH

const uint TILE_M = 32u;
const uint TILE_N = 32u;
const uint CHUNK_K = 64u;
const uint STEP_K = 16u;
const uint MAT = 8u;

layout(local_size_x = 64) in;

layout(set = 0, binding = 0, std430) readonly buffer InputX {
  uint values[];
} input_x;
layout(set = 0, binding = 1, std430) readonly buffer InputW {
  uint values[];
} input_w;
layout(set = 0, binding = 2, std430) readonly buffer Scales {
  float16_t values[];
} scales;
layout(set = 0, binding = 3, std430) readonly buffer Biases {
  float16_t values[];
} biases;
layout(set = 0, binding = 4, std430) writeonly buffer Output {
  float16_t values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

shared float x_s[TILE_M * STEP_K];
shared float w_s[STEP_K * TILE_N];

// One 16-k step: stage x and w into shared, then the two ascending
// 8-wide coopmat updates. (S) is the step index within the 64-k chunk;
// k_base is its only use. See the file header for the path contract.
#define QMM_STEP_BODY(S) { \
  uint k_base = chunk * CHUNK_K + (S) * STEP_K; \
  uint xw0, xw1, xw2, xw3; \
  if (QMM_PATH == 1u) { \
    uint x_word_k = k_base / 2u; \
    xw0 = x_row_ok[0] ? input_x.values[x_row_addr[0] + x_word_k] : 0u; \
    xw1 = x_row_ok[1] ? input_x.values[x_row_addr[1] + x_word_k] : 0u; \
    xw2 = x_row_ok[2] ? input_x.values[x_row_addr[2] + x_word_k] : 0u; \
    xw3 = x_row_ok[3] ? input_x.values[x_row_addr[3] + x_word_k] : 0u; \
  } else { \
    uint i0 = lid; uint r0 = row_base + i0 / 8u; \
    uint i1 = lid + 64u; uint r1 = row_base + i1 / 8u; \
    uint i2 = lid + 128u; uint r2 = row_base + i2 / 8u; \
    uint i3 = lid + 192u; uint r3 = row_base + i3 / 8u; \
    xw0 = r0 < params.matrix_m \
        ? input_x.values[x_slice + r0 * x_words_per_row + k_base / 2u \
                         + (i0 % 8u)] : 0u; \
    xw1 = r1 < params.matrix_m \
        ? input_x.values[x_slice + r1 * x_words_per_row + k_base / 2u \
                         + (i1 % 8u)] : 0u; \
    xw2 = r2 < params.matrix_m \
        ? input_x.values[x_slice + r2 * x_words_per_row + k_base / 2u \
                         + (i2 % 8u)] : 0u; \
    xw3 = r3 < params.matrix_m \
        ? input_x.values[x_slice + r3 * x_words_per_row + k_base / 2u \
                         + (i3 % 8u)] : 0u; \
  } \
  if (QMM_PATH == 1u) { \
    vec2 p0 = unpackHalf2x16(xw0); \
    x_s[x_s_addr[0]] = p0.x; x_s[x_s_addr[0] + 1u] = p0.y; \
    vec2 p1 = unpackHalf2x16(xw1); \
    x_s[x_s_addr[1]] = p1.x; x_s[x_s_addr[1] + 1u] = p1.y; \
    vec2 p2 = unpackHalf2x16(xw2); \
    x_s[x_s_addr[2]] = p2.x; x_s[x_s_addr[2] + 1u] = p2.y; \
    vec2 p3 = unpackHalf2x16(xw3); \
    x_s[x_s_addr[3]] = p3.x; x_s[x_s_addr[3] + 1u] = p3.y; \
  } else { \
    vec2 p0 = unpackHalf2x16(xw0); \
    x_s[(lid / 8u) * STEP_K + 2u * (lid % 8u)] = p0.x; \
    x_s[(lid / 8u) * STEP_K + 2u * (lid % 8u) + 1u] = p0.y; \
    vec2 p1 = unpackHalf2x16(xw1); \
    x_s[((lid + 64u) / 8u) * STEP_K + 2u * ((lid + 64u) % 8u)] = p1.x; \
    x_s[((lid + 64u) / 8u) * STEP_K + 2u * ((lid + 64u) % 8u) + 1u] = p1.y; \
    vec2 p2 = unpackHalf2x16(xw2); \
    x_s[((lid + 128u) / 8u) * STEP_K + 2u * ((lid + 128u) % 8u)] = p2.x; \
    x_s[((lid + 128u) / 8u) * STEP_K + 2u * ((lid + 128u) % 8u) + 1u] = p2.y; \
    vec2 p3 = unpackHalf2x16(xw3); \
    x_s[((lid + 192u) / 8u) * STEP_K + 2u * ((lid + 192u) % 8u)] = p3.x; \
    x_s[((lid + 192u) / 8u) * STEP_K + 2u * ((lid + 192u) % 8u) + 1u] = p3.y; \
  } \
  uint packed; \
  if (QMM_PATH == 1u) { \
    packed = column_ok ? input_w.values[w_word_addr + k_base / 8u] : 0u; \
  } else { \
    packed = column_ok \
        ? input_w.values[w_row + k_base / 8u + w_part] : 0u; \
  } \
  uint w_base_q = (QMM_PATH == 1u) \
      ? w_s_base : 8u * w_part * TILE_N + w_column_local; \
  if (QMM_PATH == 2u) { \
    float fpacked = float(packed); \
    w_s[w_base_q + 0u * TILE_N] = fpacked; \
    w_s[w_base_q + 1u * TILE_N] = fpacked; \
    w_s[w_base_q + 2u * TILE_N] = fpacked; \
    w_s[w_base_q + 3u * TILE_N] = fpacked; \
    w_s[w_base_q + 4u * TILE_N] = fpacked; \
    w_s[w_base_q + 5u * TILE_N] = fpacked; \
    w_s[w_base_q + 6u * TILE_N] = fpacked; \
    w_s[w_base_q + 7u * TILE_N] = fpacked; \
  } else { \
    w_s[w_base_q + 0u * TILE_N] = scale * float(packed & 0xFu) + bias; \
    w_s[w_base_q + 1u * TILE_N] = scale * float((packed >> 4u) & 0xFu) + bias; \
    w_s[w_base_q + 2u * TILE_N] = scale * float((packed >> 8u) & 0xFu) + bias; \
    w_s[w_base_q + 3u * TILE_N] = scale * float((packed >> 12u) & 0xFu) + bias; \
    w_s[w_base_q + 4u * TILE_N] = scale * float((packed >> 16u) & 0xFu) + bias; \
    w_s[w_base_q + 5u * TILE_N] = scale * float((packed >> 20u) & 0xFu) + bias; \
    w_s[w_base_q + 6u * TILE_N] = scale * float((packed >> 24u) & 0xFu) + bias; \
    w_s[w_base_q + 7u * TILE_N] = scale * float(packed >> 28u) + bias; \
  } \
  barrier(); \
  for (uint ks = 0u; ks < STEP_K / MAT; ++ks) { \
    coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseA> mat_a[2]; \
    coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseB> mat_b[4]; \
    for (uint rb = 0u; rb < 2u; ++rb) { \
      coopMatLoad(mat_a[rb], x_s, \
          (sub_rb + rb) * MAT * STEP_K + ks * MAT, STEP_K, \
          gl_CooperativeMatrixLayoutRowMajor); \
    } \
    for (uint cb = 0u; cb < 4u; ++cb) { \
      coopMatLoad(mat_b[cb], w_s, \
          ks * MAT * TILE_N + cb * MAT, TILE_N, \
          gl_CooperativeMatrixLayoutRowMajor); \
    } \
    for (uint rb = 0u; rb < 2u; ++rb) { \
      for (uint cb = 0u; cb < 4u; ++cb) { \
        acc[rb][cb] = \
            coopMatMulAdd(mat_a[rb], mat_b[cb], acc[rb][cb]); \
      } \
    } \
  } \
  barrier(); \
}

void main() {
  uint lid = gl_LocalInvocationID.x;
  uint sub = gl_SubgroupID;
  uint sub_rb = 2u * sub;
  uint batch = params.shape[0];
  uint w_batch_words = params.shape[1];
  uint param_batch = params.shape[2];
  uint x_batch_rows = params.matrix_m * params.matrix_k;
  uint m_tiles = (params.matrix_m + TILE_M - 1u) / TILE_M;
  uint n_tiles = (params.matrix_n + TILE_N - 1u) / TILE_N;
  uint k_chunks = params.matrix_k / CHUNK_K;
  uint words_per_row = params.matrix_k / 8u;
  uint groups_per_row = params.matrix_k / 64u;
  uint x_words_per_row = params.matrix_k / 2u;
  uint w_column_local = lid % 32u;
  uint w_part = lid / 32u;

  for (uint b = 0u; b < batch; ++b) {
  uint w_slice = params.rhs_offset + b * w_batch_words;
  uint scale_slice = params.aux_offset + b * param_batch;
  uint bias_slice = params.aux_size + b * param_batch;
  uint x_slice = (params.lhs_offset + b * x_batch_rows) / 2u;
  uint out_slice = params.output_offset +
      b * params.matrix_m * params.matrix_n;
  for (uint tile_row = gl_WorkGroupID.y; tile_row < m_tiles;
       tile_row += gl_NumWorkGroups.y) {
    uint row_base = tile_row * TILE_M;
    for (uint tile_col = gl_WorkGroupID.x; tile_col < n_tiles;
         tile_col += gl_NumWorkGroups.x) {
      uint column = tile_col * TILE_N + w_column_local;
      bool column_ok = column < params.matrix_n;
      uint w_row = w_slice + column * words_per_row;
      uint scale_row = scale_slice + column * groups_per_row;
      uint bias_row = bias_slice + column * groups_per_row;

      // Hoisted staging addresses for path 1: lane- and tile-invariant
      // terms computed once. (lid + 64j)/8 == lid/8 + 8j and
      // (lid + 64j) % 8 == lid % 8; the shipped kernel writes these as
      // one composite expression per use inside the step loop.
      uint x_col8 = lid % 8u;
      uint x_row_addr[4];
      uint x_s_addr[4];
      bool x_row_ok[4];
      for (uint j = 0u; j < 4u; ++j) {
        uint i = lid + 64u * j;
        uint local_row = i / 8u;
        uint row = row_base + local_row;
        x_row_ok[j] = row < params.matrix_m;
        x_row_addr[j] = x_slice + row * x_words_per_row + (i % 8u);
        x_s_addr[j] = local_row * STEP_K + 2u * (i % 8u);
      }
      uint w_s_base = 8u * w_part * TILE_N + w_column_local;
      uint w_word_addr = w_row + w_part;

      coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseAccumulator>
          acc[2][4];
      for (uint rb = 0u; rb < 2u; ++rb) {
        for (uint cb = 0u; cb < 4u; ++cb) {
          acc[rb][cb] = coopmat<float, gl_ScopeSubgroup, MAT, MAT,
              gl_MatrixUseAccumulator>(0.0);
        }
      }

      for (uint chunk = 0u; chunk < k_chunks; ++chunk) {
        float scale = 0.0;
        float bias = 0.0;
        if (column_ok) {
          scale = float(scales.values[scale_row + chunk]);
          bias = float(biases.values[bias_row + chunk]);
        }
        QMM_STEP_BODY(0u)
        QMM_STEP_BODY(1u)
        QMM_STEP_BODY(2u)
        QMM_STEP_BODY(3u)
      }

      // One subgroup stores each 16-row half; duplicated column lanes
      // each drain their four distinct rows of the selected 8-row block.
      for (uint rb = 0u; rb < 4u; ++rb) {
        if (sub_rb == (rb & ~1u)) {
          for (uint cb = 0u; cb < 4u; ++cb) {
            coopMatStore(
                acc[rb & 1u][cb], x_s, cb * MAT * MAT, MAT,
                gl_CooperativeMatrixLayoutRowMajor);
          }
        }
        barrier();
        if (column_ok) {
          for (uint pass = 0u; pass < 4u; ++pass) {
            uint r = 4u * w_part + pass;
            uint row = row_base + rb * MAT + r;
            if (row < params.matrix_m) {
              output_data.values[out_slice + row * params.matrix_n + column] =
                  float16_t(x_s[(w_column_local / 8u) * MAT * MAT +
                                r * MAT + (w_column_local % 8u)]);
            }
          }
        }
        barrier();
      }
    }
  }
  }
}
