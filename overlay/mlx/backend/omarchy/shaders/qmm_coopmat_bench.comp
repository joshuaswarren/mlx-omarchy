#version 460
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Bench/data-path arms for the Q4/group-64 f16 prefill cooperative
// matrix kernel (shaders/qmm_coopmat.comp). Selected only through
// MLX_OMARCHY_QMM_COOP_BENCH; arm 0 always means the shipped kernel.
//
// Arms (compiled as separate SPIR-V kernels via -DQMM_COOP_BENCH_PATH):
//   1  chunk staging: one 64-wide k chunk staged per barrier pair
//      (8 barriers per chunk instead of 32), same f32 values and the
//      same ascending 8-wide coopmat updates over k, so the output is
//      bit-identical to the shipped kernel.
//   2  chunk staging with anti-bank-alias strides (x_s row pitch 66,
//      w_s row pitch 34 instead of 64/32); also bit-identical.
//   3  shared-load + MMA ceiling: shared is filled with synthetic
//      values once, the k loop only coopMatLoad + MulAdd. Output is
//      deterministic garbage; measurement arm.
//   4  pure MulAdd ceiling: fragments are loaded once, the k loop
//      only issues coopMatMulAdd. Measures the driver's 8x8x8 fp32
//      matrix rate at the real dispatch shapes; measurement arm.
//   5  pure MulAdd ceiling with ONE independent accumulator chain per
//      lane (latency-bound rung); measurement arm.
//   6  pure MulAdd ceiling, two independent chains; measurement arm.
//   7  pure MulAdd ceiling, four independent chains; measurement arm.
//      Arms 4-7 form the chains-in-flight ladder: 8/1/2/4 chains at
//      the real dispatch shapes, 64 MulAdds per lane per k chunk each.
//   8  double-buffered step staging: staging for the next 16-k step
//      overlaps the current step's MulAdd burst, one barrier per step
//      instead of two, 8 KiB shared. Same per-output ascending-k
//      MulAdd sequence; bit-identical to the shipped kernel.
//   9  load-hoist: shipped staging and barrier cadence, but all six
//      operand fragments for both 8-k halves load before the MulAdd
//      burst, so the 16 MulAdds issue back to back. Bit-identical.
//  10  paired order: arm 9's hoisted loads with each fragment's two
//      updates issued adjacently (two serial updates per chain).
//      Bit-identical; isolates burst width from load placement.

const uint TILE_M = 32u;
const uint TILE_N = 32u;
const uint CHUNK_K = 64u;
const uint MAT = 8u;

#if QMM_COOP_BENCH_PATH == 2
const uint XSTRIDE = 66u;
const uint WSTRIDE = 34u;
#else
const uint XSTRIDE = 64u;
const uint WSTRIDE = 32u;
#endif

// Chains-in-flight ladder (arms 4-7): independent accumulator chains
// updated per loop iteration. Every rung issues 64 MulAdds per lane
// per 64-k chunk, so GFLOP/s compares directly across the ladder.
#if QMM_COOP_BENCH_PATH == 5
const uint ILP_CHAINS = 1u;
#elif QMM_COOP_BENCH_PATH == 6
const uint ILP_CHAINS = 2u;
#elif QMM_COOP_BENCH_PATH == 7
const uint ILP_CHAINS = 4u;
#else
const uint ILP_CHAINS = 8u;
#endif

layout(local_size_x = 64) in;

layout(set = 0, binding = 0, std430) readonly buffer InputX {
  uint values[];
} input_x;
layout(set = 0, binding = 1, std430) readonly buffer InputW {
  uint values[];
} input_w;
layout(set = 0, binding = 2, std430) readonly buffer Scales {
  float16_t values[];
} scales;
layout(set = 0, binding = 3, std430) readonly buffer Biases {
  float16_t values[];
} biases;
layout(set = 0, binding = 4, std430) writeonly buffer Output {
  float16_t values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

#if QMM_COOP_BENCH_PATH == 8
// Two 16-k step buffers: 2x (32x16 x tile) + 2x (16x32 weight tile)
// = 8 KiB, below the 16 KiB occupancy cliff the chunk arms hit.
shared float x_s[2u * TILE_M * 16u];
shared float w_s[2u * 16u * TILE_N];
#else
shared float x_s[TILE_M * XSTRIDE];
shared float w_s[CHUNK_K * WSTRIDE];
#endif

#if QMM_COOP_BENCH_PATH >= 8
// Stage one 16-k step exactly like the shipped kernel: x as exact
// f16->f32 pairs, weights dequantized (scale * nibble + bias) in f32.
// SLOT selects the double-buffer slot (arm 8; arms 9/10 pass 0).
void qmm_stage_step(
    uint b, uint tile_row, uint tile_col, uint k_base, uint slot) {
  uint lid = gl_LocalInvocationID.x;
  uint w_part = lid / 32u;
  uint w_column_local = lid % 32u;
  uint words_per_row = params.matrix_k / 8u;
  uint groups_per_row = params.matrix_k / 64u;
  uint x_words_per_row = params.matrix_k / 2u;
  uint w_slice = params.rhs_offset + b * params.shape[1];
  uint scale_slice = params.aux_offset + b * params.shape[2];
  uint bias_slice = params.aux_size + b * params.shape[2];
  uint x_slice = (params.lhs_offset +
                     b * params.matrix_m * params.matrix_k) / 2u;
  uint row_base = tile_row * TILE_M;
  uint column = tile_col * TILE_N + w_column_local;
  bool column_ok = column < params.matrix_n;
  uint w_row = w_slice + column * words_per_row;
  uint scale_row = scale_slice + column * groups_per_row;
  uint bias_row = bias_slice + column * groups_per_row;
  uint xoff = slot * (TILE_M * 16u);
  for (uint j = 0u; j < 4u; ++j) {
    uint i = lid + 64u * j;
    uint local_row = i / 8u;
    uint row = row_base + local_row;
    uint word = row < params.matrix_m
        ? input_x.values[x_slice + row * x_words_per_row +
              k_base / 2u + (i % 8u)]
        : 0u;
    vec2 pair = unpackHalf2x16(word);
    x_s[xoff + local_row * 16u + 2u * (i % 8u)] = pair.x;
    x_s[xoff + local_row * 16u + 2u * (i % 8u) + 1u] = pair.y;
  }
  uint packed = column_ok
      ? input_w.values[w_row + k_base / 8u + w_part] : 0u;
  float scale = 0.0;
  float bias = 0.0;
  if (column_ok) {
    scale = float(scales.values[scale_row + k_base / 64u]);
    bias = float(biases.values[bias_row + k_base / 64u]);
  }
  uint w_base = slot * (16u * TILE_N) + 8u * w_part * TILE_N +
      w_column_local;
  w_s[w_base] = scale * float(packed & 0xFu) + bias;
  w_s[w_base + 1u * TILE_N] =
      scale * float((packed >> 4u) & 0xFu) + bias;
  w_s[w_base + 2u * TILE_N] =
      scale * float((packed >> 8u) & 0xFu) + bias;
  w_s[w_base + 3u * TILE_N] =
      scale * float((packed >> 12u) & 0xFu) + bias;
  w_s[w_base + 4u * TILE_N] =
      scale * float((packed >> 16u) & 0xFu) + bias;
  w_s[w_base + 5u * TILE_N] =
      scale * float((packed >> 20u) & 0xFu) + bias;
  w_s[w_base + 6u * TILE_N] =
      scale * float((packed >> 24u) & 0xFu) + bias;
  w_s[w_base + 7u * TILE_N] = scale * float(packed >> 28u) + bias;
}
#endif
#if QMM_COOP_BENCH_PATH >= 11
// Register prefetch for one 16-k step: the global loads (four x words,
// the packed weight word, scale, bias) issue while the previous step's
// MulAdd burst and barrier drain run; unpack, dequant, and the shared
// stores happen after the barrier. Values and the shared layout are
// exactly the shipped kernel's (slot-0, x row pitch 16, w row pitch
// TILE_N), so the outputs are bit-identical.
struct QmmPrefetch {
  uint xw[4];
  uint packed;
  float scale;
  float bias;
};

QmmPrefetch qmm_prefetch(uint b, uint tile_row, uint tile_col, uint k_base) {
  uint lid = gl_LocalInvocationID.x;
  uint w_part = lid / 32u;
  uint w_column_local = lid % 32u;
  uint words_per_row = params.matrix_k / 8u;
  uint groups_per_row = params.matrix_k / 64u;
  uint x_words_per_row = params.matrix_k / 2u;
  uint w_slice = params.rhs_offset + b * params.shape[1];
  uint scale_slice = params.aux_offset + b * params.shape[2];
  uint bias_slice = params.aux_size + b * params.shape[2];
  uint x_slice = (params.lhs_offset +
                     b * params.matrix_m * params.matrix_k) / 2u;
  uint row_base = tile_row * TILE_M;
  uint column = tile_col * TILE_N + w_column_local;
  bool column_ok = column < params.matrix_n;
  uint w_row = w_slice + column * words_per_row;
  uint scale_row = scale_slice + column * groups_per_row;
  uint bias_row = bias_slice + column * groups_per_row;
  QmmPrefetch pf;
  for (uint j = 0u; j < 4u; ++j) {
    uint i = lid + 64u * j;
    uint local_row = i / 8u;
    uint row = row_base + local_row;
    pf.xw[j] = row < params.matrix_m
        ? input_x.values[x_slice + row * x_words_per_row +
              k_base / 2u + (i % 8u)]
        : 0u;
  }
  pf.packed = column_ok
      ? input_w.values[w_row + k_base / 8u + w_part] : 0u;
  pf.scale = 0.0;
  pf.bias = 0.0;
  if (column_ok) {
    pf.scale = float(scales.values[scale_row + k_base / 64u]);
    pf.bias = float(biases.values[bias_row + k_base / 64u]);
  }
  return pf;
}

void qmm_stage_from(QmmPrefetch pf) {
  uint lid = gl_LocalInvocationID.x;
  uint w_part = lid / 32u;
  uint w_column_local = lid % 32u;
  for (uint j = 0u; j < 4u; ++j) {
    uint i = lid + 64u * j;
    uint local_row = i / 8u;
    vec2 pair = unpackHalf2x16(pf.xw[j]);
    x_s[local_row * 16u + 2u * (i % 8u)] = pair.x;
    x_s[local_row * 16u + 2u * (i % 8u) + 1u] = pair.y;
  }
  uint w_base = 8u * w_part * TILE_N + w_column_local;
  w_s[w_base] = pf.scale * float(pf.packed & 0xFu) + pf.bias;
  w_s[w_base + 1u * TILE_N] =
      pf.scale * float((pf.packed >> 4u) & 0xFu) + pf.bias;
  w_s[w_base + 2u * TILE_N] =
      pf.scale * float((pf.packed >> 8u) & 0xFu) + pf.bias;
  w_s[w_base + 3u * TILE_N] =
      pf.scale * float((pf.packed >> 12u) & 0xFu) + pf.bias;
  w_s[w_base + 4u * TILE_N] =
      pf.scale * float((pf.packed >> 16u) & 0xFu) + pf.bias;
  w_s[w_base + 5u * TILE_N] =
      pf.scale * float((pf.packed >> 20u) & 0xFu) + pf.bias;
  w_s[w_base + 6u * TILE_N] =
      pf.scale * float((pf.packed >> 24u) & 0xFu) + pf.bias;
  w_s[w_base + 7u * TILE_N] =
      pf.scale * float(pf.packed >> 28u) + pf.bias;
}
#endif

void main() {
  uint lid = gl_LocalInvocationID.x;
  uint sub = gl_SubgroupID;
  uint sub_rb = 2u * sub;
  uint batch = params.shape[0];
  uint w_batch_words = params.shape[1];
  uint param_batch = params.shape[2];
  uint x_batch_rows = params.matrix_m * params.matrix_k;
  uint m_tiles = (params.matrix_m + TILE_M - 1u) / TILE_M;
  uint n_tiles = (params.matrix_n + TILE_N - 1u) / TILE_N;
  uint k_chunks = params.matrix_k / CHUNK_K;
  uint words_per_row = params.matrix_k / 8u;
  uint groups_per_row = params.matrix_k / 64u;
  uint x_words_per_row = params.matrix_k / 2u;
  uint w_column_local = lid % 32u;
  uint w_part = lid / 32u;

#if QMM_COOP_BENCH_PATH >= 3
  // Synthetic operand tiles; values are deterministic and finite.
  for (uint i = lid; i < TILE_M * XSTRIDE; i += 64u) {
    x_s[i] = float((i * 7u) % 64u) * 0.25;
  }
  for (uint i = lid; i < CHUNK_K * WSTRIDE; i += 64u) {
    w_s[i] = float((i * 5u) % 32u) * 0.25;
  }
  barrier();
#endif

#if QMM_COOP_BENCH_PATH >= 4 && QMM_COOP_BENCH_PATH <= 7
  coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseA> acc_in_a[2];
  coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseB> acc_in_b[4];
  for (uint rb = 0u; rb < 2u; ++rb) {
    coopMatLoad(
        acc_in_a[rb],
        x_s,
        (sub_rb + rb) * MAT * XSTRIDE,
        XSTRIDE,
        gl_CooperativeMatrixLayoutRowMajor);
  }
  for (uint cb = 0u; cb < 4u; ++cb) {
    coopMatLoad(
        acc_in_b[cb],
        w_s,
        cb * MAT,
        WSTRIDE,
        gl_CooperativeMatrixLayoutRowMajor);
  }
#endif

  for (uint b = 0u; b < batch; ++b) {
  uint w_slice = params.rhs_offset + b * w_batch_words;
  uint scale_slice = params.aux_offset + b * param_batch;
  uint bias_slice = params.aux_size + b * param_batch;
  uint x_slice = (params.lhs_offset + b * x_batch_rows) / 2u;
  uint out_slice = params.output_offset +
      b * params.matrix_m * params.matrix_n;
  for (uint tile_row = gl_WorkGroupID.y; tile_row < m_tiles;
       tile_row += gl_NumWorkGroups.y) {
    uint row_base = tile_row * TILE_M;
    for (uint tile_col = gl_WorkGroupID.x; tile_col < n_tiles;
         tile_col += gl_NumWorkGroups.x) {
      uint column = tile_col * TILE_N + w_column_local;
      bool column_ok = column < params.matrix_n;

      coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseAccumulator>
          acc[2][4];
      for (uint rb = 0u; rb < 2u; ++rb) {
        for (uint cb = 0u; cb < 4u; ++cb) {
          acc[rb][cb] = coopmat<float, gl_ScopeSubgroup, MAT, MAT,
              gl_MatrixUseAccumulator>(0.0);
        }
      }
#if QMM_COOP_BENCH_PATH >= 11
      // Prefetch covers the chunk boundary: step 3 prefetches the next
      // chunk's step 0, so the initial pf here starts absolute k 0.
      QmmPrefetch pf = qmm_prefetch(b, tile_row, tile_col, 0u);
#endif
      for (uint chunk = 0u; chunk < k_chunks; ++chunk) {
#if QMM_COOP_BENCH_PATH == 8
        // Double-buffered step staging: the next step's operands are
        // staged while the current step's MulAdd burst runs; one
        // barrier per step instead of two. Staged values and the
        // per-output ascending-k MulAdd sequence match the shipped
        // kernel exactly.
        qmm_stage_step(
            b, tile_row, tile_col, chunk * CHUNK_K + 0u * 16u, 0u);
        barrier();
        for (uint step = 0u; step < CHUNK_K / 16u; ++step) {
          if (step + 1u < CHUNK_K / 16u) {
            qmm_stage_step(b, tile_row, tile_col,
                chunk * CHUNK_K + (step + 1u) * 16u, (step + 1u) & 1u);
          }
          uint xoff = (step & 1u) * (TILE_M * 16u);
          uint woff = (step & 1u) * (16u * TILE_N);
          for (uint ks = 0u; ks < 2u; ++ks) {
            coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseA>
                mat_a[2];
            coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseB>
                mat_b[4];
            for (uint rb = 0u; rb < 2u; ++rb) {
              coopMatLoad(
                  mat_a[rb], x_s,
                  xoff + (sub_rb + rb) * (MAT * 16u) + ks * MAT, 16u,
                  gl_CooperativeMatrixLayoutRowMajor);
            }
            for (uint cb = 0u; cb < 4u; ++cb) {
              coopMatLoad(
                  mat_b[cb], w_s,
                  woff + ks * (MAT * TILE_N) + cb * MAT, TILE_N,
                  gl_CooperativeMatrixLayoutRowMajor);
            }
            for (uint rb = 0u; rb < 2u; ++rb) {
              for (uint cb = 0u; cb < 4u; ++cb) {
                acc[rb][cb] =
                    coopMatMulAdd(mat_a[rb], mat_b[cb], acc[rb][cb]);
              }
            }
          }
          barrier();
        }
#elif QMM_COOP_BENCH_PATH == 9 || QMM_COOP_BENCH_PATH == 10
        // Shipped staging and barrier cadence; the operand fragments
        // for BOTH 8-k halves load before any MulAdd, so the 16
        // updates issue back to back. Arm 10 pairs each fragment's
        // two updates adjacently (two serial updates per chain).
        for (uint step = 0u; step < CHUNK_K / 16u; ++step) {
          qmm_stage_step(
              b, tile_row, tile_col, chunk * CHUNK_K + step * 16u, 0u);
          barrier();
          // The step staging uses the shipped layout: x rows pitch 16,
          // w rows pitch TILE_N, so both 8-k halves live in the first
          // 512 floats of each buffer (kk is step-local here).
          coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseA>
              mat_a0[2];
          coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseA>
              mat_a1[2];
          coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseB>
              mat_b0[4];
          coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseB>
              mat_b1[4];
          for (uint rb = 0u; rb < 2u; ++rb) {
            coopMatLoad(
                mat_a0[rb], x_s, (sub_rb + rb) * MAT * 16u, 16u,
                gl_CooperativeMatrixLayoutRowMajor);
            coopMatLoad(
                mat_a1[rb], x_s, (sub_rb + rb) * MAT * 16u + MAT, 16u,
                gl_CooperativeMatrixLayoutRowMajor);
          }
          for (uint cb = 0u; cb < 4u; ++cb) {
            coopMatLoad(
                mat_b0[cb], w_s, cb * MAT, TILE_N,
                gl_CooperativeMatrixLayoutRowMajor);
            coopMatLoad(
                mat_b1[cb], w_s, MAT * TILE_N + cb * MAT, TILE_N,
                gl_CooperativeMatrixLayoutRowMajor);
          }
#if QMM_COOP_BENCH_PATH == 10
          for (uint rb = 0u; rb < 2u; ++rb) {
            for (uint cb = 0u; cb < 4u; ++cb) {
              acc[rb][cb] =
                  coopMatMulAdd(mat_a0[rb], mat_b0[cb], acc[rb][cb]);
              acc[rb][cb] =
                  coopMatMulAdd(mat_a1[rb], mat_b1[cb], acc[rb][cb]);
            }
          }
#else
          for (uint rb = 0u; rb < 2u; ++rb) {
            for (uint cb = 0u; cb < 4u; ++cb) {
              acc[rb][cb] =
                  coopMatMulAdd(mat_a0[rb], mat_b0[cb], acc[rb][cb]);
            }
          }
          for (uint rb = 0u; rb < 2u; ++rb) {
            for (uint cb = 0u; cb < 4u; ++cb) {
              acc[rb][cb] =
                  coopMatMulAdd(mat_a1[rb], mat_b1[cb], acc[rb][cb]);
            }
          }
#endif
          barrier();
        }
#elif QMM_COOP_BENCH_PATH >= 11
        // Register-prefetch schedule at the shipped 4 KiB shared: the
        // next step's global loads issue after the MulAdd bursts and
        // before the end-of-step barrier, so their latency hides behind
        // the burst instead of sitting in the post-barrier staging
        // segment. Arm 12 additionally hoists the shared operand loads
        // above the MulAdd bursts (arm 9's schedule).
        for (uint step = 0u; step < CHUNK_K / 16u; ++step) {
          qmm_stage_from(pf);
          barrier();
#if QMM_COOP_BENCH_PATH == 12
          coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseA>
              mat_a0[2];
          coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseA>
              mat_a1[2];
          coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseB>
              mat_b0[4];
          coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseB>
              mat_b1[4];
          for (uint rb = 0u; rb < 2u; ++rb) {
            coopMatLoad(
                mat_a0[rb], x_s, (sub_rb + rb) * MAT * 16u, 16u,
                gl_CooperativeMatrixLayoutRowMajor);
            coopMatLoad(
                mat_a1[rb], x_s, (sub_rb + rb) * MAT * 16u + MAT, 16u,
                gl_CooperativeMatrixLayoutRowMajor);
          }
          for (uint cb = 0u; cb < 4u; ++cb) {
            coopMatLoad(
                mat_b0[cb], w_s, cb * MAT, TILE_N,
                gl_CooperativeMatrixLayoutRowMajor);
            coopMatLoad(
                mat_b1[cb], w_s, MAT * TILE_N + cb * MAT, TILE_N,
                gl_CooperativeMatrixLayoutRowMajor);
          }
          for (uint rb = 0u; rb < 2u; ++rb) {
            for (uint cb = 0u; cb < 4u; ++cb) {
              acc[rb][cb] =
                  coopMatMulAdd(mat_a0[rb], mat_b0[cb], acc[rb][cb]);
            }
          }
          for (uint rb = 0u; rb < 2u; ++rb) {
            for (uint cb = 0u; cb < 4u; ++cb) {
              acc[rb][cb] =
                  coopMatMulAdd(mat_a1[rb], mat_b1[cb], acc[rb][cb]);
            }
          }
#else
          for (uint ks = 0u; ks < 2u; ++ks) {
            coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseA>
                mat_a[2];
            coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseB>
                mat_b[4];
            for (uint rb = 0u; rb < 2u; ++rb) {
              coopMatLoad(
                  mat_a[rb], x_s,
                  (sub_rb + rb) * (MAT * 16u) + ks * MAT, 16u,
                  gl_CooperativeMatrixLayoutRowMajor);
            }
            for (uint cb = 0u; cb < 4u; ++cb) {
              coopMatLoad(
                  mat_b[cb], w_s,
                  ks * (MAT * TILE_N) + cb * MAT, TILE_N,
                  gl_CooperativeMatrixLayoutRowMajor);
            }
            for (uint rb = 0u; rb < 2u; ++rb) {
              for (uint cb = 0u; cb < 4u; ++cb) {
                acc[rb][cb] =
                    coopMatMulAdd(mat_a[rb], mat_b[cb], acc[rb][cb]);
              }
            }
          }
#endif
          uint prefetch_k = chunk * CHUNK_K + (step + 1u) * 16u;
          if (step + 1u < CHUNK_K / 16u) {
            pf = qmm_prefetch(b, tile_row, tile_col, prefetch_k);
          } else if (chunk + 1u < k_chunks) {
            pf = qmm_prefetch(b, tile_row, tile_col,
                (chunk + 1u) * CHUNK_K);
          }
          barrier();
        }
#elif QMM_COOP_BENCH_PATH >= 5
        // Chains-in-flight ladder rung: ILP_CHAINS independent
        // accumulator chains per iteration, 64 MulAdds per lane per
        // chunk (arm 4's issue count at every rung).
        for (uint iter = 0u; iter < 64u / ILP_CHAINS; ++iter) {
          for (uint i = 0u; i < ILP_CHAINS; ++i) {
            acc[i / 4u][i % 4u] = coopMatMulAdd(
                acc_in_a[i / 4u], acc_in_b[i % 4u], acc[i / 4u][i % 4u]);
          }
        }
#elif QMM_COOP_BENCH_PATH <= 2
        // Stage the whole 64-wide chunk once: x as exact f16->f32
        // pairs, weights dequantized exactly like the shipped kernel
        // (scale * nibble + bias in f32).
        // 32 rows x 64 halves = 1024 packed words, 16 per lane.
        for (uint j = 0u; j < 16u; ++j) {
          uint w = lid + 64u * j;
          uint local_row = w / 32u;
          uint kcol = (w % 32u) * 2u;
          uint row = row_base + local_row;
          uint pair = row < params.matrix_m
              ? input_x.values[
                    x_slice + row * x_words_per_row + chunk * 32u +
                    (w % 32u)]
              : 0u;
          vec2 halves = unpackHalf2x16(pair);
          x_s[local_row * XSTRIDE + kcol] = halves.x;
          x_s[local_row * XSTRIDE + kcol + 1u] = halves.y;
        }
        // 64 k x 32 columns = 256 packed words, 4 per lane.
        for (uint j = 0u; j < 4u; ++j) {
          uint w = lid + 64u * j;
          uint col = w % 32u;
          uint ksub = w / 32u;
          uint wcol = tile_col * TILE_N + col;
          bool col_ok = wcol < params.matrix_n;
          uint packed = col_ok
              ? input_w.values[
                    w_slice + wcol * words_per_row + chunk * 8u + ksub]
              : 0u;
          float cs = 0.0;
          float cb = 0.0;
          if (col_ok) {
            cs = float(scales.values[
                scale_slice + wcol * groups_per_row + chunk]);
            cb = float(biases.values[
                bias_slice + wcol * groups_per_row + chunk]);
          }
          uint dst = (ksub * 8u) * WSTRIDE + col;
          w_s[dst] = cs * float(packed & 0xFu) + cb;
          w_s[dst + WSTRIDE] = cs * float((packed >> 4u) & 0xFu) + cb;
          w_s[dst + 2u * WSTRIDE] =
              cs * float((packed >> 8u) & 0xFu) + cb;
          w_s[dst + 3u * WSTRIDE] =
              cs * float((packed >> 12u) & 0xFu) + cb;
          w_s[dst + 4u * WSTRIDE] =
              cs * float((packed >> 16u) & 0xFu) + cb;
          w_s[dst + 5u * WSTRIDE] =
              cs * float((packed >> 20u) & 0xFu) + cb;
          w_s[dst + 6u * WSTRIDE] =
              cs * float((packed >> 24u) & 0xFu) + cb;
          w_s[dst + 7u * WSTRIDE] =
              cs * float(packed >> 28u) + cb;
        }
        barrier();
#endif
#if QMM_COOP_BENCH_PATH <= 4
        for (uint step = 0u; step < CHUNK_K / 16u; ++step) {
          for (uint ks = 0u; ks < 2u; ++ks) {
#if QMM_COOP_BENCH_PATH == 4
            for (uint rb = 0u; rb < 2u; ++rb) {
              for (uint cb = 0u; cb < 4u; ++cb) {
                acc[rb][cb] = coopMatMulAdd(
                    acc_in_a[rb], acc_in_b[cb], acc[rb][cb]);
              }
            }
#else
            coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseA>
                mat_a[2];
            coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseB>
                mat_b[4];
            // Shared holds one chunk; the k offset inside it is
            // chunk-local. The staged values advance with `chunk`,
            // so the per-output MMA sequence stays the shipped
            // ascending 8-wide walk over k.
            uint kk = step * 16u + ks * 8u;
            for (uint rb = 0u; rb < 2u; ++rb) {
              coopMatLoad(
                  mat_a[rb],
                  x_s,
                  (sub_rb + rb) * MAT * XSTRIDE + kk,
                  XSTRIDE,
                  gl_CooperativeMatrixLayoutRowMajor);
            }
            for (uint cb = 0u; cb < 4u; ++cb) {
              coopMatLoad(
                  mat_b[cb],
                  w_s,
                  kk * WSTRIDE + cb * MAT,
                  WSTRIDE,
                  gl_CooperativeMatrixLayoutRowMajor);
            }
            for (uint rb = 0u; rb < 2u; ++rb) {
              for (uint cb = 0u; cb < 4u; ++cb) {
                acc[rb][cb] =
                    coopMatMulAdd(mat_a[rb], mat_b[cb], acc[rb][cb]);
              }
            }
#endif
          }
        }
#endif
#if QMM_COOP_BENCH_PATH <= 2
        barrier();
#endif
      }

      // One subgroup stores each 16-row half; duplicated column lanes
      // each drain their four distinct rows of the selected 8-row block.
      for (uint rb = 0u; rb < 4u; ++rb) {
        if (sub_rb == (rb & ~1u)) {
          for (uint cb = 0u; cb < 4u; ++cb) {
            coopMatStore(
                acc[rb & 1u][cb], x_s, cb * MAT * MAT, MAT,
                gl_CooperativeMatrixLayoutRowMajor);
          }
        }
        barrier();
        if (column_ok) {
          for (uint pass = 0u; pass < 4u; ++pass) {
            uint r = 4u * w_part + pass;
            uint row = row_base + rb * MAT + r;
            if (row < params.matrix_m) {
              output_data.values[out_slice + row * params.matrix_n + column] =
                  float16_t(x_s[(w_column_local / 8u) * MAT * MAT +
                                r * MAT + (w_column_local % 8u)]);
            }
          }
        }
        barrier();
      }
    }
  }
  }
}
