// General-axis reduction for every rank representable by uint32 extents and
// strides. The host removes singleton axes and collapses adjacent compatible
// axes. Up to four collapsed axes use the push-constant arrays. Higher ranks
// use binding 3 for [extents, strides], with matrix_k carrying the collapsed
// rank. dims and matrix_m carry the kept and reduced counts. Broadcast views
// retain stride 0.
//
// matrix_n is the chunk count: one invocation covers at most chunk-trip
// reduced elements because longer serial loops can stop early on the driver.
//
// flags bit 0 selects the phase. Bit 0 clear: the invocation owns one
// (output element, chunk) pair and writes its partial accumulator to the
// scratch buffer at binding 1 (layout scratch[out_index * matrix_n + chunk]).
// Bit 0 set: the invocation owns one output element and combines its
// matrix_n partials from scratch into the final output at binding 2.
// flags bit 1 (only meaningful with bit 0 clear) marks the single-pass
// layout: reduce_size fits in one chunk, so the accumulator is stored
// straight to the output and scratch goes untouched.
//
// The selector matches ReduceOperation in primitives.cpp: 0 Sum, 1 Prod,
// 2 Min, 3 Max, 4 Any, 5 All.
//
// Scratch (binding 1) holds one accumulator per (output element, chunk).
// Float variants accumulate in float32 and store float32 partials, the rule
// the suffix reduce and scan kernels follow; 16-bit storage never narrows a
// partial. USE_I32 / USE_U32 scratch their own width. BOOL_OUT variants
// scratch one 0/1 uint per partial and word-pack four outputs per 32-bit
// write in the combine phase, the same packing compare.comp and
// logical_or.comp use. USE_BOOL_INPUT reads a bool input through that
// word packing.
//
// Dtype families mirror the upstream remap_reduce_types contract
// (mlx/backend/metal/reduce.cpp): narrow integers accumulate in 32 bits
// (int8/int16 -> int32, uint8/uint16 -> uint32) and Sum/Prod store the
// promoted width, Min/Max store the input width through the packed
// byte/half lanes cast_int.comp proved; int64/uint64 reduce in their own
// width behind the device's shaderInt64; complex64 accumulates as a vec2
// pair with two scratch words per partial.
#version 460

#if defined(USE_FP16) || defined(USE_BF16) || defined(USE_I16) || defined(USE_U16)
#extension GL_EXT_shader_16bit_storage : require
#endif
#ifdef USE_FP16
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#elif defined(USE_I16) || defined(USE_U16)
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#endif
#if defined(USE_I64) || defined(USE_U64)
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#endif

#ifdef USE_FP16
#define STORAGE_TYPE float16_t
#define LOAD_VALUE(x) float(x)
#elif defined(USE_BF16)
#define STORAGE_TYPE uint16_t
#define LOAD_VALUE(x) uintBitsToFloat(uint(x) << 16u)
#elif defined(USE_BOOL_INPUT)
#define STORAGE_TYPE uint
#elif defined(USE_I32)
#define STORAGE_TYPE int
#define LOAD_VALUE(x) STORAGE_TYPE(x)
#elif defined(USE_U32)
#define STORAGE_TYPE uint
#define LOAD_VALUE(x) STORAGE_TYPE(x)
#elif defined(USE_I8) || defined(USE_U8) || defined(USE_I16) || defined(USE_U16)
#define STORAGE_TYPE uint
#else
#define STORAGE_TYPE float
#define LOAD_VALUE(x) float(x)
#endif

#if defined(USE_I8) || defined(USE_I16) || defined(USE_I32)
#define ACC_TYPE int
// -2147483648 has no direct GLSL literal; the C-style two-step avoids the
// unary-minus-parses-first trap.
#define MAX_SENTINEL 2147483647
#define MIN_SENTINEL (-2147483647 - 1)
#define SCRATCH_TYPE int
#elif defined(USE_U8) || defined(USE_U16) || defined(USE_U32)
#define ACC_TYPE uint
#define MAX_SENTINEL 0xffffffffu
#define MIN_SENTINEL 0u
#define SCRATCH_TYPE uint
#elif defined(USE_I64)
#define ACC_TYPE int64_t
#define MAX_SENTINEL 9223372036854775807L
#define MIN_SENTINEL (-9223372036854775807L - 1)
#define SCRATCH_TYPE int64_t
#elif defined(USE_U64)
#define ACC_TYPE uint64_t
#define MAX_SENTINEL 0xffffffffffffffffUL
#define MIN_SENTINEL 0UL
#define SCRATCH_TYPE uint64_t
#elif defined(USE_COMPLEX)
#define ACC_TYPE vec2
#define MIN_SENTINEL uintBitsToFloat(0xff800000u)
#define MAX_SENTINEL uintBitsToFloat(0x7f800000u)
#define SCRATCH_TYPE float
#else
#define ACC_TYPE float
#define MAX_SENTINEL uintBitsToFloat(0x7f800000u)
#define MIN_SENTINEL uintBitsToFloat(0xff800000u)
#define SCRATCH_TYPE float
#endif
#ifdef BOOL_OUT
// Any/All partials are always 0/1 uints; override the typed scratch width
// when an AnyAll variant shares a dtype define with a typed kernel.
#undef SCRATCH_TYPE
#define SCRATCH_TYPE uint
#endif

#ifdef USE_BF16
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
#define STORE_VALUE(f) bf16_store(f)
#elif defined(USE_BOOL_INPUT) && !defined(BOOL_OUT)
#define STORE_VALUE(f) int(f)
#elif defined(USE_COMPLEX)
#else
#define STORE_VALUE(f) STORAGE_TYPE(f)
#endif

// Which load/store transport the blob uses. BYTE_INPUT reads one byte per
// item through the gather-style word load and the constant-shift select
// chain proven in scatter.comp; HALF_INPUT binds a uint16_t storage view;
// WORD64 binds 64-bit words; COMPLEX binds vec2 pairs. Everything else
// reads one STORAGE_TYPE word per item.
#if defined(USE_I8) || defined(USE_U8) || defined(USE_BOOL_INPUT)
#define BYTE_INPUT 1
#elif defined(USE_I16) || defined(USE_U16)
#define HALF_INPUT 1
#elif defined(USE_I64) || defined(USE_U64)
#define WORD64 1
#elif defined(USE_COMPLEX)
#define COMPLEX 1
#endif

#ifdef BOOL_OUT
#define OUT_TYPE uint
#elif defined(USE_BOOL_INPUT)
#define OUT_TYPE int
#elif defined(USE_COMPLEX)
#define OUT_TYPE vec2
#else
#define OUT_TYPE STORAGE_TYPE
#endif

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer Input {
#if defined(BYTE_INPUT)
  uint values[];
#elif defined(HALF_INPUT)
  uint16_t values[];
#elif defined(WORD64)
  uint64_t values[];
#elif defined(COMPLEX)
  vec2 values[];
#else
  STORAGE_TYPE values[];
#endif
} input_data;
layout(set = 0, binding = 1, std430) buffer Scratch {
  SCRATCH_TYPE values[];
} scratch_data;
layout(set = 0, binding = 2, std430) buffer Output {
#if defined(COMPLEX)
  vec2 values[];
#elif defined(USE_I8) || defined(USE_U8) || defined(USE_I16) || defined(USE_U16)
  uint values[];
#elif defined(WORD64)
  uint64_t values[];
#else
  OUT_TYPE values[];
#endif
} output_data;
layout(set = 0, binding = 3, std430) readonly buffer AxisMetadata {
  uint values[];
} axis_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  // dims is the kept-axis count. matrix_m is the reduced-axis count.
  // matrix_k is zero for inline axes or the rank of binding 3 metadata.
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

#if defined(BYTE_INPUT)
// Honeykrisp miscompiles shift-then-mask byte extraction with a
// data-dependent shift amount (receipt 2026-09-02-masked-scatter-m1-fix,
// diag68); the constant-shift select chain is the receipt-proven
// equivalent (the same macro compare_bool.comp and cast_int.comp use).
#define BYTE_AT(word, lane)                                                  \
  ((lane) == 0u ? ((word) & 0xFFu)                                           \
       : (lane) == 1u ? (((word) >> 8u) & 0xFFu)                             \
       : (lane) == 2u ? (((word) >> 16u) & 0xFFu)                            \
                      : (((word) >> 24u) & 0xFFu))
#endif

#if defined(BYTE_INPUT) && !defined(BOOL_OUT)
// Byte inputs extend to the 32-bit accumulator exactly like static_cast:
// int8 sign-extends, uint8 zero-extends, bool canonicalizes to 0/1.
ACC_TYPE load_item(uint item) {
  uint addr = params.lhs_offset + item;
  uint byte = BYTE_AT(input_data.values[addr >> 2u], addr & 3u);
#if defined(USE_I8)
  return (byte & 0x80u) != 0u ? int(byte) - 256 : int(byte);
#elif defined(USE_U8)
  return uint(byte);
#else
  return byte != 0u ? 1 : 0;
#endif
}
#elif defined(BYTE_INPUT)
ACC_TYPE load_item(uint item) {
  uint addr = params.lhs_offset + item;
  uint word = input_data.values[addr >> 2u];
  return BYTE_AT(word, addr & 3u) != 0u ? 1 : 0;
}
#elif defined(HALF_INPUT)
ACC_TYPE load_item(uint item) {
  uint16_t bits = input_data.values[params.lhs_offset + item];
#if defined(USE_I16)
  uint extended = uint(bits);
  return (extended & 0x8000u) != 0u ? int(extended) - 65536 : int(extended);
#else
  return uint(bits);
#endif
}
#elif defined(WORD64)
ACC_TYPE load_item(uint item) {
  return ACC_TYPE(input_data.values[params.lhs_offset + item]);
}
#elif defined(COMPLEX)
ACC_TYPE load_item(uint item) {
  return input_data.values[params.lhs_offset + item];
}
#else
ACC_TYPE load_item(uint item) {
  return LOAD_VALUE(input_data.values[params.lhs_offset + item]);
}
#endif

// Output stores. The output dtype follows the upstream remap contract:
// narrow Sum/Prod store the promoted 32-bit accumulator, narrow Min/Max
// store the input width, everything else stores its own width. Byte and
// half lanes insert with atomics so adjacent elements sharing one word
// stay exact (the cast_int.comp lane-pair shape). Those bindings are
// never writeonly; the omarchy allocator page-rounds every buffer, so
// the word holding the last lane is inside the allocation.
#ifndef BOOL_OUT
void store_output(uint index, ACC_TYPE value) {
#if defined(COMPLEX)
  output_data.values[params.output_offset + index] = value;
#elif defined(WORD64)
  output_data.values[params.output_offset + index] = uint64_t(value);
#elif defined(USE_I8) || defined(USE_U8) || defined(USE_I16) ||               \
    defined(USE_U16)
  if (params.operation <= 1u) {
    // Sum/Prod: the output is the promoted int32/uint32 array.
    output_data.values[params.output_offset + index] = uint(value);
    return;
  }
  uint narrow = uint(value);
  uint addr = params.output_offset + index;
  uint shift;
#if defined(USE_I8) || defined(USE_U8)
  narrow &= 0xFFu;
  shift = (addr & 3u) * 8u;
  atomicAnd(output_data.values[addr >> 2u], ~(0xFFu << shift));
  atomicOr(output_data.values[addr >> 2u], narrow << shift);
#else
  narrow &= 0xFFFFu;
  // addr counts 16-bit items: two share one output word.
  shift = (addr & 1u) * 16u;
  atomicAnd(output_data.values[addr >> 1u], ~(0xFFFFu << shift));
  atomicOr(output_data.values[addr >> 1u], narrow << shift);
#endif
#else
  output_data.values[params.output_offset + index] = STORE_VALUE(value);
#endif
}
#endif

#if defined(USE_COMPLEX)
// Complex partials live as two float words per (element, chunk) pair.
ACC_TYPE load_partial(uint pair, uint component) {
  return vec2(scratch_data.values[2u * pair],
              scratch_data.values[2u * pair + 1u]);
}
void store_partial(uint pair, ACC_TYPE value) {
  scratch_data.values[2u * pair] = value.x;
  scratch_data.values[2u * pair + 1u] = value.y;
}
#else
ACC_TYPE load_partial(uint pair, uint component) {
  return ACC_TYPE(scratch_data.values[pair]);
}
void store_partial(uint pair, ACC_TYPE value) {
  scratch_data.values[pair] = SCRATCH_TYPE(value);
}
#endif

// The accumulator seed for each operation: the empty-reduction identity.
ACC_TYPE init_value(uint operation) {
  if (operation == 0u) {
    return ACC_TYPE(0);
  }
  if (operation == 1u) {
#ifdef USE_COMPLEX
    return ACC_TYPE(1.0, 0.0);
#else
    return ACC_TYPE(1);
#endif
  }
  if (operation == 2u) {
#ifdef USE_COMPLEX
    return ACC_TYPE(MAX_SENTINEL, MAX_SENTINEL);
#else
    return ACC_TYPE(MAX_SENTINEL);
#endif
  }
#ifdef USE_COMPLEX
  return ACC_TYPE(MIN_SENTINEL, MIN_SENTINEL);
#else
  return ACC_TYPE(MIN_SENTINEL);
#endif
}

#if defined(USE_COMPLEX)
bool complex_is_nan(ACC_TYPE value) {
  return isnan(value.x) || isnan(value.y);
}

// Lexicographic (real, then imaginary) ordering, matching the upstream
// compare_complex and complex_elementwise maximum rules: strict compare,
// ties favor the accumulator.
bool complex_less(ACC_TYPE a, ACC_TYPE b) {
  return (a.x < b.x) || (a.x == b.x && a.y < b.y);
}

// Numpy complex minimum/maximum rule, the behavior the upstream Python
// suite pins against np.minimum/np.maximum: a NaN operand is itself the
// result, the accumulator's NaN wins once carried, otherwise the strict
// lexicographic compare picks. (The upstream Metal Min/Max complex
// combine instead carries NaN per component - (nan, min(imag)) - which
// no numpy value reproduces, so the reduce would fail its own suite's
// nan_propagation_complex64 comparison either way the accumulator is
// seeded.)
ACC_TYPE combine(ACC_TYPE acc, ACC_TYPE next, uint operation) {
  if (operation == 0u) {
    return acc + next;
  }
  if (operation == 1u) {
    return ACC_TYPE(acc.x * next.x - acc.y * next.y,
                    acc.x * next.y + acc.y * next.x);
  }
  if (complex_is_nan(acc)) {
    return acc;
  }
  if (complex_is_nan(next)) {
    return next;
  }
  if (operation == 2u) {
    return complex_less(next, acc) ? next : acc;
  }
  return complex_less(acc, next) ? next : acc;
}
#else
#ifndef BOOL_OUT
// Min and Max follow the upstream NaN convention: any NaN in the reduced
// set poisons the result. A plain ordered compare silently drops a NaN
// carried in the accumulator, so the poison is held once it enters.
// Integer accumulators compare exactly with no NaN domain.
ACC_TYPE combine(ACC_TYPE acc, ACC_TYPE next, uint operation) {
  if (operation == 0u) {
    return acc + next;
  }
  if (operation == 1u) {
    return acc * next;
  }
#if !defined(USE_I32) && !defined(USE_U32) && !defined(USE_I8) &&              \
    !defined(USE_U8) && !defined(USE_I16) && !defined(USE_U16) &&              \
    !defined(USE_I64) && !defined(USE_U64) && !defined(USE_BOOL_INPUT)
  if (isnan(acc)) {
    return acc;
  }
  if (isnan(next)) {
    return next;
  }
#endif
  if (operation == 2u) {
    return acc < next ? acc : next;
  }
  return acc > next ? acc : next;
}
#endif
#endif

#if defined(BOOL_OUT) || defined(USE_BOOL_INPUT)
bool load_truthy(uint index) {
#ifdef USE_BOOL_INPUT
  uint position = params.lhs_offset + index;
  uint word = input_data.values[position >> 2u];
  return BYTE_AT(word, position & 3u) != 0u;
#elif defined(USE_I32)
  return input_data.values[params.lhs_offset + index] != 0;
#elif defined(USE_U32)
  return input_data.values[params.lhs_offset + index] != 0u;
#else
  return LOAD_VALUE(input_data.values[params.lhs_offset + index]) != 0.0;
#endif
}
#endif

uint axis_extent(uint index) {
  if (params.matrix_k == 0u) {
    return params.shape[index];
  }
  return axis_data.values[index];
}

uint kept_axis_stride(uint index) {
  if (params.matrix_k == 0u) {
    return params.in_strides[index];
  }
  return axis_data.values[params.matrix_k + index];
}

uint reduced_axis_stride(uint index) {
  if (params.matrix_k == 0u) {
    return params.out_strides[index];
  }
  return axis_data.values[params.matrix_k + params.dims + index];
}

uint decode_kept_offset(uint output_index) {
  uint rem = output_index;
  uint in_off = 0u;
  for (int d = int(params.dims) - 1; d >= 0; --d) {
    uint coord = rem % axis_extent(uint(d));
    rem /= axis_extent(uint(d));
    in_off += coord * kept_axis_stride(uint(d));
  }
  return in_off;
}

uint decode_reduced_offset(uint j) {
  uint rrem = j;
  uint r_off = 0u;
  for (uint r = 0u; r < params.matrix_m; ++r) {
    uint coord = rrem % axis_extent(params.dims + r);
    rrem /= axis_extent(params.dims + r);
    r_off += coord * reduced_axis_stride(r);
  }
  return r_off;
}
#ifdef BOOL_OUT
void main() {
  uint word_stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  if ((params.flags & 1u) != 0u) {
    // Combine phase: one output word per invocation, four output elements.
    uint word_count = (params.output_size + 3u) >> 2u;
    uint word_index = gl_GlobalInvocationID.x;
    while (word_index < word_count) {
      uint word = 0u;
      for (uint lane = 0u; lane < 4u; ++lane) {
        uint output_index = word_index * 4u + lane;
        if (output_index >= params.output_size) {
          continue;
        }
        uint base = output_index * params.matrix_n;
        bool value = params.operation == 4u ? false : true;
        for (uint c = 0u; c < params.matrix_n; ++c) {
          bool partial = scratch_data.values[base + c] != 0u;
          value = params.operation == 4u ? (value || partial)
                                         : (value && partial);
        }
        word |= (value ? 1u : 0u) << ((output_index & 3u) * 8u);
      }
      output_data.values[word_index] = word;
      if (word_count - word_index <= word_stride) {
        break;
      }
      word_index += word_stride;
    }
    return;
  }
  // Single pass (bit 1 set): the reduce fits in one chunk, so the
  // invocation owns one packed output word over the full reduced range,
  // exactly the original layout. Otherwise the invocation owns one
  // (output element, chunk) pair and stores a 0/1 partial.
  if ((params.flags & 2u) != 0u) {
    uint word_count = (params.output_size + 3u) >> 2u;
    uint word_index = gl_GlobalInvocationID.x;
    while (word_index < word_count) {
      uint word = 0u;
      for (uint lane = 0u; lane < 4u; ++lane) {
        uint output_index = word_index * 4u + lane;
        if (output_index >= params.output_size) {
          continue;
        }
        uint in_off = decode_kept_offset(output_index);
        bool value = params.operation == 4u ? false : true;
        for (uint j = 0u; j < params.reduce_size; ++j) {
          bool truthy = load_truthy(in_off + decode_reduced_offset(j));
          value = params.operation == 4u ? (value || truthy)
                                         : (value && truthy);
        }
        word |= (value ? 1u : 0u) << ((output_index & 3u) * 8u);
      }
      output_data.values[word_index] = word;
      if (word_count - word_index <= word_stride) {
        break;
      }
      word_index += word_stride;
    }
    return;
  }
  uint pairs = params.output_size * params.matrix_n;
  uint id = gl_GlobalInvocationID.x;
  while (id < pairs) {
    uint output_index = id / params.matrix_n;
    uint chunk = id - output_index * params.matrix_n;
    uint trips = (params.reduce_size + params.matrix_n - 1u) / params.matrix_n;
    uint lo = chunk * trips;
    uint hi = min(lo + trips, params.reduce_size);
    uint in_off = decode_kept_offset(output_index);
    bool value = params.operation == 4u ? false : true;
    for (uint j = lo; j < hi; ++j) {
      bool truthy = load_truthy(in_off + decode_reduced_offset(j));
      value = params.operation == 4u ? (value || truthy) : (value && truthy);
    }
    scratch_data.values[id] = value ? 1u : 0u;
    if (pairs - id <= word_stride) {
      break;
    }
    id += word_stride;
  }
}
#else
void main() {
  uint grid = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  if ((params.flags & 1u) != 0u) {
    // Combine phase: one output element per invocation.
    uint output_index = gl_GlobalInvocationID.x;
    while (output_index < params.output_size) {
      ACC_TYPE value = init_value(params.operation);
      uint base = output_index * params.matrix_n;
      for (uint c = 0u; c < params.matrix_n; ++c) {
        value = combine(value, load_partial(base + c, 0u),
                        params.operation);
      }
      store_output(output_index, value);
      if (params.output_size - output_index <= grid) {
        break;
      }
      output_index += grid;
    }
    return;
  }
  // Partial phase: one (output element, chunk) pair per invocation. With
  // bit 1 set the chunk covers the whole reduced range and the accumulator
  // is the final element.
  uint id = gl_GlobalInvocationID.x;
  while (id < params.output_size * params.matrix_n) {
    uint output_index = id / params.matrix_n;
    uint chunk = id - output_index * params.matrix_n;
    uint trips = (params.reduce_size + params.matrix_n - 1u) / params.matrix_n;
    uint lo = chunk * trips;
    uint hi = min(lo + trips, params.reduce_size);
    uint in_off = decode_kept_offset(output_index);
    ACC_TYPE value = init_value(params.operation);
    for (uint j = lo; j < hi; ++j) {
      uint offset = in_off + decode_reduced_offset(j);
#ifdef USE_BOOL_INPUT
      ACC_TYPE next = ACC_TYPE(load_truthy(offset));
#else
      ACC_TYPE next = load_item(offset);
#endif
      value = combine(value, next, params.operation);
    }
    if ((params.flags & 2u) != 0u) {
      store_output(output_index, value);
    } else {
      store_partial(id, value);
    }
    if (params.output_size * params.matrix_n - id <= grid) {
      break;
    }
    id += grid;
  }
}
#endif
