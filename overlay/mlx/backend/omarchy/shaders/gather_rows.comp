//
// Row gather for axis-0 takes of a 2D row-contiguous table with 1D
// int32, uint32, or int64 indices. Output row i copies table row
// indices[i]. params.operation selects the index interpretation:
// 0 = signed 32-bit, 1 = unsigned 32-bit, 2 = signed 64-bit read as two
// little-endian words. Negative signed indices wrap like upstream
// offset_neg_idx: -1 reads the last row and -table_rows reads row 0.
// An index outside [-table_rows, table_rows) still writes a zero row,
// the same documented deviation the axis gather makes; upstream leaves
// such reads undefined. An int64 index whose high word is neither 0 nor
// 0xFFFFFFFF cannot be a small signed value, so it takes the same
// zero-row path.
//
// USE_U32 selects raw uint32 storage: table words copy with no float
// conversion, so packed words above 2^31 stay bit-exact. An int32 table
// shares the kernel unchanged because the copy is bitwise and the zero
// row is the zero word in both interpretations. The load stays one
// straight-line per-thread read at a linear address, the shape the
// Honeykrisp driver reads correctly.

#version 460

#ifdef USE_FP16
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#elif defined(USE_BF16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define STORAGE_TYPE uint16_t
#define LOAD_VALUE(x) uintBitsToFloat(uint(x) << 16u)
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
#define STORE_VALUE(f) bf16_store(f)
#elif defined(USE_U32)
#define STORAGE_TYPE uint
#define LOAD_VALUE(x) (x)
#define STORE_VALUE(x) (x)
#else
#define STORAGE_TYPE float
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#endif

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer Table {
  STORAGE_TYPE values[];
} input_data;
layout(set = 0, binding = 1, std430) readonly buffer Indices {
  int values[];
} indices_data;
layout(set = 0, binding = 2, std430) writeonly buffer Output {
  STORAGE_TYPE values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
} params;

void main() {
  uint output_index = gl_GlobalInvocationID.x;
  uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  uint row_length = params.reduce_size;
  uint table_rows = params.lhs_size / row_length;
  while (output_index < params.count) {
    uint row = output_index / row_length;
    uint column = output_index - row * row_length;
    // Index words arrive as raw 32-bit values. table_rows doubles as the
    // out-of-range sentinel: an out-of-range index fails the row bounds
    // check below and writes the zero row.
    uint word_row = params.operation == 2u ? row + row : row;
    uint word = uint(indices_data.values[params.rhs_offset + word_row]);
    uint index = table_rows;
    if (params.operation == 0u) {
      // Negative int32 indices wrap: -1 maps to table_rows - 1. The
      // uint add is the wrap; an index below -table_rows lands back
      // above the sentinel and takes the zero row.
      index = word < 0x80000000u ? word : table_rows + word;
    } else if (params.operation == 1u) {
      index = word;
    } else {
      // Signed 64-bit: high word 0 is a small non-negative value,
      // 0xFFFFFFFF is a small negative one and wraps by its low word.
      // Every other high word is out of [-2^31, 2^31) and stays
      // out-of-range; wrapping by the low word alone would misroute
      // values below -2^32 into the table.
      uint high =
          uint(indices_data.values[params.rhs_offset + word_row + 1u]);
      if (high == 0u) {
        index = word;
      } else if (high == 0xFFFFFFFFu) {
        index = table_rows + word;
      }
    }
#ifdef USE_U32
    STORAGE_TYPE value = 0u;
#else
    float value = 0.0;
#endif
    if (index < table_rows) {
      value = LOAD_VALUE(
          input_data
              .values[params.lhs_offset + index * row_length + column]);
    }
    output_data.values[params.output_offset + output_index] =
        STORE_VALUE(value);
    if (params.count - output_index <= stride) {
      break;
    }
    output_index += stride;
  }
}
