// Logical shader (Or/And/Not) on bool inputs. The bool comparison
// sextet lives in compare_bool.comp.
//
// Original shape: one invocation per output word; per-lane loop packs
// four bytes into one word, one strided word store at the end. Honeykrisp
// coalesces four adjacent word stores into one 16-byte vector store and
// drops the inner three lanes' values, so the per-lane word store is
// not safe. Instead, one invocation per output byte: four adjacent
// invocations race on the same uint word but their byte lanes are
// disjoint, so an atomicOr store cannot be folded into the dropped-lane
// coalesce and every byte lands. The full op selector and the broadcast
// index resolution live in main() to keep the per-thread path free of
// helper-function calls, which is the pattern Honeykrisp miscompiled.
//
// Bool inputs and output. The interface reads and writes them as
// little-endian 32-bit words, so no 8-bit storage feature is needed;
// the omarchy allocator page-rounds every buffer, so the word that
// contains the last byte is always inside the allocation.

#version 460

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer InputA {
  uint words[];
} input_a;
layout(set = 0, binding = 1, std430) readonly buffer InputB {
  uint words[];
} input_b;
layout(set = 0, binding = 2, std430) writeonly buffer Output {
  uint words[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  // dims == 0 selects the modulo fast path below. Otherwise the output
  // is unraveled over shape[] and lhs_strides/rhs_strides index the
  // operands; a stride of 0 broadcasts the axis.
  uint dims;
  uint shape[4];
  uint lhs_strides[4];
  uint rhs_strides[4];
} params;

void main() {
  uint index = gl_GlobalInvocationID.x;
  if (index >= params.count) {
    return;
  }
  // Resolve input indices inline. dims != 0 means a general broadcast;
  // the dispatch handles that case via fill_broadcast_transport and never
  // reaches this shader with dims > 0 for the bool-input tests on M1.
  uint li = params.lhs_offset;
  uint ri = params.rhs_offset;
  if (params.dims != 0u) {
    uint rem = index;
    for (int dim = int(params.dims) - 1; dim >= 0; --dim) {
      uint coord = rem % params.shape[dim];
      rem /= params.shape[dim];
      li += coord * params.lhs_strides[dim];
      ri += coord * params.rhs_strides[dim];
    }
  } else {
    li += params.lhs_size == 1u
        ? 0u
        : (params.lhs_size == params.count ? index : index % params.lhs_size);
    ri += params.rhs_size == 1u
        ? 0u
        : (params.rhs_size == params.count ? index : index % params.rhs_size);
  }
  // Read the source byte from each input word and normalize to canonical
  // 0/1 the way upstream bool casts do, so a stray 0xFF byte from a
  // vendor cast still compares truthy.
  uint aw = input_a.words[li >> 2u];
  uint av = (aw >> ((li & 3u) * 8u)) & 0xFFu;
  uint bw = input_b.words[ri >> 2u];
  uint bv = (bw >> ((ri & 3u) * 8u)) & 0xFFu;
  // Selector codes match LogicalOperation in primitives.cpp:
  //   0 = Or, 1 = And, 2 = Not (unary on a; the host sets rhs to a).
  // The bool comparison sextet (Equal, NotEqual, Greater, Less,
  // GreaterEqual, LessEqual) lives in compare_bool.comp, not here:
  // a wider if/else chain re-triggers the Honeykrisp store-coalescing
  // miscompile that FixM1BoolAndInt isolated on hardware, and this
  // kernel's atomicOr accumulate path needs a zero-filled destination
  // that the comparison path does not want to require.
  bool result;
  if (params.operation == 2u) {
    result = av == 0u;
  } else if (params.operation == 1u) {
    result = (av != 0u) && (bv != 0u);
  } else {
    result = (av != 0u) || (bv != 0u);
  }
  uint bit = result ? 1u : 0u;
  uint word_index = (params.output_offset + index) >> 2u;
  uint shift = ((params.output_offset + index) & 3u) * 8u;
  atomicOr(output_data.words[word_index], bit << shift);
}