#version 460
#if defined(USE_BF16) && defined(DECODE_GEMV)
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle_relative : require
#endif

// One lane per output preserves the tiled kernel's sequential K accumulation.
// DECODE_GEMV (BF16, M=1) instead maps one subgroup to four output columns
// with compensated accumulation: see the variant main() below.

#ifdef USE_FP16
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#elif defined(USE_BF16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define STORAGE_TYPE uint16_t
#define LOAD_VALUE(x) uintBitsToFloat(uint(x) << 16u)
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
#define STORE_VALUE(f) bf16_store(f)
#else
#define STORAGE_TYPE float
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#endif

const uint COLUMNS_PER_GROUP = 32u;
layout(local_size_x = 32) in;

#if defined(USE_BF16) && defined(DECODE_GEMV)
layout(set = 0, binding = 0, std430) readonly buffer InputA {
  uvec2 values[];
} input_a;
layout(set = 0, binding = 1, std430) readonly buffer InputB {
  uvec2 values[];
} input_b;
#else
layout(set = 0, binding = 0, std430) readonly buffer InputA {
  STORAGE_TYPE values[];
} input_a;
layout(set = 0, binding = 1, std430) readonly buffer InputB {
  STORAGE_TYPE values[];
} input_b;
#endif
layout(set = 0, binding = 2, std430) readonly buffer InputC {
  STORAGE_TYPE values[];
} input_c;
layout(set = 0, binding = 3, std430) writeonly buffer Output {
  STORAGE_TYPE values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
  uint lhs_gap;
  uint rhs_gap;
} params;

#if defined(USE_BF16) && defined(DECODE_GEMV)

vec4 unpack_bf16x4(uvec2 packed) {
  return vec4(
      uintBitsToFloat((packed.x & 0xffffu) << 16u),
      uintBitsToFloat(packed.x & 0xffff0000u),
      uintBitsToFloat((packed.y & 0xffffu) << 16u),
      uintBitsToFloat(packed.y & 0xffff0000u));
}

// Double-single step: Knuth's two-sum keeps the exact rounding error of
// sum + product in err; comp accumulates the errors. precise blocks fma
// contraction, which would break the error recovery. The cheaper 3-op
// fast variant ((a - s) + b) is NOT exact for mixed-sign operands and
// silently drops corrections; only the full two-sum survives the deep
// cancellation these decode projections hit.
void dd_add(vec4 product, inout precise vec4 sum, inout vec4 comp) {
  precise vec4 total = sum + product;
  precise vec4 bb = total - sum;
  precise vec4 as = total - bb;
  vec4 err = (product - bb) + (sum - as);
  comp = comp + err;
  sum = total;
}

// Unconditional two-sum of two scalars; err = (a + b) - s exactly.
void two_sum(float a, float b, out float s, out float err) {
  s = a + b;
  float bb = s - a;
  float as = s - bb;
  err = (a - as) + (b - bb);
}

// Dense M=1 decode GEMV: one subgroup per four output columns, wide
// uvec2 loads, per-lane double-single accumulation, compensated
// shuffle-down reduction. Every addition carries its exact rounding
// error, so the result tracks round-to-nearest-even of the exact f64
// sum regardless of traversal order. That is the load-bearing property
// for decode q/k/v: the sequential tiled path is already RNE(f64)-exact
// there, and bias cancellation amplifies any accumulation slack into
// visible bit flips (receipts/2026-09-10-bf16-rootcause). The dispatch
// side guards 4-aligned offsets/strides and matrix_k %
// (4*subgroupSize) == 0, which keeps every uvec2 index exact.
void main() {
  uint batch_index = gl_WorkGroupID.z;
  uint remaining = batch_index;
  uint a_batch = 0u;
  uint b_batch = 0u;
  for (uint axis = params.dims; axis > 0u; --axis) {
    uint coord = remaining % params.shape[axis - 1u];
    remaining /= params.shape[axis - 1u];
    a_batch += coord * params.in_strides[axis - 1u];
    b_batch += coord * params.out_strides[axis - 1u];
  }
  uint a_base = params.lhs_offset + a_batch;
  uint b_base = params.rhs_offset + b_batch;
  uint row_groups = params.matrix_n / 4u;
  uint lane_k = gl_SubgroupInvocationID * 4u;
  uint lane_stride = gl_SubgroupSize * 4u;
  for (uint row_group = gl_WorkGroupID.x; row_group < row_groups;
       row_group += gl_NumWorkGroups.x) {
    uint row = row_group * 4u;
    precise vec4 sum0 = vec4(0.0);
    precise vec4 sum1 = vec4(0.0);
    precise vec4 sum2 = vec4(0.0);
    precise vec4 sum3 = vec4(0.0);
    vec4 comp0 = vec4(0.0);
    vec4 comp1 = vec4(0.0);
    vec4 comp2 = vec4(0.0);
    vec4 comp3 = vec4(0.0);
    for (uint k = lane_k; k < params.matrix_k; k += lane_stride) {
      vec4 x = unpack_bf16x4(input_a.values[(a_base + k) / 4u]);
      vec4 weight0 = unpack_bf16x4(
          input_b.values[(b_base + row * params.rhs_gap + k) / 4u]);
      vec4 weight1 = unpack_bf16x4(
          input_b.values[(b_base + (row + 1u) * params.rhs_gap + k) / 4u]);
      vec4 weight2 = unpack_bf16x4(
          input_b.values[(b_base + (row + 2u) * params.rhs_gap + k) / 4u]);
      vec4 weight3 = unpack_bf16x4(
          input_b.values[(b_base + (row + 3u) * params.rhs_gap + k) / 4u]);
      dd_add(weight0 * x, sum0, comp0);
      dd_add(weight1 * x, sum1, comp1);
      dd_add(weight2 * x, sum2, comp2);
      dd_add(weight3 * x, sum3, comp3);
    }
    // Fold the four positions of each (sum, comp) pair into one scalar
    // pair. The compensation must NOT be merged into the sum here: lane
    // partials sit at pre-cancellation scale, and one early f32 merge
    // would leak eps*|partial| into a near-zero total — the exact
    // failure the compensation exists to prevent. Two-sum every merge,
    // keep the errors in the carry.
    float s01; float e01; two_sum(sum0.x, sum0.y, s01, e01);
    float s11; float e11; two_sum(sum1.x, sum1.y, s11, e11);
    float s21; float e21; two_sum(sum2.x, sum2.y, s21, e21);
    float s31; float e31; two_sum(sum3.x, sum3.y, s31, e31);
    float carry0 = (e01 + comp0.x) + comp0.y;
    float carry1 = (e11 + comp1.x) + comp1.y;
    float carry2 = (e21 + comp2.x) + comp2.y;
    float carry3 = (e31 + comp3.x) + comp3.y;
    float s02; float e02; two_sum(s01, sum0.z, s02, e02);
    float s12; float e12; two_sum(s11, sum1.z, s12, e12);
    float s22; float e22; two_sum(s21, sum2.z, s22, e22);
    float s32; float e32; two_sum(s31, sum3.z, s32, e32);
    carry0 += e02 + comp0.z;
    carry1 += e12 + comp1.z;
    carry2 += e22 + comp2.z;
    carry3 += e32 + comp3.z;
    float sum00; float e03; two_sum(s02, sum0.w, sum00, e03);
    float sum01; float e13; two_sum(s12, sum1.w, sum01, e13);
    float sum02; float e23; two_sum(s22, sum2.w, sum02, e23);
    float sum03; float e33; two_sum(s32, sum3.w, sum03, e33);
    carry0 += e03 + comp0.w;
    carry1 += e13 + comp1.w;
    carry2 += e23 + comp2.w;
    carry3 += e33 + comp3.w;
    // Compensated subgroup reduction of the four row pairs.
    for (uint offset = gl_SubgroupSize >> 1u; offset > 0u; offset >>= 1u) {
      float other0 = subgroupShuffleDown(sum00, offset);
      float other1 = subgroupShuffleDown(sum01, offset);
      float other2 = subgroupShuffleDown(sum02, offset);
      float other3 = subgroupShuffleDown(sum03, offset);
      float fold0; float err0; two_sum(sum00, other0, fold0, err0);
      float fold1; float err1; two_sum(sum01, other1, fold1, err1);
      float fold2; float err2; two_sum(sum02, other2, fold2, err2);
      float fold3; float err3; two_sum(sum03, other3, fold3, err3);
      carry0 += err0 + subgroupShuffleDown(carry0, offset);
      carry1 += err1 + subgroupShuffleDown(carry1, offset);
      carry2 += err2 + subgroupShuffleDown(carry2, offset);
      carry3 += err3 + subgroupShuffleDown(carry3, offset);
      sum00 = fold0;
      sum01 = fold1;
      sum02 = fold2;
      sum03 = fold3;
    }
    if (gl_SubgroupInvocationID == 0u) {
      uint output_index = batch_index * params.matrix_n + row;
      output_data.values[params.output_offset + output_index] =
          bf16_store(sum00 + carry0);
      output_data.values[params.output_offset + output_index + 1u] =
          bf16_store(sum01 + carry1);
      output_data.values[params.output_offset + output_index + 2u] =
          bf16_store(sum02 + carry2);
      output_data.values[params.output_offset + output_index + 3u] =
          bf16_store(sum03 + carry3);
    }
  }
}

#else

void main() {
  uint batch_index = gl_WorkGroupID.z;
  uint remaining = batch_index;
  uint a_batch = 0u;
  uint b_batch = 0u;
  for (uint axis = params.dims; axis > 0u; --axis) {
    uint coord = remaining % params.shape[axis - 1u];
    remaining /= params.shape[axis - 1u];
    a_batch += coord * params.in_strides[axis - 1u];
    b_batch += coord * params.out_strides[axis - 1u];
  }
  bool b_transposed = (params.flags & 1u) != 0u;
  bool a_transposed = (params.flags & 4u) != 0u;
  uint a_base = params.lhs_offset + a_batch;
  uint b_base = params.rhs_offset + b_batch;
  uint tiles = params.matrix_n / COLUMNS_PER_GROUP +
      uint(params.matrix_n % COLUMNS_PER_GROUP != 0u);
  for (uint tile = gl_WorkGroupID.x; tile < tiles; tile += gl_NumWorkGroups.x) {
    uint column = tile * COLUMNS_PER_GROUP + gl_LocalInvocationID.x;
    if (column >= params.matrix_n) {
      continue;
    }
    float accumulator = 0.0;
    for (uint k = 0u; k < params.matrix_k; ++k) {
      uint a_index = a_base + (a_transposed ? k * params.lhs_gap : k);
      uint b_index = b_transposed
          ? b_base + column * params.rhs_gap + k
          : b_base + k * params.rhs_gap + column;
      accumulator += LOAD_VALUE(input_a.values[a_index]) *
          LOAD_VALUE(input_b.values[b_index]);
    }
    uint output_index = batch_index * params.matrix_n + column;
    float value = params.alpha * accumulator;
    if ((params.flags & 2u) != 0u) {
      uint c_index = params.aux_size == 1u ? 0u : output_index % params.aux_size;
      value += params.beta * LOAD_VALUE(input_c.values[params.aux_offset + c_index]);
    }
    output_data.values[params.output_offset + output_index] = STORE_VALUE(value);
  }
}

#endif
