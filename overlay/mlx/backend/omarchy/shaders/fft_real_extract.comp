//
// Wave 8 FFT helper: takes the real part of a complex64 buffer into a
// float32 buffer. The irfft final pass produces a full-length inverse
// transform whose imaginary residue is round-off of a mathematically real
// signal (the same quantity pocketfft's c2r discards), so taking .x here is
// exact up to float32 rounding.

#version 460

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer InComplex {
  vec2 values[];
} fft_in_complex;
layout(set = 0, binding = 2, std430) writeonly buffer OutReal {
  float values[];
} fft_out_real;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
} params;

void main() {
  uint index = gl_GlobalInvocationID.x;
  if (index >= params.count) {
    return;
  }
  fft_out_real.values[params.output_offset + index] =
      fft_in_complex.values[params.lhs_offset + index].x;
}
