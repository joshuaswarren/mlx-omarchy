+          binding(q), binding(k), binding(v), binding(out)};
+      encoder.dispatch_compute(
+          select_float_kernel(
+              q.dtype(),
+              omarchy::ComputeKernel::SdpaDecodeF32,
+              omarchy::ComputeKernel::SdpaDecodeF16,
+              omarchy::ComputeKernel::SdpaDecodeBF16),
+          bindings,
+          params,
+          static_cast<uint32_t>(groups));
+      return;
+    }
+  }
