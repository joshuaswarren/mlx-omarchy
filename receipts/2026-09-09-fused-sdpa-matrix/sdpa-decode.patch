diff --git a/tmp/mlx-sdpa-experiment/overlay/mlx/backend/omarchy/shaders/sdpa_decode.comp b/tmp/mlx-sdpa-experiment/overlay/mlx/backend/omarchy/shaders/sdpa_decode.comp
new file mode 100644
index 0000000..e1d7a26
--- /dev/null
+++ b/tmp/mlx-sdpa-experiment/overlay/mlx/backend/omarchy/shaders/sdpa_decode.comp
@@ -0,0 +1,221 @@
+// Copyright © 2026 Joshua Warren / mlx-omarchy contributors.
+// SPDX-License-Identifier: MIT
+//
+// Fused single-query scaled dot-product attention mirroring the native
+// Metal reference sdpa_vector<T, 64, 64> (mlx/backend/metal/kernels/
+// sdpa_vector.h) for the decode shapes this backend dispatches:
+// q_len = 1, head_dim = v_dim = 64, no mask, no sinks, kv_len >= 1.
+// A length-1 query attends to every key under the causal rule, so key
+// filtering drops out entirely.
+//
+// One workgroup of 1024 threads = 32 subgroups x 32 lanes reproduces
+// the Metal kernel's 32 simdgroups of 32 threads. Subgroup sgid streams
+// the keys t = sgid, sgid+32, ...; its lanes each hold two query
+// features (2*lane, 2*lane+1), so one subgroupAdd completes the 64-wide
+// dot product. The online softmax (running max, rescale factor, running
+// exp sum, two value accumulators) follows the reference statement for
+// statement. The final combine is the reference transpose reduction:
+// shared max_scores[32] and sum_exp_scores[32] plus a 32x32 float tile
+// outputs[1024] let lane l of subgroup s read subgroup l's lane-s
+// partial against subgroup l's own rescale factor; two barriered rounds
+// per accumulator pair. Every one of the 1024 threads executes both
+// barriers unconditionally. A subgroup with no keys (kv_len <= sgid)
+// keeps the reference empty-state invariants - max -FLT_MAX, exp sum 0,
+// zero partials - and contributes exactly nothing to the combine.
+//
+// Everything between load and store is float32; the final store is the
+// one rounding to the storage dtype, matching the Metal kernel's
+// static_cast<T> epilogue. This kernel tracks the fused native path, so
+// there are no per-step storage rounds (unlike the composed-path parity
+// kernels such as fast_rope.comp).
+//
+// bfloat16 rides the repo's proven uint16_t word form (qmm_vec.comp):
+// loads shift the 16-bit lane into the high half of a float, stores
+// round to nearest even with the NaN-preserve tweak.
+//
+// Push-constant mapping (ComputeParams fields):
+//   matrix_m     query heads (per batch)
+//   matrix_n     kv heads
+//   matrix_k     kv length
+//   alpha        softmax scale, premultiplied into the query
+//   lhs_offset / rhs_offset / aux_offset / output_offset
+//                item offsets of q / k / v / out
+//   shape[0..1]  q batch / head strides
+//   shape[2..3]  k batch / head strides
+//   in_strides[0]     k sequence stride
+//   in_strides[1..3]  v batch / head / sequence strides
+//   Feature stride is 1 on every operand; the output is contiguous
+//   (batch, heads, 1, 64) and workgroup g covers batch = g / heads,
+//   head = g % heads, kv head = head / (heads / kv_heads).
+//
+// Dispatch requires subgroupSize == 32, the BASIC and ARITHMETIC
+// subgroup features, a 1024-thread workgroup, and >= 4352 bytes of
+// shared memory. Those caps are probed host-side at dispatch: Vulkan
+// compute cannot branch on subgroup size in-shader (mirroring the
+// USE_SUBGROUP gate in qmm_vec.comp), and any other shape or capability
+// set falls back to the composed elementwise path.
+
+#version 460
+
+#ifdef USE_FP16
+#extension GL_EXT_shader_16bit_storage : require
+#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
+#define STORAGE_TYPE float16_t
+#define LOAD_VALUE(x) float(x)
+#define STORE_VALUE(f) STORAGE_TYPE(f)
+#elif defined(USE_BF16)
+#extension GL_EXT_shader_16bit_storage : require
+#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
+#define STORAGE_TYPE uint16_t
+#define LOAD_VALUE(x) uintBitsToFloat(uint(x) << 16u)
+uint16_t bf16_store(float value) {
+  uint bits = floatBitsToUint(value);
+  if (isnan(value)) {
+    return uint16_t((bits >> 16) | 0x40u);
+  }
+  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
+}
+#define STORE_VALUE(f) bf16_store(f)
+#else
+#define STORAGE_TYPE float
+#define LOAD_VALUE(x) float(x)
+#define STORE_VALUE(f) STORAGE_TYPE(f)
+#endif
+
+#extension GL_KHR_shader_subgroup_basic : require
+#extension GL_KHR_shader_subgroup_arithmetic : require
+
+layout(set = 0, binding = 0, std430) readonly buffer Query {
+  STORAGE_TYPE values[];
+} query_data;
+layout(set = 0, binding = 1, std430) readonly buffer Key {
+  STORAGE_TYPE values[];
+} key_data;
+layout(set = 0, binding = 2, std430) readonly buffer Value {
+  STORAGE_TYPE values[];
+} value_data;
+layout(set = 0, binding = 3, std430) writeonly buffer Output {
+  STORAGE_TYPE values[];
+} output_data;
+
+layout(local_size_x = 1024, local_size_y = 1, local_size_z = 1) in;
+
+layout(push_constant) uniform Params {
+  uint count;
+  uint operation;
+  uint lhs_size;
+  uint rhs_size;
+  uint reduce_size;
+  uint output_size;
+  uint lhs_offset;
+  uint rhs_offset;
+  uint output_offset;
+  uint aux_size;
+  uint aux_offset;
+  uint matrix_m;
+  uint matrix_n;
+  uint matrix_k;
+  uint flags;
+  float alpha;
+  float beta;
+  uint dims;
+  uint shape[4];
+  uint in_strides[4];
+  uint out_strides[4];
+} params;
+
+const uint SUBGROUPS = 32u;
+const uint LANES = 32u;
+// head_dim 64 / 32 lanes: two features per lane on q, k, and v.
+const uint FEATURES_PER_LANE = 2u;
+
+shared float max_scores[SUBGROUPS];
+shared float sum_exp_scores[SUBGROUPS];
+shared float outputs[SUBGROUPS * LANES];
+
+void main() {
+  uint group = gl_WorkGroupID.x;
+  uint heads = params.matrix_m;
+  uint batch = group / heads;
+  uint head = group - batch * heads;
+  uint kv_head = head / (heads / params.matrix_n);
+
+  uint sgid = gl_SubgroupID;
+  uint lane = gl_SubgroupInvocationID;
+
+  // The reference premultiplies the scale into the query once.
+  float q[FEATURES_PER_LANE];
+  uint q_base = params.lhs_offset + batch * params.shape[0] +
+      head * params.shape[1] + FEATURES_PER_LANE * lane;
+  for (uint j = 0u; j < FEATURES_PER_LANE; j++) {
+    q[j] = params.alpha * LOAD_VALUE(query_data.values[q_base + j]);
+  }
+
+  uint k_base = params.rhs_offset + batch * params.shape[2] +
+      kv_head * params.shape[3] + FEATURES_PER_LANE * lane;
+  uint v_base = params.aux_offset + batch * params.in_strides[1] +
+      kv_head * params.in_strides[2] + FEATURES_PER_LANE * lane;
+
+  // -FLT_MAX, the reference Limits<float>::finite_min empty cap.
+  float max_score = uintBitsToFloat(0xff7fffffu);
+  float sum_exp_score = 0.0;
+  float o[FEATURES_PER_LANE];
+  for (uint j = 0u; j < FEATURES_PER_LANE; j++) {
+    o[j] = 0.0;
+  }
+
+  // Each subgroup owns the keys t = sgid, sgid + 32, ... and advances
+  // by 32 sequence strides per step, exactly like the reference's
+  // inner_k_stride / inner_v_stride walk.
+  for (uint t = sgid; t < params.matrix_k; t += SUBGROUPS) {
+    uint k_index = k_base + t * params.in_strides[0];
+    float score = subgroupAdd(
+        q[0] * LOAD_VALUE(key_data.values[k_index]) +
+        q[1] * LOAD_VALUE(key_data.values[k_index + 1u]));
+    float new_max = max(max_score, score);
+    float factor = exp(max_score - new_max);
+    float exp_score = exp(score - new_max);
+    max_score = new_max;
+    sum_exp_score = sum_exp_score * factor + exp_score;
+    uint v_index = v_base + t * params.in_strides[3];
+    o[0] = o[0] * factor + exp_score * LOAD_VALUE(value_data.values[v_index]);
+    o[1] = o[1] * factor +
+        exp_score * LOAD_VALUE(value_data.values[v_index + 1u]);
+  }
+
+  // Combine the per-subgroup online states across the workgroup, the
+  // reference's max/sum exchange. Lane l reads subgroup l's state, so
+  // the subgroup reductions cover all 32 subgroups and every lane ends
+  // with the same global max and weighted exp sum.
+  if (lane == 0u) {
+    max_scores[sgid] = max_score;
+    sum_exp_scores[sgid] = sum_exp_score;
+  }
+  barrier();
+  max_score = max_scores[lane];
+  float new_max = subgroupMax(max_score);
+  float factor = exp(max_score - new_max);
+  sum_exp_score = subgroupAdd(sum_exp_scores[lane] * factor);
+
+  // Aggregate the outputs through the shared transpose: the write puts
+  // subgroup sgid's lane partial at [lane][sgid], the read pairs
+  // subgroup lane's partial with subgroup lane's factor, and the
+  // subgroupAdd folds all 32 subgroups. The trailing barrier keeps the
+  // next round's write off this round's read.
+  for (uint j = 0u; j < FEATURES_PER_LANE; j++) {
+    outputs[LANES * lane + sgid] = o[j];
+    barrier();
+    float combined = subgroupAdd(outputs[LANES * sgid + lane] * factor);
+    combined =
+        (sum_exp_score == 0.0) ? combined : (combined / sum_exp_score);
+    o[j] = combined;
+    barrier();
+  }
+
+  if (lane == 0u) {
+    uint out_base = params.output_offset +
+        group * (SUBGROUPS * FEATURES_PER_LANE) + sgid * FEATURES_PER_LANE;
+    output_data.values[out_base] = STORE_VALUE(o[0]);
+    output_data.values[out_base + 1u] = STORE_VALUE(o[1]);
+  }
+}
