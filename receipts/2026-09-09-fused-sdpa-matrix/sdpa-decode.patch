+  // SdpaDecode: the single-query decode shape (q_len=1, 64-wide head
+  // and value dims, exactly q/k/v, k_len>0) rides one fused kernel: one
+  // 1024-thread workgroup per (batch, query head) computes the whole
+  // scores/softmax/probs chain with float32 intermediates and stores
+  // the result once in the native dtype. With one query row, causal
+  // masking permits every key, so the fused kernel is exact here. The
+  // k/v strides pass raw, so a padded KV-cache slice is read in place
+  // with no materialization. Anything else - other shapes, masks,
+  // sinks, or a device without the 32-lane subgroup, 1024-invocation
+  // workgroup, or 4352-byte shared tile the shader assumes - falls
+  // through to the composition below unchanged.
+  if (inputs.size() == 3 && q_len == 1 && head_dim == 64 && v_dim == 64 &&
+      k_len > 0 && q.strides()[3] == 1 && k.strides()[3] == 1 &&
+      v.strides()[3] == 1) {
+    constexpr uint32_t kSubgroupBits =
+        VK_SUBGROUP_FEATURE_BASIC_BIT | VK_SUBGROUP_FEATURE_ARITHMETIC_BIT;
+    const auto& caps = encoder.device().capabilities();
+    uint64_t groups =
+        static_cast<uint64_t>(batch) * static_cast<uint64_t>(heads);
+    bool decode_ready = caps.subgroup_size == 32u &&
+        (caps.subgroup_operations & kSubgroupBits) == kSubgroupBits &&
+        caps.max_compute_work_group_invocations >= 1024u &&
+        caps.max_compute_work_group_size[0] >= 1024u &&
+        caps.max_compute_shared_memory_size >= 4352u &&
+        groups <= omarchy::kMaxComputeGroupCountX;
+    for (const array* input : {&q, &k, &v}) {
+      if (!decode_ready) {
+        break;
+      }
+      uint64_t span = 1;
+      for (int axis = 0; axis < input->ndim(); ++axis) {
+        int64_t stride = input->strides()[axis];
+        if (stride < 0 || static_cast<uint64_t>(stride) > UINT32_MAX) {
+          decode_ready = false;
+          break;
+        }
+        uint64_t term = static_cast<uint64_t>(input->shape(axis) - 1) * stride;
+        if (term > UINT32_MAX - span) {
+          decode_ready = false;
+          break;
+        }
+        span += term;
+      }
+      uint64_t offset = input->offset() / input->itemsize();
+      decode_ready = decode_ready &&
+          omarchy::compute_index_span_fits(offset, span) &&
+          (offset + span) * input->itemsize() <= binding(*input).range;
+    }
+    if (decode_ready) {
