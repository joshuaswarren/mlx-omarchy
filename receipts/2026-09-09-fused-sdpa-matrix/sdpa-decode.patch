+      params.output_offset = checked_item_offset(out, out.size(), tag, out);
+      params.matrix_m = checked_u32(heads, tag, out);
+      params.matrix_n = checked_u32(kv_heads, tag, out);
+      params.matrix_k = checked_u32(k_len, tag, out);
+      params.alpha = scale_;
+      params.shape[0] = checked_u32(q.strides()[0], tag, out);
+      params.shape[1] = checked_u32(q.strides()[1], tag, out);
+      params.shape[2] = checked_u32(k.strides()[0], tag, out);
+      params.shape[3] = checked_u32(k.strides()[1], tag, out);
+      params.in_strides[0] = checked_u32(k.strides()[2], tag, out);
+      params.in_strides[1] = checked_u32(v.strides()[0], tag, out);
+      params.in_strides[2] = checked_u32(v.strides()[1], tag, out);
