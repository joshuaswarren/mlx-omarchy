program(1.3)
[buildInfo = dict<string, string>({})]
{
  func main<ios18>(tensor<fp16, [1, 8, 375, 128]> a) {
    tensor<int32, [4]> perm = const()[name = string("perm"), val = tensor<int32, [4]>([0, 2, 1, 3])];
    tensor<fp16, [1, 375, 8, 128]> y = transpose(perm = perm, x = a)[name = string("y")];
  } -> (y);
}
