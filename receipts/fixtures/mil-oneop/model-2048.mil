program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3520.4.1"}, {"coremlc-version", "3520.5.1"}})]
{
    func main<ios18>(tensor<fp16, [1, 2048]> t1) {
        tensor<fp16, [1, 2048]> t0 = const()[name = string("t0"), val = tensor<fp16, [1, 2048]>(BLOBFILE(path = string("@model_path/weights.bin"), offset = uint64(64)))];
        tensor<fp16, [1, 2048]> t2 = add(x = t1, y = t0)[name = string("t2")];
    } -> (t2);
}
