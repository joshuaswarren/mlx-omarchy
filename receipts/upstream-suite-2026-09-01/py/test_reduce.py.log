    def test_zero_size(self):
        # max and min have no identity, so they are only undefined when an axis
        # being reduced is itself empty. An array that is empty because of some
        # other axis reduces into an empty result.
        for shape, axis in [
            ((0, 2), -1),
            ((2, 0), 0),
            ((3, 0, 2), -1),
            ((0, 3, 2), (1, 2)),
