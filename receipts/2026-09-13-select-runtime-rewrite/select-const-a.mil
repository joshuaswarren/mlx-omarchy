program(1.3)
[buildInfo = dict<string, string>({})]
{
  func main<ios18>(tensor<fp16, [1, 8, 375, 375]> b, tensor<bool, [1, 8, 375, 375]> cond) {
    tensor<fp16, []> ninf = const()[name = string("ninf"), val = tensor<fp16, []>(BLOBFILE(path = string("@model_path/weights.bin"), offset = uint64(64)))];
    tensor<fp16, [1, 8, 375, 375]> y = select(a = ninf, b = b, cond = cond)[name = string("y")];
  } -> (y);
}
