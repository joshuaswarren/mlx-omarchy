//
// Fused RMSNorm (-DRMS default) or LayerNorm (-DLAYER_NORM=1) forward over the
// last axis, matching mlx::core::fast fallback math in mlx/fast.cpp. One
// workgroup handles one row with shared-memory reductions and a grid-stride
// row loop. RMSNorm rounds the normalized value before applying the weight.
//
//   RMS:   n = rsqrt(mean(x^2) + eps);            y = x * n * w
//   Layer: mu = mean(x); var = mean(x^2) - mu^2;
//          n = rsqrt(var + eps);                  y = (x - mu) * n * w + b
//
// A scalar weight or bias (element count 1, the weightless upstream form)
// broadcasts to every column. eps arrives in params.alpha.

#version 460

#ifdef USE_FP16
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#elif defined(USE_BF16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define STORAGE_TYPE uint16_t
#define LOAD_VALUE(x) uintBitsToFloat(uint(x) << 16u)
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
#define STORE_VALUE(f) bf16_store(f)
#else
#define STORAGE_TYPE float
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#endif

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer Input {
  STORAGE_TYPE values[];
} input_data;
layout(set = 0, binding = 1, std430) readonly buffer Weight {
  STORAGE_TYPE values[];
} weight_data;
#ifdef LAYER_NORM
layout(set = 0, binding = 2, std430) readonly buffer Bias {
  STORAGE_TYPE values[];
} bias_data;
#endif
layout(set = 0, binding = 3, std430) writeonly buffer Output {
  STORAGE_TYPE values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
} params;

shared float block_values[256];

void main() {
  uint thread = gl_LocalInvocationID.x;
  uint row_length = params.reduce_size;
  float eps = params.alpha;
  uint threads = 256u;

  for (uint row = gl_WorkGroupID.x; row < params.output_size;
       row += gl_NumWorkGroups.x) {
    uint start = params.lhs_offset + row * row_length;

#ifdef LAYER_NORM
    float local_sum = 0.0;
    for (uint index = thread; index < row_length; index += threads) {
      local_sum += LOAD_VALUE(input_data.values[start + index]);
    }
    block_values[thread] = local_sum;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
      if (thread < stride) {
        block_values[thread] += block_values[thread + stride];
      }
      barrier();
    }
    float mu = block_values[0] / float(row_length);
    barrier();
#endif

    float local_sq = 0.0;
#ifdef LAYER_NORM
    for (uint index = thread; index < row_length; index += threads) {
      float value = LOAD_VALUE(input_data.values[start + index]);
      local_sq += value * value;
    }
#else
    for (uint base = thread * 4u; base < row_length; base += threads * 4u) {
      for (uint item = 0u; item < 4u && base + item < row_length; ++item) {
        float value = LOAD_VALUE(input_data.values[start + base + item]);
        local_sq += value * value;
      }
    }
#endif
    block_values[thread] = local_sq;
    barrier();
#ifdef LAYER_NORM
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
      if (thread < stride) {
        block_values[thread] += block_values[thread + stride];
      }
      barrier();
    }
#else
    uint lane = thread % 32u;
    for (uint stride = 1u; stride < 32u; stride <<= 1u) {
      if (lane % (2u * stride) == 0u) {
        block_values[thread] += block_values[thread + stride];
      }
      barrier();
    }
    float group_sum = thread < 8u ? block_values[thread * 32u] : 0.0;
    barrier();
    block_values[thread] = group_sum;
    barrier();
    for (uint stride = 1u; stride < 8u; stride <<= 1u) {
      if (thread < 8u && thread % (2u * stride) == 0u) {
        block_values[thread] += block_values[thread + stride];
      }
      barrier();
    }
#endif
    float mean_square = block_values[0] / float(row_length);
    barrier();
#ifdef LAYER_NORM
    float variance = mean_square - mu * mu;
#else
    float variance = mean_square;
#endif
    precise float norm = inversesqrt(variance + eps);
    float diagnostic[8];
    for (uint i = 0u; i < 8u; ++i) { diagnostic[i] = 0.0; }
    diagnostic[0] = variance + eps;
    diagnostic[1] = norm;
#ifndef LAYER_NORM
    if (norm > 0.0 && !isinf(norm)) {
      precise float denominator = variance + eps;
      for (uint refinement = 0u; refinement < 2u; ++refinement) {
      precise float root = denominator * norm;
      precise float residual = fma(-norm, root, 1.0);
      precise float product_error = fma(-denominator, norm, root);
      if (refinement == 0u) {
        diagnostic[2] = root; diagnostic[3] = residual; diagnostic[4] = product_error;
        diagnostic[5] = fma(norm, product_error, residual);
      }
      norm = fma(0.5 * norm, fma(norm, product_error, residual), norm);
      diagnostic[6u + refinement] = norm;
      }
    }
#endif

    for (uint index = thread; index < row_length; index += threads) {
      float value = LOAD_VALUE(input_data.values[start + index]);
      float weight =
          (params.lhs_size == 1u)
              ? LOAD_VALUE(weight_data.values[params.rhs_offset])
              : LOAD_VALUE(weight_data.values[params.rhs_offset + index]);
#ifdef LAYER_NORM
      float bias =
          (params.aux_size == 1u)
              ? LOAD_VALUE(bias_data.values[params.aux_offset])
              : LOAD_VALUE(bias_data.values[params.aux_offset + index]);
      float result = (value - mu) * norm * weight + bias;
#else
#ifdef USE_FP16
      float normalized = unpackHalf2x16(packHalf2x16(vec2(value * norm, 0.0))).x;
#else
      float normalized = LOAD_VALUE(STORE_VALUE(value * norm));
#endif
      float result = normalized * weight;
#endif
#if !defined(LAYER_NORM) && !defined(USE_FP16) && !defined(USE_BF16)
      result = diagnostic[index % 8u];
#endif
      output_data.values[params.output_offset + row * row_length + index] =
          STORE_VALUE(result);
    }
    barrier();
  }
}
