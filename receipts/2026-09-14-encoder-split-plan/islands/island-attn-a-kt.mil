program(1.3)
[buildInfo = dict<string, string>({})]
{
  func main<ios18>(tensor<fp16, [1, 8, 375, 128]> q_v, tensor<fp16, [1, 8, 128, 749]> pos_kT, tensor<fp16, [1, 8, 375, 128]> q_scaled, tensor<fp16, [1, 8, 128, 375]> k_headsT) {
    bool tx = const()[name = string("tx"), val = bool(false)];
    bool ty0 = const()[name = string("ty0"), val = bool(false)];
    tensor<fp16, [1, 8, 375, 749]> attention_scores_1 = matmul(transpose_x = tx, transpose_y = ty0, x = q_v, y = pos_kT)[name = string("attention_scores_1")];
    tensor<fp16, [1, 8, 375, 375]> matmul_0 = matmul(transpose_x = tx, transpose_y = ty0, x = q_scaled, y = k_headsT)[name = string("matmul_0")];
  } -> (attention_scores_1, matmul_0);
}
