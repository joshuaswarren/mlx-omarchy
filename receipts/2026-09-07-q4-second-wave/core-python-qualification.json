  "failure_clusters": [
    {
      "area": "FFT",
      "classification": "confirmed_backend_defect",
      "cluster_id": "fft-stage-multidimensional-dispatch-indexing",
      "evidence": [
        {
          "lines": "4224-4226, 4444-4456, 4461-4504",
          "observation": "The planner accepts lengths through 2^24. dispatch_fft_stage computes group_x/group_y/group_z for workgroups=(elements+255)/256 and dispatches all three dimensions. For 2^24 elements this is 65,536 workgroups, one more than a 65,535 x limit.",
          "path": "/tmp/mlx-second-wave-integration/overlay/mlx/backend/omarchy/primitives.cpp"
        },
        {
          "lines": "114-118",
          "observation": "The shader sets p = gl_GlobalInvocationID.x and never incorporates y or z.",
          "path": "/tmp/mlx-second-wave-integration/overlay/mlx/backend/omarchy/shaders/fft_stage.comp"
        },
        {
          "observation": "The 2^24 case reports 8,191 mismatched bins and the final expected nonzero bin is 0+0j in the GPU output.",
          "path": "/tmp/mlx-py-parity-f5ba1c8/core/test_fft.log"
        }
      ],
      "failed_test_names": [
        "tests.test_fft.TestFFT::test_fft_big_powers_of_two"
      ],
      "root_cause": "The host splits an elementwise FFT stage across x/y/z workgroup dimensions once the stage exceeds the x-dimension limit, but fft_stage.comp indexes only gl_GlobalInvocationID.x. At the accepted 2^24 boundary, an elementwise stage needs 65,536 workgroups, so dispatch_fft_stage uses more than one y group while the shader repeats x addresses and leaves part of the destination unwritten. Later stages amplify the incomplete stage.",
      "support_implication": "Power-of-two FFT at the accepted upper boundary is not numerically qualified on software Vulkan."
    },
    {
      "area": "array/ops feeding FFT",
      "classification": "confirmed_backend_defect",
      "cluster_id": "complex-abs-broadcast-strides",
      "evidence": [
        {
          "lines": "3039-3056, 2982-3025",
          "observation": "Complex Abs routes to dispatch_complex_extract. That helper binds the original input and count/offset only; unlike dispatch_complex at lines 2949-2970, it has no general-broadcast transport or materialization.",
          "path": "/tmp/mlx-second-wave-integration/overlay/mlx/backend/omarchy/primitives.cpp"
        },
        {
          "observation": "On Device(gpu, 0), the broadcast view itself matched NumPy, but mx.abs(view)+4 mismatched 511 of 512 elements; the downstream FFT mismatched 377 bins.",
          "path": "/tmp/mlx-py-parity-f5ba1c8/core/fft-contiguity-diagnostic.log"
        },
        {
          "observation": "The pinned test reports 332 of 512 FFT elements mismatched after mx.abs on the broadcast complex view.",
          "path": "/tmp/mlx-py-parity-f5ba1c8/core/test_fft.log"
        }
      ],
      "failed_test_names": [
        "tests.test_fft.TestFFT::test_fft_contiguity"
      ],
      "root_cause": "The failure occurs before FFT. Abs::eval_gpu routes complex64 magnitude through dispatch_complex_extract, which dispatches a flat count and offsets but carries no shape or stride metadata. A broadcast complex input is therefore read as contiguous storage instead of through its zero strides, and FFT receives incorrect dense values.",
      "support_implication": "Complex magnitude over broadcast layouts is not qualified; this is an array/ops stride bug rather than an FFT contiguity defect."
    },
    {
      "area": "array/ops",
      "classification": "confirmed_operation_defect",
      "cluster_id": "reflect-pad-multireflect-phase",
      "evidence": [
        {
          "lines": "1458-1540, especially 1491-1515",
          "observation": "reflect_pad uses tile=n-1 and repeatedly slices [filled_start+offset, filled_start+offset+chunk), flips it, and moves filled_start left.",
          "path": "/tmp/mlx-second-wave-integration/.work/mlx/mlx/ops.cpp"
        },
        {
          "observation": "For [0,1,2] with reflect pad [(9,1)], output index 1 was 0 while NumPy expected 2; all other listed values expose the shifted repeated-reflection phase.",
          "path": "/tmp/mlx-py-parity-f5ba1c8/core/diagnostic-smoke.log"
        },
        {
          "observation": "The full pinned file fails first at mode=reflect, shape=(3,), pad=[(9,1)].",
          "path": "/tmp/mlx-py-parity-f5ba1c8/core/test_ops.log"
        }
      ],
      "failed_test_names": [
        "tests.test_ops.TestOps::test_pad_reflect_symmetric"
      ],
      "root_cause": "The iterative left-pad loop reflects fixed-size chunks from the moving filled_start boundary in the already-padded array. For reflect mode with n=3 and a left pad of 9, the chunk source crosses the original/padded boundary with the wrong phase after repeated reflections. The generated period duplicates the low edge where NumPy's period requires the high edge.",
      "support_implication": "Reflect padding larger than the axis is not qualified."
    },
    {
      "area": "array/ops",
      "classification": "intentional_named_refusal",
      "cluster_id": "large-trig-named-refusal",
      "evidence": [
