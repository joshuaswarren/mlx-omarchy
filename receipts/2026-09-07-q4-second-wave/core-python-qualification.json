      ],
      "failed_test_names": [
        "tests.test_ops.TestOps::test_sin"
      ],
      "root_cause": "This backend deliberately refuses real sin/cos inputs whose magnitude exceeds 1e5 because the Vulkan driver's built-in range reduction is not accurate there and the attempted software Payne-Hanek path miscompiles. The upstream test expects values through 1e30, so it reaches the named refusal rather than a numerical comparison.",
      "support_implication": "Large-magnitude real sin/cos remains an explicit unsupported range, not a silent numerical implementation."
    },
