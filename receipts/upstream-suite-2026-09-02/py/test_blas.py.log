                    np.random.normal(0.0, scale, (G, M, K)).astype(np.float32)
                ).astype(dtype)
                w_mx = mx.array(
                    np.random.normal(0.0, scale, (E, N, K)).astype(np.float32)
                ).astype(dtype)
