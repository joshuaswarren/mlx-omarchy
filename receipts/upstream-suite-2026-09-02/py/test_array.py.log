            (mx.uint64, np.uint64),
            (mx.int8, np.int8),
            (mx.int16, np.int16),
            (mx.int32, np.int32),
            (mx.int64, np.int64),
            (mx.float16, np.float16),
            (mx.float32, np.float32),
            (mx.complex64, np.complex64),
        ]
        for mlx_dtype, np_dtype in mlx_to_dlpack:
            with self.subTest(direction="export", dtype=mlx_dtype):
                x = mx.ones((3,), dtype=mlx_dtype)
