    def test_unstack(self):
        a_np = np.arange(6).reshape(3, 2)
        a = mx.array(a_np)
        for axis in [0, 1, -1]:
            parts = mx.unstack(a, axis=axis)
            expected = np.unstack(a_np, axis=axis)
            self.assertEqual(len(parts), len(expected))
