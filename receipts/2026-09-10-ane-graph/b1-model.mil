program(1.3)
[buildInfo = dict<string, string>({})]
{
  func main<ios18>(tensor<fp16, [1, 896]> x) {
    bool tx = const()[name = string("tx"), val = bool(false)];
    bool ty = const()[name = string("ty"), val = bool(true)];
    tensor<fp16, [4864, 896]> W = const()[name = string("W"), val = tensor<fp16, [4864, 896]>(BLOBFILE(path = string("@model_path/weights.bin"), offset = uint64(64)))];
    tensor<fp16, [1, 4864]> y = matmul(x = x, y = W, transpose_x = tx, transpose_y = ty)[name = string("projection")];
  } -> (y);
}
