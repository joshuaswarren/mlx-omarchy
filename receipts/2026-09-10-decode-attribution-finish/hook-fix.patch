+      std::getenv("MLX_OMARCHY_ABLATE_DEBUG") != nullptr;
   static const std::unordered_map<ComputeKernel, ShaderBytes> ablate =
       [] {
         std::unordered_map<ComputeKernel, ShaderBytes> map;
@@ -520,9 +524,26 @@ ShaderBytes shader_bytes(ComputeKernel kernel) {
