+              "shader_bytes call, map_size=%zu\n",
+              map.size());
+        }
         return map;
       }();
   if (const auto it = ablate.find(kernel); it != ablate.end()) {
+    if (ablate_debug) {
+      static std::mutex dbg_mu;
+      static std::set<int> reported;
+      int id = static_cast<int>(kernel);
+      std::lock_guard<std::mutex> g(dbg_mu);
+      if (reported.insert(id).second) {
+        std::fprintf(stderr,
+            "[ablate-debug] kernel=%d swapped, abl_bytes=%zu\n",
+            id, it->second.second);
+      }
+    }
     return it->second;
   }
   switch (kernel) {
