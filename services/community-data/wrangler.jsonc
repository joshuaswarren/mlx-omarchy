// wrangler config for the mlx-omarchy community-data worker.
//
// No account_id here, on purpose: wrangler reads CLOUDFLARE_ACCOUNT_ID from
// the environment. Never commit an account id, token, or zone to this file.
//
// The ONE value an owner fills in by hand: database_id below, printed by
// `wrangler d1 create`. It is not a secret.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mlx-omarchy-community-data",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": { "directory": "./public" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mlx-omarchy-community",
      "database_id": "4d3b499f-fc37-444c-b6fc-9f424b675652",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    // Hourly: rebuild cached index/dataset responses, GC stale submissions.
    "crons": ["17 * * * *"]
  }
}
