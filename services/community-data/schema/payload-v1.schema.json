{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mlx-omarchy community submission payload, schema v1",
  "description": "The JSON summary the collector sends alongside the chunked archive. The Worker validates this strictly; unknown fields are rejected.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "generated_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "enum": ["quick", "deep"] },
    "generated_at": {
      "type": "string",
      "maxLength": 20,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "arch": { "type": ["string", "null"], "maxLength": 512 },
    "model": { "type": ["string", "null"], "maxLength": 512 },
    "chip": { "type": ["string", "null"], "maxLength": 512 },
    "kernel": { "type": ["string", "null"], "maxLength": 512 },
    "mesa_driver": { "type": ["string", "null"], "maxLength": 512 },
    "mesa_device": { "type": ["string", "null"], "maxLength": 512 },
    "mlx_version": { "type": ["string", "null"], "maxLength": 512 },
    "mlx_device": { "type": ["string", "null"], "maxLength": 512 },
    "source_commit": { "type": ["string", "null"], "maxLength": 64 },
    "repo_dirty": { "type": ["boolean", "null"] },
    "cpu_online": { "type": ["integer", "null"], "minimum": 0 },
    "cpu_present": { "type": ["integer", "null"], "minimum": 0,
                     "maximum": 65536 },
    "hotplug_control": { "type": ["boolean", "null"] },
    "ane_dt_node": { "type": ["boolean", "null"] },
    "ane_port": { "type": ["string", "null"], "maxLength": 1024 },
    "ane_port_detail": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "devicetree": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ane_node_present", "ane_nodes", "darts",
                       "pmgr_domains", "phandles"],
          "properties": {
            "ane_node_present": { "type": "boolean" },
            "ane_nodes": {
              "type": "object",
              "additionalProperties": { "type": "object" }
            },
            "darts": {
              "type": "object",
              "additionalProperties": { "type": "object" }
            },
            "pmgr_domains": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path"],
                "properties": {
                  "path": { "type": "string", "maxLength": 256 },
                  "label": { "type": ["string", "null"],
                             "maxLength": 128 },
                  "compatible": {
                    "type": "array",
                    "items": { "type": "string", "maxLength": 128 },
                    "maxItems": 8
                  }
                }
              },
              "maxItems": 64
            },
            "aic": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "properties": {
                "path": { "type": "string", "maxLength": 256 },
                "compatible": {
                  "type": "array",
                  "items": { "type": "string", "maxLength": 128 },
                  "maxItems": 8
                }
              }
            },
            "phandles": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        },
        "runtime": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "iomem": {
              "type": ["array", "null"],
              "items": { "type": "string", "maxLength": 512 },
              "maxItems": 32
            },
            "module_version": { "type": ["string", "null"],
                                "maxLength": 128 },
            "srcversion": { "type": ["string", "null"],
                            "maxLength": 128 },
            "loaded": { "type": ["string", "null"], "maxLength": 256 },
            "dmesg": {
              "type": ["array", "null"],
              "items": { "type": "string", "maxLength": 512 },
              "maxItems": 64
            }
          }
        },
        "truncated": {
          "type": "array",
          "items": { "type": "string", "maxLength": 64 },
          "maxItems": 16
        }
      }
    },
    "ane_dt_compatible": { "type": ["string", "null"], "maxLength": 512 },
    "boot_chain": { "type": ["string", "null"], "maxLength": 512 },
    "cmdline": { "type": ["string", "null"], "maxLength": 1024 },
    "core_shortfall": { "type": ["boolean", "null"] },
    "benchmark": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["n"],
        "properties": {
          "n": { "type": "integer", "minimum": 1 },
          "tflops": { "type": ["number", "null"] },
          "median_ms": { "type": ["number", "null"] }
        }
      }
    },
    "redaction_summary": {
      "type": "object",
      "additionalProperties": { "type": "integer" }
    },
    "files": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "maxLength": 256 },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
