{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mlx-omarchy community submission payload, schema v1",
  "description": "The JSON summary the collector sends alongside the chunked archive. The Worker validates this strictly; unknown fields are rejected.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "generated_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "enum": [
        "quick",
        "deep",
        "omarchy-mac-e2e"
      ]
    },
    "generated_at": {
      "type": "string",
      "maxLength": 20,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "arch": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512
    },
    "model": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512
    },
    "chip": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512
    },
    "kernel": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512
    },
    "mesa_driver": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512
    },
    "mesa_device": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512
    },
    "mlx_version": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512
    },
    "mlx_device": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512
    },
    "source_commit": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "repo_dirty": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "cpu_online": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "cpu_present": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 65536
    },
    "hotplug_control": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "ane_dt_node": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "ane_port": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1024
    },
    "ane_port_detail": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "devicetree": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ane_node_present",
            "ane_nodes",
            "darts",
            "pmgr_domains",
            "phandles"
          ],
          "properties": {
            "ane_node_present": {
              "type": "boolean"
            },
            "ane_nodes": {
              "type": "object",
              "additionalProperties": {
                "type": "object"
              }
            },
            "darts": {
              "type": "object",
              "additionalProperties": {
                "type": "object"
              }
            },
            "ane_reg": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string",
                "maxLength": 128
              },
              "maxItems": 8
            },
            "pmgr_blocks": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "children"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "reg": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "items": {
                      "type": "string",
                      "maxLength": 128
                    },
                    "maxItems": 8
                  },
                  "children": {
                    "type": "array",
                    "maxItems": 256,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "name"
                      ],
                      "properties": {
                        "name": {
                          "type": "string",
                          "maxLength": 128
                        },
                        "label": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "maxLength": 128
                        },
                        "compatible": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "maxLength": 128
                          },
                          "maxItems": 8
                        }
                      }
                    }
                  },
                  "children_total": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            },
            "pmgr_domains": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "label": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 128
                  },
                  "compatible": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 128
                    },
                    "maxItems": 8
                  }
                }
              },
              "maxItems": 64
            },
            "aic": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "maxLength": 256
                },
                "compatible": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "maxItems": 8
                }
              }
            },
            "phandles": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "boot": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "properties": {
                "model": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 256
                },
                "compatible": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "maxItems": 8
                },
                "chosen": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "additionalProperties": {
                    "type": "string",
                    "maxLength": 256
                  }
                }
              }
            },
            "dtb_sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$"
            },
            "set_base_candidate": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "description": "HYPOTHESIS, never a derived fact: ANE SET region candidate = pmgr block base + 0xc000 (where the T8103/T6001 ane_* pwrstate cluster lives and where m1n1 ps_map points). driver_window_confirms records whether Apple's own ane device reg grants a window at exactly that address, which corroborates the hypothesis (t6021: ane0 reg range 3). Linux/m1n1 enumerates the cluster itself. Linux emits the ane_pwrstate_cells shape instead: the ane_set* pwrstate offsets it can source from the DTB (labels ane_cpu/ane_td/ane_base/ane_setN), never a SET MMIO window.",
              "properties": {
                "pmgr_block": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 32
                },
                "offset": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 16
                },
                "base": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 32
                },
                "driver_window_confirms": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "status": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 64
                },
                "ane_pwrstate_cells": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "maxItems": 16,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "label": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "maxLength": 128
                      },
                      "offset": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 0
                      }
                    }
                  }
                },
                "note": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 512
                }
              }
            },
            "adt": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "description": "Apple Device Tree artifact discovery on Linux (m1n1 stage2 / distro ADT dump / live FDT). Presence + sha256 only; the artifact bytes stay on the machine and the hash pins which tree a capture explains. found=false with source=null means no candidate artifact exists.",
              "properties": {
                "found": {
                  "type": "boolean"
                },
                "path": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 256
                },
                "sha256": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[0-9a-f]{64}$"
                },
                "source": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 16
                }
              }
            },
            "adt_nodes": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "description": "ANE-relevant nodes decoded from the ADT artifact: the authoritative path for engine base + DART stream-IDs on any SoC (macOS IORegistry does not expose the engine sub-window). null until the ADT decode step emits it.",
              "properties": {
                "ane0": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "reg": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 8192
                    },
                    "reg_ranges": {
                      "type": [
                        "array",
                        "null"
                      ],
                      "items": {
                        "type": "string",
                        "maxLength": 128
                      },
                      "maxItems": 256
                    }
                  }
                },
                "dart_ane0": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "reg": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 8192
                    },
                    "reg_ranges": {
                      "type": [
                        "array",
                        "null"
                      ],
                      "items": {
                        "type": "string",
                        "maxLength": 128
                      },
                      "maxItems": 256
                    }
                  }
                },
                "ane0_iommus": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "maxItems": 16,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "stream_id": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  }
                },
                "ane0_interrupts": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "maxItems": 16,
                  "items": {
                    "type": "string",
                    "maxLength": 128
                  }
                }
              }
            }
          }
        },
        "runtime": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "iomem": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string",
                "maxLength": 512
              },
              "maxItems": 32
            },
            "module_version": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 128
            },
            "srcversion": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 128
            },
            "loaded": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 256
            },
            "dmesg": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string",
                "maxLength": 512
              },
              "maxItems": 64
            }
          }
        },
        "truncated": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64
          },
          "maxItems": 16
        },
        "macos": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "available",
            "instances",
            "ane_nodes",
            "dart_nodes",
            "coreml",
            "powermetrics"
          ],
          "properties": {
            "available": {
              "type": "boolean"
            },
            "instances": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "matched",
                  "firmware_loaded"
                ],
                "properties": {
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 128
                  },
                  "matched": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 128
                  },
                  "firmware_loaded": {
                    "type": "boolean"
                  },
                  "cores": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "version": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "hw_board_type": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "arch": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 128
                  },
                  "minor_version": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "ANEDevicePropertyANEMinorVersion; version.minor forms e.g. 128.17."
                  }
                }
              }
            },
            "ane_nodes": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "compatible": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "items": {
                      "type": "string",
                      "maxLength": 128
                    },
                    "maxItems": 8
                  },
                  "reg": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 8192
                  },
                  "IOInterruptControllers": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 256
                  },
                  "IOInterruptSpecifiers": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 256
                  },
                  "IOClass": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 128
                  },
                  "phandle": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "reg_ranges": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "items": {
                      "type": "string",
                      "maxLength": 128
                    },
                    "maxItems": 256
                  },
                  "range_kinds": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "items": {
                      "type": "string",
                      "enum": [
                        "ane_mmio",
                        "pmgr_block",
                        "pmgr_plus_c000"
                      ]
                    },
                    "maxItems": 256
                  },
                  "children": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "maxItems": 16,
                    "description": "IORegistry children of this node with their reg entries, when the registry exposes them. t6021 mining showed macOS exposes NO ane0 engine sub-window; an empty/null capture is a platform fact, not a probe failure.",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "name": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "maxLength": 128
                        },
                        "reg": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "maxLength": 8192
                        }
                      }
                    }
                  }
                }
              }
            },
            "dart_nodes": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "compatible": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "items": {
                      "type": "string",
                      "maxLength": 128
                    },
                    "maxItems": 8
                  },
                  "reg": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 8192
                  },
                  "IOInterruptControllers": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 256
                  },
                  "IOInterruptSpecifiers": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 256
                  },
                  "IOClass": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 128
                  },
                  "phandle": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "reg_ranges": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "items": {
                      "type": "string",
                      "maxLength": 128
                    },
                    "maxItems": 256
                  },
                  "dart_id": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "iommu_cells": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Devicetree-only property; always null on macOS (see truncated marker iommu_cells:unavailable_on_macos)."
                  },
                  "dart_options": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 256,
                    "description": "Raw dart-options IORegistry property when present; dart-internal ID, NOT a stream map (t6021: 0x25-class values). Recorded for completeness."
                  }
                }
              }
            },
            "interrupt_controllers": {
              "type": "array",
              "maxItems": 8,
              "description": "Interrupt-controller table for decoding device IOInterruptSpecifiers (AIC phandle -> cells). IORegistry rarely surfaces #interrupt-cells; null is a platform miss, not a probe failure.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "compatible": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "items": {
                      "type": "string",
                      "maxLength": 128
                    },
                    "maxItems": 8
                  },
                  "phandle": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "interrupt_cells": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  }
                }
              }
            },
            "pmgr_nodes": {
              "type": [
                "array",
                "null"
              ],
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "location": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 64
                  },
                  "reg": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 8192
                  },
                  "reg_ranges": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "items": {
                      "type": "string",
                      "maxLength": 128
                    },
                    "maxItems": 256
                  },
                  "reg_ranges_total": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0,
                    "description": "True range count; null when the range cap dropped any (truncated marker reg_ranges:<name>:<total>)."
                  }
                }
              }
            },
            "coreml": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "required": [
                "available",
                "compute_units",
                "error"
              ],
              "properties": {
                "available": {
                  "type": "boolean"
                },
                "compute_units": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 128
                },
                "error": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 128
                }
              }
            },
            "powermetrics": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "required": [
                "available",
                "power_mw",
                "error"
              ],
              "properties": {
                "available": {
                  "type": "boolean"
                },
                "power_mw": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "error": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 128
                }
              }
            },
            "truncated": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 64
              },
              "maxItems": 16
            },
            "driver": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "properties": {
                "matched_class": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 128
                },
                "bundle_identifier": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 128
                },
                "matched_compatible": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 128
                },
                "kext_version": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 64
                },
                "arch": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 32
                },
                "cores": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "ane_version": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "ane_minor_version": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "firmware_loaded": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "instance_count": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "classes_empty": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "maxItems": 8
                }
              }
            },
            "platform": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "properties": {
                "target_type": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 64
                },
                "soc_id": {
                  "type": [
                    "string",
                    "null"
