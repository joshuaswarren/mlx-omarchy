; Attempt: a cooperative matrix constructed by OpCooperativeMatrixLoadKHR
; from a Private-storage pointer, i.e. per-invocation (register) values.
; If the driver accepted this, a B operand could be built in registers
; with no memory round trip. The SPIR-V grammar accepts the module
; (Private is a pointer storage class like any other); the question is
; whether the driver admits it. Expected: pipeline creation rejected.
OpCapability Shader
OpCapability CooperativeMatrixKHR
OpExtension "SPV_KHR_cooperative_matrix"
OpMemoryModel Logical GLSL450
OpEntryPoint GLCompute %main "main"
OpExecutionMode %main LocalSize 32 1 1
%void = OpTypeVoid
%fn = OpTypeFunction %void
%u32 = OpTypeInt 32 0
%f32 = OpTypeFloat 32
%f32_1 = OpConstant %f32 1.0
%u32_0 = OpConstant %u32 0
%u32_8 = OpConstant %u32 8
%u32_3 = OpConstant %u32 3
%u32_2 = OpConstant %u32 2
%priv_f32 = OpTypePointer Private %f32
%priv = OpVariable %priv_f32 Private
%rtarr = OpTypeRuntimeArray %f32
%strct = OpTypeStruct %rtarr
%sb = OpTypePointer StorageBuffer %strct
%buf = OpVariable %sb StorageBuffer
%sb_f32 = OpTypePointer StorageBuffer %f32
%cm = OpTypeCooperativeMatrixKHR %f32 %u32_3 %u32_8 %u32_8 %u32_2
%main = OpFunction %void None %fn
%entry = OpLabel
OpStore %priv %f32_1
%addr = OpAccessChain %sb_f32 %buf %u32_0 %u32_0
%val = OpCooperativeMatrixLoadKHR %cm %priv %u32_8
OpCooperativeMatrixStoreKHR %addr %val %u32_8
OpReturn
OpFunctionEnd
